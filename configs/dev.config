# dev -- debug, loginnable, stable addresses, the Go runtime; no test ladder.
# This is the "accounts, no tests" shape that was impossible before DEV_ACCOUNTS
# was split out of BOOT_PROBES. Add --with chunk-clade for the on-device C/C++ toolchain.
BUILD_TYPE=debug
TESTS=n
BOOT_PROBES=n
DEV_ACCOUNTS=y
HARDENING_FULL=n
KASLR=n
SANITIZE=none
TICKLESS=y
CHUNK_GOROOT=y
CHUNK_CLADE=n
