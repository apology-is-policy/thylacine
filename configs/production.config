# production -- lean, hardened, loginnable, release. The v1.0 boot-to-getty shape.
# Note: unlike the old --production, this HAS login accounts (DEV_ACCOUNTS=y) --
# accounts no longer ride the boot-test ladder.
BUILD_TYPE=release
TESTS=n
BOOT_PROBES=n
DEV_ACCOUNTS=y
HARDENING_FULL=y
KASLR=y
SANITIZE=none
TICKLESS=y
CHUNK_GOROOT=y
CHUNK_CLADE=n
