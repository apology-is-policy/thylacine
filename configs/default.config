# default -- the shape a bare `build.sh` (no --config/--production/--dev) produces.
# It preserves the HISTORICAL default: the in-kernel test suite AND joey's boot-test
# probe ladder ON (the dev/CI shape that `make kernel`, tools/test.sh, and the SMP
# gate all rely on). Do not flip these off here without auditing those callers --
# a lean bare build would silently drop their coverage. Use --production/--config
# for a lean image instead.
TESTS=y
BOOT_PROBES=y
DEV_ACCOUNTS=y
CHUNK_GOROOT=y

# HALCYON IS THE DEFAULT UI (operator-directed 2026-09-09). After login the
# user gets the tiled Halcyon environment instead of a bare `ut` on /dev/cons;
# aurora stays the PRE-LOGIN console renderer (the separate, and per build.sh
# retiring, HALCYON_CONSOLE lever is deliberately NOT set here -- it also bakes
# a wedge-test verb rule, which is a dev/test shape).
#
# THE CALLER AUDIT THIS FILE'S HEADER DEMANDS, done and MEASURED: 47 of the
# interactive scenarios log in, and 35 of those then drive a shell with
# `lc_send`. Those 35 expect `ut` on the serial console and will NOT find it on
# an image built from this profile. They are not broken by it -- they need an
# image without this lever, which is what configs/ci.config now pins
# explicitly. Bake the gate fleet with `tools/build.sh --config ci`, or
# pre-set THYLACINE_HALCYON_SESSION=0 (a caller-set env var wins over the
# config -- bc__export_env does not clobber).
HALCYON_SESSION=y
