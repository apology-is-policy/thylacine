# ci -- the full boot-test regression: in-kernel unit tests + joey's boot-probe
# ladder. BOOT_PROBES implies DEV_ACCOUNTS (the probes authenticate the accounts),
# so accounts are auto-raised on. Add --with chunk-clade for the toolchain probes.
BUILD_TYPE=debug
TESTS=y
BOOT_PROBES=y
HARDENING_FULL=n
KASLR=n
SANITIZE=none
TICKLESS=y
CHUNK_GOROOT=y
CHUNK_CLADE=n
# EXPLICIT, not merely the schema default: since 2026-09-09 the `default`
# profile turns HALCYON_SESSION on, and 35 interactive scenarios log in and
# then drive a shell with `lc_send` -- they need `ut` on /dev/cons, which the
# session lever replaces. Stated here so the gate image is unambiguous and so
# a future edit of default.config cannot silently drag the gates along.
HALCYON_SESSION=n

# The gate fleet's Halcyon scenarios that predate Instrument (ls-halcyon, the
# ls-gfx-* set) assert the LEGACY UI's literals, so the gate image pins the
# legacy profile just as it pins the session off above. The Instrument gates
# override it the same way they enable the session: a caller-set
# THYLACINE_HALCYON_PROFILE=instrument wins over this file.
HALCYON_PROFILE=legacy
