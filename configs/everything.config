# everything -- every bake chunk on, no boot tests: the complete, quick-to-boot
# image (the replacement for build-everything.sh). Optional chunks whose inputs are
# absent are skipped with a forage instruction, not a hard failure.
# (CHUNK_AURORA_CFG stays off -- a niche opt-in payload, matching the prior behavior.)
BUILD_TYPE=debug
TESTS=n
BOOT_PROBES=n
DEV_ACCOUNTS=y
HARDENING_FULL=n
KASLR=n
SANITIZE=none
TICKLESS=y
CHUNK_GOROOT=y
CHUNK_CLADE=y
CHUNK_CHASE_W2=y
CHUNK_ALPINE=y
CHUNK_QUAKE=y
CHUNK_DOSBOX=y
CHUNK_DUKE3D=y
CHUNK_TOMBRAIDER=y
DOSBOX_CPU_PRESET=pentium
CHUNK_AURORA_CFG=n
