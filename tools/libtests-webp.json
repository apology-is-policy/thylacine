{
  "comment": "libwebp registers no CTest tests (its tests/ is fuzzers; its test vectors are a separate repository driven by shell scripts). These are the checks in CTest's own JSON shape, so tools/libtests-manifest.py translates them like upstream lists. Upstream's documented verification (doc/tools.md: dwebp test.webp -ppm equal to test_ref.ppm) has not held since 0.5.0 changed the YUV->RGB rounding (NEWS); 1.6.0's decode differs from test_ref.ppm by exactly 1 in 13265 of its 49152 samples. So each lossy check pins a SHA-256 instead: libwebp 1.6.0's own output, built natively on an arm64 host, where the C (-noasm) and NEON paths agree byte for byte; a new pin recomputes them the same way. The lossless round trip (exact against test_ref.ppm) and the PNG round trip through libpng need no digest. @BUILD@ and @SRC@ are the build and source trees.",
  "kind": "ctestInfo",
  "version": { "major": 1, "minor": 0 },
  "tests": [
    {"name": "dwebp-ref", "command": ["@BUILD@/dwebp", "@SRC@/examples/test.webp", "-ppm", "-o", "ref.ppm"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}] },
    {"name": "dwebp-ref-sha256", "command": ["cmake", "-E", "sha256sum", "ref.ppm"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["dwebp-ref"]}, {"name": "PASS_REGULAR_EXPRESSION", "value": ["^db448ba15096dd0941cacb7e7cc8f0bf5461226c423c330fa73d0591bd8ac980  "]}] },
    {"name": "cwebp-lossless", "command": ["@BUILD@/cwebp", "-lossless", "@SRC@/examples/test_ref.ppm", "-o", "ll.webp"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}] },
    {"name": "dwebp-lossless", "command": ["@BUILD@/dwebp", "ll.webp", "-ppm", "-o", "ll.ppm"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["cwebp-lossless"]}] },
    {"name": "lossless-cmp", "command": ["cmake", "-E", "compare_files", "ll.ppm", "@SRC@/examples/test_ref.ppm"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["dwebp-lossless"]}] },
    {"name": "dwebp-png", "command": ["@BUILD@/dwebp", "ll.webp", "-o", "ll.png"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["cwebp-lossless"]}] },
    {"name": "cwebp-png", "command": ["@BUILD@/cwebp", "-lossless", "ll.png", "-o", "png.webp"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["dwebp-png"]}] },
    {"name": "dwebp-png-back", "command": ["@BUILD@/dwebp", "png.webp", "-ppm", "-o", "png.ppm"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["cwebp-png"]}] },
    {"name": "png-cmp", "command": ["cmake", "-E", "compare_files", "png.ppm", "@SRC@/examples/test_ref.ppm"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["dwebp-png-back"]}] },
    {"name": "cwebp-lossy", "command": ["@BUILD@/cwebp", "-q", "75", "@SRC@/examples/test_ref.ppm", "-o", "lossy.webp"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}] },
    {"name": "cwebp-lossy-sha256", "command": ["cmake", "-E", "sha256sum", "lossy.webp"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["cwebp-lossy"]}, {"name": "PASS_REGULAR_EXPRESSION", "value": ["^69b51cca94353c41bf9ff01e3995c86d0d5f377c998e72b937af7818e1c66dfa  "]}] },
    {"name": "webpinfo-lossy", "command": ["@BUILD@/webpinfo", "lossy.webp"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["cwebp-lossy"]}] },
    {"name": "dwebp-lossy", "command": ["@BUILD@/dwebp", "lossy.webp", "-ppm", "-o", "lossy.ppm"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["cwebp-lossy"]}] },
    {"name": "dwebp-lossy-sha256", "command": ["cmake", "-E", "sha256sum", "lossy.ppm"],
      "properties": [{"name": "WORKING_DIRECTORY", "value": "@BUILD@"}, {"name": "DEPENDS", "value": ["dwebp-lossy"]}, {"name": "PASS_REGULAR_EXPRESSION", "value": ["^ca74f0a0d462122b17c8b46eeaa9c8aabe6cfb81833c78ba8f4ae50c85b66edb  "]}] }
  ]
}
