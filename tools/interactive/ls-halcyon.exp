#!/usr/bin/expect -f
# tools/interactive/ls-halcyon.exp -- the H-2 transcript MVP, end to end
# (HALCYON.md sections 4 + 13; the ROADMAP section-11.1 H-2 gate row).
#
# GATED ON THE BAKED LEVER (the cfg-4 precedent): the pool carries
# /lib/halcyon/renderer = "halcyond" only under THYLACINE_HALCYON=1, because
# every sibling scenario and the suite assume the aurora fbcon. On a default
# image joey spawns aurora and this scenario SKIPs cleanly (the go5/chords
# idiom: lc_quit + exit 0); on a lever image it proves:
#
#   render  : joey chose halcyond; the rich advertisement landed; login ->
#             ut flows through the transcript; the screendump's dominant
#             color is the PARCHMENT ground (paper-light -- aurora never
#             paints it: its default is the Bonfire dark) with real ink on
#             top (the discriminating pixel pair).
#   rich    : the H-1 canary now reads RICH ("ut: beacon rich exported" +
#             "transcript zones armed" -- the F7 transport half through a
#             REAL advertisement), and `ls -l` emits the rich PRE (box-
#             drawing code-fence) frame on the wire ("1936;v1;pre" -- PL-5:
#             box-drawing output rides `pre`, HALCYON.md 14.13; output-only:
#             no typed command contains it). F10's silence is pinned too:
#             no "re-exported" line (the tier never changed mid-session).
#   reflow  : /dev/winsize reads the full mono grid; a compositor SPLIT
#             (the default Super+H chord over the REAL QMP keyboard path)
#             halves the width -> halcyond reflows + re-reports winsize;
#             ZOOM (Super+F) restores it. The resize E2E of the gate row.
#
# HVF like the gfx siblings (bare TCG hangs at the pre-existing 8a-2b
# hwwatch E2E -- task #27). Serial discipline: typed commands stay short;
# assertion tokens are output-only.

set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

set repo $lc_repo
set qmp [lc_qmp_sock]

# The whole-session transcript (the ls-3a idiom): tail greps are
# buffer-order-immune where expect's cursor has already moved past a line.
set transcript /tmp/ls-halcyon-[pid].log
catch {file delete -force $transcript}
log_file -a $transcript

proc hkey {chord} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k $chord} err]} {
        lc_fail "qmp-sendtext -k $chord failed: $err"
    }
    after 1500 ;# split/zoom -> CONFIGURE -> reflow -> winsize re-report
}

# Screendump + region verdict: "<off> <total> <dom_r> <dom_g> <dom_b>".
proc region {x0 y0 x1 y1 {r 242} {g 235} {b 224}} {
    global repo qmp
    set out /tmp/ls-halcyon-[pid].png
    file delete -force $out
    if {[catch {exec $repo/tools/screendump.sh -s $qmp $out} err]} {
        return "DUMP-ERR $err"
    }
    if {![file exists $out]} { return "DUMP-MISSING" }
    if {[catch {exec python3 $repo/tools/interactive/gfx_region.py $out $x0 $y0 $x1 $y1 $r $g $b} verdict]} {
        return "REGION-ERR $verdict"
    }
    return $verdict
}

proc strip_want {x0 y0 x1 y1 r g b what want_ink} {
    set v ""
    for {set i 0} {$i < 12} {incr i} {
        set v [region $x0 $y0 $x1 $y1 $r $g $b]
        if {[regexp {^(\d+) (\d+) (\d+) (\d+) (\d+)$} $v -> off tot dr dg db]} {
            if {$dr == $r && $dg == $g && $db == $b && (!$want_ink || $off > 0)} {
                return "$off $tot"
            }
        }
        after 500
    }
    lc_fail "$what: region $x0,$y0-$x1,$y1 never read dominant $r,$g,$b (want_ink=$want_ink; last: $v)"
}

lc_boot

# The renderer probe: joey names its choice in the boot stream. Aurora =>
# the lever is not baked => SKIP (never a red on a default image).
set timeout $lc_boot_timeout
expect {
    -ex "joey: halcyond spawned" { lc_step "joey chose halcyond (lever image)" }
    -ex "joey: aurora spawned" {
        puts "\nLS-CI SKIP: default image (aurora fbcon) -- the halcyon lever\
 is not baked. Bake with THYLACINE_HALCYON=1 to run this scenario."
        lc_quit
        # 77 = the harness's SKIP code: scored SKIP and summarized as "NOT
        # coverage". exit 0 here was scored PASS, and three H-3b runs read that
        # PASS as a bevel/tag-bar witness the scenario never executed.
        exit 77
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction before the renderer spawn" }
    timeout { lc_fail "no renderer spawn line within ${lc_boot_timeout}s" }
    eof     { lc_fail "qemu exited before the renderer spawn" }
}

# halcyond bring-up (the rich advertisement + the transcript surface) is
# asserted at the END via tgrep, NOT inline here: an inline lc_expect consumes
# the stream up through "console up", but "Thylacine login: " races ahead of
# "console up" on some boots (login and halcyond print on the SAME serial from
# different procs, so their order is non-deterministic) -- swallowing the login
# prompt and hanging lc_login for the whole boot timeout. tgrep is
# order-independent (it greps the whole transcript at the end).
lc_login michael correct-horse-battery-staple-v1

# The session leg: real output through the transcript (frames bracket the
# payload; the payload bytes are intact on serial -- the strip identity).
# Sequencing markers are OUTPUT-ONLY (`; pwd` -> /home/michael): a token
# from the ls arguments would match its own typed echo (the #60 class).
# The CONTENT proof is the transcript's frame greps below + the pixels.
# OPERANDS MUST EXIST POST-PIVOT: /version//welcome are BOOT-ramfs paths
# and vanish at the pivot -- pointing ls at them made every leg pass
# hollowly through `; pwd` while ls errored to stderr (the hunt that
# found it: ps framed, ls never did; the gate was innocent).
lc_run_expect "ls /lib/aurora; pwd" "/home/michael"
lc_run_expect "ls -l /lib/aurora; pwd" "/home/michael"

# The pixel proof: the dominant color of a rect over the transcript's
# newest third IS the parchment ground (242,235,224) -- aurora's Bonfire
# dark can never produce it -- and ink exists on top (off > 0 alone would
# pass an unpainted buffer; require real text mass). The LOWER band, not the
# display's centre: on this lever the transcript opens with the mirrored
# boot log, which the composition round's class rule renders as a raw
# island on the `header` ground (206,196,182), and the view is bottom-
# anchored, so how much of that island the centre band sees depends on how
# many rows the session has produced below it. The centre-band form passed
# only while a per-paint say line was padding the transcript (the chrome-
# content round's observer-effect bug); with that fixed it read header-
# dominant on three boots straight -- a measurement keyed on content
# history, not on the property it claims.
# THE BAND MOVE WAS NOT ENOUGH, and the paragraph above says why without
# drawing the conclusion: if the verdict depends on how many rows precede the
# shell, then ANY change to the boot chatter can flip it -- moving the band
# only changes which line count breaks it. Measured 2026-09-09: two new
# startup lines (halcyond and tapestryd each naming the theme in force) put
# the boot-log island back under the lower band, and this read header-dominant
# on three boots straight, deterministically.
#
# So assert THE PROPERTY THIS CLAIMS instead of a proxy for it: the dominant
# ground is a DAYLIGHT ground. Both members are Daylight's -- 242,235,224 is
# the pane surface, 206,196,182 is the `header` the raw-output island sits on
# -- and which one wins is a fact about content history, which this gate does
# not exist to pin. Discrimination is unchanged and by construction: it is a
# whitelist of two exact LIGHT colours, so aurora's Bonfire dark ground (or an
# unpainted buffer) fails it as hard as it did before. The ink floor below is
# what keeps "painted" from meaning "cleared".
set v [region 200 450 1080 760]
if {![regexp {^(\d+) (\d+) (\d+) (\d+) (\d+)$} $v -> off total dr dg db]} {
    lc_fail "gfx_region verdict unparseable: $v"
}
# TH-5b: which theme the image was BAKED with is the HARNESS's fact, not the
# guest's -- keying the expectation on a line the guest emits would let a guest
# that loaded nothing pass by saying so. `LS_THEME` comes from the same place
# `THYLACINE_HALCYON_THEME` did, and the guest must AGREE with it.
set ls_theme "daylight"
if {[info exists ::env(LS_THEME)] && $::env(LS_THEME) ne ""} {
    set ls_theme $::env(LS_THEME)
}
# Defined HERE rather than beside its Daylight-only call block near the end of
# the file, so the non-Daylight run -- which exits well above that -- can use it
# (TH-6 F6). It reads `$transcript` at call time, so its position only has to
# be after the boot.
proc tgrep {pat what} {
    global transcript
    if {[catch {exec grep -q -- $pat $transcript}]} {
        lc_fail "transcript missing: $what ($pat)"
    }
    lc_pass "halcyon: $what"
}
# The grounds ARE the proof. Nothing but a theme file read off the disk,
# parsed, resolved and painted can put Nightjar's #1A1614 or #2A2422 on this
# screen -- there is no other source of those values in the tree -- so the
# pixel check IS the end-to-end witness of the load path, not a proxy for it.
# `dark` is an explicit per-theme FACT, not `$ls_theme ne "daylight"`. The
# parchment assertion below is only sound for a theme whose palette cannot
# reach Daylight's surface; a future LIGHT gallery theme would hard-fail it
# with a message accusing a Daylight constant that is not there.
switch -- $ls_theme {
    daylight { set grounds {242,235,224 206,196,182} ; set dark 0 }
    nightjar { set grounds {26,22,20 42,36,34}       ; set dark 1 }
    default  { lc_fail "ls-halcyon: unknown LS_THEME '$ls_theme'" }
}
set dom "$dr,$dg,$db"
if {[lsearch -exact $grounds $dom] < 0} {
    lc_fail "dominant color ($dom) is not a $ls_theme ground (expected one of: $grounds) -- halcyond is not painting that theme"
}
if {$ls_theme ne "daylight"} {
    lc_pass "halcyon: $ls_theme loaded from /lib/halcyon/theme.toml and PAINTED (ground $dom)"
    # TH-6 F1's WITNESS, and it costs nothing because the number is already
    # here: `region`'s reference colour is Daylight's parchment, so `$off`
    # counts pixels that are NOT it. Under any other theme EVERY pixel must be
    # one -- a single parchment pixel in a Nightjar transcript means something
    # is still painting a Daylight CONSTANT into themed content.
    #
    # That is exactly what F1 was: the console renderer seeded its transcript
    # pen from `daylight_palette()` twelve lines after threading the resolved
    # theme into its sheet, so every cell's default style was Daylight's, and
    # `st.bg != sheet.theme.terminal.bg` turned each run into a full-height
    # parchment box on a dark pane. The `off >= 300` check below could not see
    # it -- it was SATISFIED BY those very boxes. Reachability is not a
    # coincidence either: Nightjar's lightest ink is (232,224,212), darker than
    # parchment in every channel, so no blend of its ink and ground can produce
    # (242,235,224). Measured on the fix: 272800/272800.
    if {$dark && $off != $total} {
        lc_fail "[expr {$total - $off}] of $total pixels are DAYLIGHT parchment (242,235,224) in a $ls_theme transcript -- a Daylight constant is still painting into themed content (TH-6 F1)"
    }
    lc_pass "halcyon: not one Daylight pixel in the $ls_theme transcript ($off/$total)"
}
if {$off < 300} {
    lc_fail "only $off/$total non-ground pixels -- no ink on the transcript"
}
lc_pass "halcyon: parchment ground + ink ($off/$total non-ground px, dom $dr,$dg,$db)"

# The reflow E2E: full grid -> compositor split (REAL Super+H over QMP) ->
# halcyond reflows + re-reports -> zoom restores. The winsize read is the
# kernel-visible witness of the CONFIGURE path end to end.
lc_run_expect "cat /dev/winsize" "winsize 213 "
# The full-width column count, the reference every halved-grid check below
# derives from (a literal range written for one cell size rots the day the
# cell changes -- it did, at 6 px).
set full_cols 213
lc_pass "halcyon: full-width mono grid reported ($full_cols cols: the 6-px island cell, one mono size)"

# H-3d: THE STATUS BAR (HALCYON.md 13.6; Daylight 6). halcyond mints ONE
# Role::Status surface once the console is up; the compositor carves the
# display's bottom 20 rows for it and places it there. The compositor's
# `statusbar` file is the rect (its own fact, read off ctl's display size);
# halcyond's `painted` line says where the four slots landed (it reaches the
# serial like every say line; the transcript mirror is harmless -- the bar
# is outside the transcript). Pixels: the strip's left end is the bar's own
# dark (status_bg 26,18,10) and the active workspace indicator is ember
# (224,120,64) -- colours nothing else on this screen is painted -- and the
# condition (the turnstile + its label) follows the console's last exit:
# cinnabar (152,40,24) after a failing command (a quiet `grep -q` miss: exit
# 1 with no operand error -- the sanity control below greps for that
# wording), ember after a passing one (the operator's mockups: sage does not
# read on the dark bar), in step with the live tile. The context slot
# carries the console's directory (ut's OSC 7) and its running-or-last
# command (ut's cmd mark) -- checked at the end by tgrep, order-independent.
lc_send "cat /dev/tapestry/ctl"
set dispw 0; set disph 0
expect {
    -re {display (\d+) (\d+)[\r\n]} { set dispw $expect_out(1,string); set disph $expect_out(2,string) }
    timeout { lc_fail "no display line from the tapestry ctl" }
}
lc_send "cat /dev/tapestry/statusbar"
expect {
    -re {[\r\n\\](\d+) (\d+) (\d+) (\d+)[\r\n]} {
        set sx $expect_out(1,string); set sy $expect_out(2,string); set sw $expect_out(3,string); set sh $expect_out(4,string)
    }
    timeout { lc_fail "no rect from the statusbar file" }
}
if {$sx != 0 || $sw != $dispw || $sh != 20 || $sy != $disph - 20} {
    lc_fail "statusbar rect $sx $sy $sw $sh is not the bottom strip of ${dispw}x${disph}"
}
lc_pass "halcyon: the compositor carved the status strip ($sx $sy $sw $sh of ${dispw}x${disph})"
# H-3d (F4): the carve is not just the statusbar rect -- it must shrink the
# LAYOUT. The single console leaf's content height in the compositor's
# `layout` file must equal the display MINUS the strip. A regression that
# registered the bar (rect correct) but skipped `layout.recompute(dw,
# layout_h, ..)` would leave the leaf full-height -- its bottom 20px hidden
# behind the opaque bar -- and still pass the rect check above. Cell-height
# independent (reads the compositor's own geometry, not a derived grid).
lc_send "cat /dev/tapestry/layout"
set leaf_h 0
expect {
    -re {leaf surface=\d+ \[\d+,\d+,\d+,(\d+)\]} { set leaf_h $expect_out(1,string) }
    timeout { lc_fail "no console leaf row in the layout file" }
}
if {$leaf_h != $disph - 20} {
    lc_fail "the console leaf height $leaf_h is not the carved region [expr {$disph - 20}] (the layout was not recomputed above the bar)"
}
lc_pass "halcyon: the carve shrank the layout -- the console leaf is $leaf_h of the ${disph}px display (strip 20)"
set smid [expr {$sy + 10}]
# The bar's own ground is a THEME token, not a constant -- the same lesson the
# transcript ground taught above, found the same way: the Nightjar run failed
# here reading 42,36,34 where this wanted Daylight's 26,18,10, which is the
# gate correctly noticing that halcyond had followed the theme and it had not.
# The ember below is deliberately NOT parameterised: HALCYON-VISUAL 1.3 shares
# it verbatim between themes, so a run where it MOVED is a real failure.
switch -- $ls_theme {
    daylight { set sbg {26 18 10} ; set cinn {152 40 24} }
    nightjar { set sbg {42 36 34} ; set cinn {208 64 56} }
}
strip_want 1 [expr {$sy + 2}] 6 [expr {$sy + 18}] {*}$sbg "status bar left end (status_bg)" 0
strip_want [expr {$dispw - 6}] [expr {$sy + 2}] [expr {$dispw - 1}] [expr {$sy + 18}] {*}$sbg "status bar right end (status_bg)" 0
strip_want 9 [expr {$sy + 5}] 13 [expr {$sy + 15}] 224 120 64 "the active workspace indicator (ember)" 0
lc_pass "halcyon: the status bar is dark at both ends with the ember workspace indicator at the left"
# A failing command -> the live tile AND the bar's condition go cinnabar
# (the same record); a passing one -> the good state. The painted line
# carries the condition slot's rect: the turnstile + its label (`⊢ exit 1`
# / `⊢ ok`) in the key's ink. Glyphs are ANTIALIASED (the island bake's
# turnstile too -- measured: 3 px within a 24-box of the ink, 34 within 80),
# so the leg counts the pixels ON the blend line from the bar's dark to the
# ink (gfx_region.py --ink: at least half the ink, a tight residual) AND
# requires NONE on the other state's line in the same slot -- ink of any
# colour would pass a slot painted the wrong state, a box tolerance wide
# enough for the blends also catches the other ink (ember and cinnabar sit
# within 80 of each other), and a dominant-colour verdict cannot see a
# glyph at all (the slot is mostly the bar's dark).
proc status_painted {want_cond what} {
    global timeout lc_cmd_timeout
    set timeout $lc_cmd_timeout
    expect {
        -re "halcyond: status bar (\\d+) painted ws \\\[(\\d+) (\\d+)\\\] ctx \\\[(\\d+) (\\d+)\\\] cond \\\[(\\d+) (\\d+)\\\] clock \\\[(\\d+) (\\d+)\\\] context \"(\[^\"\]*)\" condition $want_cond" {
            return [list $expect_out(6,string) $expect_out(7,string) $expect_out(10,string)]
        }
        timeout { lc_fail "$what: no status bar painted line with condition $want_cond" }
    }
}
# Pixels of a screendump rect on the blend line from the bar's dark
# (status_bg 26,18,10) to the ink (r,g,b): the antialiased-glyph witness.
proc ink_of {x0 y0 x1 y1 r g b} {
    global repo qmp
    set out /tmp/ls-halcyon-[pid].png
    file delete -force $out
    if {[catch {exec $repo/tools/screendump.sh -s $qmp $out} err]} { return -1 }
    if {![file exists $out]} { return -1 }
    # The blend runs FROM the bar's own ground, which is the theme's -- the
    # same token `strip_want` above now reads off `$sbg`. Hardcoding Daylight
    # here would measure a blend line the bar is not on.
    global sbg
    if {[catch {exec python3 $repo/tools/interactive/gfx_region.py --ink $out $x0 $y0 $x1 $y1 {*}$sbg $r $g $b} n]} { return -1 }
    return $n
}
# The condition slot [cx, cx+cw) across the bar's middle 16 rows must carry
# >= 6 px of the (r,g,b) ink and 0 px of the (nr,ng,nb) ink; retried across
# the paint (the say line precedes the present).
proc cond_want {cx cw smid r g b nr ng nb what} {
    set n -1; set m -1
    for {set i 0} {$i < 12} {incr i} {
        set n [ink_of $cx [expr {$smid - 8}] [expr {$cx + $cw}] [expr {$smid + 8}] $r $g $b]
        set m [ink_of $cx [expr {$smid - 8}] [expr {$cx + $cw}] [expr {$smid + 8}] $nr $ng $nb]
        if {$n >= 6 && $m == 0} { return $n }
        after 500
    }
    lc_fail "$what: the condition slot $cx+$cw never read >= 6 px of the $r,$g,$b ink with none of $nr,$ng,$nb (last $n / $m)"
}
lc_send "grep -q h3d-not-there /lib/beacon/verbs"
set p [status_painted Err "after a failing command"]
set cx [lindex $p 0]
set cw [lindex $p 1]
set n [cond_want $cx $cw $smid {*}$cinn 224 120 64 "condition after a failing command (cinnabar)"]
lc_pass "halcyon: the bar's condition went cinnabar with the failing command ($n px; context \"[lindex $p 2]\")"
lc_send "cd /lib/aurora; ls; pwd"
set p [status_painted Ok "after a passing command"]
# F3: the slot's x moves with the condition label ("ok" is narrower than
# "exit 1"), so re-extract cx/cw from THIS (Ok) painted line.
set cx [lindex $p 0]
set cw [lindex $p 1]
set n [cond_want $cx $cw $smid 224 120 64 {*}$cinn "condition after a passing command (ember)"]
lc_pass "halcyon: the bar's condition went ember with the passing command ($n px; context \"[lindex $p 2]\")"

# WHERE THE NON-DAYLIGHT RUN STOPS, and why it stops HERE rather than running
# on. Everything above is either theme-independent or reads its colours off
# `$ls_theme`; everything BELOW is calibrated for Daylight's palette in ways
# that do not merely fail under another theme -- they pass HOLLOWLY. The worst
# is `no_strip_at_left`, which returns "no strip present" when it cannot
# recognise the strip's colours, so under Nightjar a leg asserting a strip is
# ABSENT would be satisfied by a strip that is plainly there.
#
# So the Nightjar run proves what it can prove soundly -- the file was read
# off the disk, parsed, resolved, and PAINTED, with the transcript ground, the
# status bar ground and the condition inks all following it -- and hands the
# rest to the Daylight run, which still exercises every leg. Widening the
# remaining legs is real work; claiming them by running past them is not.
# TH-6 F6: THE COMPOSITOR'S HALF. Everything above proves HALCYOND followed
# the theme. None of it proves TAPESTRYD did -- and tapestryd's chrome is
# exactly what TH-5b caught painting Daylight around a Nightjar pane, silently,
# because the compositor starts before the pool it would read the file from is
# mounted. Until now the only pixels the non-Daylight run asserted were
# halcyond's (its status surface is opaque and Clear()s its own ground over
# tapestryd's fill), so the compositor's painter had NO witness on the run that
# could actually discriminate. Two, both cheap:
#
# (1) the log line proving the gated `theme` verb was ADMITTED, not refused.
tgrep "halcyond: theme pushed to the compositor" "the resolved theme was pushed over the gated verb"
if {$ls_theme ne "daylight"} {
    # Only under a lever: `apply_theme` is idempotent, so on a default image
    # the renderer pushes the built-in the compositor already has and says
    # nothing -- which is correct, and is also why this cannot be asserted
    # unconditionally.
    tgrep "tapestryd: theme applied" "the COMPOSITOR admitted the push and re-derived its metrics"
}
# (2) a pixel TAPESTRYD itself painted: the pane bevel (HALCYON-VISUAL 2.1,
# `paint_borders`). The bevel needs TWO leaves -- MEASURED on a failing first
# attempt at this leg, which sampled the pre-split screen and found columns
# 0..8 all pane surface (26,22,20) and rows 0..24 all tag-bar header: a single
# full-bleed pane carries no floor gap and no bevel, exactly as the pre-split
# control at the `no_strip_at_left` leg below already states. It failed loudly
# rather than passing hollowly, which is the safe direction for a leg that
# asserts a thing is PRESENT.
#
# So the Daylight run keeps its bevel check at the real split further down, and
# the non-Daylight run -- which exits before that -- makes its own split here.
switch -- $ls_theme {
    daylight { set bev_l {226 214 192} ; set bev_t {248 242 230} }
    nightjar { set bev_l {58 51 46}    ; set bev_t {78 69 62} }
    # Two switches enumerate this same variable with different arm sets. The
    # one above fails an unknown theme first, so this cannot fire today -- but
    # add a third theme there and forget it here, and `bevel_want` reads UNSET
    # globals: an uncaught Tcl error, i.e. a run that dies with no failure
    # line, which is this project's tell for a script that died rather than a
    # gate that failed.
    default  { lc_fail "ls-halcyon: no bevel colours for LS_THEME '$ls_theme' -- add an arm beside the grounds switch" }
}

# `bevel_want` is shared by both runs so the two checks cannot drift, and so
# the values live in the `$bev_*` pair rather than in literals at each site.
proc bevel_want {when} {
    global bev_l bev_t ls_theme
    # RETRIED, like `strip_want` and for its reason: this samples after a
    # chord, and a fixed `after 1500` is a guess about how long the
    # compositor's reconcile takes on a loaded host. A single early sample
    # would fail with a message naming THE COMPOSITOR as the culprit -- a
    # fabricated defect with a wrong cause attached, which is worse than a
    # missed one. The last reading is reported so a real failure still says
    # what it saw.
    set lr ""; set lg ""; set lb ""; set tr ""; set tg ""; set tb ""
    for {set i 0} {$i < 12} {incr i} {
        set vl [region 1 120 3 560]
        set vt [region 120 1 560 3]
        if {[regexp {^(\d+) (\d+) (\d+) (\d+) (\d+)$} $vl -> l_off l_tot lr lg lb]
            && [regexp {^(\d+) (\d+) (\d+) (\d+) (\d+)$} $vt -> t_off t_tot tr tg tb]
            && [list $lr $lg $lb] eq $bev_l && [list $tr $tg $tb] eq $bev_t} {
            if {[list $lr $lg $lb] eq [list $tr $tg $tb]} {
                lc_fail "$when: bevel_left == bevel_top -- the NNW four-value bevel collapsed to a two-value diagonal (section 2.1 broken)"
            }
            lc_pass "halcyon: TAPESTRYD painted the $ls_theme bevel $when (left $bev_l != top $bev_t -- four-value NNW)"
            return
        }
        after 500
    }
    lc_fail "$when: after 12 samples the edges read left ($lr,$lg,$lb) / top ($tr,$tg,$tb), wanted $ls_theme bevel_left ($bev_l) / bevel_top ($bev_t) -- THE COMPOSITOR is not painting this theme's chrome"
}

if {$ls_theme ne "daylight"} {
    # A split of our own: two leaves is what makes a bevel exist at all.
    hkey "meta_l+h"
    bevel_want "under $ls_theme"
    lc_pass "halcyon: $ls_theme END-TO-END -- disk -> parse -> resolve -> paint,\
             BOTH halves: halcyond's grounds/status/condition inks AND the\
             COMPOSITOR's own bevel plus its admission of the pushed verb"
    lc_quit
    exit 0
}
lc_run_expect "pwd" "/lib/aurora"
lc_run_expect "cd; pwd" "/home/michael"

# H-3c: THE KEYBOARD PATH (HALCYON.md 13.6 "obj interaction"; 5/6). `ls
# /lib/aurora; pwd` leaves a path obj run on the row above the newest; Esc
# enters Normal at the newest row, k moves onto the ls row, Enter opens the
# verb menu for its first run. halcyond says the placement + the run's
# DISPLAY rect (the coordinates every later leg keys on); the compositor
# says its own placement. The menu ground is Daylight `raised` (189,176,160)
# -- a colour nothing else on this screen is painted -- so the placed rect's
# DOMINANT colour is the proof it composed on top. Esc then dismisses it
# COMPOSITOR-SIDE (its `dismissed (esc)` line: nothing else emits it), and
# the rect reads transcript parchment again once the console re-presented
# under the heal's redraw request.
# Returns {id x y w h ref} -- the COMPOSITOR's clamped rect (its own
# `placed` line, printed inside the `menu place` write, before halcyond's;
# halcyond's line carries the REQUESTED point, which the compositor clamps
# into the display) + the ref halcyond displayed.
proc menu_placed {what} {
    global timeout lc_cmd_timeout
    set timeout $lc_cmd_timeout
    expect {
        -re {tapestryd: menu (\d+) placed at (\d+),(\d+) (\d+)x(\d+)[\r\n]} {
            set id $expect_out(1,string); set x $expect_out(2,string); set y $expect_out(3,string)
            set w $expect_out(4,string); set h $expect_out(5,string)
        }
        -re {halcyond: menu (surface failed|place refused)[^\r\n]*} {
            lc_fail "$what: the menu was refused: $expect_out(0,string)"
        }
        timeout { lc_fail "$what: no compositor placement line" }
        eof     { lc_fail "$what: EOF waiting for the menu" }
    }
    expect {
        -re {halcyond: menu (\d+) placed at (\d+) (\d+) \((\d+)x(\d+)\) for path (\S+) run at (\d+) (\d+) (\d+) (\d+)[\r\n]} {
            if {$expect_out(1,string) != $id} { lc_fail "$what: halcyond placed menu $expect_out(1,string), the compositor $id" }
            return [list $id $x $y $w $h $expect_out(6,string)]
        }
        timeout { lc_fail "$what: no halcyond placement line" }
        eof     { lc_fail "$what: EOF waiting for halcyond's placement line" }
    }
}
proc menu_open_kbd {what} {
    hkey "esc"
    hkey "k"
    hkey "ret"
    return [menu_placed $what]
}
proc menu_want_raised {mx my mw mh what} {
    set v ""
    for {set i 0} {$i < 12} {incr i} {
        set v [region $mx $my [expr {$mx + $mw}] [expr {$my + $mh}] 189 176 160]
        if {[regexp {^(\d+) (\d+) (\d+) (\d+) (\d+)$} $v -> off tot dr dg db] \
                && $dr == 189 && $dg == 176 && $db == 160} {
            return "$off $tot"
        }
        after 500
    }
    lc_fail "$what: the menu rect $mx,$my ${mw}x$mh never read Daylight raised (189,176,160): $v"
}
# The menu is gone when its rect reads a TRANSCRIPT ground again -- the
# parchment, or the `header` a raw island paints (a verb chosen from the
# menu runs a command whose output can be an island right where the menu
# stood: the command-path leg's `stat`); the menu's own `raised`
# (189,176,160) is what must have gone, and neither ground can be it.
proc menu_want_gone {mx my mw mh what} {
    set v ""
    for {set i 0} {$i < 12} {incr i} {
        set v [region $mx $my [expr {$mx + $mw}] [expr {$my + $mh}]]
        if {[regexp {^(\d+) (\d+) (\d+) (\d+) (\d+)$} $v -> off tot dr dg db] \
                && (($dr == 242 && $dg == 235 && $db == 224) || ($dr == 206 && $dg == 196 && $db == 182))} {
            return "$off $tot"
        }
        after 500
    }
    lc_fail "$what: the menu rect $mx,$my ${mw}x$mh never read a transcript ground (parchment or a raw island's header) again after the dismiss: $v"
}
proc menu_expect_dismissed {reason what} {
    global timeout lc_cmd_timeout
    set timeout $lc_cmd_timeout
    expect {
        -re "tapestryd: menu (\\d+) dismissed \\($reason\\)\[\r\n\]" {}
        timeout { lc_fail "$what: no compositor `dismissed ($reason)` line" }
        eof     { lc_fail "$what: EOF waiting for the dismiss" }
    }
}
# The tablet's absolute axis is 0..32767 over the display (px = v*(dim-1)/
# 32767, ls-gfx-panes' measured rule), so v = px*32767/(dim-1) at 1280x800.
proc ptr_abs {px py} {
    global repo qmp
    set vx [expr {int($px * 32767 / 1279)}]
    set vy [expr {int($py * 32767 / 799)}]
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -p "abs $vx $vy"} err]} {
        lc_fail "qmp abs failed: $err"
    }
    after 300
}
proc ptr_click {} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -p "btn left down"} err]} {
        lc_fail "qmp btn down failed: $err"
    }
    after 150
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -p "btn left up"} err]} {
        lc_fail "qmp btn up failed: $err"
    }
    after 1500
}

lc_run_expect "ls /lib/aurora; pwd" "/home/michael"
lassign [menu_open_kbd "keyboard menu"] mid mx my mw mh mref
if {![string match "/lib/aurora/*" $mref]} {
    lc_fail "the menu names ref '$mref', not a resolved /lib/aurora/ path (the anti-clickjack line)"
}
menu_want_raised $mx $my $mw $mh "keyboard menu"
lc_pass "halcyon: Enter on a path run opened its verb menu (raised ground at $mx,$my ${mw}x$mh; ref $mref)"
hkey "esc"
menu_expect_dismissed "esc" "keyboard menu"
menu_want_gone $mx $my $mw $mh "keyboard menu"
lc_pass "halcyon: Esc dismissed the menu compositor-side and the transcript healed under it"
hkey "i"

# H-3b-3 control: the tag-bar strip does not exist on a single fullscreen
# leaf (the strip APPEARS with the split; the name ink appears with
# halcyond's paint). Witnessed by what only a STRIP has -- a live tint on
# its interior, a separator key on its bottom row (4.2) -- and by the
# compositor's own carve record (`pane/<id>/tagbar` = `0 0 0 0`); never by
# the interior reading `header`: the transcript's raw island (the mirrored
# boot log on this lever) is the same `header` tone a resting strip would
# be, and the view is bottom-anchored, so whether the island sits under the
# strip region is content history (the chrome-content round read header
# there on a single leaf, three boots straight, with no strip in sight).
# The dominant colour of a rect, or "" when unparseable.
proc dom_of {x0 y0 x1 y1} {
    set v [region $x0 $y0 $x1 $y1]
    if {[regexp {^(\d+) (\d+) (\d+) (\d+) (\d+)$} $v -> off tot r g b]} { return "$r $g $b" }
    return ""
}
# 1 iff neither the strip interior's tint nor its separator's key is there.
proc no_strip_at_left {} {
    set inner [dom_of 8 6 300 22]
    set sep [dom_of 8 23 300 24]
    if {$inner eq "" || $sep eq ""} { return 0 }
    if {$inner eq "184 204 196" || $inner eq "220 184 176"} { return 0 }
    if {$sep eq "200 96 48" || $sep eq "30 88 68" || $sep eq "152 40 24"} { return 0 }
    return 1
}
proc single_leaf_tagbar_zero {what} {
    global timeout lc_cmd_timeout
    lc_send "cat /dev/tapestry/layout"
    set timeout $lc_cmd_timeout
    set leaf_id ""
    expect {
        -re {[\r\n] *(\d+)\*? leaf surface=\d+ \[} { set leaf_id $expect_out(1,string) }
        timeout { lc_fail "$what: no leaf row in the layout file" }
        eof     { lc_fail "$what: EOF reading the layout" }
    }
    lc_send "cat /dev/tapestry/pane/$leaf_id/tagbar"
    expect {
        -re {(\d+) (\d+) (\d+) (\d+)[\r\n]} {
            set rect "$expect_out(1,string) $expect_out(2,string) $expect_out(3,string) $expect_out(4,string)"
            if {$rect ne "0 0 0 0"} { lc_fail "$what: the single leaf's tagbar file reads a carved strip ($rect) -- the >1-leaf gate is broken" }
        }
        timeout { lc_fail "$what: no rect from pane $leaf_id's tagbar file" }
        eof     { lc_fail "$what: EOF reading pane $leaf_id's tagbar" }
    }
    return $leaf_id
}
if {![no_strip_at_left]} { lc_fail "pre-split: the strip region already carries a strip's tint or separator on a single leaf (inner [dom_of 8 6 300 22], sep [dom_of 8 23 300 24]) -- the >1-leaf gate is broken" }
set pre_leaf [single_leaf_tagbar_zero "pre-split"]
lc_pass "halcyon: pre-split control -- no tag-bar strip on a single leaf (pane $pre_leaf tagbar 0 0 0 0; no tint, no separator key)"

hkey "meta_l+h"
lc_send "cat /dev/winsize"
set timeout $lc_cmd_timeout
expect {
    -re {winsize (\d+) (\d+)[\r\n]} {
        set c $expect_out(1,string)
        set lo [expr {int($full_cols * 0.40)}]
        set hi [expr {int($full_cols * 0.55)}]
        if {$c < $lo || $c > $hi} {
            lc_fail "post-split cols $c (want a halved grid in \[$lo,$hi\] of the full $full_cols)"
        }
        lc_pass "halcyon: split reflow re-reported winsize ($c cols)"
    }
    timeout { lc_fail "no winsize line after the split" }
    eof     { lc_fail "EOF after the split" }
}

# The bevel after the REAL split (HALCYON-VISUAL section 2): two leaves on
# screen, so each pane carries the NNW single-light-source 2px four-value
# bevel. Same helper the non-Daylight run uses on its own split, so the two
# checks cannot drift and neither carries a literal colour triple.
bevel_want "after the split"

# H-3b-3/H-3b-4: the per-leaf tag bar, painted by halcyond -- the POSITIVE
# twin of ls-gfx-panes' E_PERM probes (the same `role=chrome` create and
# the same `tag status` verb from the renderer). At gaps=1 the strip is y
# 4..24 (floor 1 + bevel 2 + hairline 1 above it); the left pane's hairline
# column is x=3. HALCYON-VISUAL 4.2 states: the split focused the NEW
# (right, empty) leaf, so IT is the live tile -- nothing has run in it, so
# its strip is the sage tint with the sage separator; the left (halcyond)
# tile is a resting pane's sole tile ("resting, active tile"): header bg
# WITH INK (the name "halcyon" in fg) and the ember_deep separator; its
# hairline stays header (no status shows where input is not). Retried: the
# chrome lands a relayout after the split's CONFIGURE.
set ink [strip_want 8 6 300 22 206 196 182 "left strip interior" 1]
lc_pass "halcyon: left tag bar is Daylight header with name ink ($ink off/total)"
strip_want 8 23 300 24 200 96 48 "left strip separator (resting, active tile -> ember_deep)" 0
strip_want 700 6 1200 22 184 204 196 "right strip interior (live, nothing has run -> sage tint)" 0
strip_want 700 23 1200 24 30 88 68 "right strip separator (live -> sage key)" 0
strip_want 3 120 4 560 206 196 182 "left hairline (not live -> header)" 0
lc_pass "halcyon: tag-bar keys follow focus (left resting ember_deep, right live sage; left hairline header)"

# A chord split moves focus to the NEW (empty) leaf (pane.rs split:
# `self.focused = new_leaf` -- caught when zoom targeted the empty pane
# and halcyond, hidden, never got the restore CONFIGURE). Focus back to
# halcyond first; THEN zoom it to full width.
hkey "meta_l+left"
# Focus back on halcyond: the keys swap. A focus-only epoch reaches the
# chrome as a same-size CONFIGURE; halcyond re-reads the layout's `*` and
# the pane's `status` (its last command, `cat /dev/winsize`, exited 0 ->
# `ok` -> sage). The compositor re-keys the LIVE tile's hairline from the
# same record (5.3): the left column reads the sage key alongside the
# content, and the top row alongside the bar reads the bar's TINT -- the
# 2.4 vanish, kept under a live bar.
strip_want 8 6 300 22 184 204 196 "left strip interior after focus-back (live ok -> sage tint)" 1
strip_want 8 23 300 24 30 88 68 "left strip separator after focus-back (sage key)" 0
strip_want 700 6 1200 22 206 196 182 "right strip interior after focus-back (resting -> header)" 0
strip_want 700 23 1200 24 200 96 48 "right strip separator after focus-back (ember_deep)" 0
strip_want 3 120 4 560 30 88 68 "left hairline after focus-back (live ok -> sage key)" 0
strip_want 120 3 560 4 184 204 196 "left top hairline alongside the live bar (sage tint)" 0
lc_pass "halcyon: focus move re-keyed the tiles (left live sage: strip + content hairline; right resting ember_deep)"

# H-3c-2 (THE EVENT SET): a focus move between two panes NEITHER of which
# is the console re-keys their tag bars. Before the event set a tile's
# events landed only at the next pane-tree RPC, and this move sends the
# console nothing (no FOCUS, no CONFIGURE -- the focus-only fan is chrome-
# only), so the bars stayed stale until some later relayout; the 2-pane
# legs above never exercised it (every move touched the console). Split the
# right leaf again (Super+Right onto it, Super+H): three leaves -- the
# console, A (the middle, resting) and B (the new right, live). Then
# Super+Left (B -> A) and Super+Right (A -> B): the strips' interiors +
# separators must swap live/resting each time. The strip rects come off the
# pane tree through the console (ids depend on the layout history; the
# observer effect scrolls the transcript, harmless at the strips).
hkey "meta_l+right"
hkey "meta_l+h"
lc_send "cat /dev/tapestry/layout"
set timeout $lc_cmd_timeout
set ev_leaves {}
set ev_console -1
set ev_focused -1
expect {
    -re {[\r\n] *(\d+)(\*?) leaf([^\r\n]*)[\r\n]} {
        set lid $expect_out(1,string)
        lappend ev_leaves $lid
        if {$expect_out(2,string) eq "*"} { set ev_focused $lid }
        if {[string match "*surface=*" $expect_out(3,string)]} { set ev_console $lid }
        if {[llength $ev_leaves] < 3} { exp_continue }
    }
    timeout { lc_fail "the layout did not list three leaves after the second split (got: $ev_leaves)" }
    eof     { lc_fail "EOF reading the layout" }
}
if {$ev_console < 0 || $ev_focused < 0 || $ev_focused == $ev_console} {
    lc_fail "event set: leaves $ev_leaves, console $ev_console, focused $ev_focused -- the second split did not focus a new non-console leaf"
}
set ev_b $ev_focused
set ev_a -1
foreach lid $ev_leaves { if {$lid != $ev_console && $lid != $ev_b} { set ev_a $lid } }
if {$ev_a < 0} { lc_fail "event set: no third leaf among $ev_leaves" }
# The "x y w h" text follows the output zone's frame on the SAME line (no
# newline before its first digit), so the match anchors on the trailing
# newline only.
proc bar_rect {id what} {
    global timeout lc_cmd_timeout
    lc_send "cat /dev/tapestry/pane/$id/tagbar"
    set timeout $lc_cmd_timeout
    expect {
        -re {(\d+) (\d+) (\d+) (\d+)[\r\n]} {
            return [list $expect_out(1,string) $expect_out(2,string) $expect_out(3,string) $expect_out(4,string)]
        }
        timeout { lc_fail "$what: no tagbar rect for pane $id" }
        eof     { lc_fail "$what: EOF reading pane $id's tagbar" }
    }
}
lassign [bar_rect $ev_a "pane A"] ax ay aw ah
lassign [bar_rect $ev_b "pane B"] bx by bw bh
if {$aw < 40 || $bw < 40 || $ah < 8 || $bh < 8} { lc_fail "event set: degenerate bars A ${aw}x$ah B ${bw}x$bh" }
proc bar_want {x y w h live what} {
    if {$live} {
        strip_want [expr {$x + 6}] [expr {$y + 2}] [expr {$x + $w - 6}] [expr {$y + $h - 2}] 184 204 196 "$what interior (live -> sage tint)" 0
        strip_want [expr {$x + 6}] [expr {$y + $h - 1}] [expr {$x + $w - 6}] [expr {$y + $h}] 30 88 68 "$what separator (live -> sage key)" 0
    } else {
        strip_want [expr {$x + 6}] [expr {$y + 2}] [expr {$x + $w - 6}] [expr {$y + $h - 2}] 206 196 182 "$what interior (resting -> header)" 0
        strip_want [expr {$x + 6}] [expr {$y + $h - 1}] [expr {$x + $w - 6}] [expr {$y + $h}] 200 96 48 "$what separator (resting -> ember_deep)" 0
    }
}
bar_want $ax $ay $aw $ah 0 "A after the split (B focused)"
bar_want $bx $by $bw $bh 1 "B after the split (B focused)"
hkey "meta_l+left"
bar_want $ax $ay $aw $ah 1 "A after B->A"
bar_want $bx $by $bw $bh 0 "B after B->A"
lc_pass "halcyon: THE EVENT SET -- a focus move between two non-console panes re-keyed both tag bars (A live sage, B resting ember_deep) with no event to the console"
hkey "meta_l+right"
bar_want $ax $ay $aw $ah 0 "A after A->B"
bar_want $bx $by $bw $bh 1 "B after A->B"
lc_pass "halcyon: THE EVENT SET -- and back (A resting, B live)"
# Restore the two-pane layout the legs below were written against: close B
# (Super+Shift+Q, the chord table's close; focus lands on a neighbour), then
# lefts back to the console (a left at the edge is a no-op).
hkey "meta_l+shift+q"
hkey "meta_l+left"
hkey "meta_l+left"
strip_want 8 23 300 24 30 88 68 "console separator after returning focus (sage key)" 0

# H-3c: CLICK-A-PATH + CLICK-AWAY (the mouse door to the same menu), in the
# split: the console is the LEFT pane now, so its run rects carry the pane's
# content origin. The keyboard path first, to learn the run's display rect
# from its say line; then a REAL QMP tablet click on that rect opens the
# menu at the pointer (the same ref -- the same run), and a click OUTSIDE
# the menu dismisses it compositor-side WITHOUT reaching the console: the
# press is swallowed, so a run under a click-away can never open a second
# menu (the negative arm below is that proof).
lc_run_expect "ls /lib/aurora; pwd" "/home/michael"
lassign [menu_open_kbd "split keyboard menu"] mid mx my mw mh mref
menu_want_raised $mx $my $mw $mh "split keyboard menu"
hkey "esc"
menu_expect_dismissed "esc" "split keyboard menu"
menu_want_gone $mx $my $mw $mh "split keyboard menu"
lc_pass "halcyon: in the split, the keyboard menu opened under the left pane's run (clamped to $mx,$my ${mw}x$mh) and Esc dismissed it"
# THE OBSERVER EFFECT: every diagnostic line the compositor or halcyond
# prints is mirrored into the console transcript and scrolls it, so a run
# rect reported earlier no longer holds. The click aims at a FRESH report:
# Esc, k onto the ls row, `w` selects its run and (test builds) says the
# run's CURRENT display rect + the mono row height -- that one line then
# scrolls the transcript by exactly one such row, which the click subtracts.
hkey "i"
lc_run_expect "ls /lib/aurora; pwd" "/home/michael"
hkey "esc"
hkey "k"
hkey "w"
set timeout $lc_cmd_timeout
expect {
    -re {halcyond: run at (\d+) (\d+) (\d+) (\d+) rowh (\d+)[\r\n]} {
        set rx $expect_out(1,string); set ry $expect_out(2,string)
        set rw $expect_out(3,string); set rh $expect_out(4,string); set rowh $expect_out(5,string)
    }
    timeout { lc_fail "no run report after w (test-mode halcyond?)" }
    eof     { lc_fail "EOF waiting for the run report" }
}
after 800 ;# the report line lands in the transcript and re-renders before the click
ptr_abs [expr {$rx + $rw / 2}] [expr {$ry + $rh / 2 - $rowh}]
ptr_click
lassign [menu_placed "click menu"] cid cx cy cw ch cref
if {$cref ne $mref} {
    lc_fail "the click opened a menu for '$cref', the keyboard for '$mref' -- not the same run"
}
menu_want_raised $cx $cy $cw $ch "click menu"
lc_pass "halcyon: a click on the run opened the same menu at the pointer (clamped to $cx,$cy; ref $cref)"
ptr_abs [expr {$cx + $cw / 2}] [expr {max($cy - 40, 30)}]
ptr_click
menu_expect_dismissed "click-away" "click menu"
# The H-3c round F1: BOTH edges of the click-away are the compositor's -- the
# press and its release (a release with no press would reach the pane under
# the pointer, where a release-activated widget acts; the first cut set the
# swallow record and then let the retire arm clear it). Each line is printed
# from inside its swallow branch: a compositor that delivered either edge
# prints neither. halcyond ignores releases, so no other witness can see it.
set timeout $lc_cmd_timeout
expect {
    -re {tapestryd: menu click-away press swallowed \(btn (\d+)\)[\r\n]} {}
    timeout { lc_fail "the click-away press was not swallowed (no compositor line)" }
    eof     { lc_fail "EOF waiting for the press swallow" }
}
expect {
    -re {tapestryd: menu click-away release swallowed \(btn (\d+)\)[\r\n]} {}
    timeout { lc_fail "the click-away RELEASE was not swallowed (the H-3c round F1: it reached the pane under the pointer)" }
    eof     { lc_fail "EOF waiting for the release swallow" }
}
menu_want_gone $cx $cy $cw $ch "click menu"
set timeout 3
expect {
    -re {halcyond: menu (\d+) placed[^\r\n]*} {
        lc_fail "the click-away press reached the console (a second menu opened)"
    }
    timeout {}
}
lc_pass "halcyon: a click outside the menu dismissed it compositor-side; neither its press nor its release reached the console"

# THE GATE PROOF (HALCYON.md 13.6; ROADMAP 11.1's H-3 row: "menu-dismiss-
# by-compositor proven against a wedged client"). The lever bake put a test
# rule FIRST in /lib/beacon/verbs (`wedge-test` = the internal action
# `#wedge 6000`, admitted only by a test-mode halcyond): choosing it FREEZES
# halcyond for 6 s with the menu still placed -- a wedged owner holding a
# modal. While it is frozen: Esc must dismiss the menu (the compositor's
# line; nothing else can produce it), and keys typed over the REAL keyboard
# must route to the CONSOLE surface, not to the (gone) menu: they queue
# there, and when halcyond wakes it runs them -- `i` (Insert) then `pwd`,
# whose output-only path is the witness. Had the grab stood, the keys would
# have sat on the menu surface and pwd would never run; had the compositor
# wedge-retired the CONSOLE instead, no output could follow at all (and a
# WEDGED line would be in the transcript -- checked at the end).
hkey "i"
lc_run_expect "ls /lib/aurora; pwd" "/home/michael"
lassign [menu_open_kbd "wedged owner's menu"] wid wx wy ww wh wref
menu_want_raised $wx $wy $ww $wh "wedged owner's menu"
hkey "ret"
set timeout $lc_cmd_timeout
expect {
    -ex "halcyond: wedge-test: frozen" { lc_step "halcyond frozen with the menu up" }
    timeout { lc_fail "the wedge-test rule did not fire (lever verbs not baked, or test-mode off?)" }
    eof     { lc_fail "EOF waiting for the wedge" }
}
hkey "esc"
menu_expect_dismissed "esc" "wedged owner's menu"
lc_pass "halcyon: THE GATE -- the compositor dismissed the menu while its owner was frozen"
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp "ipwd\n"} err]} {
    lc_fail "qmp-sendtext ipwd failed: $err"
}
set timeout 20
expect {
    -ex "halcyond: wedge-test: woke" { lc_step "halcyond woke" }
    timeout { lc_fail "halcyond never woke from the wedge test" }
    eof     { lc_fail "EOF waiting for the wake" }
}
set timeout $lc_cmd_timeout
expect {
    -ex "halcyond: menu closed by the compositor" {}
    timeout { lc_fail "the woken owner never found its menu closed" }
}
expect {
    -ex "/home/michael" {
        lc_pass "halcyon: THE GATE -- keys typed during the freeze reached the console (routing restored by the compositor alone)"
    }
    timeout { lc_fail "pwd typed during the freeze never ran: the keys did not reach the console" }
    eof     { lc_fail "EOF waiting for the queued pwd" }
}
menu_want_gone $wx $wy $ww $wh "wedged owner's menu"
lc_pass "halcyon: the transcript healed under the menu once its owner woke"

# H-3c round (SA-8 + F5): THE COMMAND PATH -- a chosen verb runs on exactly
# the displayed ref, as its OWN command line. A draft half-typed at the
# prompt (`echo half`, no Enter) must not be run INTO: halcyond feeds ^E ^U
# before the command (ut's editor: the draft moves to the kill buffer), so
# the transcript never shows `halfls` -- the token the concatenation would
# print twice (the echoed line, then echo's own output). The verb chosen is
# `ls` (the lever table: wedge-test first, then ls = `ls -l -- {}`) on an
# `ls /lib/aurora` row's run (pwd's own output is plain text, no obj): the
# `menu ran:` line carries the exact command (the `--` guard + the rc
# quoting of the ref the placement line named); the global operand-error
# control at the end proves ls took `--` (a rejected `--` errors on it).
# The mode is Insert here (the `i` typed during the freeze).
lc_run_expect "ls /lib/aurora; pwd" "/home/michael"
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp "echo half"} err]} {
    lc_fail "qmp-sendtext draft failed: $err"
}
after 500
lassign [menu_open_kbd "command-path menu"] vid vx vy vw vh vref
if {![string match "/lib/aurora/*" $vref]} { lc_fail "the command-path menu opened on '$vref', want a /lib/aurora/ path" }
menu_want_raised $vx $vy $vw $vh "command-path menu"
hkey "j"
hkey "ret"
# The owner's dismiss (`menu dismiss` from halcyond's close) precedes the
# `menu ran:` line in the stream -- expect them in that order.
menu_expect_dismissed "owner" "command-path menu"
set timeout $lc_cmd_timeout
expect {
    -ex "halcyond: menu ran: ls -l -- '$vref'" { lc_step "the verb ran on the quoted ref behind --" }
    -re {halcyond: menu ran: [^\r\n]*} { lc_fail "the verb ran the wrong command: $expect_out(0,string)" }
    timeout { lc_fail "no `menu ran:` line after choosing ls" }
    eof     { lc_fail "EOF waiting for the verb to run" }
}
menu_want_gone $vx $vy $vw $vh "command-path menu"
lc_run_expect "pwd" "/home/michael"
lc_pass "halcyon: a chosen verb ran `ls -l -- '$vref'` as its own command line (the draft killed first, the ref rc-quoted behind --)"

# H-3b-4: the status feed end to end. A line whose LAST status is non-zero
# (`pwd; false` -> \$? = 1; the exit mark carries the shell's status, the
# sequencing token is pwd's output-only path) turns the live tile
# cinnabar: strip tint + separator + the content hairline. Then a clean
# command turns it back to sage -- the state is the LAST exit, never
# sticky. `false` prints nothing, so the operand-error control below is
# untouched.
lc_run_expect "pwd; false" "/home/michael"
strip_want 8 6 300 22 220 184 176 "left strip after a failing command (cinnabar tint)" 1
strip_want 8 23 300 24 152 40 24 "left strip separator after a failing command (cinnabar key)" 0
strip_want 3 120 4 560 152 40 24 "left hairline after a failing command (cinnabar key)" 0
strip_want 120 3 560 4 220 184 176 "left top hairline alongside the cinnabar bar (tint)" 0
lc_pass "halcyon: a non-zero exit keyed the live tile cinnabar (strip + separator + content hairline)"
lc_run_expect "pwd" "/home/michael"
strip_want 8 6 300 22 184 204 196 "left strip after recovery (sage tint)" 1
strip_want 8 23 300 24 30 88 68 "left strip separator after recovery (sage key)" 0
strip_want 3 120 4 560 30 88 68 "left hairline after recovery (sage key)" 0
lc_pass "halcyon: a zero exit re-keyed the live tile sage (the status is the last exit)"
hkey "meta_l+f"
lc_run_expect "cat /dev/winsize" "winsize 213 "
lc_pass "halcyon: zoom restored the full grid (reflow round-trip)"
# Zoomed = one visible leaf: the strips are ZERO and halcyond drops its
# chrome tiles. The live tint it read a moment ago and the sage separator
# under it are gone from the strip region (a strip's own features -- the
# pre-split control's reasoning: the interior's ground is not a witness,
# the raw island paints `header` there too), and the compositor's carve
# record for the one leaf reads `0 0 0 0`. Retried: the zoom lands a
# relayout, then halcyond's drop.
set gone 0
for {set i 0} {$i < 12} {incr i} {
    if {[no_strip_at_left]} { set gone 1; break }
    after 500
}
if {!$gone} { lc_fail "zoomed: the left strip region still carries the strip's tint or separator (inner [dom_of 8 6 300 22], sep [dom_of 8 23 300 24]) -- chrome not dropped / strip not ZERO" }
set zoom_leaf [single_leaf_tagbar_zero "zoomed"]
lc_pass "halcyon: zoom dropped the tag bars (single leaf $zoom_leaf, strip ZERO: no tint, no separator key)"

# H-3c: the surface census after the zoom. The tag-bar surfaces the zoom
# dropped live on the renderer's SHARED session, whose Drop must say
# `destroy` -- a bare fd close leaked them (the H-3b close's shared-chrome
# regression, found at the H-3c survey), and the renderer's 36-surface cap
# then filled after ~17 zoom cycles. `surfaces 1` = the console alone: the
# two bars and every menu this scenario opened are gone server-side.
set census -1
for {set i 0} {$i < 6} {incr i} {
    lc_send "cat /dev/tapestry/ctl"
    set timeout $lc_cmd_timeout
    expect {
        -re {surfaces (\d+)[\r\n]} { set census $expect_out(1,string) }
        timeout { lc_fail "no `surfaces N` line from /dev/tapestry/ctl" }
        eof     { lc_fail "EOF reading the ctl census" }
    }
    if {$census == 2} break
    after 1000
}
# H-3d: the status bar is the second surface (the console + the bar); a
# leaked tag bar or menu would make it 3.
if {$census != 2} {
    lc_fail "surfaces $census after the zoom: dropped shared-session surfaces leaked server-side (want 2 = the console + the status bar)"
}
lc_pass "halcyon: the zoom's dropped tag bars + every menu retired server-side (surfaces 2: the console + the status bar)"

# HALCYON-SCALE 6 (the scale round): the CONSOLE follows the compositor's
# scale at runtime -- the console path's only E2E (it is inert at 1.0 by
# construction, which every other leg of this gate proves; the compose gate
# proves the SESSION follower at 200%). Zoomed + the status bar = the
# Composed arm: the chord retires the old-height bar, the leaf is re-offered
# the full display, and halcyond re-reads the ctl on that relayout. The say
# names the percent AND the mono cell it selected: 125% must land on a
# BIGGER cell than 1.0's 6x14 (the 8-advance bake; one mono size since
# 2026-09-08 -- the grid runs at the preformatted block's cell), so the bakes
# were swapped and not just the number. Super+0 re-derives from the EDID (100
# on QEMU): the 1.0 cell and the 213-column winsize return.
hkey "meta_l+equal"
set timeout $lc_cmd_timeout
expect {
    -re {halcyond: scale 100 -> 125 \(cell (\d+)x(\d+)\)} {
        set scw $expect_out(1,string); set sch $expect_out(2,string)
        if {$scw <= 6 || $sch <= 14} { lc_fail "scale 125: the mono cell ${scw}x$sch did not grow past 1.0's 6x14 (the bakes were not swapped)" }
    }
    timeout { lc_fail "the console never followed Super+= (no `halcyond: scale 100 -> 125` say: the relayout the bar retire fans did not reach it)" }
    eof { lc_fail "EOF waiting for the console's scale say" }
}
lc_pass "halcyon: the console followed Super+= to 125% (cell ${scw}x$sch)"
hkey "meta_l+0"
expect {
    -re {halcyond: scale 125 -> 100 \(cell 6x14\)} {}
    timeout { lc_fail "the console never followed Super+0 back to 100 (cell 6x14)" }
    eof { lc_fail "EOF waiting for the console's scale-reset say" }
}
lc_run_expect "cat /dev/winsize" "winsize 213 "
lc_pass "halcyon: Super+0 returned the console to 1.0 (cell 6x14; 213 columns again)"

lc_quit

# Transcript greps (output-only tokens; buffer-order-immune). `proc tgrep` is
# defined much earlier -- above the non-Daylight early exit -- so the Nightjar
# run can use it too (TH-6 F6); only these Daylight-only calls live here.
log_file
tgrep "halcyond: beacon rich advertised" "halcyond advertised the rich tier (the surface bring-up)"
tgrep "halcyond: console up" "halcyond brought up the transcript surface"
tgrep "ut: beacon rich exported" "the rich canary (the F7 transport half, real advertisement)"
tgrep "transcript zones armed" "ut armed the transcript zones"
tgrep "1936;v1;pre" "ls -l emitted the rich pre (code-fence box) frame on the wire"
tgrep "7;file://localhost/lib/aurora" "ut reported the working directory as OSC 7 (H-3d)"
tgrep "1936;v1;mark;k=cmd;text=grep -q h3d-not-there /lib/beacon/verbs" "ut marked the accepted command as the output zone's first child (H-3d)"
tgrep "context \"halcyon.*/lib/aurora.*pwd\" condition Ok" "the status bar showed the console's directory and last command (H-3d)"
tgrep "1936;v1;obj" "ls emitted obj presentation frames on the wire"
tgrep "1936;v1;zone" "ut emitted zone frames on the wire (the F7 zone half)"
# The Thylacine wording, NOT the generic "no such file": the boot-time
# ambush probe prints delve's Unix-worded history-file complaint, which
# is noise this control must not trip on.
if {![catch {exec grep -q -- "no such file or namespace entry" $transcript}]} {
    lc_fail "a session command errored on its operand (a hollow `; pwd` pass -- fix the operand)"
}
lc_pass "halcyon: no session command errored on its operand"
if {![catch {exec grep -q -- "re-exported" $transcript}]} {
    lc_fail "an unexpected tier re-export fired (F10 must be silent without a renderer change)"
}
lc_pass "halcyon: F10 stayed silent (no renderer change, no re-export)"
# H-3c: no surface was wedge-retired -- the menu is force-RETIRED on a
# dismiss (never WEDGED), and the frozen console must never be either.
if {![catch {exec grep -q -- "WEDGED" $transcript}]} {
    lc_fail "a surface was WEDGED during the run (the frozen console, or a menu, was wedge-retired)"
}
lc_pass "halcyon: no surface was wedge-retired (the frozen owner's console survived the gate)"
# The command path's draft control: the draft WAS typed (its echo is in the
# transcript) and was never run into (`halfls` would appear twice if the
# ^E ^U had not killed it).
# ut's editor redraws the line per key with per-token SGR sequences, so the
# echoed draft is "echo" + SGR + "half": grep the token, not the phrase.
tgrep "half" "the half-typed draft was echoed before the verb ran (the positive arm of the draft control)"
if {![catch {exec grep -q -- "halfls" $transcript}]} {
    lc_fail "the chosen verb was appended to the half-typed draft (halfls): the ^E ^U kill did not land"
}
lc_pass "halcyon: the chosen verb never ran into the half-typed draft (no halfls)"
tgrep "verb rules loaded" "halcyond loaded the verb table (/lib/beacon/verbs)"

lc_pass "ls-halcyon: the H-2 transcript MVP + the H-3b tag bar + the H-3c menus verified (halcyond render + rich chain + parchment pixels + split/zoom reflow + live-tile keys + keyboard/click menus + the compositor-owned dismiss against a wedged owner + both click-away edges swallowed + the command path behind --)"
exit 0
