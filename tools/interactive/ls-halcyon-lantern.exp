#!/usr/bin/expect -f
# The deck presenter in a real Halcyon tile -- the RICH tier, which no other
# lantern test can reach (docs/LANTERN-DESIGN.md).
#
# tools/interactive/lantern.exp drives the same program over the serial console,
# where the tier is `cells` and every realization is plain text. That gate proves
# the program runs, pages and refuses; it is structurally blind to whether
# anything RICH happens, because nothing on that path renders a Beacon frame.
# This one runs it where the pts advertises `rich` and a compositor is drawing.
#
# What it asserts, and why these and not "it looked right":
#   1. A slide PAINTS -- the tile is not blank after `lantern /deck`.
#   2. SPACE CHANGES THE SCREEN. This is the whole clear-and-rerender claim in
#      one check: the presenter writes ESC[2J and the next slide, and in a tile
#      that is a grid operation the compositor re-lays. If the screens were
#      identical the key did nothing, or the clear wiped without repainting.
#   3. The deck is still SHOWING after the change, not blanked -- a clear that
#      erased and failed to repaint would satisfy (2) on its own, so (3) is (2)'s
#      control rather than a restatement of (1).
#   5. In a tile WITH history the clear still starts the slide at the top of a
#      clean view (TC-1, HALCYON 14.13). (1)-(3) run on a fresh tile, which has
#      no history, and that is exactly why none of them could see the defect.
#   6. A clear MOVES the screen into the history rather than losing it (TC-1a).
#      (5) cannot see this: the moved text sits above the view's top edge. The
#      tile counts its history rows when Normal mode opens, and a `clear` over
#      a full screen must add more than half a screen of them, where `true`
#      (the control, one variable away) adds a line or two.
#   7. Super+K DELETES the history and nothing else (TC-1b): afterwards the
#      tile holds no history row at all, the view three screens up is ground
#      where it showed history, the live screen looks as it did, its grid is
#      the size it was, and new output starts a history again.
#   8. A slide change is ONE synchronized frame (FL-1, LANTERN-DESIGN 13): the
#      tile says, once, that a frame held its paint until its program closed
#      it. That line is the premise measured, not assumed -- the slide's
#      records spanned reads of the pipe, so without the hold the blank and a
#      partial slide showed. The same deck without the marks never prints it,
#      and neither does a render step that counts the hold but paints anyway:
#      its paint lands while the frame is open, which the tile reports as cut
#      short (a RED bake of each, FL-1). A frame the 150 ms bound let through
#      before one was shown whole is reported in the pass line. If every frame
#      hit the bound the leg fails: a slide crosses the pipe in milliseconds,
#      so a frame that needs 150 ms is a finding to hunt, not a slow host.
#   9. Slide two's block quote is an ASIDE, which a tile draws as a hairline on
#      four sides around the passage, with no ground of its own (HALCYON-VISUAL
#      8.4). The capture must hold exactly one closed hairline frame that slide
#      one's does not, unfilled, with ink inside and clear of all four sides.
#      Slide one is the control one keystroke away: a frame both slides show is
#      the tile's, not the deck's. On the image before the aside, slide two
#      shows none.
#  10. The picture slide SHOWS THE PICTURE (LANTERN-DESIGN 14). lantern has
#      `view --embed` place it over the pane's own channel -- halcyond says on
#      the serial line that a 640x400 raster reached a tile -- and writes the
#      reference inside the slide's frame, so the capture holds the picture's
#      amber. Slide three, a text slide, is the control one keystroke before
#      it. Without the reference the raster sits in the tile's cache undrawn;
#      without the upload the slide is the stand-in, which has no amber.
#
# The captures are kept at build/lantern-rich-*.png whatever the verdict: the
# reason to run this is as much to LOOK at the result as to gate it, and a gate
# that deletes its evidence on the way out is the #223 mistake.
#
# Needs HALCYON_SESSION=y. Bake with the Instrument profile, the operator's: its
# top padding is what the pinned view in (5) has to keep history out of.
#   THYLACINE_HALCYON_SESSION=1 THYLACINE_HALCYON_PROFILE=instrument tools/build.sh kernel --config ci
# A gate-image run SKIPs (exit 77) rather than failing: a lever the image lacks
# is not a defect.

set ::env(THYLACINE_ACCEL) [expr {[info exists ::env(LS_CI_GFX_ACCEL)] ? $::env(LS_CI_GFX_ACCEL) : "hvf"}]
source [file join [file dirname [info script]] lib.exp]
set repo $lc_repo
set qmp [lc_qmp_sock]

# qmp-sendtext types printable US-ASCII and '\n' (which it maps to the Enter
# key) -- and REFUSES anything else rather than dropping it, which is how the
# first run of this scenario failed loudly on a '\r' instead of silently
# typing nothing.
proc type {text} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp $text} e]} { lc_fail $e }
    after 400
}
proc key {chord} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k $chord} e]} { lc_fail $e }
    after 700
}
proc capture {name} {
    global repo qmp
    after 1200
    set out $repo/build/lantern-rich-$name.png
    if {[catch {exec $repo/tools/screendump.sh -s $qmp $out} e]} { lc_fail $e }
    lc_step "captured $out"
    return $out
}
# Ink coverage: how many pixels are NOT the commonest colour. A blank tile is
# almost entirely one colour, so this separates "a document was drawn" from "the
# compositor painted a ground and stopped", pinning no theme's palette.
proc ink {png} {
    global repo
    return [exec python3 $repo/tools/interactive/gfx_ink.py $png]
}
# The same count inside the band BELOW where slide one sits on a fresh tile. The
# right tenth is left out: a tile with history reserves the position indicator's
# lane, and at the bottom of the scroll its thumb sits in exactly this band.
proc band {png} {
    global repo
    return [exec python3 $repo/tools/interactive/gfx_ink.py $png --rect 0 0.45 0.9 0.94]
}
# The same count across a tile's top rows: the live screen's first lines.
proc top {png} {
    global repo
    return [exec python3 $repo/tools/interactive/gfx_ink.py $png --rect 0 0.03 0.9 0.35]
}
# Pixels of the picture slide's amber (gfx_amber.py), the predicate lantern's
# host test the_shipped_picture_is_one_view_shows pins against the file itself.
proc amber {png} {
    global repo
    return [exec python3 $repo/tools/interactive/gfx_amber.py $png]
}
# The closed hairline frames in a capture, one list per frame:
# {x0 y0 x1 y1 ink filled left top right bottom colour} (gfx_frame.py).
proc frames {png} {
    global repo
    set found {}
    foreach line [split [exec python3 $repo/tools/interactive/gfx_frame.py $png] "\n"] {
        if {[llength $line] == 11} { lappend found $line }
    }
    return $found
}

lc_boot
set timeout $lc_boot_timeout
expect {
    -ex "Thylacine login: " {}
    -re {EXTINCTION:} { lc_extinction_fail "boot" }
    timeout { lc_fail "no login" }
    eof { lc_fail "EOF before login" }
}
lc_raw_send "michael\r" "login user"
expect {
    -ex "password: " {}
    timeout { lc_fail "no password prompt" }
    eof { lc_fail "EOF before password" }
}
lc_raw_send "correct-horse-battery-staple-v1\r" "login password"
expect {
    -ex "login: session compositor (halcyond) spawned" {}
    -ex "Thylacine textual shell" {
        puts "\nLS-CI SKIP: default (ut) image -- this scenario drives the session\
 compositor. Bake with: THYLACINE_HALCYON_SESSION=1 THYLACINE_HALCYON_PROFILE=instrument\
 tools/build.sh kernel --config ci"
        lc_quit
        exit 77
    }
    timeout { lc_fail "no graphical session" }
    eof { lc_fail "EOF at session start" }
}
set timeout 120
expect {
    -re {halcyond: status bar [^\r\n]*panes [0-9]+} {}
    -re {EXTINCTION:} { lc_extinction_fail "session" }
    timeout { lc_fail "the session's shell did not become ready" }
    eof { lc_fail "EOF before the session was ready" }
}
lc_step "the session is up"

set blank [capture blank]
set ink_blank [ink $blank]
lc_step "ink before the deck: $ink_blank"

# Zoom the focused pane first (Super+F). Not decoration: a deck in a half-width
# tile is not the posture anyone presents in, and the reason to capture at all is
# that someone will LOOK at the result and judge whether it reads from the back
# of a room. Judging that from half a screen would answer a different question.
key "meta_l+f"
type "lantern /deck\n"
set one [capture slide1]
set ink_one [ink $one]
lc_step "ink on slide one: $ink_one"
if {$ink_one < 2000} {
    lc_fail "slide one painted almost nothing (ink $ink_one): the deck did not render"
}
lc_pass "ls-halcyon-lantern(1): a slide paints in a real tile at the rich tier"

# SPACE: the clear-and-rerender claim, in one check.
type " "
set two [capture slide2]
set ink_two [ink $two]
lc_step "ink on slide two: $ink_two"
if {[catch {exec cmp -s $one $two} ] == 0} {
    lc_fail "SPACE changed nothing: slide one and slide two are byte-identical captures"
}
lc_pass "ls-halcyon-lantern(2): SPACE clears and repaints -- the screen changed"

# (2)'s control: a clear that erased without repainting would also "change".
if {$ink_two < 2000} {
    lc_fail "slide two is effectively blank (ink $ink_two): the clear erased and did not repaint"
}
lc_pass "ls-halcyon-lantern(3): slide two is DRAWN, not merely different -- the clear repainted"

# (9) The aside. The path is the whole of it: lantern's rich stream through the
# tile's grid, whose cells carry the aside's tag, into the transcript and the
# layout. A frame both slides show belongs to the tile, so the aside is the one
# frame slide two adds. The padding is only asked to be there; the host tests
# pin its size.
set geo_one {}
foreach f [frames $one] { lappend geo_one [lrange $f 0 3] }
set added {}
foreach f [frames $two] {
    if {[lsearch -exact $geo_one [lrange $f 0 3]] < 0} { lappend added $f }
}
lc_step "hairline frames: slide one [llength $geo_one], slide two adds [llength $added] ($added)"
if {[llength $added] != 1} {
    lc_fail "slide two's block quote should add one hairline frame; it added [llength $added]"
}
lassign [lindex $added 0] x0 y0 x1 y1 aside_ink filled pad_l pad_t pad_r pad_b
if {$filled} {
    lc_fail "the aside's frame has a ground of its own: an aside is a hairline around the page's ground"
}
if {$aside_ink < 1500} {
    lc_fail "the aside's frame holds almost no ink ($aside_ink): the passage was not laid inside it"
}
if {$pad_l < 4 || $pad_t < 4 || $pad_r < 4 || $pad_b < 4} {
    lc_fail "the aside's text touches its frame (padding $pad_l left, $pad_t top, $pad_r right, $pad_b bottom)"
}
lc_pass "ls-halcyon-lantern(9): slide two's block quote is a hairline frame around its passage ($x0,$y0 to $x1,$y1)"

# (8) FL-1. Slides one and two have changed by now, and the tile has said once
# how its first held frame of each kind ended. Nothing read the console since
# the status bar (the captures go over QMP), so every line is still buffered,
# and expect tries its patterns in list order against all of it: `shown` wins
# whenever it is there, and an `abandoned` line before it is reported. With no
# `shown`, an `abandoned` or a `cut` line fails, each with its own reason.
set timeout 20
set late ""
expect {
    -re {halcyond: session tile leaf=[0-9]+ synchronized frame shown \(([0-9]+) paint\(s\) held\)} {
        set held $expect_out(1,string)
        if {[regexp {synchronized frame abandoned at its bound \(([0-9]+) paint} $expect_out(buffer) -> n]} {
            set late "; a frame before it hit the 150 ms bound ($n paint(s) held)"
            lc_step "a frame hit the 150 ms bound before one was shown whole ($n paint(s) held)"
        }
    }
    -re {halcyond: session tile leaf=[0-9]+ synchronized frame abandoned at its bound \(([0-9]+) paint\(s\) held\)} {
        set n $expect_out(1,string)
        if {$n >= 1000} {
            lc_fail "the session loop spun while a frame held its paint ($n passes), so the frame's close was never read"
        }
        lc_fail "every frame hit the 150 ms bound ($n paint(s) held): the marks reached the tile and a paint waited, but no frame closed in time"
    }
    -re {halcyond: session tile leaf=[0-9]+ synchronized frame cut short \(([0-9]+) paint\(s\) held\)} {
        lc_fail "a frame was painted before its program closed it, and none was shown whole: the render step counted the hold and painted anyway, or a reconfigure or an exit cut the frame"
    }
    -re {EXTINCTION:} { lc_extinction_fail "synchronized frame" }
    timeout {
        lc_fail "no frame held a paint: lantern's marks did not reach the tile, or every slide fit one read of the pipe (the premise)"
    }
    eof { lc_fail "EOF waiting for the synchronized-frame line" }
}
set timeout 120
# Each held pass is one wake of the session loop: an ingest, an event, the
# hold's deadline. A loop that comes back for a held tile without waiting
# spins, and piles up tens of thousands in the 150 ms (the first GREEN run:
# 91612, and the spin kept the frame's close unread until the bound).
if {$held >= 1000} {
    lc_fail "the session loop spun while the frame held its paint ($held passes)"
}
lc_pass "ls-halcyon-lantern(8): a slide change is one synchronized frame -- the tile held $held paint(s) until it closed$late"

# (10) The picture slide. SPACE shows slide three, the control; SPACE again shows
# the picture. The witness line is the upload reaching the tile; the amber is the
# reference resolving inside the slide. The chrome is the same in both captures,
# so the difference is the slide's own, and the text slide is asked to hold
# little amber of its own, or the difference could not tell the two apart.
type " "
set three [capture slide3]
type " "
set timeout 60
expect {
    -re {halcyond: session inline leaf=[0-9]+ 640x400} {}
    -re {halcyond: session inline leaf=[0-9]+ cache refused} {
        lc_fail "the picture reached the tile but its raster cache refused it"
    }
    -re {EXTINCTION:} { lc_extinction_fail "picture slide" }
    timeout {
        lc_fail "no 'session inline' line after the picture slide: lantern's view --embed placed nothing (the pane's channel, the limit read or the upload)"
    }
    eof { lc_fail "EOF waiting for the picture's placement" }
}
set timeout 120
set four [capture slide4-picture]
set amber_three [amber $three]
set amber_four [amber $four]
lc_step "amber pixels: slide three (text) $amber_three, slide four (the picture) $amber_four"
if {$amber_three > 5000} {
    lc_fail "premise: the text slide already holds $amber_three amber pixels, so amber cannot tell the picture apart"
}
if {$amber_four - $amber_three < 10000} {
    lc_fail "the picture slide adds only [expr {$amber_four - $amber_three}] amber pixels: the raster was placed but the slide did not show it (the reference), or the stand-in was drawn"
}
lc_pass "ls-halcyon-lantern(10): the picture slide shows the picture in the tile ($amber_four amber pixels against the text slide's $amber_three)"

# (5) TC-1, the operator's "lantern doesn't clear". Before the fix the view
# bottom-anchored the live tail, so after a clear the slide sat at the BOTTOM of
# a tile with history, the earlier output filling the space above it. Quit, fill
# the history, start the deck again, and ask the band below slide one. Its
# control is slide one's own fresh-tile capture: the same band must be ground
# there, or this check could not tell the two apart.
type "q"
type "seq 1 150\n"
after 1500
type "lantern /deck\n"
set hist [capture slide1-history]
set ink_hist [ink $hist]
set band_fresh [band $one]
set band_hist [band $hist]
lc_step "ink below slide one: fresh tile $band_fresh, after 150 lines of history $band_hist"
if {$band_fresh > 500} {
    lc_fail "premise: slide one already inks the band below it on a fresh tile ($band_fresh), so the band cannot discriminate"
}
if {$ink_hist < 2000} {
    lc_fail "slide one painted almost nothing after the history (ink $ink_hist)"
}
if {$band_hist > $band_fresh + 500} {
    lc_fail "after 150 lines of history the band below slide one is inked ($band_hist): the clear did not start the slide at the top of a clean view"
}
lc_pass "ls-halcyon-lantern(5): in a tile with history the clear starts the slide at the top of a clean view"
# Slide two again, which is what (4) scales.
type " "

# (4) The display scale, which is the answer to "can this be presented from the
# back of a room" that costs NO code: SCALE_MIN 100 / SCALE_MAX 200 / STEP 25,
# already built, gated and chorded. Four presses reach the ceiling from any
# EDID-derived start, because the verb clamps. The assertion is only that the
# slide STILL RENDERS at the ceiling -- deliberately not that the screen
# changed, because a display already at 200 % is a legitimate no-op and a gate
# that failed on it would be asserting the fixture, not the feature.
for {set i 0} {$i < 4} {incr i} { key "meta_l+equal" }
set big [capture slide2-200]
set ink_big [ink $big]
lc_step "ink at the scale ceiling: $ink_big"
if {$ink_big < 2000} {
    lc_fail "the slide stopped rendering at the scale ceiling (ink $ink_big)"
}
lc_pass "ls-halcyon-lantern(4): the deck survives the display scale ceiling"

type "q"
after 800
# Back to the measured scale: more grid rows make (6)'s threshold wider. The
# tile re-lays at the new size before (6) reads its first count.
key "meta_l+0"
after 1500

# Esc opens Normal mode, which says the flat list's size and the history's
# share of it; `i` returns. With a SHOT name it also pages three screens up
# (`u` is half a page) and captures the view there: a tile's history is
# reachable only through Normal mode (the view follows the cursor; a tile
# takes no wheel). It consumes every line it waits for, so no later call can
# read an earlier call's count.
proc normal_rows {what {shot ""}} {
    key "esc"
    expect {
        -re {halcyond: session tile leaf=[0-9]+ normal mode \(([0-9]+) rows\)} { set all $expect_out(1,string) }
        -re {EXTINCTION:} { lc_extinction_fail "normal mode ($what)" }
        timeout { lc_fail "no Normal mode after Esc ($what)" }
        eof { lc_fail "EOF waiting for Normal mode ($what)" }
    }
    expect {
        -re {halcyond: session tile leaf=[0-9]+ history ([0-9]+) rows} { set hist $expect_out(1,string) }
        timeout { lc_fail "Normal mode said no history count ($what)" }
        eof { lc_fail "EOF waiting for the history count ($what)" }
    }
    set png ""
    if {$shot ne ""} {
        type "uuuuuu"
        set png [capture $shot]
    }
    type "i"
    expect {
        -re {halcyond: session tile leaf=[0-9]+ insert mode} {}
        timeout { lc_fail "no Insert mode after i ($what)" }
        eof { lc_fail "EOF waiting for Insert mode ($what)" }
    }
    lc_step "$what: $hist history rows of $all"
    return [list $hist [expr {$all - $hist}] $png]
}

# (6) TC-1a's move, which (5) cannot see.
type "seq 1 150\n"
after 1500
lassign [normal_rows "after seq 1 150"] h_full grid
type "true\n"
after 1000
lassign [normal_rows "after true"] h_true grid_true
type "clear\n"
after 1500
lassign [normal_rows "after clear"] h_clear grid_clear
if {$grid < 8 || $grid_true != $grid || $grid_clear != $grid} {
    lc_fail "premise: the grid must stay one size of at least 8 rows (it read $grid, $grid_true, $grid_clear)"
}
set grew_true [expr {$h_true - $h_full}]
set grew_clear [expr {$h_clear - $h_true}]
if {$grew_true > 3} {
    lc_fail "control: true grew the history by $grew_true rows, so a clear's growth cannot be told apart"
}
if {$grew_clear <= $grid / 2} {
    lc_fail "the clear added $grew_clear history rows on a $grid-row screen full of text: the screen was not moved into the history"
}
lc_pass "ls-halcyon-lantern(6): a clear moves the screen into the history ($grew_clear rows on a $grid-row grid; true added $grew_true)"

# (7) TC-1b's delete. Beside the count, a second axis: the view three screens
# up. Below the cursor row it shows history before Super+K and ground after.
# And its positive control, one variable away: the live screen, inked by a
# marker line, must look the same after the chord as before it.
type "echo live-screen-marker-that-inks-a-whole-row-of-the-grid\n"
after 1000
lassign [normal_rows "before Super+K" history-before] h_pre grid_pre png_before
if {$grid_pre != $grid || $h_pre < 3 * $grid} {
    lc_fail "premise: three screens up must stay inside the history ($h_pre history rows on a $grid_pre-row grid)"
}
set live_before [capture live-before]
key "meta_l+k"
expect {
    -re {halcyond: session tile leaf=[0-9]+ history forgotten} {}
    -re {halcyond: history chord for pane [0-9]+ -- no tile here} { lc_fail "Super+K named a pane the session does not host" }
    -re {tapestryd: chord history: no rail} { lc_fail "Super+K found no rail to deliver to" }
    -re {tapestryd: chord history: the rail's queue was full} { lc_fail "Super+K overflowed the rail's queue" }
    -re {EXTINCTION:} { lc_extinction_fail "history chord" }
    timeout { lc_fail "Super+K forgot nothing (no witness)" }
    eof { lc_fail "EOF waiting for the history chord" }
}
set live_after [capture live-after]
lassign [normal_rows "after Super+K" history-forgotten] h_gone grid_gone png_after
if {$h_gone != 0} {
    lc_fail "after Super+K the tile still holds $h_gone history rows (it held $h_pre)"
}
if {$grid_gone != $grid} {
    lc_fail "Super+K changed the live grid ($grid rows before, $grid_gone after)"
}
set band_before [band $png_before]
set band_after [band $png_after]
lc_step "ink three screens up, below the cursor row: before Super+K $band_before, after $band_after"
if {$band_before < 800} {
    lc_fail "premise: three screens up into the history the band painted almost nothing ($band_before)"
}
if {$band_after * 4 > $band_before} {
    lc_fail "three screens up after Super+K the band is still inked ($band_after against $band_before): history is showing"
}
set top_before [top $live_before]
set top_after [top $live_after]
lc_step "ink on the live screen's top rows: before Super+K $top_before, after $top_after"
if {$top_before < 1500} {
    lc_fail "premise: the live screen's top rows painted almost nothing ($top_before)"
}
if {$top_after * 10 < $top_before * 8} {
    lc_fail "Super+K took the live screen with the history (ink $top_after against $top_before)"
}
# New output starts a history again. The clear in (6) left the grid mostly
# empty, so a line or two scrolls nothing off: two screens of output must
# scroll at least one screen into the history.
type "seq 1 [expr {2 * $grid}]\n"
after 1500
lassign [normal_rows "after Super+K and two screens of output"] h_again grid_again
if {$h_again < $grid} {
    lc_fail "two screens of output after Super+K made $h_again history rows on a $grid-row grid: the tile stopped recording"
}
lc_pass "ls-halcyon-lantern(7): Super+K deletes the history ($h_pre rows to 0) and keeps the grid; the tile records again ($h_again)"

lc_quit
lc_pass "LS-CI ls-halcyon-lantern: the deck renders in a Halcyon tile and pages on a keystroke; captures at build/lantern-rich-*.png"
exit 0
