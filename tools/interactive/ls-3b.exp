#!/usr/bin/expect -f
# LS-3b: fs-mutation coreutils over a real PTY -- mkdir / touch / cp / mv / tee /
# rm. Proves the interactive human path for creating, copying, moving, and
# deleting files (the LS-3b companion to fs-mut-smoke's non-interactive gate).
#
# Discipline (see lib.exp): match command OUTPUT, never typed input (the ut line
# editor redraws the prompt per keystroke and does not emit the typed line as
# plain bytes). Each step is one self-synchronizing `cmd -> token` round.
#
# Scratch lives under the user's OWN home (/home/michael, 0700, michael-owned):
# the session user is uid 1000, and the pivot root `/` is PRINCIPAL_SYSTEM-owned
# 0755, so a non-system user (correctly, per A-3b rwx enforcement) cannot create
# under `/`. (fs-mut-smoke runs as joey=SYSTEM and uses `/`; an interactive user
# works in their home.) Idempotent: step (a) `rm -rf` reclaims any stale tree
# (the pool persists across boots).

# G-3: HVF. MEASURED ~200s -> ~40s (this scenario is boot-dominated, and a
# TCG boot is ~5x an HVF one). Coverage argument, because a green run under a
# different accel is NOT the same as the same coverage: accel also picks the
# CPU model and the GIC version (hvf -> -cpu host + GICv2; tcg -> -cpu max +
# GICv3, tools/run-vm.sh), so a flip moves this scenario off those axes. It is
# safe HERE because LS-3 console/line-discipline assertions; the hardware paths it rides are anchored elsewhere, and because the GICv3 + `-cpu max` axes stay covered
# by the TCG anchor set the wrapper enforces (freeze-172, flood-174, split173,
# nora-demo, idle-probe, ls-7, pty-4). Set THYLACINE_ACCEL=tcg to A/B it.
set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

lc_boot
lc_login michael correct-horse-battery-staple-v1

# (a) clean start + mkdir + create a file in the new dir (a depth-2 redirect
# create under home) + read it back. One command, verified by the content token.
lc_run_expect "rm -rf /home/michael/l3b; mkdir /home/michael/l3b; echo cu-mk-3b71 > /home/michael/l3b/src3b; cat /home/michael/l3b/src3b" "cu-mk-3b71"
lc_pass "LS-3b(a): mkdir + create-in-dir + cat"

# (b) cp the file; the copy has the same content.
lc_run_expect "cp /home/michael/l3b/src3b /home/michael/l3b/cpy3b; cat /home/michael/l3b/cpy3b" "cu-mk-3b71"
lc_pass "LS-3b(b): cp file"

# (c) mv the copy; the moved file has the content.
lc_run_expect "mv /home/michael/l3b/cpy3b /home/michael/l3b/mvd3b; cat /home/michael/l3b/mvd3b" "cu-mk-3b71"
lc_pass "LS-3b(c): mv file"

# (d) touch a new empty file; ls shows it among the dir's entries.
lc_send "touch /home/michael/l3b/tch3b"
lc_run_expect "ls /home/michael/l3b" "tch3b"
lc_pass "LS-3b(d): touch + ls enumerates it"

# (e) tee writes to stdout AND to the file.
lc_run_expect "echo tee-3b91 | tee /home/michael/l3b/tee3b" "tee-3b91"
lc_run_expect "cat /home/michael/l3b/tee3b" "tee-3b91"
lc_pass "LS-3b(e): tee (stdout + file)"

# (g) G12: file times. stat prints each time as epoch seconds; every leg sets a
# different time, so one leg's token left in the buffer cannot satisfy the next.
# touch -t / -d / -r and cp -p / -a set explicit times (the owner's); a bare
# touch sets both to the file server's clock, the form write permission allows.
lc_run_expect "touch -t 200109090146.40 /home/michael/l3b/tch3b; stat /home/michael/l3b/tch3b" "Modify: 1000000000"
lc_pass "LS-3b(g): touch -t sets the mtime"
lc_run_expect "touch -d 2004-11-09T11:33:20Z /home/michael/l3b/src3b; cp -p /home/michael/l3b/src3b /home/michael/l3b/cpp3b; stat /home/michael/l3b/cpp3b" "Modify: 1100000000"
lc_pass "LS-3b(h): cp -p keeps the source's mtime"
lc_send "mkdir /home/michael/l3b/arc; touch -d 2008-01-10T21:20:00Z /home/michael/l3b/arc/f; touch -d 2009-02-13T23:31:30Z /home/michael/l3b/arc; cp -a /home/michael/l3b/arc /home/michael/l3b/arc2; stat /home/michael/l3b/arc2/f; stat /home/michael/l3b/arc2"
lc_expect "Modify: 1200000000" "cp -a kept a file's mtime"
lc_expect "Modify: 1234567890" "cp -a kept the directory's mtime, set after its entries"
lc_pass "LS-3b(i): cp -a keeps a tree's times"
lc_run_expect "touch -t 201603151200 /home/michael/l3b/ref3b; touch -r /home/michael/l3b/ref3b /home/michael/l3b/tch3b; stat /home/michael/l3b/tch3b" "Modify: 1458043200"
lc_pass "LS-3b(j): touch -r copies a reference's times"

# The bare touch: its mtime is the clock's, within two seconds of date's.
proc expect_touch_now {phase} {
    global lc_cmd_timeout timeout
    set timeout $lc_cmd_timeout
    expect {
        -re {Modify: ([0-9]+) .*?\n([0-9]{9,11})\r?\n} {
            set m $expect_out(1,string)
            set d $expect_out(2,string)
            if {abs($m - $d) > 2} {
                lc_fail "touch set mtime $m against the clock's $d ($phase)"
            }
            lc_step "saw: $phase (mtime $m, clock $d)"
        }
        -re {EXTINCTION:} { lc_extinction_fail "kernel extinction during '$phase'" }
        timeout           { lc_fail "timeout (${lc_cmd_timeout}s) during '$phase'" }
        eof               { lc_fail "unexpected EOF during '$phase'" }
    }
}
lc_send "touch /home/michael/l3b/tch3b; stat /home/michael/l3b/tch3b; date +%s"
expect_touch_now "a bare touch takes the clock"
lc_pass "LS-3b(k): touch sets both times to now"

# (l)-(n) env: it sets variables in its OWN /env and execs the command, which
# inherits them; the shell's environment is untouched. Every value is read back
# upper-cased, so the typed command's echo cannot satisfy it.
proc env_value {tag cmd} {
    global lc_cmd_timeout timeout
    set timeout $lc_cmd_timeout
    set up [string toupper $tag]
    lc_send "echo $tag-\$($cmd) | tr a-z A-Z"
    expect {
        -re "$up- ?(\[^\r\n\]*)\r" { set v [string trim $expect_out(1,string)] }
        -re {EXTINCTION:}          { lc_extinction_fail "kernel extinction during $cmd" }
        timeout                    { lc_fail "timeout (${lc_cmd_timeout}s) during $cmd ($tag)" }
        eof                        { lc_fail "unexpected EOF during $cmd ($tag)" }
    }
    lc_step "saw: $tag = $v"
    return $v
}
proc env_status {tag cmd} {
    global lc_cmd_timeout timeout
    set timeout $lc_cmd_timeout
    set up [string toupper $tag]
    lc_send "$cmd; echo $tag-\$status | tr a-z A-Z"
    expect {
        -re "$up- ?(\[0-9\]+)\r" { set v $expect_out(1,string) }
        -re {EXTINCTION:}        { lc_extinction_fail "kernel extinction during $cmd" }
        timeout                  { lc_fail "timeout (${lc_cmd_timeout}s) during $cmd ($tag)" }
        eof                      { lc_fail "unexpected EOF during $cmd ($tag)" }
    }
    lc_step "saw: $tag status = $v"
    return $v
}
set v [env_value envset {env T3BENV=ev-3b42 /bin/env | grep T3BENV}]
if {$v ne "T3BENV=EV-3B42"} { lc_fail "env NAME=VALUE: the command saw '$v'" }
set v [env_status envleft {cat /env/T3BENV}]
if {$v == 0} { lc_fail "env changed the shell's environment (/env/T3BENV exists)" }
lc_pass "LS-3b(l): env sets a variable for the command alone"
set v [env_value envcnt {env -i T3BENV=ev-3b43 /bin/env | grep -c =}]
if {$v ne "1"} { lc_fail "env -i: the command saw $v variables, not 1" }
lc_pass "LS-3b(m): env -i starts from an empty environment"
set v [env_status envnf {env /no/such/cmd3b}]
if {$v != 127} { lc_fail "env of a missing command exited $v, not 127" }
set v [env_status envst {env T3BENV=1 false}]
if {$v != 1} { lc_fail "env false exited $v, not false's 1" }
lc_pass "LS-3b(n): env exits 127 for a missing command and with the command's status"

# (f) rm -r removes the whole tree; ls of the gone dir errors.
lc_run_expect "rm -r /home/michael/l3b; ls /home/michael/l3b" "ls:"
lc_pass "LS-3b(f): rm -r removes the tree"

lc_quit
lc_pass "LS-CI ls-3b: mkdir + touch + cp + mv + tee + times + env + rm all verified"
exit 0
