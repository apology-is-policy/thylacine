#!/usr/bin/expect -f
# tools/interactive/im1-sak-lever.exp -- IM-1 + IM-3: the BREAK lever, the
# kernel's SAK witness, and the EMPTY trusted episode (IMPERIUM-DESIGN.md 11.3
# + 11.5; TRUSTED-PATH.md 12; I-27 on serial).
#
# Proves, over the real console, that the harness CAN inject a serial BREAK --
# A-4c-2's note said it could not, stale since the console became a `mux=on`
# chardev shared with the qemu monitor: Ctrl-A b is the monitor's "send a
# BREAK" verb on the muxed serial -- and that the kernel recognizes it:
# proc_console_sak emits `cons: SAK (<decision>)` on EVERY SAK it services.
# Since IM-3 corvus ARMS itself as the episode consumer at startup, so the
# decision is `episode`: the kernel freezes the console for everyone but
# corvus, corvus finds no pending imperium request, shows the "nothing
# pending" panel on the trusted path, and ENDs on any key -- the section-4
# "when in doubt, hit the SAK" check. (Before IM-3 this scenario asserted
# `unarmed`; the request arms live in im3-lex-curiata.exp.)
#
#   (b) NEGATIVE CONTROL, one variable away, and FIRST so a stale witness can
#       never satisfy (a): a bare `b` (the lever minus the monitor escape)
#       produces no SAK line -- the witness keys on the BREAK, not the byte.
#   (a) POSITIVE: Ctrl-A b -> `cons: SAK (episode)` -> the "nothing pending"
#       panel (corvus's bytes, on a console the shell cannot reach) -> a key
#       dismisses it -> `trusted path: done`.
#   (c) EVERY SAK: a second Ctrl-A b -> a second episode (the refinement that
#       retired the early return which swallowed every SAK after the first).
#   (d) the session SURVIVES: after END a command EXECUTES, keyed on an
#       UPPERCASED token the editor's lowercase echo can never produce -- so
#       the freeze was lifted, the termios restored, the owner handed back.
#
# What this CANNOT see, said so the green reads no larger: that the dismissing
# key went to corvus and not the shell (both would leave the shell prompt
# looking the same). im3-lex-curiata.exp's wrong-key arm is the witness for
# input exclusivity: the key it types reaches corvus's verdict, never the
# shell.
#
# Tcl trap, recorded so nobody "fixes" it back: "\x01b" is NOT Ctrl-A + b --
# \x consumes every following hex digit, so it is one byte 0x1b (ESC). The
# octal form "\001b" (three digits max) is the byte 0x01 followed by `b`, the
# same spelling lc_quit uses for Ctrl-A x.

set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

# Wait `secs` for a SAK witness line; return the kernel's DECISION string
# (the text inside the parentheses), or "" on timeout. Returned, not read from
# expect_out by the caller: expect_out is local to the proc that matched.
# Extinction and EOF are hard failures either way.
proc sak_witness_within {secs phase} {
    global timeout
    set timeout $secs
    expect {
        -re {cons: SAK \(([a-z ]+)\)} {
            set d $expect_out(1,string)
            lc_step "saw: cons: SAK ($d) during '$phase'"
            return $d
        }
        -re {EXTINCTION:} { lc_extinction_fail "kernel extinction during '$phase'" }
        eof               { lc_fail "unexpected EOF during '$phase'" }
        timeout           { return "" }
    }
}

# One empty episode: the SAK, the panel, the dismiss, the END witness.
proc empty_episode {phase} {
    lc_raw_send "\001b" "monitor BREAK ($phase)"
    set d [sak_witness_within 10 "the SAK witness ($phase)"]
    if {$d eq ""} {
        lc_fail "no `cons: SAK (...)` line within 10s of Ctrl-A b ($phase) -- the BREAK did not reach the kernel (the mux chardev lever is broken) or proc_console_sak no longer emits the witness"
    }
    if {$d ne "episode"} {
        lc_fail "SAK decision was '$d', expected 'episode' ($phase) -- corvus is not ARMED as the episode consumer (IM-3's startup ARM), or the trusted Proc is gone"
    }
    lc_expect "nothing pending -- press any key" "corvus's empty-episode panel ($phase)"
    lc_raw_send "x" "dismiss the panel ($phase)"
    lc_expect "trusted path: done" "the episode END witness ($phase)"
}

lc_boot
lc_login michael correct-horse-battery-staple-v1

# (b) the negative control: the lever WITHOUT its monitor escape. The byte is
# just typed at the shell; Enter runs it as a (nonexistent) command, which is
# the harmless way to consume it from the line editor.
lc_send "b"
set d [sak_witness_within 3 "negative control: a bare 'b'"]
if {$d ne ""} {
    lc_fail "a bare 'b' produced a SAK line (decision '$d') -- the witness keys on the byte, not the BREAK"
}
lc_pass "IM-1(b): a bare 'b' is not a SAK (negative control holds)"

# (a) the lever: Ctrl-A b = the qemu monitor's BREAK on the muxed serial ->
# the kernel opens the episode -> corvus's panel -> a key -> END.
empty_episode "first"
lc_pass "IM-1(a): Ctrl-A b reached the kernel as a BREAK: cons: SAK (episode) -> the empty panel -> END"

# (c) every SAK is serviced + witnessed, not only the first of a session.
empty_episode "second"
lc_pass "IM-1(c): a second SAK opens a second episode"

# (d) the episode left nothing frozen: the shell still executes a command.
lc_send "echo im1-after-sak | tr a-z A-Z"
lc_expect "IM1-AFTER-SAK" "a command executes after the episodes"
lc_pass "IM-1(d): the session survives two empty episodes (the freeze lifted, the termios restored)"

lc_quit
lc_pass "IM-1 im1-sak-lever: BREAK lever + SAK witness + negative control + two empty episodes + session survives"
exit 0
