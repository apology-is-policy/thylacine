#!/usr/bin/expect -f
# A server stopped mid-copy does not stop typing (ASYNC-SERVICE-LIFECYCLE, AS-4d). A
# real Nora on a pts the probe owns, against loom-fixture's interaction node over the
# private ring. The session's real service cannot be held, since typing goes through
# it, and ut cannot give a child an environment, so the probe hosts the editor.
#
# Image and boot:
#   tools/build.sh kernel --config ci --set PRIVATE_ASYNC_QUAL=y
#   THYLACINE_BUILD_DIR=build/kernel-private-async-qual tools/test-interactive.sh ls-nora-stopped-copy
#
# What the run must show (usr/kaua-term-probe/src/stopped_nora.rs):
#   - The control: the same keys against the service that answers copy and paste.
#   - Typed text in the file while the fixture still holds the copy, read in that
#     order: an editor that waited for the client's deadline lands it afterwards.
#   - The client gives up at its deadline, ends the connection and says so.
#   - More typing, a new copy over a new connection, and :wq with that copy held: the
#     editor leaves, and its session ends with it.
#   - The fixture exits 77: no violation and every session ended.
set ::env(THYLACINE_SERIAL_SAK) 1
source [file join [file dirname [info script]] lib.exp]
lc_boot
lc_login michael correct-horse-battery-staple-v1
lc_send "imperium post"
lc_expect "as pid" "post request"
lc_raw_send "\001b" "serial SAK fixture"
lc_expect "CONFERRING IMPERIUM" "trusted provincia"
lc_expect "CAP_POST_SERVICE" "posting authority"
lc_expect "imperium key: " "trusted key prompt"
lc_raw_send "imperium-key-michael-v1\r" "fixture key"
lc_expect "Authority conferred to the requesting process." "corvus's verdict panel"
lc_raw_send "\r" "Enter closes the verdict panel (vote 70)"
lc_expect "imperium: conferred" "post capability conferred"
lc_send "kaua-term-probe --stopped-nora"
set timeout 240
expect {
    -ex "stopped-nora: UNAVAILABLE" {
        puts "\nLS-CI SKIP: no private ring in this kernel -- see this scenario's header for the bake"
        lc_quit
        exit 77
    }
    -ex "stopped-nora: PASS" {}
    -re {stopped-nora: FAIL -- ([^\r\n]+)[\r\n]} { lc_fail "probe: $expect_out(1,string)" }
    -re {EXTINCTION:} { lc_extinction_fail "stopped-nora" }
    timeout { lc_fail "the probe did not finish" }
    eof { lc_fail "EOF during the probe" }
}
lc_run_expect "echo stopped-nora-shell-live | tr a-z A-Z" "STOPPED-NORA-SHELL-LIVE"
lc_pass "a server stopped mid-copy did not stop typing, and Nora left without it"
lc_quit
exit 0
