#!/usr/bin/expect -f
# ls-mac-folders -- the shared folders of the line to the Mac (docs/MAC-RUNNER.md 4.4), through the
# guest's kernel, against the Mac app itself: THYLACINE_MAC_APP, else macrunner/app's debug build.
# Without one this SKIPs (exit 77): an absent app is neither a regression nor coverage. The app
# shares four host folders this scenario makes: `work` and `inbox` read-write, `docs` read-only,
# and `nested`, which is work/sub shared again. Every change the guest makes is checked ON THE
# MAC, in the folder itself:
#
#   1. folders/ lists the four shares, and files one and two levels down read as the Mac wrote them.
#   2. A file the guest writes holds the guest's bytes on the Mac.
#   3. mkdir, mv, rm and rmdir each change the Mac's folder as they say, and cp brings a file of
#      the guest's own into a share.
#   4. A link in a shared folder is a served link (DISTRO 4.6; the driver posts /srv/mac remote):
#      a relative one resolves beside it, and an absolute one beneath /mnt/mac -- one naming
#      /folders/work/... reads the share's file, and one naming the guest's own /tmp decoy reads
#      nothing. Without the remote declaration both flip.
#   5. A link the Mac puts in place of a directory the guest is using: the guest stands in a
#      shared directory, and mac-line-probe holds it as a path handle, while the Mac swaps it
#      for a link to a folder outside the share. Only the `go` the Mac writes into work/release
#      after the swap releases the probe (a console child's stdin is a closed pipe), and it says
#      so before its walk. The handle walks from its fid, so the app's own
#      O_NOFOLLOW_ANY refuses the next step (ELOOP), and the app's record shows that walk began
#      at the held directory. The cwd is a name (LS-4): a read beside it walks from the root
#      again, meets the link, and the kernel resolves that beneath /mnt/mac, where the Mac's
#      path names nothing (ENOENT). The outside file's words reach the guest by neither.
#   6. The read-only share reads. Its modes carry no write, and the guest's kernel checks them
#      (dev9p enforces rwx), so a create, a write over a file, a remove and a rename are refused
#      in the guest (permission denied). The owner's mode change is passed on, and the app's own
#      rule refuses it (EROFS: read-only file system). The Mac's folder is unchanged.
#   7. Every file is the session user's (the uid `id` names), with the host file's owner bits:
#      0600 for a 0644 file, 0400 in the read-only share.
#   8. A move across devices (vote M15): the guest's /tmp is its home's 9P session and /mnt/mac
#      another, so the kernel answers a rename between them EXDEV before it asks either, and
#      between two shares the app answers it. mv then copies under a new name beside the
#      destination, keeping times and mode, syncs the copy, renames it over the destination, syncs
#      that directory, and only then removes the source (votes M19, M20; the app's record shows
#      the order): a guest file into a share, a file between two shares (its time and its 0400
#      mode kept), a tree out of a share into the guest. Out of the read-only share the copy is
#      made and the source cannot be removed: mv says so, fails, and leaves both, as POSIX mv
#      does. No temporary name is left.
#   9. rm -r removes a link in a tree, never what it names: work/rmtree holds a link to the
#      directory work/keep, and the tree goes while work/keep and its file stay on the Mac; the
#      app's record shows each entry opened from rmtree's own handle (vote M21). A
#      plain rm of a link to a directory removes the link: a link is not a directory.
#  10. What must not happen leaves everything as it was. work/sub/inner.txt and
#      nested/inner.txt are one file: mv and cp refuse it as the same file (one host file has
#      one identity whichever share reaches it), and it keeps its words. /srv/mac reads as a
#      regular file until it is opened, and mv refuses it as special once it has. A move whose
#      copy fails leaves the source and the destination as they were and removes only its own
#      copy: an unreadable file over an existing one (vote M19), and a read-only tree holding an
#      unreadable file, whose copy keeps the owner's 0700 until the whole copy is done (round 2
#      F11), so it can be removed.
#
# Uses the --config ci image (a serial-console login). Every capture ends at the delimiter after
# it, and the guest's output is upper-cased, so the echoed command line can never match it.

set ::env(THYLACINE_ACCEL) hvf
source [file join [file dirname [info script]] lib.exp]

set app [expr {[info exists ::env(THYLACINE_MAC_APP)] && $::env(THYLACINE_MAC_APP) ne "" \
    ? $::env(THYLACINE_MAC_APP) : [file join $::lc_repo macrunner app target debug thylacine-mac]}]
if {![file executable $app]} {
    puts "LS-CI SKIP: no Mac app at $app -- build it (cargo build in macrunner/app) or set THYLACINE_MAC_APP"
    exit 77
}

# The Mac's folders.
set ::work [exec mktemp -d -t thyla-mac-folders]
set ::W $::work/work
set ::R $::work/docs
set ::I $::work/inbox
set ::O $::work/outside
file mkdir $::W/sub $::W/d $::W/tree/deeper $::W/keep $::W/rmtree $::W/locked $::R $::I $::O
proc write_file {path text} {
    set fh [open $path w]
    puts -nonewline $fh $text
    close $fh
    file attributes $path -permissions 00644
}
proc read_file {path} {
    if {[catch {set fh [open $path r]}]} { return "<unreadable>" }
    set s [read $fh]
    close $fh
    return $s
}
write_file $::W/hello.txt        "hello from a mac folder\n"
write_file $::W/sub/inner.txt    "inner file two deep\n"
write_file $::W/sub/linked.txt   "reached by a relative link\n"
write_file $::W/sub/anchored.txt "reached by an absolute link beneath the mount\n"
write_file $::W/d/inside.txt     "inside the directory the mac swaps\n"
write_file $::O/secret.txt       "secret outside the share\n"
write_file $::R/readme.txt       "read only words\n"
write_file $::W/tree/a.txt       "tree file a\n"
write_file $::W/tree/deeper/b.txt "tree file b one deeper\n"
write_file $::W/old.txt          "an old file the mac wrote\n"
set ::old_time 1000000000
file mtime $::W/old.txt $::old_time
file attributes $::W/old.txt -permissions 00400
write_file $::W/keep/kept.txt     "kept beside the tree\n"
write_file $::W/rmtree/gone.txt   "removed with the tree\n"
write_file $::W/unreadable.txt    "the guest may not read this\n"
file attributes $::W/unreadable.txt -permissions 00200
write_file $::I/over.txt          "inbox over words\n"
write_file $::W/locked/ok.txt     "ok in a locked tree\n"
write_file $::W/locked/unreadable.txt "unreadable in a locked tree\n"
file attributes $::W/locked/unreadable.txt -permissions 00200
file attributes $::W/locked -permissions 00500
# `file link` insists the target exist, and these targets are the guest's to resolve.
exec ln -s sub/linked.txt                 $::W/rel
exec ln -s /folders/work/sub/anchored.txt $::W/inshare
exec ln -s /tmp/mac-decoy-a               $::W/abs
exec ln -s ../keep                        $::W/rmtree/link
exec ln -s keep                           $::W/dirlink

set ::mac_sock [file join $::lc_repo build "mac-folders-[pid].sock"]
set ::mac_log [file join $::lc_repo build "mac-folders-[pid].log"]
catch {file delete -force $::mac_sock $::mac_log}
set ::env(THYLACINE_MAC_LINE) $::mac_sock
set ::app_pid [exec $app --mac-line $::mac_sock --line-log $::mac_log --snarf-memory "folders" \
    --share work=$::W --share docs=$::R:ro --share inbox=$::I --share nested=$::W/sub >>& $::mac_log.err &]
lc_step "thylacine-mac started (pid $::app_pid): work=$::W, inbox=$::I, docs=$::R read-only, nested=$::W/sub (work/sub again)"
exit -onexit {
    catch {exec kill $::app_pid}
    catch {file delete -force $::mac_sock}
    # work/locked is 0500, and a failed run can leave a read-only copy: open them, or they stay.
    catch {exec chmod -R u+rwx $::work}
    catch {file delete -force $::work}
}

proc app_log {} {
    if {[catch {set f [open $::mac_log r]}]} { return "" }
    set s [read $f]
    close $f
    return $s
}
proc app_wait {re secs phase} {
    for {set i 0} {$i < $secs * 5} {incr i} {
        if {[regexp -line -- $re [app_log] m]} {
            lc_step "the app logged: $m ($phase)"
            return $m
        }
        after 200
    }
    lc_fail "the app's log had no \[$re\] within ${secs}s ($phase); its log: [app_log]"
}
# The app's record of each walk naming `name`: where it began, its names and its outcome.
proc app_walks {name} {
    set got [regexp -all -inline -line -- "walk \[^\n\]*'[string map {. \\.} $name]'\[^\n\]*" [app_log]]
    return [expr {[llength $got] ? [join $got "; "] : "none"}]
}
# The number of the first or last line of the app's record matching `re`, or -1: what came first.
proc log_line {re which} {
    set got [lsearch -all -regexp [split [app_log] "\n"] $re]
    if {![llength $got]} { return -1 }
    return [expr {$which eq "first" ? [lindex $got 0] : [lindex $got end]}]
}
# Whether a temporary name of mv's is left in the Mac folder `dir`.
proc mv_left {dir} {
    return [llength [glob -nocomplain -directory $dir .mv-*]]
}
# A fact about the Mac's folder. Each is read after the guest printed the status of the command
# that changed it, and the guest's command returns only once the app has answered.
proc on_mac {ok what} {
    if {!$ok} { lc_fail "on the Mac: NOT $what" }
    lc_step "on the Mac: $what"
}

# `cat path`, upper-cased; the file's words, or a failure naming the tool's error.
proc read_ok {path want phase} {
    lc_send "cat $path | tr a-z A-Z"
    lc_within $::lc_cmd_timeout {
        -ex $want                                   { lc_step "saw: $phase" }
        -re {(cat|tr|ut): ([^\r\n]*)[\r\n]}         { lc_fail "[string trimright $expect_out(0,string)] ($phase)" }
        -re {EXTINCTION:}                           { lc_extinction_fail "kernel extinction during '$phase'" }
        timeout                                     { lc_fail "timeout waiting for \[$want\] ($phase)" }
        eof                                         { lc_fail "unexpected EOF during '$phase'" }
    }
}
# `cat path` that must fail: the error's text, or a failure if `never` (upper-cased words the read
# must not reach) shows instead.
proc read_refused {path never phase} {
    lc_send "cat $path | tr a-z A-Z"
    lc_within $::lc_cmd_timeout {
        -ex $never                                  { lc_fail "the guest read \[$never\] through $path ($phase)" }
        -re {cat: ([^\r\n]*): ([^\r\n]*)[\r\n]}     { set why $expect_out(2,string) }
        -re {EXTINCTION:}                           { lc_extinction_fail "kernel extinction during '$phase'" }
        timeout                                     { lc_fail "cat $path printed neither an error nor \[$never\] ($phase)" }
        eof                                         { lc_fail "unexpected EOF during '$phase'" }
    }
    lc_step "refused: $why ($phase)"
    return $why
}
# Run `cmd`, then echo its status and $errstr under `tag`; {status errstr}, or a failure on any
# tool's error line. $errstr means something only when the status is not 0.
proc run_status {cmd tag phase} {
    lc_send "$cmd; echo $tag status \$status err \$errstr end | tr a-z A-Z"
    set re "[string toupper $tag] STATUS (\[0-9\]+) ERR(\[^\r\n\]*) END\[\r\n\]"
    lc_within $::lc_cmd_timeout {
        -re $re                                              { set st $expect_out(1,string); set err [string trim $expect_out(2,string)] }
        -re {(cat|cp|ls|mkdir|mv|rm|rmdir|tr|ut): ([^\r\n]*)[\r\n]} { lc_fail "[string trimright $expect_out(0,string)] ($phase)" }
        -re {EXTINCTION:}                                    { lc_extinction_fail "kernel extinction during '$phase'" }
        timeout                                              { lc_fail "timeout waiting for \[$tag\]'s status ($phase)" }
        eof                                                  { lc_fail "unexpected EOF during '$phase'" }
    }
    return [list $st $err]
}
# Run `cmd`, whose tool is `tool`, then echo its status under `tag`: {status why}, where why is the
# text after "<tool>: " on the tool's own error line, or empty when it printed none.
proc tool_status {tool cmd tag phase} {
    lc_send "$cmd; echo $tag status \$status end | tr a-z A-Z"
    set t [string toupper $tag]
    lc_within $::lc_cmd_timeout {
        -re "$tool: (\[^\r\n\]*)\[\r\n\].*$t STATUS (\[0-9\]+) END\[\r\n\]" { set why $expect_out(1,string); set st $expect_out(2,string) }
        -re "$t STATUS (\[0-9\]+) END\[\r\n\]"                            { set why ""; set st $expect_out(1,string) }
        -re {EXTINCTION:}                                                     { lc_extinction_fail "kernel extinction during '$phase'" }
        timeout                                                               { lc_fail "timeout waiting for \[$tag\]'s status ($phase)" }
        eof                                                                   { lc_fail "unexpected EOF during '$phase'" }
    }
    return [list $st $why]
}
proc run_ok {cmd tag phase} {
    lassign [run_status $cmd $tag $phase] st err
    if {$st != 0} { lc_fail "status $st, \$errstr '$err' ($phase)" }
    lc_step "status 0: $phase"
}

lc_boot
# lc_boot returns once the VM is started, a minute before the driver runs. The driver holds its
# READY until the app's HELLO came, so by the login the line is up, and the HELLO is in the log.
lc_login michael correct-horse-battery-staple-v1
app_wait {hello maxframe=16384} 30 "the driver's HELLO reached the app before the login"
lc_send "echo guest side a > /tmp/mac-decoy-a"
# lc_send consumes nothing, so the login's own `ut: ...` lines are still unread, and the tool-error
# arms below would take the first of them. Read past them to a marker first.
lc_send "echo folders-setup-done | tr a-z A-Z"
lc_expect "FOLDERS-SETUP-DONE" "the guest's decoy, and past the login's lines"

# ---- 1. the shares, and reads one and two levels down.
lc_send "ls /mnt/mac/folders | tr a-z A-Z"
lc_within $lc_cmd_timeout {
    -re {DOCS[\r\n]+INBOX[\r\n]+NESTED[\r\n]+WORK[\r\n]} { lc_step "folders/ lists docs, inbox, nested and work" }
    -re {(ls|tr|ut): ([^\r\n]*)[\r\n]}      { lc_fail "[string trimright $expect_out(0,string)] (ls /mnt/mac/folders)" }
    -re {EXTINCTION:}                       { lc_extinction_fail "kernel extinction at ls /mnt/mac/folders" }
    timeout                                 { lc_fail "ls /mnt/mac/folders did not list DOCS, INBOX, NESTED, WORK" }
    eof                                     { lc_fail "unexpected EOF at ls /mnt/mac/folders" }
}
read_ok /mnt/mac/folders/work/hello.txt "HELLO FROM A MAC FOLDER" "a file in a share"
read_ok /mnt/mac/folders/work/sub/inner.txt "INNER FILE TWO DEEP" "a file two levels down"
lc_pass "ls-mac-folders: folders/ lists the four shares, and the Mac's files read one and two levels down"

# ---- 2. a write lands on the Mac.
run_ok "echo written by the guest > /mnt/mac/folders/work/new.txt" leg2 "the guest writes new.txt"
on_mac [expr {[read_file $::W/new.txt] eq "written by the guest\n"}] "work/new.txt holds the guest's line"
lc_pass "ls-mac-folders: a file the guest wrote holds its bytes on the Mac"

# ---- 3. mkdir, mv, rm, rmdir.
run_ok "mkdir /mnt/mac/folders/work/made" leg3a "mkdir"
on_mac [file isdirectory $::W/made] "work/made is a directory"
run_ok "mv /mnt/mac/folders/work/new.txt /mnt/mac/folders/work/made/moved.txt" leg3b "mv"
on_mac [expr {![file exists $::W/new.txt]}] "work/new.txt is gone"
on_mac [expr {[read_file $::W/made/moved.txt] eq "written by the guest\n"}] "work/made/moved.txt holds the guest's line"
run_ok "rm /mnt/mac/folders/work/made/moved.txt" leg3c "rm"
on_mac [expr {![file exists $::W/made/moved.txt]}] "work/made/moved.txt is gone"
run_ok "rmdir /mnt/mac/folders/work/made" leg3d "rmdir"
on_mac [expr {![file exists $::W/made]}] "work/made is gone"
run_ok "cp /tmp/mac-decoy-a /mnt/mac/folders/work/copied.txt" leg3e "cp from the guest's /tmp into the share"
on_mac [expr {[read_file $::W/copied.txt] eq "guest side a\n"}] "work/copied.txt holds the guest file's line"
lc_pass "ls-mac-folders: mkdir, mv, rm, rmdir and cp each changed the Mac's folder as they say"

# ---- 4. served links, contained beneath /mnt/mac.
read_ok /mnt/mac/folders/work/rel "REACHED BY A RELATIVE LINK" "a relative link resolves beside itself"
read_ok /mnt/mac/folders/work/inshare "REACHED BY AN ABSOLUTE LINK BENEATH THE MOUNT" \
    "an absolute link naming /folders/work/... resolves beneath /mnt/mac"
set why [read_refused /mnt/mac/folders/work/abs "GUEST SIDE A" "an absolute link naming the guest's /tmp decoy"]
if {$why ne "no such file or namespace entry"} {
    lc_fail "the link to /tmp/mac-decoy-a failed with '$why', not as a name /mnt/mac lacks"
}
lc_pass "ls-mac-folders: the Mac's links resolve beneath /mnt/mac -- the share's file, never the guest's"

# ---- 5. a link the Mac puts in place of a directory the guest is using.
lc_send "cd /mnt/mac/folders/work/d"
read_ok inside.txt "INSIDE THE DIRECTORY THE MAC SWAPS" "a read beside the cwd, before the swap"
# The probe holds the handle until work/release reads `go`, and says when it is released. The Mac
# writes go only after the swap, so the walk follows the swap whenever that line comes. ut gives an
# ordinary child a closed pipe for stdin, never the console, so the release cannot be typed. The
# echoed command line holds no `mac-line-probe:`; only the probe's own lines do.
close [open $::W/release w]
lc_send "mac-line-probe beneath /mnt/mac/folders/work/d secret.txt /mnt/mac/folders/work/release"
lc_within $lc_cmd_timeout {
    -re {mac-line-probe: beneath: ([^\r\n]*)[\r\n]}  { set said $expect_out(1,string) }
    -re {(mac-line-probe|ut): ([^\r\n]*)[\r\n]}      { lc_fail "[string trimright $expect_out(0,string)] (the probe, before the swap)" }
    -re {EXTINCTION:}                                { lc_extinction_fail "kernel extinction at the probe's hold" }
    timeout                                          { lc_fail "mac-line-probe beneath said nothing" }
    eof                                              { lc_fail "unexpected EOF at the probe's hold" }
}
if {![string match "holding *" $said]} { lc_fail "mac-line-probe: beneath: $said (before the swap)" }
lc_step "the probe holds work/d as a path handle"
file rename $::W/d $::W/d-before
exec ln -s $::O $::W/d
lc_step "on the Mac: work/d is now a link to $::O"
set f [open $::W/release w]
puts $f go
close $f
lc_step "on the Mac: work/release says go"
lc_within $lc_cmd_timeout {
    -re {mac-line-probe: beneath: ([^\r\n]*)[\r\n]}  { set said $expect_out(1,string) }
    -re {EXTINCTION:}                                { lc_extinction_fail "kernel extinction at the probe's release" }
    timeout                                          { lc_fail "the probe said nothing once the Mac wrote go, after the swap" }
    eof                                              { lc_fail "unexpected EOF at the probe's release" }
}
if {![string match "released by go in /mnt/mac/folders/work/release after *" $said]} {
    lc_fail "the probe was not released by the go the Mac wrote after the swap: it said '$said'"
}
lc_step "the probe was $said"
lc_within $lc_cmd_timeout {
    -re {mac-line-probe: beneath: ([^\r\n]*)[\r\n]}  { set said $expect_out(1,string) }
    -re {EXTINCTION:}                                { lc_extinction_fail "kernel extinction at the walk from the held handle" }
    timeout                                          { lc_fail "the probe said nothing once released, after the swap" }
    eof                                              { lc_fail "unexpected EOF at the walk from the held handle" }
}
if {[string match "secret.txt read *" $said]} {
    lc_fail "the guest read the outside file through the held handle: $said"
}
if {$said ne "secret.txt refused: too many levels of symbolic links"} {
    lc_fail "the walk from the handle held across the swap gave '$said', not the app's ELOOP; the app's walks naming secret.txt: [app_walks secret.txt]"
}
lc_step "refused: too many levels of symbolic links (a walk from the handle held across the swap)"
app_wait {walk 'folders/work/d' \['secret\.txt'\] -> errno 40} 5 "the app refused the walk that began at the held directory"
set why [read_refused secret.txt "SECRET OUTSIDE THE SHARE" "a read beside the cwd, after the swap"]
if {$why ne "no such file or namespace entry"} {
    lc_fail "the read beside the cwd after the swap failed with '$why', not as a name /mnt/mac lacks"
}
lc_send "cd"
lc_pass "ls-mac-folders: a link the Mac swapped in is refused from a held handle (ELOOP) and resolved beneath /mnt/mac from the cwd (ENOENT); nothing outside the share was read"

# ---- 6. the read-only share. Its modes carry no write, and the guest's kernel checks them before
# it asks the app (dev9p enforces rwx), so an ordinary user's change is refused in the guest and
# never reaches the app. The owner may change a mode, so the kernel passes that on, and the app's
# own rule answers it (EROFS). MAC-RUNNER 4.4, vote M14.
read_ok /mnt/mac/folders/docs/readme.txt "READ ONLY WORDS" "the read-only share reads"
set ::mac_mode [file attributes $::R/readme.txt -permissions]
lassign [run_status "echo should not land > /mnt/mac/folders/docs/new.txt" leg6a "a create in the read-only share"] st err
if {$st == 0 || ![string match "*: OPEN FAILED: PERMISSIONDENIED" $err]} {
    lc_fail "a create in the read-only share gave status $st, \$errstr '$err' -- not permission denied (the guest's mode check)"
}
lc_step "the create was refused in the guest: $err"
on_mac [expr {![file exists $::R/new.txt]}] "docs/new.txt was never made"
# An existing file: the kernel opens it O_WRONLY|O_TRUNC rather than creating it, so this is the
# open's check, and a miss would truncate the Mac's file.
lassign [run_status "echo should not land > /mnt/mac/folders/docs/readme.txt" leg6b "a write over a read-only file"] st err
if {$st == 0 || ![string match "*: OPEN FAILED: PERMISSIONDENIED" $err]} {
    lc_fail "a write over a read-only file gave status $st, \$errstr '$err' -- not permission denied (the guest's mode check)"
}
lc_step "the write was refused in the guest: $err"
on_mac [expr {[read_file $::R/readme.txt] eq "read only words\n"}] "docs/readme.txt is unchanged"
lassign [tool_status rm "rm /mnt/mac/folders/docs/readme.txt" leg6c "a remove in the read-only share"] st why
if {$st == 0 || ![string match "*: permission denied" $why]} {
    lc_fail "a remove in the read-only share gave status $st, '$why' -- not permission denied (the guest's mode check)"
}
lc_step "the remove was refused in the guest: $why"
on_mac [expr {[read_file $::R/readme.txt] eq "read only words\n"}] "docs/readme.txt is still there, unchanged"
lassign [tool_status mv "mv /mnt/mac/folders/docs/readme.txt /mnt/mac/folders/docs/moved.txt" leg6d "a rename in the read-only share"] st why
if {$st == 0 || ![string match "*: permission denied" $why]} {
    lc_fail "a rename in the read-only share gave status $st, '$why' -- not permission denied (the guest's mode check)"
}
lc_step "the rename was refused in the guest: $why"
on_mac [expr {[file exists $::R/readme.txt] && ![file exists $::R/moved.txt]}] "docs/readme.txt kept its name"
lassign [tool_status chmod "chmod 600 /mnt/mac/folders/docs/readme.txt" leg6e "the owner's mode change in the read-only share"] st why
if {$st == 0 || ![string match "*: read-only file system" $why]} {
    lc_fail "the owner's mode change in the read-only share gave status $st, '$why' -- not the app's EROFS (read-only file system)"
}
lc_step "the app refused the mode change: $why"
on_mac [expr {[file attributes $::R/readme.txt -permissions] eq $::mac_mode}] "docs/readme.txt keeps its mode ($::mac_mode)"
lc_pass "ls-mac-folders: the read-only share reads; the guest refuses a create, a write over a file, a remove and a rename (permission denied), and the app refuses the owner's mode change (EROFS)"

# ---- 7. ownership and modes.
lc_send "id"
lc_within $lc_cmd_timeout {
    -re {uid=([0-9]+) gid=}  { set me $expect_out(1,string) }
    -re {EXTINCTION:}        { lc_extinction_fail "kernel extinction at id" }
    timeout                  { lc_fail "id printed no uid" }
    eof                      { lc_fail "unexpected EOF at id" }
}
lc_step "michael is principal $me"
foreach {path mode} {/mnt/mac/folders/work/hello.txt 0600 /mnt/mac/folders/docs/readme.txt 0400} {
    lc_send "stat $path"
    lc_within $lc_cmd_timeout {
        -re {Mode:(?:\x1b\[[0-9;]*m)? \(([0-7]{4})/} { set got $expect_out(1,string) }
        -re {stat: ([^\r\n]*)[\r\n]}                  { lc_fail "stat $path failed: $expect_out(1,string)" }
        -re {EXTINCTION:}                             { lc_extinction_fail "kernel extinction at stat $path" }
        timeout                                       { lc_fail "stat $path printed no Mode" }
        eof                                           { lc_fail "unexpected EOF at stat $path" }
    }
    lc_within $lc_cmd_timeout {
        -re {Uid:(?:\x1b\[[0-9;]*m)? *([0-9]+|system)[ \t\r\n]} { set uid $expect_out(1,string) }
        -re {EXTINCTION:}                                       { lc_extinction_fail "kernel extinction at stat $path" }
        timeout                                                 { lc_fail "stat $path printed no Uid" }
        eof                                                     { lc_fail "unexpected EOF at stat $path" }
    }
    if {$got ne $mode || $uid ne $me} {
        lc_fail "$path is mode $got, owner $uid; wanted $mode, owned by michael ($me)"
    }
    lc_step "$path: mode $got, owned by $uid"
}
lc_pass "ls-mac-folders: every file is michael's ($me), with the host file's owner bits (0600; 0400 read-only)"

# ---- 8. a move across devices (vote M15). /mnt/mac is one 9P session and the guest's /tmp its
# home's, two devices, so the kernel answers a rename between them EXDEV before it asks either;
# between two shares the app answers it (two host folders). On EXDEV mv copies, keeping times and
# mode, then removes the source, as POSIX mv does. Each move is checked on the Mac and in the guest.
run_ok "rm -rf /tmp/mac-mv-a /tmp/mac-tree /tmp/mac-readme.txt" leg8h "the moves' guest targets, gone before the leg"
run_ok "echo moved from the guest > /tmp/mac-mv-a" leg8s "a guest file to move"
lassign [tool_status mv "mv /tmp/mac-mv-a /mnt/mac/folders/work/from-guest.txt" leg8a "a guest file moved into a share"] st why
if {$st != 0 || $why ne ""} {
    lc_fail "a guest file moved into a share gave status $st, '$why' -- not a quiet copy and remove"
}
lc_step "status 0, nothing said: the guest's file moved into the share"
on_mac [expr {[read_file $::W/from-guest.txt] eq "moved from the guest\n"}] "work/from-guest.txt holds the guest's line"
set why [read_refused /tmp/mac-mv-a "MOVED FROM THE GUEST" "the moved file's old name in the guest"]
if {$why ne "no such file or namespace entry"} {
    lc_fail "the guest's /tmp/mac-mv-a after the move: '$why', not a name the guest lacks"
}
file stat $::W/old.txt pre
set ::old_ino $pre(ino)
lassign [tool_status mv "mv /mnt/mac/folders/work/old.txt /mnt/mac/folders/inbox/across.txt" leg8b "a file moved between two shares"] st why
if {$st != 0 || $why ne ""} {
    lc_fail "a file moved between two shares gave status $st, '$why' -- not a quiet copy and remove"
}
lc_step "status 0, nothing said: the file moved from work to inbox"
on_mac [expr {[read_file $::I/across.txt] eq "an old file the mac wrote\n"}] "inbox/across.txt holds work/old.txt's words"
on_mac [expr {![file exists $::W/old.txt]}] "work/old.txt is gone"
set t [expr {[file exists $::I/across.txt] ? [file mtime $::I/across.txt] : "none"}]
on_mac [expr {$t eq $::old_time}] "inbox/across.txt keeps the source's time ($t, wanted $::old_time)"
set ino none
if {[file exists $::I/across.txt]} { file stat $::I/across.txt post; set ino $post(ino) }
on_mac [expr {$ino ne "none" && $ino != $::old_ino}] "inbox/across.txt is a copy (inode $ino; the source's was $::old_ino), the app having refused the rename between two shares"
set m -1
if {[file exists $::I/across.txt]} { scan [file attributes $::I/across.txt -permissions] %o m }
on_mac [expr {$m == 0400}] "inbox/across.txt keeps the source's mode ([format %04o $m], wanted 0400)"
# Vote M20, from the app's record: the copy is synced under its temporary name, renamed into place,
# then inbox is synced, and only then is the source removed.
set fl [log_line {fsync 'folders/inbox/\.mv-[0-9]+-[0-9]+' -> ok} first]
set nl [log_line {rename 'folders/inbox/\.mv-[0-9]+-[0-9]+' -> 'folders/inbox/across\.txt' -> ok} last]
set dl [log_line {fsync 'folders/inbox' -> ok} last]
set rl [log_line {unlink 'folders/work/old\.txt' -> ok} last]
on_mac [expr {$fl >= 0 && $nl > $fl && $dl > $nl && $rl > $dl}] "the app synced the copy (record line $fl), renamed it into place (line $nl), then synced inbox (line $dl), before it removed the source (line $rl)"
lassign [tool_status mv "mv /mnt/mac/folders/work/tree /tmp/mac-tree" leg8c "a tree moved out of a share into the guest"] st why
if {$st != 0 || $why ne ""} {
    lc_fail "a tree moved out of a share gave status $st, '$why' -- not a quiet copy and remove"
}
lc_step "status 0, nothing said: work/tree moved into the guest"
read_ok /tmp/mac-tree/a.txt "TREE FILE A" "the moved tree's file in the guest"
read_ok /tmp/mac-tree/deeper/b.txt "TREE FILE B ONE DEEPER" "the moved tree's file one deeper"
on_mac [expr {![file exists $::W/tree]}] "work/tree is gone, with what it held"
# Out of the read-only share the copy is made and the source cannot be removed: mv says so, fails,
# and leaves both.
lassign [tool_status mv "mv /mnt/mac/folders/docs/readme.txt /tmp/mac-readme.txt" leg8d "a file moved out of the read-only share"] st why
if {$st == 0 || $why ne "cannot remove '/mnt/mac/folders/docs/readme.txt': permission denied"} {
    lc_fail "a file moved out of the read-only share gave status $st, '$why' -- not a copy whose source could not be removed"
}
lc_step "status $st: $why"
on_mac [expr {[read_file $::R/readme.txt] eq "read only words\n"}] "docs/readme.txt is still there, unchanged"
read_ok /tmp/mac-readme.txt "READ ONLY WORDS" "the copy stays in the guest"
on_mac [expr {![mv_left $::W] && ![mv_left $::I]}] "no .mv- name is left in work or inbox"
lc_pass "ls-mac-folders: a move across devices copies, syncs, renames, then removes: a guest file into a share, a file between two shares with its time and mode, a tree into the guest; out of the read-only share the copy stays and the source cannot be removed"

# ---- 9. rm -r removes a link in a tree, never what it names. work/rmtree holds `link -> ../keep`;
# a removal that followed it would empty work/keep through it.
lassign [tool_status rm "rm -r /mnt/mac/folders/work/rmtree" leg9 "rm -r of a tree holding a link to a directory"] st why
if {$st != 0 || $why ne ""} {
    lc_fail "rm -r of a tree holding a link to a directory gave status $st, '$why'"
}
on_mac [expr {![file exists $::W/rmtree]}] "work/rmtree is gone"
on_mac [expr {[read_file $::W/keep/kept.txt] eq "kept beside the tree\n"}] "work/keep/kept.txt, in the directory the link named, is still there"
# Vote M21, from the app's record: rm opened work/rmtree once, from work's handle, and each entry
# from rmtree's own; a walk by path comes down to rmtree again for each entry.
set n [llength [lsearch -all -regexp [split [app_log] "\n"] {walk .*\['rmtree'\]}]]
on_mac [expr {$n == 1}] "rm walked to rmtree once and to its entries from its handle (walks naming rmtree: $n)"
lassign [tool_status rm "rm /mnt/mac/folders/work/dirlink" leg9b "rm of a link to a directory"] st why
if {$st != 0 || $why ne ""} {
    lc_fail "rm of a link to a directory gave status $st, '$why' -- not the link removed"
}
on_mac [catch {file lstat $::W/dirlink dl}] "work/dirlink, the link, is gone"
on_mac [expr {[read_file $::W/keep/kept.txt] eq "kept beside the tree\n"}] "work/keep/kept.txt, in the directory it named, is still there"
lc_pass "ls-mac-folders: rm -r removes a link in a tree, never the directory it names; rm removes a link to a directory itself"

# ---- 10. what must not happen leaves everything as it was. `nested` is work/sub shared again, so
# the two names below are one host file: the app gives it one identity whichever share reaches it,
# and mv and cp refuse it as the same file (the rename between two shares is the app's EXDEV, so
# mv examines both). A truncating cp would empty it.
set ::same "'/mnt/mac/folders/work/sub/inner.txt' and '/mnt/mac/folders/nested/inner.txt' are the same file"
lassign [tool_status mv "mv /mnt/mac/folders/work/sub/inner.txt /mnt/mac/folders/nested/inner.txt" leg10a "a file moved onto itself through two shares"] st why
if {$st == 0 || $why ne $::same} {
    lc_fail "a file moved onto itself through two shares gave status $st, '$why' -- not refused as the same file"
}
lc_step "status $st: $why"
on_mac [expr {[read_file $::W/sub/inner.txt] eq "inner file two deep\n"}] "work/sub/inner.txt keeps its words"
lassign [tool_status cp "cp /mnt/mac/folders/work/sub/inner.txt /mnt/mac/folders/nested/inner.txt" leg10b "a file copied onto itself through two shares"] st why
if {$st == 0 || $why ne $::same} {
    lc_fail "a file copied onto itself through two shares gave status $st, '$why' -- not refused as the same file"
}
lc_step "status $st: $why"
on_mac [expr {[read_file $::W/sub/inner.txt] eq "inner file two deep\n"}] "work/sub/inner.txt keeps its words, not truncated"
# /srv/mac is a regular file until it is opened; the open attaches a session, whose root is a
# directory, and mv refuses what the open handle says.
lassign [tool_status mv "mv /srv/mac /mnt/mac/folders/work/srvcopy" leg10c "a service moved into a share"] st why
if {$st == 0 || $why ne "cannot copy special file '/srv/mac'"} {
    lc_fail "a service moved into a share gave status $st, '$why' -- not refused as a special file"
}
lc_step "status $st: $why"
on_mac [expr {![file exists $::W/srvcopy]}] "work/srvcopy was never made"
# A copy that fails: the destination exists and must survive it (vote M19: mv never removes it
# first), and the source stays.
lassign [tool_status mv "mv /mnt/mac/folders/work/unreadable.txt /mnt/mac/folders/inbox/over.txt" leg10d "an unreadable file moved over an existing one"] st why
if {$st == 0 || $why ne "cannot open '/mnt/mac/folders/work/unreadable.txt' for reading: permission denied"} {
    lc_fail "an unreadable file moved over an existing one gave status $st, '$why' -- not a copy refused at its open"
}
lc_step "status $st: $why"
on_mac [expr {[read_file $::I/over.txt] eq "inbox over words\n"}] "inbox/over.txt, the destination, holds its own words"
on_mac [file exists $::W/unreadable.txt] "work/unreadable.txt, the source, is still there"
# A read-only tree whose copy fails part way: the copy's directory stays the owner's 0700 until a
# whole copy is finished, so mv can remove it (round 2 F11).
lassign [tool_status mv "mv /mnt/mac/folders/work/locked /mnt/mac/folders/inbox/locked" leg10e "a read-only tree holding an unreadable file moved between shares"] st why
if {$st == 0 || $why ne "cannot open '/mnt/mac/folders/work/locked/unreadable.txt' for reading: permission denied"} {
    lc_fail "a read-only tree holding an unreadable file gave status $st, '$why' -- not a copy refused at that file's open"
}
lc_step "status $st: $why"
on_mac [expr {![file exists $::I/locked]}] "inbox/locked was never made"
on_mac [expr {[read_file $::W/locked/ok.txt] eq "ok in a locked tree\n" && [file exists $::W/locked/unreadable.txt]}] "work/locked keeps both its files"
on_mac [expr {![mv_left $::W] && ![mv_left $::I]}] "no .mv- name is left in work or inbox"
lc_pass "ls-mac-folders: mv and cp refuse one file through two shares, mv refuses a service, and a failed move leaves the source and the destination as they were and nothing of its own"

lc_quit
