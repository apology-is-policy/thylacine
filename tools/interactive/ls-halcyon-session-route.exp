#!/usr/bin/expect -f
# A session compositor's login does not route the console renderer's place channel.
#
# login gives the bare `halcyon` name to the shell that runs on the console and to no
# session compositor (docs/SRV-SESSION-REGISTRY-DESIGN.md, the November 12 paragraphs):
# a pane's programs have the session's own place address, and `view` without one must
# find no console channel to fall back to. A routed name walks even while its service is
# offline, so `stat` of it succeeds; a name the view does not route has nothing to walk
# to. The pane's shell runs `stat`, and the Instrument bar's log line carries the exit
# status to the serial log.
#
# Two controls, because the claim is a failure: `false` shows that the bar reports a
# failing command at all, and `stat` of a resident route shows that a routed name does
# stat from this pane. Without the second, a `stat` broken for any other reason would
# pass for the missing route.
#
# Image: THYLACINE_HALCYON_SESSION=1 THYLACINE_HALCYON_PROFILE=instrument
#        tools/build.sh kernel --config ci
set ::env(THYLACINE_ACCEL) [expr {[info exists ::env(LS_CI_GFX_ACCEL)] ? $::env(LS_CI_GFX_ACCEL) : "hvf"}]
source [file join [file dirname [info script]] lib.exp]
set repo $lc_repo
set qmp [lc_qmp_sock]
proc type {text} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp $text} e]} { lc_fail $e }
}
# The bar's line for a command that has ended: `want` is Ok or Err.
proc bar_ended {want what} {
    set status [expr {$want eq "Ok" ? "0" : "\[1-9\]\[0-9\]*"}]
    expect {
        -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*condition $want \[^\\r\\n\]*exit $status \[^\\r\\n\]*running false" {}
        -re {snare:|EXTINCTION:} { lc_extinction_fail $what }
        timeout { lc_fail $what }
        eof { lc_fail "EOF: $what" }
    }
}
lc_boot
set timeout $lc_boot_timeout
expect {
    -ex "Thylacine login: " {}
    -re {EXTINCTION:} { lc_extinction_fail "boot" }
    timeout { lc_fail "no login" }
    eof { lc_fail "EOF before login" }
}
lc_raw_send "michael\r" "login user"
expect {
    -ex "password: " {}
    timeout { lc_fail "no password prompt" }
    eof { lc_fail "EOF before password" }
}
lc_raw_send "correct-horse-battery-staple-v1\r" "login password"
expect {
    -ex "login: session compositor (halcyond) spawned" {}
    -ex "Thylacine textual shell" {
        puts "\nLS-CI SKIP: default (ut) image -- this scenario asks a session compositor's pane.\
 Bake with: THYLACINE_HALCYON_SESSION=1 THYLACINE_HALCYON_PROFILE=instrument tools/build.sh kernel --config ci"
        lc_quit
        exit 77
    }
    timeout { lc_fail "no graphical session" }
    eof { lc_fail "EOF at session start" }
}
set timeout 60
expect {
    -re {halcyond: theme [^\r\n]*; profile (instrument|legacy) } {
        if {$expect_out(1,string) ne "instrument"} {
            puts "\nLS-CI SKIP: legacy status bar -- this scenario reads a command's exit status from the\
 bar's log line, which only the Instrument bar writes when a command ends.\
 Bake with: THYLACINE_HALCYON_SESSION=1 THYLACINE_HALCYON_PROFILE=instrument tools/build.sh kernel --config ci"
            lc_quit
            exit 77
        }
    }
    -re {EXTINCTION:} { lc_extinction_fail "session" }
    timeout { lc_fail "session did not report its graphics profile" }
    eof { lc_fail "EOF before profile" }
}
expect {
    -re {halcyond: status bar [^\r\n]*running false panes 2} {}
    -re {EXTINCTION:} { lc_extinction_fail "session" }
    timeout { lc_fail "welcome and shell did not become ready" }
}
after 1500
set timeout 30
type "false\n"
bar_ended Err "the bar did not report a failing command (`false`): nothing below could be read"
lc_step "saw: the bar reports a failing command"
type "stat /srv/tapestry\n"
bar_ended Ok "stat of a resident route (/srv/tapestry) did not succeed from the pane: a failing stat below would mean nothing"
lc_step "saw: a resident route stats from the pane"
type "stat /srv/halcyon\n"
bar_ended Err "stat /srv/halcyon did not fail in a session compositor's pane: the session's view routes the console place channel"
lc_pass "session route: the pane's view has the resident names and no console place channel"
lc_quit
