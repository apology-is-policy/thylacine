#!/usr/bin/expect -f
# tools/interactive/ls-gfx-dosbox.exp -- the DX-2 (Cryptid) first-light gate.
#
# Mirrors the G-7 ls-gfx-quake acceptance gate: a demanding SDL2 client
# (DOSBox-X) drives the Tapestry stack. Two legs:
#   execution : `dosbox-x -version` prints "DOSBox-X version ..." and exits --
#               proves the 17.6 MB static ET_EXEC runs main() on Thylacine.
#   render    : `dosbox-x` (no args) auto-mounts its internal Z:\ and paints the
#               VGA text screen through output=surface -> the SDL framebuffer
#               path (THYLACINE_CreateWindowFramebuffer/UpdateWindowFramebuffer)
#               -> thyla_tap_present -> the tapestry compositor. First light:
#               Z:\ on the pane. Ctrl-C stops it.
#
# output=surface is DOSBox-X's default on THIS build (C_OPENGL/D3D/TTF all off
# -> GetDefaultOutput() returns "surface", src/output/output_tools.cpp) --
# exactly the software-framebuffer path the SDL_thylacine backend implements.
#
# GATE SOUNDNESS (the DX-2b spurious-green lesson): the color-bucket floor alone
# is NOT a first-light proof -- the aurora CONSOLE (dosbox-x's own log text)
# yields ~12 buckets, so a screendump taken after dosbox-x EXITS passes a naive
# floor while nothing rendered. The load-bearing signal is the log: DOSBox-X
# prints "SDL: version ... Video thylacine, Audio dummy" only AFTER the fatal
# combined SDL_Init(AUDIO|VIDEO|...) succeeds; an audio-backend gap makes that
# init E_Exit ("Can't init SDL") BEFORE any surface. So the render leg gates on
# "Video thylacine" (positive) + fails on E_Exit / a crash / a no-show, then the
# floor is just a "not flat black" sanity check on the presented frame.
#
# HVF posture (the ls-gfx sibling; TCG hangs at the 8a-2b hwwatch E2E, #27).

set ::env(THYLACINE_ACCEL) hvf
source [file join [file dirname [info script]] lib.exp]

set repo $lc_repo
set qmp [lc_qmp_sock]

# Fingerprint a screendump PNG -> "<rolling-hash> <distinct-color-buckets>"
# (RGB quantized to 32-level bins).
proc gfx_fingerprint {png} {
    return [exec python3 [file join [file dirname [info script]] gfx_fp.py] $png]
}

# Screendump via QMP, returning "" on success or the error string.
proc gfx_dump_or_fail {out} {
    global repo qmp
    if {[catch {exec $repo/tools/screendump.sh -s $qmp $out} err]} {
        return $err
    }
    return ""
}

lc_boot
lc_login michael correct-horse-battery-staple-v1

# --- execution leg: does the binary run + print + exit?
lc_send "dosbox-x -version"
set timeout 60
expect {
    -re {DOSBox-X version ([0-9.]+)} {
        lc_pass "dosbox-x executes: version $expect_out(1,string) (17.6 MB static ET_EXEC runs main() on Thylacine)"
    }
    "snare:" { lc_fail "dosbox-x -version faulted (snare)" }
    "user fault" { lc_fail "dosbox-x -version user fault" }
    -re {not found|No such} { lc_fail "dosbox-x not in the namespace (ramfs staging?)" }
    timeout { lc_fail "no version line within 60s" }
}

# --- render leg: does graphical dosbox-x paint the DOS screen to the scanout?
# Foreground run: dosbox-x reads keyboard from the Tapestry path, not the
# console, so the console stays free for the log-based fault-watch while the
# shell blocks on it.
set dbx_render_png $repo/build/ls-gfx-dosbox-render.png
# "Not flat black" backstop on the presented frame (measured: the DOSBox-X
# welcome screen yields ~24 buckets; the aurora console alone ~12; a resize-loop
# inactive scanout ~2). The LOAD-BEARING proof is the "Video thylacine" + the
# "COMMAND.COM" log arms below, not this number (see GATE SOUNDNESS).
set dbx_color_floor 8
lc_send "dosbox-x"
# Positive: "SDL: version ... Video thylacine ..." proves the fatal combined
# SDL_Init succeeded with our driver. Fail fast on E_Exit (the audio-backend
# gap the 0004 patch closes), a crash, a kernel fault, or a no-show.
set timeout 30
expect {
    -re {Video thylacine}       { lc_step "SDL up: thylacine video + dummy audio (past the fatal SDL_Init)" }
    -re {E_Exit|Can't init SDL} { lc_fail "dosbox-x E_Exit during SDL init -- audio/video backend gap (0004 patch missing/regressed?)" }
    "snare:"                    { lc_fail "dosbox-x graphical faulted (snare)" }
    "user fault"                { lc_fail "dosbox-x graphical user fault" }
    -re {EXTINCTION:}           { lc_extinction_fail "kernel extinction while dosbox-x graphical ran" }
    timeout                     { lc_fail "dosbox-x SDL did not come up within 30s (no 'Video thylacine' line)" }
}
# Positive 2: DOSBox-X boots its INTERNAL DOS to the COMMAND.COM shell (the Z:\
# prompt). This is the load-bearing "the DOS is live" proof -- SDL being up is
# not enough, and it closes the spurious-green gap (a screendump taken after
# dosbox-x EXITED would show the console, but an exit trips the death arms here).
set timeout 25
expect {
    -re {COMMAND\.COM}                        { lc_step "DOS booted: COMMAND.COM shell up (Z:\ reached)" }
    -re {user fault|snare:|E_Exit|EXTINCTION:} { lc_fail "dosbox-x died before the internal DOS reached COMMAND.COM" }
    timeout                                    { lc_fail "DOSBox-X did not reach the COMMAND.COM DOS shell within 25s" }
}
# Settle: let the VGA text screen present to the scanout, watching for a late death.
set timeout 6
expect {
    -re {user fault|snare:|E_Exit|EXTINCTION:} { lc_fail "dosbox-x died after reaching the DOS shell, before the scanout settled" }
    timeout { lc_step "dosbox-x rendering the DOS screen (no death in the settle window)" }
}

if {[gfx_dump_or_fail $dbx_render_png] ne ""} { lc_fail "screendump failed" }
set fp [gfx_fingerprint $dbx_render_png]
set c [lindex $fp 1]
lc_step "render: $c distinct color buckets in the scanout ($dbx_render_png)"
if {$c < $dbx_color_floor} {
    lc_fail "too few colors ($c < $dbx_color_floor) -- the DOS screen is not on the scanout (flat/black surface?)"
}

# Stop it: the console Ctrl-C cooks to the `interrupt` note -> the foreground
# process group (dosbox-x). Best-effort clean stop; lc_quit is the backstop.
lc_ctrlc
after 1500
lc_pass "dosbox-x's DOS screen on the scanout ($c color buckets; output=surface -> SDL framebuffer -> tapestry)"

lc_quit
lc_pass "ls-gfx-dosbox: the DX-2 Cryptid first-light gate verified"
exit 0
