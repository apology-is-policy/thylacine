#!/usr/bin/expect -f
# ls-graphical-sak-chain -- a client's draws in flight must not deny the
# graphical SAK (I-27; vote 50's audit, rounds 1 and 2).
#
# warp-prove chain-hold keeps about a second of full-screen draws on the device,
# as a client rendering without pause does. Those draws sit on the host's FIFO
# ahead of anything the trusted seat submits after the chord, so this is the
# case a poisoned slot with nothing on the device cannot show. The chord must
# still bring up the trusted screen. Control: the same chord and the same empty
# episode with no client, one variable away.
#
# A green needs a takeover that reached the device with chains on it, which lictor's
# line counts. A chord that lands while the compositor's own synchronous step drains
# the queue paints on an empty FIFO and tests nothing, so this takes chords until one
# has found chains, and a run in which none did is inconclusive, not a pass. A stall,
# if the paint met one, is reported and forbidden in the control; the retry's own
# witness is ls-graphical-sak-dead, by lever.
#
# The readback leg is the same chord with a transfer of the busy target always in
# flight, and it proves only that the seat comes through that: the wide wait can drain
# the queue before the chord is seen. The pointer leg moves the pointer behind that
# transfer, and tapestryd must retry an update it was refused and have it taken again.
# QEMU runs the cursor queue apart from the GL work a client queued, so on virgl a move
# is refused by the engine's stall rather than its own lane's: the lane's own stall is
# reported, and required to come back when it happens. The dead scenario's lever drives
# that lane on every boot.
#
# Each client ends before a witness types, because keys typed behind its queue can
# be lost.
#
# Needs a ctx, so a virgl device, and the session compositor. From the remote
# repo: THYLACINE_GPU_DEV=virtio-gpu-gl-pci THYLACINE_DISPLAY=egl-headless
# THYLACINE_EGL_VNC_SOCKET=/tmp/sak-vnc.sock LS_CI_JOBS=1
# tools/test-interactive.sh ls-graphical-sak-chain
set ::env(THYLACINE_ACCEL) [expr {[info exists ::env(LS_CI_GFX_ACCEL)] ? $::env(LS_CI_GFX_ACCEL) : "hvf"}]
set ::env(THYLACINE_SERIAL_SAK) 0
source [file join [file dirname [info script]] lib.exp]
if {![info exists ::env(THYLACINE_GPU_DEV)] || ![string match virtio-gpu-gl* $::env(THYLACINE_GPU_DEV)]} {
    puts "\nLS-CI SKIP: this scenario needs a warp ctx, so a virgl device (THYLACINE_GPU_DEV=virtio-gpu-gl-pci)"
    exit 77
}
if {![info exists ::env(THYLACINE_EGL_VNC_SOCKET)]} {
    puts "\nLS-CI SKIP: this scenario reads the glass through egl-headless's VNC socket (THYLACINE_EGL_VNC_SOCKET)"
    exit 77
}
set repo $lc_repo
set qmp [lc_qmp_sock]

proc key {chord} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k $chord} e]} { lc_fail $e }
    after 700
}
proc type {text} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp $text} e]} { lc_fail $e }
}
proc witness {stage} {
    type "caps-probe --seat-$stage\n"
    global timeout
    set timeout 60
    expect {
        -ex "seat-probe: PASS $stage (endpoint denied; GPU denied; DAC verified)" { lc_pass "seat $stage authority" }
        -ex "seat-probe: FAIL" { lc_fail "guest authority witness failed ($stage)" }
        -re {EXTINCTION:} { lc_extinction_fail "seat $stage" }
        timeout { lc_fail "no authority witness ($stage)" }
        eof { lc_fail "EOF ($stage)" }
    }
}
# How much of the glass is the trusted screen's ground. Lictor's line says what it
# asked the device for; this reads what reached the glass.
proc ground {name} {
    global repo
    after 1000
    set out [file join $repo build sak-chain-$name.png]
    if {[catch {exec python3 $repo/tools/interactive/vnc_capture.py $::env(THYLACINE_EGL_VNC_SOCKET) $out} e]} { lc_fail $e }
    if {[catch {exec python3 $repo/tools/interactive/sak_glass.py $repo/usr/lictor/src/render.rs $out} r]} { lc_fail $r }
    if {![regexp {^ground ([0-9]+)\n(.*)$} $r -> pct top]} { lc_fail "an unread capture: $r" }
    set ::glass_top [lindex [split $top :] 0]
    lc_pass "SAK-CHAIN glass $name ground=$pct% $top"
    return $pct
}
# The workspace back on the glass: not the trusted ground, and not a dark output or a
# frozen frame either, which read as no ground too.
proc back {name} {
    if {[ground $name] > 5} { lc_fail "$name: the workspace did not come back after the episode" }
    if {$::glass_top ne $::workspace_top} { lc_fail "$name: the glass's main colour is $::glass_top, the workspace's is $::workspace_top" }
}
# One chord and one Return, as an empty episode; the takeover must show first, and
# then the episode must end by itself. Corvus prints its end line for a seat that
# failed too, and expect tries arms in list order over everything buffered during the
# capture, so each failure arm comes before the line it would otherwise lose to. The
# client's end can land anywhere in this, in no fixed order with the seat's lines, so
# it shares their alternation. Returns the chains the takeover found; how many times it
# met a stall is left in ::stalls.
proc episode {leg} {
    global timeout
    key "ctrl+alt+f10"
    set timeout 20
    set stalls 0
    set chains -1
    expect {
        -re {lictor: seat failed: [^\r\n]*[\r\n]} {
            lc_fail "SAK-CHAIN RED ($leg): the seat refused the takeover: $expect_out(0,string)"
        }
        -re {lictor: kernel closed trusted seat \(scanout [a-z]+\)} {
            lc_fail "SAK-CHAIN RED ($leg): the episode failed at its deadline: $expect_out(0,string)"
        }
        -re {warp-prove: CHAIN-HOLD END [^\r\n]*[\r\n]|lictor: takeover met a stall, starting over generation=[0-9]+|lictor: trusted scanout active generation=[0-9]+ chains=([0-9]+) took_ms=([0-9]+)} {
            set hit $expect_out(0,string)
            if {[string match "*CHAIN-HOLD END*" $hit]} {
                client_ended $hit
                exp_continue
            }
            if {[string match "*met a stall*" $hit]} {
                incr stalls
                exp_continue
            }
            set chains $expect_out(1,string)
            lc_pass "SAK-CHAIN $leg chains=$chains took_ms=$expect_out(2,string) stalls=$stalls"
        }
        -re {EXTINCTION:} { lc_extinction_fail "takeover ($leg)" }
        timeout { lc_fail "$leg: no takeover and no failure within 20 s of the chord" }
        eof { lc_fail "EOF at the takeover ($leg)" }
    }
    if {[ground $leg] < 30} { lc_fail "SAK-CHAIN RED ($leg): lictor said the scanout is up, and the glass is not the trusted screen" }
    key "ret"
    set timeout 30
    expect {
        -re {lictor: seat failed: [^\r\n]*[\r\n]} {
            lc_fail "$leg: the episode failed after the takeover: $expect_out(0,string)"
        }
        -re {lictor: kernel closed trusted seat \(scanout [a-z]+\)} {
            lc_fail "$leg: the episode failed instead of ending: $expect_out(0,string)"
        }
        -ex "lictor: trusted seat recovered; nothing was conferred" {
            lc_fail "$leg: the seat recovered from a failure instead of ending the episode"
        }
        -re {warp-prove: CHAIN-HOLD END [^\r\n]*[\r\n]|corvus: imperium: SAK with nothing pending} {
            set hit $expect_out(0,string)
            if {[string match "*CHAIN-HOLD END*" $hit]} {
                client_ended $hit
                exp_continue
            }
            lc_step "$leg: the empty episode ended"
        }
        -re {EXTINCTION:} { lc_extinction_fail "the end of the episode ($leg)" }
        timeout { lc_fail "$leg: the episode did not end within 30 s" }
        eof { lc_fail "EOF at the end of the episode ($leg)" }
    }
    after 1500
    set timeout 1
    expect {
        -re {lictor: seat failed: [^\r\n]*[\r\n]} {
            lc_fail "$leg: the seat failed as the episode ended: $expect_out(0,string)"
        }
        -re {lictor: kernel closed trusted seat \(scanout [a-z]+\)} {
            lc_fail "$leg: the kernel closed the seat as the episode ended: $expect_out(0,string)"
        }
        -re {warp-prove: CHAIN-HOLD END [^\r\n]*[\r\n]} {
            client_ended $expect_out(0,string)
            exp_continue
        }
        -re {EXTINCTION:} { lc_extinction_fail "after the episode ($leg)" }
        timeout {}
    }
    set ::stalls $stalls
    return $chains
}
proc client_ended {line} {
    set ::client_gone 1
    lc_pass "SAK-CHAIN client: $line"
}
proc pointer {x y} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -p "abs $x $y"} e]} { lc_fail $e }
}
proc client {args} {
    global timeout
    set ::client_gone 0
    type "warp-prove chain-hold $args &\n"
    set timeout 60
    expect {
        -re {warp-prove: CHAIN-HOLD DEEP ctx [0-9]+ sent [0-9]+ retired [0-9]+ refused [0-9]+ after [0-9]+ ms} {
            lc_pass "SAK-CHAIN client: $expect_out(0,string)"
        }
        -re {warp-prove: FAIL[^\r\n]*[\r\n]} { lc_fail "the client failed: $expect_out(0,string)" }
        -re {EXTINCTION:} { lc_extinction_fail "starting the client" }
        timeout { lc_fail "the client reported no full queue within 60 s of chain-hold" }
        eof { lc_fail "EOF starting the client" }
    }
}
proc client_end {} {
    global timeout
    if {$::client_gone} { return }
    set timeout 120
    expect {
        -re {warp-prove: CHAIN-HOLD END [^\r\n]*[\r\n]} { lc_pass "SAK-CHAIN client: $expect_out(0,string)" }
        -re {warp-prove: FAIL[^\r\n]*[\r\n]} { lc_fail "the client failed: $expect_out(0,string)" }
        -re {EXTINCTION:} { lc_extinction_fail "ending the client" }
        timeout { lc_fail "the client did not end within 120 s" }
        eof { lc_fail "EOF ending the client" }
    }
}
lc_boot
set timeout $lc_boot_timeout
expect {
    -ex "Thylacine login: " {}
    -re {EXTINCTION:} { lc_extinction_fail "boot" }
    timeout { lc_fail "no login" }
    eof { lc_fail "EOF before login" }
}
lc_raw_send "michael\r" "login user"
expect {
    -ex "password: " {}
    timeout { lc_fail "no password prompt" }
    eof { lc_fail "EOF before password" }
}
lc_raw_send "correct-horse-battery-staple-v1\r" "login password"
expect {
    -ex "login: session compositor (halcyond) spawned" {}
    -ex "Thylacine textual shell" {
        puts "\nLS-CI SKIP: default (ut) image -- this scenario drives the session\
 compositor. Bake with: THYLACINE_HALCYON_SESSION=1 THYLACINE_HALCYON_PROFILE=instrument tools/build.sh kernel --config ci"
        lc_quit
        exit 77
    }
    timeout { lc_fail "no graphical session" }
    eof { lc_fail "EOF at session start" }
}
set timeout 60
expect {
    -re {halcyond: status bar [^\r\n]*running false panes 2} {}
    -re {EXTINCTION:} { lc_extinction_fail "session" }
    timeout { lc_fail "welcome and shell did not become ready" }
}
after 1500
key "meta_l+f"
witness baseline
if {[ground workspace] > 5} { lc_fail "the workspace reads as the trusted screen, so the glass check tells nothing" }
set ::workspace_top $::glass_top
set ::client_gone 1

episode control
if {$::stalls != 0} { lc_fail "a takeover with no client met a stall, so this control tells nothing" }
witness control
back restored

client 45
set met 0
for {set i 1} {$i <= 6 && !$met && !$::client_gone} {incr i} {
    if {[episode chain$i] > 0} { set met 1 }
    back chain$i-restored
}
client_end
if {!$met} { lc_fail "SAK-CHAIN INCONCLUSIVE: none of the chords found a client's chain on the device" }
witness chain

client 12 readback
episode readback
back readback-restored
client_end
witness readback

client 20 readback
# These lines come from three processes in no fixed order, so one alternation: the
# earliest in the buffer wins, and no line is lost to a later one that matched first.
proc pointer_saw {hit} {
    if {[string match "*missed*" $hit]} { set ::stalled 1 }
    if {[string match "*refused*" $hit]} { set ::refused 1 }
    if {[string match "*revived*" $hit]} { set ::revived 1 }
    if {[string match "*accepted*" $hit]} { set ::accepted 1 }
    if {[string match "*CHAIN-HOLD END*" $hit]} {
        set ::ended 1
        lc_pass "SAK-CHAIN client: $hit"
    }
}
set pointer_lines {lictor: cursor chain missed its [0-9]+ ms deadline|tapestryd: pointer backend refused an update; retrying|cursor queue revived|tapestryd: pointer backend accepted an update again|warp-prove: CHAIN-HOLD END [^\r\n]*[\r\n]}
set stalled 0
set refused 0
set revived 0
set accepted 0
set ended 0
set timeout 1
for {set i 0} {$i < 40 && !$refused} {incr i} {
    pointer [expr {2000 + $i * 500}] 8000
    expect {
        -re {cursor queue (abandoned|failed)} { lc_fail "pointer: the cursor queue did not survive a client's readback" }
        -re {warp-prove: FAIL[^\r\n]*[\r\n]} { lc_fail "the client failed: $expect_out(0,string)" }
        -re {EXTINCTION:} { lc_extinction_fail "the pointer behind a readback" }
        -re $pointer_lines {
            pointer_saw $expect_out(0,string)
            exp_continue
        }
        timeout {}
        eof { lc_fail "EOF at the pointer" }
    }
}
if {!$refused} { lc_fail "SAK-CHAIN INCONCLUSIVE (pointer): no pointer update behind the client's readback was refused (lane stalled=$stalled)" }
lc_pass "SAK-CHAIN pointer: an update behind a readback was refused (lane stalled=$stalled)"
# A client's end may have come already, so the update owed after it is sent when both
# are known.
set timeout 60
set nudged 0
while {!($ended && $accepted)} {
    if {$ended && !$nudged} {
        set nudged 1
        pointer 9000 9000
    }
    expect {
    -re {cursor queue (abandoned|failed)} { lc_fail "pointer: the cursor queue did not survive a client's readback" }
    -re {warp-prove: FAIL[^\r\n]*[\r\n]} { lc_fail "the client failed: $expect_out(0,string)" }
    -re {EXTINCTION:} { lc_extinction_fail "the pointer's revival" }
    -re $pointer_lines { pointer_saw $expect_out(0,string) }
    timeout { lc_fail "pointer: within 60 s: revived=$revived accepted=$accepted ended=$ended" }
    eof { lc_fail "EOF at the pointer's revival" }
    }
}
if {$stalled && !$revived} { lc_fail "pointer: the update was accepted, but lictor never said the stalled lane revived" }
after 1500
witness pointer
lc_pass "graphical SAK: the trusted screen came up behind another client's draws in flight"
lc_quit
exit 0
