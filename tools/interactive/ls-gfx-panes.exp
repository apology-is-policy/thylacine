#!/usr/bin/expect -f
# tools/interactive/ls-gfx-panes.exp -- the G-6 compositor acceptance leg
# (TAPESTRY.md 18.9: "the acceptance battery on synthetic clients").
#
# Drives /bin/tapestry-battery in the session foreground and asserts the
# views agree:
#   focus event: TEV_FOCUS gained arrives at host-at-create (G-6c);
#   structural : the battery's own in-guest asserts (layout text vs the
#                pane geometry files; disjoint nonzero rects);
#   pixels     : screendump -P + tools/ppm-sample.py at coordinates the
#                battery prints, one dump per stage (each stage holds the
#                screen static ~1.5 s);
#   resize     : the 18.3 protocol (G-6b) -- ack negative probes, then B
#                reweaves onto its pane's exact size;
#   multirect  : ONE present carrying TWO rects (G-6c) -- green + yellow
#                quarter points both land (a rect0-only server leaves
#                the right half blue);
#   tabbed     : the D7 glyph-free strip (G-6c) -- segment colors exact
#                (inactive BORDER, focused-active FOCUS) + `tab next`;
#   zoom       : the focused pane alone at full display (direct scanout;
#                corner pixel red), then restored (G-6c);
#   move       : directional re-parenting (D6/G-6c) -- pull-out + swap,
#                pixel-verified at the new centers;
#   input      : QMP-typed keys arrive on the FOCUSED surface's stream
#                only (focus leg A via the layout file, leg B via B's
#                own pane ctl);
#   chord      : QMP Super+Left is intercepted ABOVE the event stream
#                (18.4) -- focus moves compositor-side, the arrow never
#                reaches a surface (G-6c);
#   rel        : a QMP `rel` frame reaches the focused surface as ONE
#                exact TEV_PTR_REL (virtio-mouse claim + classify +
#                drain + focused routing), and two abs injections
#                synthesize the exact display-delta twin (the cocoa
#                mouse-look path);
#   test-mode  : the 18.6 determinism mode -- frozen FRAME clock + the
#                `tick` drive (G-6c, in-guest asserts);
#   hold       : TPRESENT_HOLD + release (G-6c) -- B stays blue on
#                screen with magenta already presented; release flips
#                it (two dumps bracket the release);
#   close      : a compositor-initiated pane close delivers TEV_CLOSE
#                (G-6b); the surface retires only when the client drops.
# The coda proves teardown: the battery exits, its panes collapse, the
# console returns to fullscreen direct scanout, and the -c console verify
# passes again.
#
# Runs under HVF (the gfx-scenario medium; TCG hangs at the pre-existing
# 8a-2b hwwatch E2E, task #27). Needs the QMP socket + python3; GPU-less
# boots use the standing THYLACINE_NO_GPU escape.

set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

set repo $lc_repo
set qmp [lc_qmp_sock]

proc gfx_dump {out args_} {
    global repo qmp
    if {[catch {exec $repo/tools/screendump.sh -s $qmp {*}$args_ $out} err]} {
        return $err
    }
    return ""
}

# Dump a PPM and assert one pixel; fails the run on mismatch.
proc gfx_sample {tag x y want} {
    global repo
    set ppm /tmp/ls-gfx-panes-$tag.ppm
    if {[gfx_dump $ppm "-P"] ne ""} { lc_fail "$tag: PPM capture failed" }
    set rgba [exec $repo/tools/ppm-sample.py $ppm $x $y]
    if {$rgba ne $want} { lc_fail "$tag: pixel ($x,$y) = '$rgba', want '$want'" }
}

lc_boot
lc_login michael correct-horse-battery-staple-v1

# Anchor: the fullscreen console renders before the battery perturbs it.
set ok 0
for {set i 0} {$i < 12} {incr i} {
    if {[gfx_dump /tmp/ls-gfx-panes-pre.png "-c"] eq ""} { set ok 1; break }
    after 700
}
if {!$ok} { lc_fail "pre-battery console verify (-c) never passed" }
lc_pass "panes: pre-battery console verified"

# The battery (foreground; its say! lines land on the serial tee).
lc_send "tapestry-battery"
set timeout 45

# G-6c: TEV_FOCUS gained at A's host-at-create.
expect {
    -ex "battery: focus event OK" { lc_pass "panes: TEV_FOCUS gained at create" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "battery focus-event leg failed" }
    timeout { lc_fail "battery never reached the focus event" }
    eof { lc_fail "qemu exited during the battery" }
}

expect {
    -ex "battery: console leaf tiled" { lc_pass "panes: the console leaf keeps a real column under an UNDECLARED client" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the undeclared-client control failed" }
    timeout { lc_fail "the undeclared-client control never reported" }
    eof { lc_fail "qemu exited during the battery" }
}
expect {
    -ex "tapestry-battery: structure OK" { lc_pass "panes: in-guest structure asserts OK" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "battery structure legs failed" }
    timeout { lc_fail "battery never reached structure OK" }
    eof { lc_fail "qemu exited during the battery" }
}

# Stage 1 pixels: A solid red (crop posture), B solid blue.
expect {
    -re {battery: stage1 centers (\d+) (\d+) (\d+) (\d+)\r?\n} {
        set ax $expect_out(1,string)
        set ay $expect_out(2,string)
        set bx $expect_out(3,string)
        set by $expect_out(4,string)
    }
    timeout { lc_fail "no stage1 centers line" }
}
gfx_sample stage1a $ax $ay "255 0 0"
gfx_sample stage1b $bx $by "0 0 255"
lc_pass "panes: composed pixels exact at both centers (A red, B blue)"

# H-3b-1: the per-leaf Daylight tag bar renders header-bg (the resting
# fallback, before a halcyond chrome surface binds). Positive witness: the
# `tagbar` 9P file reports A's strip and its centre reads Daylight `header`
# (0xCEC4B6 = 206 196 182).
expect {
    -re {battery: tagbar A (\d+) (\d+)\r?\n} {
        set tbx $expect_out(1,string)
        set tby $expect_out(2,string)
    }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the tagbar leg failed" }
    timeout { lc_fail "no tagbar A line" }
}
gfx_sample tagbarA $tbx $tby "206 196 182"
lc_pass "panes: per-leaf tag bar renders Daylight header-bg"

# H-3b-2: the chrome-create gate (surface ctl `create W H role=chrome bind=<id>`):
# malformed -> E_INVAL for every peer; well-formed chrome from a NON-renderer
# (this battery) -> E_PERM. The positive twin (the same line from halcyond,
# composited at the tag bar) is ls-halcyon's at H-3b-3.
expect {
    -ex "battery: chrome-create gate OK" { lc_pass "panes: chrome-create gate discriminates (E_INVAL syntax / E_PERM non-renderer; + the H-3d status role)" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the chrome-create gate leg failed" }
    timeout { lc_fail "battery never reached the chrome-create gate" }
}

# H-3d: the status bar is a display-level chrome surface (`role=status`, no
# bind, renderer-gated -- probed in the gate above); with no renderer bar the
# compositor's `statusbar` file reads zeros. The positive twin (a real bar's
# rect + the carve it makes) is ls-halcyon's at H-3d-3.
expect {
    -ex "battery: statusbar file reads empty (no bar)" { lc_pass "panes: the statusbar file exists and reads empty with no renderer bar" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the statusbar file leg failed" }
    timeout { lc_fail "battery never reached the statusbar file read" }
}

# H-3b-4: the tile-status verb (global ctl `tag <id> status ok|err|resting`)
# is gated: a NON-renderer's write is refused (E_PERM) and the pane's
# `status` file -- an ungated read -- still says `resting` after it (the
# refusal did not apply). The positive twin (halcyond keying its live tile
# sage/cinnabar) is ls-halcyon's.
expect {
    -ex "battery: tag-status gate OK" { lc_pass "panes: tag-status gate refuses a non-renderer (E_PERM; state unchanged)" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the tag-status gate leg failed" }
    timeout { lc_fail "battery never reached the tag-status gate" }
}

# H-3c: the menu verbs (`menu place` / `menu dismiss`) are gated like the
# tile status -- a NON-renderer is refused whatever it writes, and the
# `ctl` read shows `menu none` afterwards. The positive twin (halcyond
# summoning a menu, the compositor dismissing it against a wedged owner)
# is ls-halcyon's.
expect {
    -ex "battery: menu gate OK" { lc_pass "panes: menu gate refuses place/dismiss from a non-renderer (E_PERM; none placed)" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the menu gate leg failed" }
    timeout { lc_fail "battery never reached the menu gate" }
}

# The pane tree's trust model (the H-3b round F2): a client acts only on
# what it owns. From the battery, `close` / `focus` / a `tag` write on the
# console renderer's pane are E_PERM and the pane is intact; `focus` on its
# own pane succeeds. A headless SKIP line is a failure here: this image has
# a console.
expect {
    -ex "battery: pane-tree gate OK" { lc_pass "panes: pane-tree gate refuses close/focus/tag on a foreign pane (E_PERM; tree intact); own pane ok" }
    -ex "battery: pane-tree gate SKIPPED" { lc_fail "the pane-tree gate leg found no foreign pane on an image with a console" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the pane-tree gate leg failed" }
    timeout { lc_fail "battery never reached the pane-tree gate" }
}

# Scenario 2 (G-6b): the resize protocol.
expect {
    -ex "battery: resize rejects OK" { lc_pass "panes: resize-ack negative probes OK" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "resize negative probes failed" }
    timeout { lc_fail "battery never reached the resize probes" }
}
expect {
    -re {battery: resize OK (\d+) (\d+)\r?\n} {
        lc_pass "panes: B reweaved to $expect_out(1,string)x$expect_out(2,string) (exact pane fit)"
    }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the reweave leg failed" }
    timeout { lc_fail "battery never completed the reweave" }
}

# Scenario 2b (G-6c): the multi-rect present -- both halves must land.
expect {
    -re {battery: multirect ready (\d+) (\d+) (\d+) (\d+)\r?\n} {
        set gx $expect_out(1,string)
        set gy $expect_out(2,string)
        set yx $expect_out(3,string)
        set yy $expect_out(4,string)
    }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the multirect leg failed" }
    timeout { lc_fail "battery never reached multirect" }
}
gfx_sample mrg $gx $gy "0 255 0"
gfx_sample mry $yx $yy "255 255 0"
lc_pass "panes: multi-rect present painted both halves (green + yellow)"

# Scenario 2c (G-6c): the tabbed strip -- glyph-free segment colors.
expect {
    -re {battery: tabbed ready (\d+) (\d+) (\d+)\r?\n} {
        set sy $expect_out(1,string)
        set sax $expect_out(2,string)
        set sbx $expect_out(3,string)
    }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the tabbed leg failed" }
    timeout { lc_fail "battery never reached tabbed" }
}
gfx_sample tabA $sax $sy "206 196 182"
gfx_sample tabB $sbx $sy "224 120 64"
lc_pass "panes: tab strip segments exact (Daylight: inactive header, active-focused ember)"
expect {
    -ex "battery: tab cycled" { lc_pass "panes: tab next cycled the active child" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the tab-cycle leg failed" }
    timeout { lc_fail "battery never cycled the tab" }
}

# Scenario 2d (G-6c): zoom -- A alone at full display (direct scanout).
expect {
    -ex "battery: zoom ready" {}
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the zoom leg failed" }
    timeout { lc_fail "battery never reached zoom" }
}
gfx_sample zoom 3 3 "255 0 0"
lc_pass "panes: zoomed pane fills the display (corner red)"
expect {
    -ex "battery: zoom restored" { lc_pass "panes: unzoom restored the layout exactly" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the unzoom leg failed" }
    timeout { lc_fail "battery never restored from zoom" }
}

# Scenario 2e (G-6c): directional move -- pixel-verified at new centers.
expect {
    -re {battery: move OK (\d+) (\d+) (\d+) (\d+)\r?\n} {
        set max_ $expect_out(1,string)
        set may_ $expect_out(2,string)
        set mbx $expect_out(3,string)
        set mby $expect_out(4,string)
    }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the move leg failed" }
    timeout { lc_fail "battery never completed the moves" }
}
gfx_sample moveA $max_ $may_ "255 0 0"
gfx_sample moveB $mbx $mby "0 0 255"
lc_pass "panes: directional move re-parented (A red, B blue at new centers)"

# Focus leg A: the typed key must arrive on A's stream (the battery waits
# there; a mis-route hangs it into its budget FAIL).
expect {
    -ex "tapestry-battery: panes ready" {}
    timeout { lc_fail "battery never reached panes ready" }
}
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp "x"} err]} {
    lc_fail "qmp-sendtext (leg A) failed: $err"
}
expect {
    -ex "battery: A key" { lc_pass "panes: focused-leaf routing (leg A)" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "battery focus leg A failed" }
    timeout { lc_fail "key never arrived on A (focus routing broken)" }
}
expect {
    -ex "tapestry-battery: focus B" {}
    timeout { lc_fail "battery never switched focus to B" }
}
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp "y"} err]} {
    lc_fail "qmp-sendtext (leg B) failed: $err"
}
expect {
    -ex "battery: B key" { lc_pass "panes: focus switch via pane ctl (leg B)" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "battery focus leg B failed" }
    timeout { lc_fail "key never arrived on B (pane-ctl focus broken)" }
}

# The chord leg (G-6c): Super+Left moves focus compositor-side; the arrow
# never reaches a surface.
expect {
    -ex "battery: chord ready" {}
    -ex "tapestry-battery: FAIL" { lc_fail_detail "battery died before the chord leg" }
    timeout { lc_fail "battery never reached the chord leg" }
}
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k "meta_l+left"} err]} {
    lc_fail "qmp-sendtext chord failed: $err"
}
expect {
    -ex "battery: chord focus OK" { lc_pass "panes: Super chord intercepted + focus moved (18.4)" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the chord leg failed" }
    timeout { lc_fail "the chord never moved focus" }
}

# The rel legs (the relative-mouse arc): leg 1 -- a QMP `rel` frame
# routes to the virtio-mouse uniquely (the tablet's handler masks
# BTN|ABS only) and must arrive as ONE exact TEV_PTR_REL on the focused
# surface. Leg 2 -- the abs-synthesis twin (the cocoa mouse-look path):
# two tablet abs at the same Y; the first seeds the delta base, the
# second arrives as the exact display delta: px(v) = v*1279/32767, so
# px(20480)-px(16384) = 799-639 = 160.
expect {
    -ex "battery: rel ready" {}
    -ex "tapestry-battery: FAIL" { lc_fail_detail "battery died before the rel leg" }
    timeout { lc_fail "battery never reached the rel leg" }
}
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -p "rel 7 3"} err]} {
    lc_fail "qmp-sendtext rel failed: $err"
}
expect {
    -ex "battery: rel OK 7 3" { lc_pass "panes: mouse rel delivered exact (7,3) to the focused surface" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the mouse rel leg failed" }
    timeout { lc_fail "the mouse rel never arrived" }
}
expect {
    -ex "battery: relsynth ready" {}
    timeout { lc_fail "battery never reached the rel-synthesis leg" }
}
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -p "abs 16384 16384"} err]} {
    lc_fail "qmp-sendtext abs (seed) failed: $err"
}
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -p "abs 20480 16384"} err]} {
    lc_fail "qmp-sendtext abs (delta) failed: $err"
}
expect {
    -ex "battery: relsynth OK 160" { lc_pass "panes: abs motion synthesized the exact rel twin (dx=160)" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the rel-synthesis leg failed" }
    timeout { lc_fail "the synthesized rel never arrived" }
}

# The test-mode leg (18.6): in-guest frozen-clock + tick asserts.
expect {
    -ex "battery: test-mode OK" { lc_pass "panes: test-mode freezes the clock; tick drives it" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the test-mode leg failed" }
    timeout { lc_fail "battery never completed test-mode" }
}

# The cfg-3 apply-authority gate leg: the battery (NOT the console
# renderer) must be REFUSED the authority verbs (mode, clock-rate) on the
# very conn whose ctl read + determinism verbs just worked above.
expect {
    -ex "battery: gate OK" { lc_pass "panes: authority verbs refused for a non-renderer conn" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the apply-authority gate leg failed" }
    timeout { lc_fail "battery never completed the gate leg" }
}

# The hold leg (TPRESENT_HOLD + release): B is magenta-presented but the
# screen must still show blue until the release.
expect {
    -re {battery: hold ready (\d+) (\d+)\r?\n} {
        set hbx $expect_out(1,string)
        set hby $expect_out(2,string)
    }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the hold present failed" }
    timeout { lc_fail "battery never reached hold" }
}
gfx_sample holdpre $hbx $hby "0 0 255"
lc_pass "panes: held present deferred (B still blue on screen)"
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp "z"} err]} {
    lc_fail "qmp-sendtext (hold sync) failed: $err"
}
expect {
    -ex "battery: released" {}
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the release failed" }
    timeout { lc_fail "battery never released the hold" }
}
gfx_sample holdpost $hbx $hby "255 0 255"
expect {
    -ex "battery: hold OK" { lc_pass "panes: release composed the held present (B magenta)" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the hold coda failed" }
    timeout { lc_fail "battery never finished the hold leg" }
}

# Scenario 3 (G-6b): a compositor-initiated pane close delivers the
# queued TEV_CLOSE exit request to the stranded surface.
expect {
    -ex "battery: close event OK" { lc_pass "panes: TEV_CLOSE delivered on pane close" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the pane-close leg failed" }
    timeout { lc_fail "TEV_CLOSE never arrived" }
}

# H-4b: the one-shot placement claim -- a surface created with the LIVE
# claim lands in the claimed EMPTY leaf while focus sits elsewhere (the
# focus path would have split A); a STALE token (re-minted under it) falls
# back to focus placement and never steers into that leaf; a malformed
# token is E_INVAL at the syntax gate.
expect {
    -ex "battery: claim OK" { lc_pass "panes: live claim places into the claimed leaf; stale falls back; malformed refused" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the claim leg failed" }
    timeout { lc_fail "the claim leg never finished" }
}
# The declared-handoff control (the KT-1 audit's round-2 C-F3): the SAME
# console leaf the undeclared control found tiled goes to the ZERO rect when
# the battery's conn declares `session on`, and comes back on `session off`
# -- the one-variable pair that proves the backgrounding is real AND gated.
expect {
    -ex "battery: console leaf backgrounded by the declaration" { lc_pass "panes: a declared session backgrounds the console leaf" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the declare control failed" }
    timeout { lc_fail "the declare control never backgrounded the console leaf" }
}
expect {
    -ex "battery: declared session cannot close the console's container" { lc_pass "panes: the destructive close sees the transparent console leaf (E_PERM)" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the declared-close control failed" }
    timeout { lc_fail "the declared-close control never reported" }
}
expect {
    -ex "battery: console leaf restored" { lc_pass "panes: session off restores the console leaf's column" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "the undeclare control failed" }
    timeout { lc_fail "session off never restored the console leaf" }
}
expect {
    -ex "tapestry-battery: PASS" { lc_pass "panes: battery PASS" }
    -ex "tapestry-battery: FAIL" { lc_fail_detail "battery failed after the declare control" }
    timeout { lc_fail "battery never finished" }
}

# The coda: panes collapsed, the console is fullscreen direct again; the
# session prompt answers and the -c verify passes (a serial command first
# forces a fresh present -- the direct switch rides a present-complete).
lc_run_expect "pwd" "/home/michael"
set ok 0
for {set i 0} {$i < 12} {incr i} {
    if {[gfx_dump /tmp/ls-gfx-panes-post.png "-c"] eq ""} { set ok 1; break }
    after 700
}
if {!$ok} { lc_fail "post-battery console verify (-c) never passed (collapse/direct-return broken)" }
lc_pass "panes: console restored fullscreen after the battery"

# #55: the battery's splits reweaved the CONSOLE pane repeatedly (each
# CHANGED grid wrote the consctl winsize verb + posted tty:winch to the
# session pgrp); after the collapse the leaf must read authoritative
# fullscreen again -- the live end-to-end (reweave -> verb -> kernel ->
# /dev/winsize) across a REAL split/unsplit cycle, not just the boot grid.
lc_run_expect "cat /dev/winsize" "winsize 128 36"
lc_pass "panes: winsize restored fullscreen after the battery (#55 live across reweaves)"

lc_quit
lc_pass "ls-gfx-panes: the G-6 compositor leg verified (focus-event + structure + resize + multirect + tabs + zoom + move + focus + chord + rel + test-mode + gate + hold + close + collapse)"
exit 0
