#!/usr/bin/expect -f
# tools/interactive/haul-hangup.exp -- a server that hangs up must make haul
# FAIL, promptly, rather than hang. (Also here, because they need no real server
# either: a server that breaks the session's msize, the command form without
# stdio, and the short-token warning. Each has its own section below.)
#
# THE DEFECT. SYS_ATTACH_9P runs Tversion + Tattach synchronously, reading the
# replies from a pipe that has no deadline. haul's down pump is the only writer
# of that pipe, and when the server hung up the pump ended WITHOUT closing its
# end -- so the kernel waited for an Rversion that could no longer arrive, and
# haul's main thread sat inside the syscall for good. Nothing left alive could
# notice: no mount line, no error, and the shell never got its prompt back.
#
# THE FIXTURE NEEDS NOTHING EXTERNAL, which is why this is its own scenario and
# not a leg of haul-npxf: a peer that accepts and hangs up is the whole
# reproduction, and PLAIN 9P reaches the attach with no handshake in the way. So
# it runs in every fleet, not only where an npxf server happens to be up. The
# encrypted twin -- a relay that lets npxf's three flights through and hangs up
# after them -- is a leg of haul-npxf, because it needs the real server.
#
# THREE ASSERTIONS, each closing a different way this could pass while wrong:
#   1. haul names the side that ended -- the down pump -- and no other failure.
#      An attach that somehow succeeded fails the leg at once, and so does a
#      dial failure: a peer that never accepted is refused at the DIAL now
#      (haul-unreachable.exp). This header once said the guest's connect to a
#      host port nothing listens on SUCCEEDS, "consistent with slirp completing
#      the guest-side handshake first". libslirp's tcp_input sends the SYN-ACK
#      only after the host connect succeeds and answers a refusal with RST|ACK
#      (its source; not measured here). What IS established is that netd
#      handed a live `data` open to a dial that had already failed -- a race
#      that explains the old success on its own, since fixed.
#   2. The shell answers the next command, so haul EXITED rather than printing
#      its error and then hanging.
#   3. The peer's own log shows it accepted and hung up -- the positive half of
#      assertion 1's "not a dial failure", from the other side of the wire --
#      and then that haul's side closed. Its verdict is "the other side closed"
#      (or "reset") within its drain window, or "STILL OPEN" once the window
#      passes, and only the first two pass: waiting for the verdict and then
#      asserting nothing about it would pass a haul that never let go.

set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

proc read_file {path} {
    if {[catch {set f [open $path r]}]} { return "" }
    set d [read $f]
    close $f
    return $d
}

# Wait up to `secs` for glob `pat` to appear in the log at `path`; return the log.
proc wait_log {path pat secs} {
    set d ""
    for {set i 0} {$i < $secs * 10} {incr i} {
        set d [read_file $path]
        if {[string match $pat $d]} { break }
        after 100
    }
    return $d
}

# The same, for a regexp: one alternation can wait for every verdict at once.
proc wait_log_re {path re secs} {
    set d ""
    for {set i 0} {$i < $secs * 10} {incr i} {
        set d [read_file $path]
        if {[regexp $re $d]} { break }
        after 100
    }
    return $d
}

# The peer's verdict on haul's side: its drain window is 10 s, so 15 covers it.
set verdict_re {guest: (the other side (closed|reset)|STILL OPEN)}
set closed_re {guest: the other side (closed|reset)}

# A host port nothing listens on, for the legs that need only a fast refusal.
# Port 1 is below the ephemeral range, so no scenario's port-0 peer can be
# handed it; a released peer port could be, and a dial there would spend that
# peer's one accept in a scenario running in parallel.
set refused_port 1

lc_boot
lc_login cora kora

# The peer starts AFTER boot: an `exec` before `spawn` is a macOS expect 5.45
# footgun (lib.exp's header), and the guest does not dial until the leg anyway.
#
# The PEER picks the port (it binds port 0) and logs it. A free port chosen here
# and handed over would be check-then-use: LS-CI runs scenarios in parallel,
# haul-npxf's relay needs a port too, and two checks can pass for one port.
set peerlog /tmp/haul-hangup-peer-[pid].log
file delete -force $peerlog
set peer_pid [exec python3 $lc_repo/tools/interactive/haul-hangup-peer.py \
    --port 0 --log $peerlog --mode accept-close &]

# Wait for it to LISTEN by reading its log, not by connecting: the peer serves
# exactly one connection, so a probe would spend it.
set d [wait_log $peerlog "*listening*" 5]
if {![regexp {listening 127\.0\.0\.1:([0-9]+)} $d -> port]} {
    lc_fail "the hang-up peer never listened -- its log: $d"
}
lc_step "hang-up peer listening on 127.0.0.1:$port (pid $peer_pid)"

# `-v` so that a regression's transcript ends on "pumps up; attaching" -- the
# location of the hang -- rather than on nothing at all.
lc_send "mkdir -p /tmp/hang"
lc_run_expect_hardfail_re "haul -v 10.0.2.2!$port /tmp/hang" \
    "attach (the server closed without replying)" \
    {haul: (cannot reach|cannot dial|attach \(9P|attach \(the connection)|mounted at}
lc_run_expect "echo haul-returned | tr a-z A-Z" "HAUL-RETURNED"

set log [wait_log_re $peerlog $verdict_re 15]
if {![string match "*accepted*" $log] || ![string match "*guest: sent FIN*" $log]} {
    lc_fail "the peer did not accept and hang up as designed -- its log: $log"
}
if {![regexp $closed_re $log]} {
    lc_fail "haul did not close its side after the server hung up -- the peer's log: $log"
}
lc_step "peer log: [string map [list "\n" " | "] [string trim $log]]"
lc_pass "haul-hangup: a server that hangs up before Rversion fails the attach, and haul exits"

# A SERVER THAT BREAKS THE SESSION'S MSIZE. The kernel caps its receive at the
# msize it proposed in its Tversion, takes the server's lower msize for what a
# reply may carry, and answers a reply past either by marking the session dead
# -- after which it reads the reply pipe no more, so a haul that relayed the
# reply parked on with a dead mount and told no one. haul now holds every reply
# to that msize (frame::ReplyBound in usr/haul), refuses a larger one, names the
# server and both sizes, and exits non-zero.
#
# The peer serves Tversion and Tattach, answers the first request after them --
# the -v mount check's -- with a frame of the given size, and keeps the
# connection open, so its verdict says whether haul closed its own side. One leg
# per half of the bound, each with the other half out of the way:
#   1. 4608 bytes against the kernel's own 4096-byte proposal, after an Rversion
#      claiming 65536 -- more than proposed, which lowers nothing, so only the
#      Tversion half stops it;
#   2. 3072 bytes after an Rversion agreeing to 2048: within the kernel's
#      proposal, so only the Rversion half stops it.
# A haul without the half a leg exercises relays the reply and parks: its mount
# check says it CANNOT read (the hard-fail arm), and the verdict is STILL OPEN.
foreach {leg answer reply bound} {1 65536 4608 4096 2 2048 3072 2048} {
    set olog /tmp/haul-oversize-$leg-[pid].log
    file delete -force $olog
    set opid [exec python3 $lc_repo/tools/interactive/haul-hangup-peer.py \
        --port 0 --log $olog --mode oversize-reply --rversion-msize $answer --reply $reply &]
    set d [wait_log $olog "*listening*" 5]
    if {![regexp {listening 127\.0\.0\.1:([0-9]+)} $d -> oport]} {
        lc_fail "the oversize peer never listened -- its log: $d"
    }
    lc_send "mkdir -p /tmp/big$leg"
    lc_run_expect_hardfail_re "haul -v 10.0.2.2!$oport /tmp/big$leg" \
        "haul: 10.0.2.2!$oport sent a $reply-byte reply, over the session's $bound-byte msize -- refusing it" \
        {haul: (cannot reach|cannot dial|attach \()|mount check: CANNOT read}
    lc_expect "haul: the 9P session with 10.0.2.2!$oport is broken -- the mount is dead" \
        "oversize leg $leg: haul says the mount is dead"
    lc_run_expect "echo oversize-$leg-returned | tr a-z A-Z" "OVERSIZE-$leg-RETURNED"
    set od [wait_log_re $olog $verdict_re 15]
    foreach want [list "we answered $answer" "served Tattach" "sent a $reply-byte reply"] {
        if {[string first $want $od] < 0} {
            lc_fail "the oversize peer did not do what leg $leg assumes (no \"$want\") -- its log: $od"
        }
    }
    if {![regexp $closed_re $od]} {
        lc_fail "haul kept the connection after refusing the reply (leg $leg) -- the peer's log: $od"
    }
    lc_step "oversize peer $leg: [string map [list "\n" " | "] [string trim $od]]"
    lc_pass "haul-hangup: a $reply-byte reply over a $bound-byte msize is refused and named, and haul exits"
    catch {exec kill $opid}
    file delete -force $olog
}

# THE COMMAND FORM WITHOUT STDIO. The kernel hands out the lowest free fd, so a
# haul started with fds 0-2 closed would put its own connection and pipe fds in
# those slots, and the command inherits slots 0-2 as its stdio -- its output
# would go INTO the connection. haul must refuse before it opens anything.
#
# `ut` cannot start a program without stdio (a spawn whose fd list has a hole is
# refused), so exec-probe's `stdio-less` launcher closes 0-2 and execs haul in
# place; it checks its own closes before the exec, so a launcher that failed to
# close cannot produce this leg's verdict either way. No server is needed: the
# refusal comes before the dial. A haul that went ahead would dial port 1 and
# be refused there; the hard-fail arm names that line, and the attach line a
# pre-fix netd let it reach instead (see assertion 1).
lc_send "mkdir -p /tmp/hang2"
lc_run_expect_hardfail_re "exec-probe stdio-less /bin/haul 10.0.2.2!$refused_port /tmp/hang2 /bin/echo stdio-leg" \
    "the command form needs stdin, stdout and stderr open" \
    {haul: cannot reach|haul: attach \(|mounted at|exec-probe: FAIL}
lc_run_expect "echo stdio-leg-returned | tr a-z A-Z" "STDIO-LEG-RETURNED"
lc_pass "haul-hangup: the command form refuses to start without stdio"

# THE SHORT-TOKEN WARNING (HAUL-DESIGN 5). npxf's server proves possession
# first, so anyone who can reach it can test token guesses offline, and haul
# warns when it is handed a token shorter than 16 bytes. The warning comes
# before the dial, so no server is needed: haul goes on to dial port 1 and is
# refused there. Fifteen bytes warn; sixteen, one byte away,
# must not -- the control that keeps a warning printed for EVERY token from
# passing.
lc_send "echo 0123456789abcde > short.token; chmod 600 short.token"
lc_run_expect_hardfail_re "haul -t short.token 10.0.2.2!$refused_port /tmp/hang3" \
    "haul: warning: the token is only 15 bytes" \
    {mounted at}
lc_run_expect "echo short-token-returned | tr a-z A-Z" "SHORT-TOKEN-RETURNED"
lc_send "echo 0123456789abcdef > long.token; chmod 600 long.token"
lc_run_expect_hardfail_re "haul -t long.token 10.0.2.2!$refused_port /tmp/hang3; echo long-token-returned | tr a-z A-Z" \
    "LONG-TOKEN-RETURNED" \
    {warning: the token is|mounted at}
lc_pass "haul-hangup: a 15-byte token is warned about and a 16-byte one is not"

catch {exec kill $peer_pid}
file delete -force $peerlog
lc_quit
exit 0
