#!/usr/bin/expect -f
# tools/interactive/ls-display-stall.exp -- a display whose device did not
# answer a bind is put right, and a mode change begun from the composed state
# (AURORA-CONFIG.md section 3.4; GPU-DESIGN.md 4.5.15).
#
# A scanout command whose deadline passes may still be executed, so from then
# until a scanout command is accepted the compositor does not know what the
# device scans. Left alone that is a display showing a screen nobody draws
# into. This scenario makes it happen, three times, with the stall lever
# (THYLACINE_TEST_LATCH_DEAD=1, GPU-DESIGN.md 4.5.15: the next synchronous
# command is executed and then reported as past its deadline), aimed by the
# host's size: a display event for a host 797 pixels high has the first bind
# of its mode change stalled, one for a host 787 high has the bind of the
# switch to direct that follows the change stalled.
#
# One boot of the gate image (`tools/build.sh kernel --config ci`), a device
# of 1280x800:
#
#   A  from the direct state (the console alone): the change makes its screen
#      and enters the composed state, and THAT bind is the one not answered.
#      The compositor says the screen is not known to be scanned, binds it
#      again, and only then says the event is followed.
#   C  the change is made, the console draws at the new size, and the bind of
#      the switch back to direct is the one not answered: the device may scan
#      the console's buffer while the compositor composes into its screen.
#      The pass binds the screen again and begins the switch again, and the
#      switch is made. Nothing is typed in between: without the pass the
#      switch is made only by the console's next present of its own, and the
#      line `bound, late` is never said.
#   B  from the composed state (the console's pane split in two): the change's
#      own bind of the new screen is not answered, so the change is given up
#      and the device may scan the screen just given up. A change that fails
#      reads the display it was for, since the mode that stood is shown on
#      that display now, and the reading binds the standing screen again.
#      Under the lever the stall is over when the change returns, so the line
#      `bound, late` is said BEFORE the event is said not followed. A failure
#      that read nothing would leave the bind to a later pass, after that
#      line. The second asking makes the change.
#   D  from the composed state, with nothing stalled: the change begins with
#      the composed line, the device scans the new screen, the picture on it
#      changes when something is typed.
#
# The order of two lines is read with one pattern that is either of them,
# which matches the one said first; two patterns in a list would be taken in
# the order listed whatever the order said.
#
# NOT reached: a stall that the device never recovers from (ls-gpu-dead), a
# stall inside a client's direct present (the same rule, `scans`, and the
# pass asks the client to draw), the adopted GL source and the image poke
# (their bind is stalled by no lever), and a pinned mode.
#
# HVF like its ls-gfx siblings.

set ::env(THYLACINE_ACCEL) [expr {[info exists ::env(LS_CI_GFX_ACCEL)] ? $::env(LS_CI_GFX_ACCEL) : "hvf"}]
set ::env(THYLACINE_GPU_RES) 1280x800
set ::env(THYLACINE_VNC_SOCKET) /tmp/ls-display-stall-[pid].sock
set ::env(THYLACINE_DISPLAY) vnc-unix
set ::env(THYLACINE_TEST_LATCH_DEAD) 1

source [file join [file dirname [info script]] lib.exp]

lc_require_image {shell}

set repo $lc_repo
set qmp [lc_qmp_sock]
set ppm /tmp/ls-display-stall-[pid].ppm

source [file join [file dirname [info script]] display-follow.tcl]

# What must not be said, ahead of every wait. `strict` adds what a stalled
# bind is expected to lead to, for the stretches in which none is stalled.
# Each body runs in the scope of the wait that matched, so what was being
# waited for is a global.
proc arm {strict} {
    if {$strict} {
        expect_before {
            -re {tapestryd: [^\r\n]*t_dma_create_weave\((\d+)\) failed -?\d+} { lc_fail "a surface or a screen could not be allocated during '$::what': $expect_out(0,string)" }
            -re {tapestryd: mode (\d+x\d+) refused -- (screen|surface) weave} { lc_fail "$expect_out(1,string) could not be allocated ($expect_out(2,string)) during '$::what'" }
            -re {tapestryd: no mode for a display of (\d+x\d+);} { lc_fail "no mode was found for a host of $expect_out(1,string) during '$::what'" }
            -re {tapestryd: display event \d+: the mode is pinned and stands} { lc_fail "the mode is pinned during '$::what': this pool's /lib/aurora/config holds a fixed mode" }
            -re {tapestryd: test-latch-dead: [^\r\n]* stall REFUSED by the broker} { lc_fail "the broker had no stall shot left during '$::what'" }
            -re {lictor: stall shot LOST[^\r\n]*} { lc_fail "during '$::what': $expect_out(0,string)" }
            -re {lictor: gpu synchronous command missed its \d+ ms deadline[^\r\n]*} { lc_fail "a stall nobody aimed, during '$::what': $expect_out(0,string)" }
            -re {tapestryd: display event \d+: not followed, the device is dead} { lc_fail "the device was declared dead during '$::what'" }
            -re {EXTINCTION:} { lc_extinction_fail "extinction during '$::what'" }
            -re {tapestryd: mode rebind failed; old geometry retained} { lc_fail "the scanout was not rebound during '$::what', with no stall aimed" }
            -re {tapestryd: mode (\d+x\d+) is set; the display is not bound to its screen} { lc_fail "mode $expect_out(1,string) was set and its screen is not known to be scanned, during '$::what', with no stall aimed" }
            -re {tapestryd: scanout composed \((\d+x\d+)\) res \d+ BIND FAILED} { lc_fail "the screen of $expect_out(1,string) was not bound, during '$::what', with no stall aimed" }
            -re {tapestryd: scanout composed \((\d+x\d+)\) res \d+ bound, late} { lc_fail "the screen of $expect_out(1,string) was bound late during '$::what', with no stall aimed" }
            -re {tapestryd: scanout direct [^\r\n]* bind REFUSED} { lc_fail "a switch to direct was refused during '$::what', with no stall aimed" }
            -re {tapestryd: display event \d+: not followed[^\r\n]*[\r\n]} { lc_fail "during '$::what': [string trim $expect_out(0,string)]" }
            -re {tapestryd: display event \d+: the mode is \d+x\d+, not finished[^\r\n]*[\r\n]} { lc_fail "during '$::what': [string trim $expect_out(0,string)]" }
            -re {lictor: gpu synchronous command retired past its deadline} { lc_fail "a stall shot fired during '$::what', which aimed none" }
        }
    } else {
        expect_before {
            -re {tapestryd: [^\r\n]*t_dma_create_weave\((\d+)\) failed -?\d+} { lc_fail "a surface or a screen could not be allocated during '$::what': $expect_out(0,string)" }
            -re {tapestryd: mode (\d+x\d+) refused -- (screen|surface) weave} { lc_fail "$expect_out(1,string) could not be allocated ($expect_out(2,string)) during '$::what'" }
            -re {tapestryd: no mode for a display of (\d+x\d+);} { lc_fail "no mode was found for a host of $expect_out(1,string) during '$::what'" }
            -re {tapestryd: display event \d+: the mode is pinned and stands} { lc_fail "the mode is pinned during '$::what': this pool's /lib/aurora/config holds a fixed mode" }
            -re {tapestryd: test-latch-dead: [^\r\n]* stall REFUSED by the broker} { lc_fail "the broker had no stall shot left during '$::what'" }
            -re {lictor: stall shot LOST[^\r\n]*} { lc_fail "during '$::what': $expect_out(0,string)" }
            -re {lictor: gpu synchronous command missed its \d+ ms deadline[^\r\n]*} { lc_fail "a stall nobody aimed, during '$::what': $expect_out(0,string)" }
            -re {tapestryd: display event \d+: not followed, the device is dead} { lc_fail "the device was declared dead during '$::what'" }
            -re {EXTINCTION:} { lc_extinction_fail "extinction during '$::what'" }
        }
    }
}
# Which of two lines is said first. A list of two patterns is taken in the
# order listed; one pattern that is either of them matches the earlier.
proc first_of {good bad what why_bad} {
    global timeout
    set ::what $what
    set timeout 30
    expect {
        -re "($good|$bad)" {
            if {[regexp -- $good $expect_out(1,string)]} {
                lc_step "saw: $what"
            } else {
                lc_fail "$why_bad (during '$what': [string trim $expect_out(1,string)])"
            }
        }
        timeout { lc_fail "timeout (30s) waiting for \[$good\] during '$what'" }
        eof     { lc_fail "qemu exited during '$what'" }
    }
}
set shot_mode   {tapestryd: test-latch-dead: the mode's bind retires past its deadline}
set shot_switch {tapestryd: test-latch-dead: the bind of the switch to direct retires past its deadline}
set injected    {lictor: gpu synchronous command retired past its deadline \(INJECTED stall shot of test-latch-dead\)}
set asking      {tapestryd: display event \d+: asking the host}
proc late {mode} { return "tapestryd: scanout composed \\($mode\\) res \\d+ bound, late" }
proc direct {mode} { return "tapestryd: scanout direct \\d+ slot \\d+ \\($mode\\)\[\r\n\]" }

# ---------- the boot ----------
lc_boot
set what "the boot"
arm 1
set timeout $lc_boot_timeout
expect {
    -re {tapestryd: serving /srv/tapestry \+ /srv/warp \((\d+x\d+)\)} { set serving $expect_out(1,string) }
    timeout { lc_fail "the compositor never served" }
    eof     { lc_fail "qemu exited during boot" }
}
if {$serving ne "1280x800"} { lc_fail "the compositor serves $serving, not the device's 1280x800" }
set what "the login"
lc_login michael correct-horse-battery-staple-v1
# The arm is asked of the compositor's state, not of its boot line, which can
# land on either side of the login prompt.
set what "reading the lever's state"
lc_send "cat /dev/tapestry/ctl; echo ctl-read"
lc_within 30 {
    -re {display 1280 800[^\n]*\n(.|\n)*test-latch-dead armed(.|\n)*\nctl-read} { lc_step "the compositor is at 1280x800 with the lever armed" }
    -re {\nctl-read} { lc_fail "the compositor's ctl carries no display line of 1280 by 800 or no armed lever" }
    timeout { lc_fail "the compositor's ctl never answered (30s)" }
    eof     { lc_fail "qemu exited while reading the compositor's ctl" }
}
wait_dims "1280 800" "the boot"
wait_cells 128 36 "the boot"
wait_redraw "the boot"
lc_pass "display stall: the gate image boots at 1280x800 with the stall lever armed"

# ---------- A: the bind of a new screen, entering the composed state ----------
arm 0
tell 1118x797
follow_expect $asking "A: the event is taken up"
follow_expect [begun 1280x800 1118x797 direct] "A: the change begins from the direct state"
follow_expect $shot_mode "A: the shot is aimed at the bind of the new screen"
follow_expect $injected "A: the bind is executed and reported as past its deadline"
follow_expect {tapestryd: scanout composed \(1118x797\) res \d+ BIND FAILED} "A: the compositor reads the bind as failed"
follow_expect {tapestryd: mode 1118x797 is set; the display is not bound to its screen} "A: the change says its screen is not known to be scanned"
set what "A: the screen is bound again"
set late_a [late 1118x797]
set timeout 30
expect {
    -re {tapestryd: display event \d+: the mode is 1118x797, not finished[^\r\n]*[\r\n]} {
        lc_step "note: the engine had not revived when the follow went on; the pass bound the screen"
        exp_continue
    }
    -re $late_a { lc_step "saw: $what" }
    timeout { lc_fail "the screen of 1118x797 was never bound again: the device is not known to scan it" }
    eof     { lc_fail "qemu exited during '$what'" }
}
arm 1
follow_expect [followed 1118x797] "A: the event is followed, after the bind"
follow_expect [direct 1118x797] "A: the console is scanned directly again"
wait_dims "1118 797" "A"
wait_cells 111 36 "A"
wait_redraw "A"
lc_pass "display stall: a bind of the new screen that is not answered is made again, and then the event is followed"

# ---------- C: the bind of the switch to direct ----------
arm 0
tell 1238x787
follow_expect $asking "C: the event is taken up"
follow_expect [begun 1118x797 1238x787 direct] "C: the change begins from the direct state"
follow_expect [up 1238x787] "C: the mode is up"
follow_expect [followed 1238x787] "C: the event is followed"
follow_expect $shot_switch "C: the shot is aimed at the bind of the switch to direct"
follow_expect $injected "C: the bind is executed and reported as past its deadline"
follow_expect {tapestryd: scanout direct \d+ slot \d+ \(1238x787\) bind REFUSED -- pending retried at each present} "C: the compositor reads the switch as refused"
first_of [late 1238x787] [direct 1238x787] "C: the pass binds the screen again" \
    "the switch was made by a later present with nothing binding the screen meanwhile: the pass does not put an unsettled scanout right"
arm 1
follow_expect {tapestryd: scanout pending-direct \d+ \(1238x787\)} "C: the switch begins again"
follow_expect [direct 1238x787] "C: the switch is made"
wait_dims "1238 787" "C"
wait_cells 123 35 "C"
wait_redraw "C"
lc_pass "display stall: a switch to direct that is not answered has the screen bound again and is begun again"

# ---------- a second pane, so that the display stays composed ----------
set what "the split"
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k meta_l+h} err]} {
    lc_fail "qmp-sendtext -k meta_l+h failed: $err"
}
follow_expect {tapestryd: scanout composed \(1238x787\) res \d+ bound[\r\n]} "the display is composed, with two panes"
wait_dims "1238 787" "two panes"
wait_redraw "two panes"
lc_pass "display stall: Super+H splits the console's pane and the display is composed"

# ---------- B: the change's own bind, from the composed state ----------
arm 0
tell 1400x797
follow_expect $asking "B: the event is taken up"
follow_expect [begun 1238x787 1400x797 composed] "B: the change begins from the composed state"
follow_expect $shot_mode "B: the shot is aimed at the change's own bind"
follow_expect $injected "B: the bind is executed and reported as past its deadline"
follow_expect {tapestryd: mode rebind failed; old geometry retained} "B: the change is given up"
first_of [late 1238x787] {tapestryd: display event \d+: not followed[^\r\n]*} \
    "B: the change that failed reads its display, and the standing screen is bound again before the event is said not followed" \
    "the event was said not followed before the standing screen was bound again: a change that failed did not read the display it was for, and until a later pass binds it the device may scan a screen that was given up"
follow_expect {tapestryd: display event \d+: not followed \(errno \d+\), to be asked again} "B: the event is to be asked again"
arm 1
follow_expect $asking "B: the host is asked again"
follow_expect [begun 1238x787 1400x797 composed] "B: the change begins again"
follow_expect [up 1400x797] "B: the mode is up"
follow_expect [followed 1400x797] "B: the event is followed"
wait_dims "1400 797" "B"
wait_redraw "B"
lc_pass "display stall: a change whose own bind is not answered leaves the standing screen bound again, and is made at the next asking"

# ---------- D: from the composed state, nothing stalled ----------
tell 1000x640
follow_expect $asking "D: the event is taken up"
follow_expect [begun 1400x797 1000x640 composed] "D: the change begins from the composed state"
follow_expect [up 1000x640] "D: the mode is up"
follow_expect [followed 1000x640] "D: the event is followed"
wait_dims "1000 640" "D"
wait_redraw "D"
lc_pass "display stall: a change from the composed state binds its new screen, and the picture on it changes"

file delete -force $ppm
set what "the shutdown"
lc_quit
file delete -force $::env(THYLACINE_VNC_SOCKET)
lc_pass "ls-display-stall: three binds that were not answered put right, and a change from the composed state"
exit 0
