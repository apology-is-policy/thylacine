#!/usr/bin/expect -f
# tools/interactive/pty-4.exp -- the PTY-4 interactive job-control scenario.
#
# The chartered "interactive LS-CI PTY scenario" (PTY-DESIGN section 14.4):
# the SAME job-control ladder the boot-fatal /bin/jc-probe scripts, but driven
# through the REAL console -- login -> `ptyhost` (the outer ut's LS-7 raw dance
# flips the console to a byte pipe around it) -> the hosted inner `ut` runs its
# session dance and takes job control -> stop / jobs / fg / re-stop / bg /
# fg + ^C -> `exit` unwinds back to the outer prompt.
#
# The stoppable job is `sleep` (NOT `cat`): a v1.0 pts has no foreground-read
# arbitration (TTIN), so a stopped job holding an outstanding terminal read
# would steal the shell's input; `sleep` holds no terminal read and exercises
# the whole stop/report/resume machinery cleanly (interactive `cat`-under-^Z is
# the documented TTIN follow-up). The sleep is LONG (30 s, ended by ^C, never
# by its deadline): a short sleep's wall clock keeps running WHILE stopped, so
# both the stop window and the post-resume window would race the expiry (the
# PTY-4e F2 right edge -- the artifact that originally masked the re-stop leg).
#
# Echo discipline: the outer console is RAW (-echo) under the dance and the
# inner editor draws its own echo, so rendered text is always something a
# process WROTE -- so the run/health legs match an UPPERCASE token emitted only
# by a `| tr a-z A-Z` pipeline (never the lowercase editor echo), and the stop
# legs match the `Stopped` line (only ut's job-control report emits it; signal
# chars are consumed by the ldisc, never echoed).

source [file join [file dirname [info script]] lib.exp]

lc_boot
lc_login michael correct-horse-battery-staple-v1

# Enter the hosted session. The inner ut's session-dance witness rides the
# UART (t_putstr) and renders on this same serial -- assert it directly.
lc_send "ptyhost"
lc_expect "job control active" "the hosted ut's session dance (setsid+acquire+set_fg+ctl)"

# The inner shell is interactive through both hops (the tr trick: the output
# token cannot appear in the typed line).
sleep 1
lc_run_expect "echo pty-inner | tr a-z A-Z" "PTY-INNER"

# sleep 30 + ^Z: the INNER pts cooks 0x1a (VSUSP) -> tty:susp -> the default
# STOP -> the WAIT_UNTRACED report -> the inner ut takes the terminal back and
# prints the Stopped line (emit_line -> the pts -> the host -> here). The
# settle covers spawn + pgrp + terminal handoff; the 30 s deadline can never
# expire inside the ladder.
# THE FAILURE-TIME PROBE for this leg (lib.exp `lc_fail_probe`). 2026-08-16
# this leg burned a retry: echo stopped at `sleep `, `Stopped` never came,
# guest ALIVE -- and the capture alone cannot say why (see lib.exp). If it
# misses again, lc_fail asks the guest, in this order, and logs every byte:
#
#   1. listen 2 s              -- is anything STILL arriving?
#   2. "\r", 2 s               -- does the editor answer? (a shell is reading)
#   3. "jobs\r", 3 s           -- `Stopped ... sleep 30` here => the stop
#                                 HAPPENED and the earlier line was LOST on
#                                 the way out (OUTPUT loss). A prompt and no
#                                 job => `sleep` ran with no arg / the line
#                                 never arrived whole (INPUT truncation).
#                                 Silence => nobody is reading the terminal.
#   4. "\x03", 3 s             -- if sleep 30 was RUNNING in the foreground
#                                 (the ^Z byte itself lost, not the `30`),
#                                 this ends it and the prompt returns.
#   5. "jobs\r", 3 s           -- ...and then jobs is empty.
#   6. "echo diag-alive | tr a-z A-Z\r", 3 s -- DIAG-ALIVE => the channel is
#                                 alive end to end; silence => a stall class,
#                                 read vm-at-fail / bridge-at-fail.
#
# It records; it asserts nothing; it costs nothing on the passing path.
set ::lc_fail_probe {
    lc_probe_capture ""     2 "listen"
    lc_probe_capture "\r"   2 "CR"
    lc_probe_capture "jobs\r" 3 "jobs"
    lc_probe_capture "\x03" 3 "Ctrl-C"
    lc_probe_capture "jobs\r" 3 "jobs after Ctrl-C"
    lc_probe_capture "echo diag-alive | tr a-z A-Z\r" 3 "channel alive?"
}

lc_send "sleep 30"
sleep 1
send "\x1a"
lc_expect "Stopped" "^Z stops the foreground sleep"
set ::lc_fail_probe {}

lc_send "jobs"
lc_expect "Stopped" "jobs lists the stopped sleep"

# THE RE-STOP LEG (task #19): fg resumes (terminal + SYS_TTY_CONT; bi_fg
# echoes the job's command line first), then a second ^Z must stop it AGAIN --
# only a RUNNING job can stop, so the second Stopped is simultaneously the
# resume proof and the re-stop regression.
lc_send "fg"
lc_expect "sleep 30" "fg echoes the resumed job"
sleep 1
send "\x1a"
lc_expect "Stopped" "a second ^Z re-stops the resumed sleep"

# bg resumes the re-stopped job in the background (no terminal handoff).
lc_send "bg"
lc_expect "&" "bg announces the backgrounded job"

# fg the RUNNING job (harmless cont), then ^C -> interrupt -> sleep
# default-terminates (LS-5) -> fg returns. Post-resume signal delivery
# through the same pts fan as the susp.
lc_send "fg"
lc_expect "sleep 30" "fg echoes the running job"
sleep 1
send "\x03"
sleep 1
lc_run_expect "echo pty-fg | tr a-z A-Z" "PTY-FG"

# THE TYPE-AHEAD LEG (PTY-DESIGN "Mode writes deliver, never discard",
# 2026-08-17). A line typed WHILE a foreground job runs is assembled by the
# COOKED pts (ut hands the job CHILD_MODE) and must survive ut's PROMPT-mode
# re-arm at the next prompt: the mode write that clears ICANON DELIVERS the
# pending fragment to the raw editor. This is the exact shape that burned this
# scenario's retries -- `sleep 30` typed right after PTY-INNER landed as `sle`
# (cooked-echoed, then DISCARDED by the mode write) + `ep 30` (delivered,
# executed) -- made DETERMINISTIC: type the line WITHOUT Enter one second into
# a `sleep 2` (CHILD_MODE is certainly on; the bytes certainly arrive before
# the sleep exits), wait until the editor HOLDS all 31 chars (its redraw ends
# with cursor-forward 4 + len = 35 -- unique in this scenario), then Enter.
# Pre-fix the fragment was zeroed: the cursor never reached 35 and the command
# never ran (a 30 s timeout here, not a flake). Regression: sabotage-verified.
#
# THE ARMED WITNESS (the ccb597b8 round, F8): the cursor-35 anchor proves the
# 31 chars REACHED the editor, not that the mode-write delivery carried them.
# If they landed before ut wrote CHILD_MODE (raw, un-echoed, into m2s) or after
# the PROMPT-mode re-arm, the editor shows them just the same and the leg is
# green with the delivery path unexercised -- under the OLD posture too. So
# first require the pts's COOKED ECHO of the line as PLAIN text directly after
# the accepted line's CRLF: only bytes cooked in CHILD_MODE are echoed there
# (raw bytes are not echoed at all, and the editor's own redraw shows the text
# behind the prompt after `\r\x1b[K`, never after a CRLF). A `sleep 4` widens
# the window the send must land in.
lc_send "sleep 4"
sleep 1
send "echo type-ahead-ok | tr a-z A-Z"
lc_expect_re {\r\necho type-ahead-ok \| tr a-z A-Z} "the pts COOKED-ECHOED the type-ahead right after the CRLF (CHILD_MODE was on: the delivery path is ARMED)"
lc_expect "\x1b\[35C" "the editor holds the 31-char type-ahead delivered by the mode write"
send "\r"
lc_expect "TYPE-AHEAD-OK" "the type-ahead line ran WHOLE (nothing dropped at the head)"

# Leave the inner session: ut exits -> the master drains-then-EOFs -> ptyhost
# reaps + exits -> the outer ut restores its prompt mode + screen. The outer
# probe proves the whole unwind.
lc_send "exit"
sleep 1
lc_run_expect "echo pty-outer | tr a-z A-Z" "PTY-OUTER"

lc_pass "PTY-4: job control end-to-end over a hosted session (stop/jobs/fg-restop/bg/fg-int + a clean unwind)"
