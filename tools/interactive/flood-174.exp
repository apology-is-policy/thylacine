#!/usr/bin/expect -f
# #174 regression: an instantaneous input flood. The 256-byte cons ring used to
# drop bytes when a flood (a fast trackpad-scroll mapped to arrow keys) filled it
# faster than the reader drained. #174 paused RX on a full ring; vote 73
# (2026-11-05) replaced the pause: the PL011 drain reads every byte, and what the
# 512-byte ring cannot take waits in the console's 4096-entry side queue
# (kernel/cons.c), which the reader moves after each drain. A flood under
# ring + queue loses nothing, and the box does NOT wedge.
#
# This bursts 300 arrow-downs (900 bytes) at the ut prompt and asserts the shell
# still responds (no wedge). rx_drop_side in /ctl/cons counts what a flood past
# the queue drops. Hand-run diagnostic
# (SKIPs without `expect`); THYLACINE_ACCEL=tcg by default (a single large burst
# is the reliable trigger under TCG's serialized vCPU + main loop).

source [file join [file dirname [info script]] lib.exp]

set timeout $::lc_boot_timeout
spawn env THYLACINE_ACCEL=tcg [file join $::lc_repo tools run-vm.sh]

expect {
    -re {KASLR offset (0x[0-9a-f]+)} {}
    timeout {}
}
lc_login michael correct-horse-battery-staple-v1

set N 300
set burst ""
for {set i 0} {$i < $N} {incr i} { append burst "\x1b\[B" }
lc_step "BURST: $N fast arrow-downs at the ut prompt (900 bytes, 3.5x the ring)"
send -- $burst

after 900
lc_step "PROBE: echo Z174ALIVE (the shell must still respond -- no wedge, no loss)"
send -- "echo Z174ALIVE\r"
set timeout 15
expect {
    -ex "Z174ALIVE"   { send_user "\n#174 RESULT: ALIVE (flood absorbed)\n"; lc_quit; exit 0 }
    -re {EXTINCTION:} { send_user "\n#174 RESULT: EXTINCTION\n"; lc_quit; exit 2 }
    timeout           { send_user "\n#174 RESULT: HUNG (wedge)\n"; exit 1 }
    eof               { send_user "\n#174 RESULT: EOF (harness)\n"; exit 3 }
}
