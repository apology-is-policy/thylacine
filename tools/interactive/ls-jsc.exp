#!/usr/bin/expect -f
# tools/interactive/ls-jsc.exp -- Boosty over a real PTY: JavaScriptCore (WebKit's
# JSCOnly port, static; B-2c: the Baseline and regexp JITs on one SYS_JIT_CREATE
# code region, DFG and FTL off) runs as the logged-in user from the pool at
# /webkit/jsc. docs/BROWSER-DESIGN.md; docs/browser-status.md.
#
# What each leg pins, and the libc defect it would have caught (all three were
# found by running this engine, not by review):
#   hello   the binary execs and the LLInt interprets
#   icu     Intl formats through the statically packaged ICU data
#   recurse a runaway recursion is a graceful RangeError -- needs TRUE main-thread
#           stack bounds (pouch 0033: pthread_getattr_np said ONE PAGE)
#   heap    400,000 object pushes -- needs a TRUE machine memory size (pouch 0034:
#           sysconf(_SC_PHYS_PAGES) returned stack residue; arrays died at ~1000)
#   typed   a 64 MiB typed array, last byte written and read back (lazy anon mmap)
#   wasm    the WebAssembly object exists and validates a module header (IPInt)
#   jit / jit-deny     a hot function runs Baseline JIT code ($vm.baselineJITTrue);
#           --thylacine-no-cap-jit, one flag away, leaves it interpreted
#   rx / rx-deny       a regexp compiles to the YARR JIT; denied, the same pattern
#           goes to the YARR interpreter (JSC says "Can't JIT" for it)
#   loop / loop-deny   a 2e7-iteration int32 loop computes the same value both ways;
#           each prints its time for the record (asserted: the value, never a time)
#   sunspider / sunspider-deny   SunSpider 1.0.2 (26 tests, each checking its own
#           result), three runs each, JIT on and denied; the totals are the record
#   tiers   DFG, FTL, BBQ and OMG stay off although every one is asked for by flag;
#           --useDollarVM=true in the same line reads on, so the flags were parsed
#           (jscOptions() reports a bool as the number 0 or 1)
#
# EVERY marker is printed by the guest in lower case and asserted in UPPER case
# through `tr`, and no expected string appears in the typed line (the inputs are
# spelled 6*7, 4e5, 64<<20): the terminal echoes what is typed, and an expect that
# the echo can satisfy proves nothing. `$errstr` is never consulted -- ut does not
# clear it after a success.
#
# G-3: HVF, the go5 argument -- this scenario is boot-dominated and CPU-bound, has
# no GIC/timer/BAR surface of its own, and the TCG anchor set keeps those axes.
set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

# Host-side skip, checked before boot so it costs no VM time: does THIS pool hold
# JavaScriptCore? Asked of the bake's verified manifest, not of the stage -- a
# stage left by an earlier bake once sent this scenario against a pool without
# WebKit (it "failed" deterministically; the guest was fine).
if {![lc_pool_has WEBKIT]} {
    puts "LS-CI SKIP: this pool holds no JavaScriptCore (build/pool-contents has no\
          WEBKIT payload -- CHUNK_WEBKIT=n / THYLACINE_BAKE_WEBKIT unset, or a pool\
          baked before the payloads line existed)"
    exit 77
}

lc_boot
lc_login michael correct-horse-battery-staple-v1

set ::lc_cmd_timeout 120
foreach {tag js want} {
    hello   {print("jsca-" + 6*7)}
            "JSCA-42"
    icu     {print("jscb-" + new Intl.NumberFormat("de-DE").format(1234567.891))}
            "JSCB-1.234.567,891"
    recurse {function d(n){return d(n+1)}; try{d(0)}catch(e){print("jscc-" + e.name)}}
            "JSCC-RANGEERROR"
    heap    {var a=[]; for(var i=0;i<4e5;i++)a.push({x:i}); print("jscd-" + a.length + "-" + a[a.length-1].x)}
            "JSCD-400000-399999"
    typed   {var u=new Uint8Array(64<<20); u[u.length-1]=7; print("jsce-" + u.length + "-" + u[u.length-1])}
            "JSCE-67108864-7"
    wasm    {print("jscf-" + (typeof WebAssembly) + "-" + WebAssembly.validate(new Uint8Array([0,97,115,109,1,0,0,0])))}
            "JSCF-OBJECT-TRUE"
} {
    lc_run_expect "/webkit/jsc -e '$js' | tr a-z A-Z" $want
    lc_pass "ls-jsc($tag): $want"
}

# B-2c. michael is jit-eligible, so jsc acquires CAP_JIT by the SELF form before
# JSC creates its pool; --thylacine-no-cap-jit skips that, the pool's SYS_JIT_CREATE
# is refused (EACCES) and the same script runs on the interpreters. Every JIT-on
# witness is paired with its denied twin: a "false" or a "Can't JIT" alone is also
# what a JIT that never started would print. @T is each leg's own marker.
set witness {function f(){return $vm.baselineJITTrue()}; var r=false; for(var i=0;i<1e6&&!r;i++)r=f(); print("@T-"+r)}
set rx {var n=0; for(var i=0;i<1000;i++) if(/a+b/.test("x"+i+"aab")) n++; print("@T-"+n)}
set loop {var t=preciseTime(); var s=0; for(var i=0;i<2e7;i++)s=(s+i*i)|0; print("@T-"+s+"-"+Math.round((preciseTime()-t)*1000)+"ms")}
set nojit {Can't JIT this regular expression: "/a+b/"}

lc_send "/webkit/jsc --useDollarVM=true -e '[string map {@T jscg} $witness]' | tr a-z A-Z"
lc_expect "CAP_JIT acquired (SELF)" "jsc acquires CAP_JIT by the SELF form"
lc_expect "JSCG-TRUE" "a hot function runs Baseline JIT code"
lc_pass "ls-jsc(jit): CAP_JIT acquired (SELF), JSCG-TRUE"

lc_run_expect_hardfail "/webkit/jsc --thylacine-no-cap-jit --useDollarVM=true -e '[string map {@T jsck} $witness]' | tr a-z A-Z" \
    "JSCK-FALSE" "CAP_JIT acquired"
lc_pass "ls-jsc(jit-deny): JSCK-FALSE, no CAP_JIT"

lc_run_expect_hardfail "/webkit/jsc --dumpCompiledRegExpPatterns=true -e '[string map {@T jsch} $rx]' | tr a-z A-Z" \
    "JSCH-1000" $nojit
lc_pass "ls-jsc(rx): JSCH-1000 through the YARR JIT"

lc_send "/webkit/jsc --thylacine-no-cap-jit --dumpCompiledRegExpPatterns=true -e '[string map {@T jscl} $rx]' | tr a-z A-Z"
lc_expect $nojit "denied, the pattern goes to the YARR interpreter"
lc_expect "JSCL-1000" "the interpreted pattern matches the same"
lc_pass "ls-jsc(rx-deny): Can't JIT, JSCL-1000"

set tiers {var o=jscOptions(); print("@T-"+o.useDFGJIT+"-"+o.useFTLJIT+"-"+o.useBBQJIT+"-"+o.useOMGJIT+"-"+o.useBaselineJIT+"-"+o.useDollarVM)}
lc_run_expect "/webkit/jsc --useDFGJIT=true --useFTLJIT=true --useBBQJIT=true --useOMGJIT=true --useDollarVM=true -e '[string map {@T jsco} $tiers]' | tr a-z A-Z" \
    "JSCO-0-0-0-0-1-1"
lc_pass "ls-jsc(tiers): only Baseline is on; the flags were parsed"

lc_run_expect "/webkit/jsc -e '[string map {@T jsci} $loop]' | tr a-z A-Z" "JSCI-820578176-"
lc_pass "ls-jsc(loop): JSCI-820578176 (Baseline JIT)"
lc_run_expect "/webkit/jsc --thylacine-no-cap-jit -e '[string map {@T jscj} $loop]' | tr a-z A-Z" "JSCJ-820578176-"
lc_pass "ls-jsc(loop-deny): JSCJ-820578176 (interpreted)"

lc_run_expect_hardfail "/webkit/jsc /webkit/sunspider/run.js -- jscm | tr a-z A-Z" "JSCM-OK-26-" "JSCM-FAIL"
lc_pass "ls-jsc(sunspider): 26 of 26 with the JIT on"
lc_run_expect_hardfail "/webkit/jsc --thylacine-no-cap-jit /webkit/sunspider/run.js -- jscn | tr a-z A-Z" "JSCN-OK-26-" "JSCN-FAIL"
lc_pass "ls-jsc(sunspider-deny): 26 of 26 interpreted"

lc_quit
exit 0
