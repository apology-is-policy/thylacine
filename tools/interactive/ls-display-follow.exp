#!/usr/bin/expect -f
# tools/interactive/ls-display-follow.exp -- a display that takes a mode for any
# size its host has, and follows the host when that size changes
# (AURORA-CONFIG.md section 3.4 as amended 2026-11-11).
#
# One boot of the gate image (`tools/build.sh kernel --config ci`: the login
# must reach a shell on the serial console). Four witnesses for every mode: the
# compositor's lines (the mode is up, said after the change, and the event is
# followed, said last, once the bind of the screen and the scale are settled
# too); the scanout QEMU dumps, its size and a picture on it; the console's
# size in cells as its renderer reported it (`/dev/winsize`, 10 by 22 pixels a
# cell at scale 100), which a console that was never told of the mode, or never
# laid itself out again, does not change; and that the dumped picture changes
# when something is typed, which it does not if the device scans a screen
# nobody composes into.
#
#   the boot:  the device is made 3456x2160, full screen on a 16-inch MacBook
#              Pro. Three buffers of a surface that size are 85 MiB against 64
#              MiB a weave, so it cannot be a mode. Before the amendment the
#              compositor started at it all the same and no surface could be
#              made (`t_dma_create_weave(89579520) failed`). Now the first
#              mode is half of it, 1728x1080, and the console is on it, 172
#              cells by 49.
#   follows:   a VNC viewer that resized its window tells QEMU a size
#              (rfb_resize.py), and virtio-gpu raises its display event: the
#              path a host window takes, without a window. The mode follows:
#              to a size it can be (2000x1280), to half of one it cannot
#              (5120x2880 -> 2560x1440), through a train of three to its last
#              (1000x640), and down to 640x400.
#   no size:   a host that tells 0x0 disables the output. The compositor asks,
#              is told nothing, and the mode stands.
#
# What must not be said is armed once, before every wait of the run, the
# library's own (the login, a command's echo, the shutdown) included:
# `expect_before` puts its patterns ahead of each wait's, and expect takes the
# first pattern LISTED that matches, so a failure cannot hide behind a success
# that is in the buffer with it. A follow that is put off because the device is
# stalled before it is asked is noted and waited out. An asking that was made
# and failed (the device refusing, or a stall that began inside the asking)
# fails the leg, though the compositor would ask again.
#
# Every change here begins from the DIRECT state, and each leg says so by the
# line the change begins with: the console is the one thing shown and fills
# the display, so the device scans the console's own buffer, and after each
# follow it does again once the console has drawn at the new size. So the size,
# the cells and the redraw are read off the console's buffer, and the change's
# own bind of a new screen never runs. A change begun from the composed state,
# and what a bind that is not answered leads to, are ls-display-stall's.
#
# NOT asserted: how many mode changes a train costs. Its sizes go out 20 ms
# apart and the compositor waits for 150 ms of quiet, so it is one change
# unless the host stalls the sender for longer than that; the rule is
# libhalcyon's `display::Follow` and its host tests hold it to one. NOT
# reached: a pinned mode (`mode W H` is the console renderer's, through its
# settings panel, which persists it: ls-gfx-mode drives that), the trusted
# screen across a follow, and the millimetres (a VNC viewer tells none, so
# the scale is 100 throughout).
#
# HVF like its ls-gfx siblings.

set ::env(THYLACINE_ACCEL) [expr {[info exists ::env(LS_CI_GFX_ACCEL)] ? $::env(LS_CI_GFX_ACCEL) : "hvf"}]
set ::env(THYLACINE_GPU_RES) 3456x2160
set ::env(THYLACINE_VNC_SOCKET) /tmp/ls-display-follow-[pid].sock
set ::env(THYLACINE_DISPLAY) vnc-unix

source [file join [file dirname [info script]] lib.exp]

lc_require_image {shell}

set repo $lc_repo
set qmp [lc_qmp_sock]
set ppm /tmp/ls-display-follow-[pid].ppm

source [file join [file dirname [info script]] display-follow.tcl]

# ---------- the boot: a mode for a host size that cannot be one ----------
lc_boot
# What must not be said, from here to the end of the run and in every wait,
# the library's included. Each body runs in the scope of the wait that
# matched, so what was being waited for is a global.
set what "the boot"
expect_before {
    -re {tapestryd: [^\r\n]*t_dma_create_weave\((\d+)\) failed -?\d+} { lc_fail "a surface or a screen could not be allocated during '$::what': $expect_out(0,string)" }
    -re {tapestryd: mode rebind failed; old geometry retained} { lc_fail "the scanout was not rebound during '$::what'" }
    -re {tapestryd: mode (\d+x\d+) is set; the display is not bound to its screen} { lc_fail "mode $expect_out(1,string) was set and the device is not known to scan its screen, during '$::what'" }
    -re {tapestryd: scanout composed \((\d+x\d+)\) res \d+ BIND FAILED} { lc_fail "the screen of $expect_out(1,string) was not bound, during '$::what'" }
    -re {tapestryd: mode (\d+x\d+) refused -- (screen|surface) weave} { lc_fail "$expect_out(1,string) could not be allocated ($expect_out(2,string)) during '$::what'" }
    -re {tapestryd: no mode for a display of (\d+x\d+);} { lc_fail "no mode was found for a host of $expect_out(1,string) during '$::what'" }
    -re {tapestryd: display event \d+: not followed[^\r\n]*[\r\n]} { lc_fail "during '$::what': [string trim $expect_out(0,string)]" }
    -re {tapestryd: display event \d+: the mode is \d+x\d+, not finished[^\r\n]*[\r\n]} { lc_fail "during '$::what': [string trim $expect_out(0,string)]" }
    -re {tapestryd: display event \d+: the mode is pinned and stands} { lc_fail "the mode is pinned during '$::what': this pool's /lib/aurora/config holds a fixed mode" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during '$::what'" }
}
set timeout $lc_boot_timeout
# The fitted mode is said in the compositor's start and the size it serves just
# after; the login prompt is a thousand lines later and is left for lc_login.
set what "the boot's first mode"
expect {
    -re {tapestryd: mode 1728x1080 for a display of 3456x2160} { lc_step "saw: the first mode is fitted" }
    -re {tapestryd: serving /srv/tapestry \+ /srv/warp \((\d+x\d+)\)} {
        lc_fail "the compositor serves $expect_out(1,string) with no fitted mode said before it"
    }
    timeout { lc_fail "the boot did not get to a fitted mode" }
    eof     { lc_fail "qemu exited during boot" }
}
set what "the boot's serving line"
expect {
    -re {tapestryd: serving /srv/tapestry \+ /srv/warp \((\d+x\d+)\)} { set serving $expect_out(1,string) }
    timeout { lc_fail "the compositor never served" }
    eof     { lc_fail "qemu exited during boot" }
}
if {$serving ne "1728x1080"} { lc_fail "the compositor serves $serving, not the fitted 1728x1080" }
set what "the login"
lc_login michael correct-horse-battery-staple-v1
wait_dims "1728 1080" "the boot's fitted mode"
wait_cells 172 49 "the boot's fitted mode"
wait_redraw "the boot's fitted mode"
lc_pass "display: a host of 3456x2160 boots at 1728x1080 with the console on it"

# ---------- follows ----------
tell 2000x1280
follow_expect {tapestryd: display event \d+: asking the host} "the event is taken up"
follow_expect [begun 1728x1080 2000x1280 direct] "the change begins from the direct state"
follow_expect [up 2000x1280] "a size that can be a mode is the mode"
follow_expect [followed 2000x1280] "the event is followed to 2000x1280"
wait_dims "2000 1280" "followed to 2000x1280"
wait_cells 200 58 "followed to 2000x1280"
wait_redraw "followed to 2000x1280"
lc_pass "display: followed the host to 2000x1280"

tell 5120x2880
follow_expect {tapestryd: mode 2560x1440 for a display of 5120x2880} "a size that cannot be a mode is halved"
follow_expect [begun 2000x1280 2560x1440 direct] "the change begins from the direct state"
follow_expect [up 2560x1440] "the halved mode is up"
follow_expect [followed 2560x1440] "the event is followed to half of 5120x2880"
wait_dims "2560 1440" "followed to half of 5120x2880"
wait_cells 256 65 "followed to half of 5120x2880"
wait_redraw "followed to half of 5120x2880"
lc_pass "display: a host of 5120x2880 is followed at 2560x1440"

tell 0x0
# A host with no size is an answer, not a device that did not answer: the mode
# stands and the host is not asked again.
follow_expect {tapestryd: display event \d+: no display to follow; 2560x1440 stands} "a host with no size is not followed"
wait_dims "2560 1440" "the mode stands"
wait_cells 256 65 "the mode stands"
wait_redraw "the mode stands"
lc_pass "display: a host that tells no size leaves the mode standing"

tell 800x600 900x700 1000x640 --gap-ms 20
follow_expect [up 1000x640] "a train ends at its last size"
follow_expect [followed 1000x640] "the train's last event is followed"
wait_dims "1000 640" "followed a train to 1000x640"
wait_cells 100 29 "followed a train to 1000x640"
wait_redraw "followed a train to 1000x640"
lc_pass "display: a train of three sizes ends at the last"

tell 640x400
follow_expect [begun 1000x640 640x400 direct] "the change begins from the direct state"
follow_expect [up 640x400] "a small size is a mode"
follow_expect [followed 640x400] "the event is followed to 640x400"
wait_dims "640 400" "followed to 640x400"
wait_cells 64 18 "followed to 640x400"
wait_redraw "followed to 640x400"
lc_pass "display: followed the host down to 640x400"

file delete -force $ppm
set what "the shutdown"
lc_quit
file delete -force $::env(THYLACINE_VNC_SOCKET)
lc_pass "ls-display-follow: a fitted first mode, four follows and a refusal"
exit 0
