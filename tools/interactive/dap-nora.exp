#!/usr/bin/expect -f
# tools/interactive/dap-nora.exp -- Stage 8e-3e: nora's in-editor `:debug`
# surface, over a real PTY.
#
# Proves the WIRING no host test can reach: the `:` debug grammar -> the editor's
# DapRequest axis -> nora's dap_host -> Ambush over piped stdio -> the status
# line. dap_host is I/O glue (like lsp_host), so it is unit-untestable; the
# dap-probe already proves parley::dapc drives real Ambush end to end, and THIS
# proves the EDITOR LOOP drives it.
#
# nora runs POST-pivot, so it reaches Ambush + the debuggee at /goroot/bin --
# baked to the pool beside the Go toolchain (build_go_goroot), on the login PATH.
# We launch nora, `:debug` the baked target, break at main.parkLoop (a name
# breakpoint -> a kernel hardware breakpoint, I-12/I-36), continue into it, then
# `:print main.Sentinel`, asserting nora's status shows the EXACT value Ambush
# read from the stopped target's memory.
#
# The assertion rides the same principle as ls-7: nora draws blind on the
# alt-screen, but kaua's cell-diff emits a status-line value as a contiguous
# same-styled run, so the 18-digit sentinel appears in the byte stream. It is a
# value nothing else prints -- unambiguous proof the whole path carried it.
#
# The teardown legs (8e-3e's `:kill` was best-effort until 2026-10-28) prove
# each way a session ends -- `:kill`, `:debug` over a live session, quitting
# nora -- goes through Ambush's disconnect, so Ambush ends its own debuggee and
# the kernel never has to (no `proc: orphan ... name="ambush-child"` line).
#
# HVF-only: the LS-CI tcg default wedges at a kernel boot probe (task #70,
# pre-existing, NOT nora); the dev-loop accel is hvf, where ls-7 + the debugger
# run. Drive it with THYLACINE_ACCEL=hvf; the wrapper's retry absorbs jitter.

source [file join [file dirname [info script]] lib.exp]

set ::dbg_file "/home/michael/dap-nora.txt"

lc_boot
lc_login michael correct-horse-battery-staple-v1

# Pre-create the buffer file (the proven ls-7 launch: edit an EXISTING file, so
# the orthogonal walk-miss/NotFound gap is out of scope). A .txt, not a .go, so
# no gopls spawns -- the debug path is the subject (gopls + Ambush coexist by
# construction, both Option<Host> in one poll loop, but that is not tested here).
lc_send "echo > $::dbg_file"
sleep 1

lc_send "nora $::dbg_file"
# Let nora launch: ut RAWs the console + Inherits fd 0/1/2 -> nora enters the
# alt-screen + starts reading fd 0.
sleep 2

# Start the debugger on the baked target. Ambush REVENANT-execs ambush-child,
# attaches, and (stopOnEntry) halts it at entry. Generous: launching + attaching
# a real Go binary is the slow step.
lc_step "nora: :debug the baked target"
send ":debug /goroot/bin/ambush-child\r"
sleep 4

# Set a function breakpoint (queued if the handshake is mid-flight; armed at the
# `initialized` event either way), then continue from the entry stop into it.
lc_step "nora: :break main.parkLoop"
send ":break main.parkLoop\r"
sleep 2
lc_step "nora: :cont into the breakpoint"
send ":cont\r"

# THE GATE. On the stop, dap_host auto-fetched the stack, so a status naming the
# FRAME + its SOURCE proves the whole state machine end to end: :debug spawned
# Ambush and ran initialize -> launch -> the `initialized` event ->
# configurationDone; :break set the function breakpoint; :cont continued from the
# entry stop; the `stopped` event landed; the auto-stack resolved the frame; and
# the status formatted it. Everything except `evaluate` -- which dap-probe proves
# on every boot -- rides this one line. The "(child.go" form is stop-specific: a
# breakpoint-SET status carries no file:line, so this cannot match the earlier
# `:break` echo. This checkpoint arrives BEFORE the heavier `:print` redraw, the
# window where the serial bridge (#78) is prone to dying under HVF.
# 8f-3b: the stop expanded the dashboard, and the Call Stack tile now shows the
# unified user->kernel stack. On the stop, dap_host read the debuggee's
# /proc/<pid>/kstack (the pid from the DAP `process` event) and appended the
# symbolized kernel frames, so the ember "-- kernel --" divider renders. The
# divider label is unique to this render (nothing else prints "kernel"), and it
# sits in the sidebar (upper-right) -- emitted in the byte stream BEFORE the
# bottom-of-screen status line, so it is strictly less exposed to the #78 bridge
# window than the parkLoop gate below. debug-probe proves the kstack read on
# every boot; THIS proves nora's live dashboard lights up the cross-boundary
# stack end to end.
lc_expect "kernel" "nora shows the -- kernel -- cross-boundary stack divider (8f-3b)"
lc_expect "parkLoop (child.go" "nora shows the stop at main.parkLoop"
lc_pass "8e-3e + 8f-3b: nora :debug drove Ambush -- stopped at main.parkLoop with the cross-boundary -- kernel -- divider (handshake + break + continue + stop + auto-stack + kstack + status)"

# BEST-EFFORT: `:print` through nora, for the transcript. `evaluate` is
# dap-probe-proven, so a missing sentinel is only a note. An EOF here is a FAIL,
# though: the teardown legs below carry this scenario's other proof, and an
# attempt that never reached them verified nothing about them.
lc_step "nora: :print main.Sentinel (best-effort)"
send ":print main.Sentinel\r"
set timeout 12
expect {
    -ex "768901734683508737" { lc_step "bonus: :print showed the sentinel through nora" }
    -re {EXTINCTION:}        { lc_extinction_fail "extinction during :print" }
    timeout                  { lc_step "note: sentinel not observed this attempt; evaluate is dap-probe-proven" }
    eof                      { lc_fail "serial bridge died at :print, before the teardown legs" }
}

# THE TEARDOWN LEGS. Each session must end through Ambush: DAP disconnect, Delve
# kills and reaps the debuggee, then exits. Killing Ambush first leaves the
# debuggee to the kernel's die-with-launcher rule (EXITKILL), which reparents it
# to init and prints `proc: orphan pid=N name="ambush-child" (parent ...
# "ambush" exiting)` -- the line every leg must NOT show. Each leg starts from a
# session with a live debuggee (a stop was seen), so the absence is about a
# debuggee that existed. The status line and the kernel's orphan line reach the
# console by different paths, so their order is not fixed: after a leg's
# positive token the watch goes on for a quiet window.
#
# A positive token is found in the byte stream only if kaua's cell diff emits it
# whole. The diff skips a cell whose character the previous frame already held
# there and moves the cursor past it, so a status drawn over another arrives
# split wherever the two share a character in the same column (the status line
# centres its message). A split token times out, so this can only fail, never
# pass falsely. "ending debugging ..." was chosen to share no column with "debug
# session ended" on the 128-column status line; re-check that pair if either
# text changes.
set ::dbg_orphan_re {orphan pid=[0-9]+ name="ambush-child"}
# When a leg sent its command. An orphan line names the time since: a kill sent
# with the disconnect lands within milliseconds, the 2 s deadline's kill near
# 2000 ms.
set ::dbg_t0 [clock milliseconds]
proc dbg_sent {} { set ::dbg_t0 [clock milliseconds] }
proc dbg_ms {} { return [expr {[clock milliseconds] - $::dbg_t0}] }

proc dbg_end_clean {token phase} {
    set timeout 30
    expect {
        -re $::dbg_orphan_re { lc_fail "$phase: the debuggee was orphaned (\[$expect_out(0,string)\], [dbg_ms] ms after the send) -- EXITKILL ended it, not ambush" }
        -ex $token           { lc_step "saw: $phase (\[$token\])" }
        -re {EXTINCTION:}    { lc_extinction_fail "kernel extinction during '$phase'" }
        timeout              { lc_fail "timeout (30s) waiting for \[$token\] during '$phase'" }
        eof                  { lc_fail "unexpected EOF during '$phase'" }
    }
    set timeout 4
    expect {
        -re $::dbg_orphan_re { lc_fail "$phase: the debuggee was orphaned (\[$expect_out(0,string)\], [dbg_ms] ms after the send) after \[$token\] -- EXITKILL ended it, not ambush" }
        -re {EXTINCTION:}    { lc_extinction_fail "kernel extinction during '$phase'" }
        timeout              { lc_step "saw: $phase -- no ambush-child orphan within 4 s" }
        eof                  { lc_fail "unexpected EOF during '$phase' (quiet window)" }
    }
}

# Leg 1, `:kill`: asynchronous -- the editor keeps running while Ambush ends
# the session; "debug session ended" is set only once Ambush answered the
# disconnect and exited.
lc_step "teardown leg 1: :kill"
send ":kill\r"
dbg_sent
dbg_end_clean "debug session ended" "leg 1: :kill ends the session through ambush"

# Leg 2, `:debug` over a live session: the old session ends first, then the new
# one launches. Session B's entry stop is the positive control; settle past its
# redraws so its status cannot stand in for session C's.
lc_step "teardown leg 2: :debug, then :debug again over the live session"
send ":debug /goroot/bin/ambush-child\r"
dbg_sent
dbg_end_clean "stopped: entry" "leg 2: session B stopped at entry"
sleep 2
set timeout 1
expect {
    -re $::dbg_orphan_re { lc_fail "leg 2: an ambush-child orphan before the relaunch (\[$expect_out(0,string)\])" }
    -re {.+}             { exp_continue }
    timeout              {}
    eof                  { lc_fail "unexpected EOF settling session B" }
}
send ":debug /goroot/bin/ambush-child\r"
dbg_sent
dbg_end_clean "stopped: entry" "leg 2: session B ended through ambush, session C stopped at entry"

# Leg 3, quit with session C live: nora's exit waits (bounded) for the same
# end. The echo runs only once nora has exited; its output, after a newline,
# cannot be the typed command line.
lc_step "teardown leg 3: :q! with the session live"
send ":q!\r"
dbg_sent
sleep 3
lc_send "echo dbg-quit-done"
set timeout 30
expect {
    -re $::dbg_orphan_re { lc_fail "leg 3: the debuggee was orphaned (\[$expect_out(0,string)\], [dbg_ms] ms after :q!) -- EXITKILL ended it, not ambush" }
    -re {\ndbg-quit-done} { lc_step "saw: leg 3: nora exited, ut ran the echo" }
    -re {EXTINCTION:}    { lc_extinction_fail "kernel extinction during leg 3" }
    timeout              { lc_fail "timeout (30s) waiting for the echo after :q!" }
    eof                  { lc_fail "unexpected EOF during leg 3" }
}
set timeout 4
expect {
    -re $::dbg_orphan_re { lc_fail "leg 3: the debuggee was orphaned (\[$expect_out(0,string)\], [dbg_ms] ms after :q!) after nora exited" }
    -re {EXTINCTION:}    { lc_extinction_fail "kernel extinction during leg 3" }
    timeout              { lc_step "saw: leg 3 -- no ambush-child orphan within 4 s" }
    eof                  { lc_fail "unexpected EOF during leg 3 (quiet window)" }
}
lc_pass "dap-nora teardown: :kill, :debug over a live session and :q! each ended the debuggee through ambush (no orphan)"

lc_step "quit qemu (Ctrl-A x)"
catch { send "\001x" }
expect { eof {} timeout {} }
lc_vm_kill
lc_pass "LS-CI dap-nora: nora in-editor :debug verified (stop at main.parkLoop; three teardowns through ambush)"
exit 0
