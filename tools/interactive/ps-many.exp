#!/usr/bin/expect -f
# tools/interactive/ps-many.exp -- the process listing with more Procs alive
# than one read of /ctl/procs holds.
#
# /ctl/procs is rendered into one 4096-byte buffer, about sixty rows. ps and
# prowl took it for the whole set until they moved to /proc's directory, whose
# listing has no such bound, and /ctl/procs now ends with a cut line when a row
# did not fit. This scenario starts seventy sleeps on a booted system and
# asserts:
#   - /ctl/procs has no cut line on the small system and ends with it on the
#     large one. The pair is one variable apart: a line that is always there,
#     or never, fails one leg. cat reads to end of file and every read renders
#     the file afresh, so when a later rendering is longer cat also prints its
#     last bytes: what follows the cut line must not end on a row. cat cannot
#     tell a first rendering without its cut line from one with it when the
#     second rendering supplies exactly that line (the bytes are the same);
#     the kernel test devctl.procs_rows_whole holds every size to it. The small
#     leg holds while the booted system fits one read (about sixty Procs).
#   - every pid /proc lists both before and after a ps is in that ps. Such a
#     Proc was alive throughout the listing (pids are never reused), and the
#     listing owes it a row. Reading the sixty rows that fit omits the rest.
#   - a program whose file name holds a space shows '?' for it in its status
#     and in ps: the name is printed into line- and column-shaped text, and
#     has one alphabet.
source [file join [file dirname [info script]] lib.exp]

lc_boot
lc_login michael correct-horse-battery-staple-v1

set cutline {\(cut: more processes than one read holds; /proc lists them all\)}

# Run `cmd` and collect group 1 of every line `rowre` matches.
proc pids_of {cmd rowre leg} {
    lc_send "$cmd; echo many-$leg-end"
    set timeout 60
    set pids {}
    expect {
        -re $rowre { lappend pids $expect_out(1,string); exp_continue }
        -re "\[\r\n\]many-$leg-end" {}
        -re {EXTINCTION:} { lc_extinction_fail "extinction during `$cmd` ($leg)" }
        timeout           { lc_fail "no end of `$cmd` ($leg)" }
        eof               { lc_fail "qemu exited during `$cmd` ($leg)" }
    }
    return $pids
}

# Start `cmd` in the background and return its pid from the shell's job line.
proc start_job {cmd what} {
    lc_send "$cmd &"
    set timeout 30
    set pid ""
    expect {
        -re {\[\d+\][ \t]+(\d+)\r?\r?\n} { set pid $expect_out(1,string) }
        -re {EXTINCTION:} { lc_extinction_fail "extinction starting $what" }
        timeout           { lc_fail "no `\[N\] pid` job line for $what" }
        eof               { lc_fail "qemu exited starting $what" }
    }
    return $pid
}

# ls prints one name per line; a directory may carry its classify suffix.
set ls_row {\n([0-9]+)/?\r}
set ps_row {\n([0-9]+) {4}[0-9]+ {4}[^ \r\n]+ {4}[A-Z?]+ {4}}
# One whole /ctl/procs row: nine columns, the last a number or `-`.
set row9 {[0-9]+ +[0-9]+ +[^ \r\n]+ +[A-Z?]+ +[0-9]+ +[0-9]+ +[0-9]+ +[0-9]+ +(?:[0-9]+|-)}

# ---- (1) a freshly booted system fits one read: no cut line -----------------
lc_send "cat /ctl/procs; echo many-small-end"
set timeout 30
set saw_kproc 0
expect {
    -re {\n0 +0 +kproc } { set saw_kproc 1; exp_continue }
    -re $cutline      { lc_fail "/ctl/procs carries the cut line on a freshly booted system (1)" }
    -re "\[\r\n\]many-small-end" {}
    -re {EXTINCTION:} { lc_extinction_fail "extinction reading /ctl/procs (1)" }
    timeout           { lc_fail "no end of /ctl/procs (1)" }
    eof               { lc_fail "qemu exited reading /ctl/procs (1)" }
}
if {!$saw_kproc} { lc_fail "no kproc row in /ctl/procs (1)" }
lc_pass "ps-many(1): /ctl/procs holds a freshly booted system whole, with no cut line"

# ---- (2) seventy more Procs: the table is cut and says so -------------------
set sleeps {}
for {set i 1} {$i <= 70} {incr i} {
    lappend sleeps [start_job "sleep 900" "sleep $i"]
}
lc_send "cat /ctl/procs; echo many-large-end"
set timeout 30
set table ""
set after_cut ""
expect {
    -re "\nPID +PPID +NAME\[^\n\]*\n((?:$row9\r*\n)+)$cutline\r*\n((?:\[^\n\]*\n)*)many-large-end" {
        set table $expect_out(1,string)
        set after_cut $expect_out(2,string)
    }
    -re "\[\r\n\]many-large-end" {
        if {[regexp -- $cutline $expect_out(buffer)]} {
            lc_fail "/ctl/procs with seventy more Procs: its first table is not a header, whole rows and then the cut line (2)"
        }
        lc_fail "/ctl/procs with seventy more Procs ends without the cut line (2)"
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction reading /ctl/procs (2)" }
    timeout           { lc_fail "no end of /ctl/procs (2)" }
    eof               { lc_fail "qemu exited reading /ctl/procs (2)" }
}
# One rendering lists a Proc once. A pid twice says the rows came from two:
# a first table with no cut line, and the end of a later one after it.
set seen {}
foreach {- pid} [regexp -all -inline -line {^([0-9]+) } [string map [list "\r" ""] $table]] {
    if {[lsearch -exact $seen $pid] >= 0} {
        lc_fail "/ctl/procs with seventy more Procs lists pid $pid twice before its cut line: two renderings, the first without the line (2)"
    }
    lappend seen $pid
}
# What cat printed after that table. Its later reads return the last bytes of
# later renderings, and each of those ends with a cut line: a row there is
# followed by rows and then a whole cut line, and the last such line is a cut
# line's end (an empty line is one: the line's newline alone). A line that is
# neither is a row's tail from a later rendering, or another program's, written
# to the same console; it says nothing about how the table ends.
set plain [string map [list "\\" ""] $cutline]
set after_cut [string map [list "\r" ""] $after_cut]
set last ""
set ends 0
set rows 0
set others 0
foreach line [lrange [split $after_cut "\n"] 0 end-1] {
    set at [expr {[string length $plain] - [string length $line]}]
    if {$at >= 0 && [string range $plain $at end] eq $line} {
        if {$last eq "row" && $at != 0} {
            lc_fail "/ctl/procs with seventy more Procs: a row after the cut line is followed by part of a cut line, `$line` (2)"
        }
        incr ends
        set last cut
    } elseif {[regexp "^$row9\$" $line]} {
        incr rows
        set last row
    } else {
        incr others
        lc_step "ps-many(2): after the cut line, a line that is neither a whole row nor a cut line's end: `[string range $line 0 79]`"
    }
}
if {$last eq "row"} {
    lc_fail "/ctl/procs with seventy more Procs: a row follows the cut line and no cut line follows it (2)"
}
lc_pass "ps-many(2): /ctl/procs with more rows than fit ends its table of [llength $seen] whole rows with the cut line (cat's read to end of file printed [string length $after_cut] more byte(s): $ends cut line end(s), $rows whole row(s), $others other line(s))"

# ---- (3) ps lists every Proc alive throughout it ----------------------------
set before [pids_of "ls /proc | cat" $ls_row "ls1"]
set shown  [pids_of "ps --color=never --beacon=never" $ps_row "ps"]
set after  [pids_of "ls /proc | cat" $ls_row "ls2"]
if {[llength $before] <= [llength $sleeps]} {
    lc_fail "/proc lists [llength $before] pids with [llength $sleeps] sleeps and their shell alive: {$before} (3)"
}
set owed {}
foreach p $before { if {[lsearch -exact $after $p] >= 0} { lappend owed $p } }
foreach p $sleeps {
    if {[lsearch -exact $owed $p] < 0} { lc_fail "/proc did not list sleep $p in both listings (3)" }
}
set missing {}
foreach p $owed { if {[lsearch -exact $shown $p] < 0} { lappend missing $p } }
if {[llength $missing] > 0} {
    lc_fail "ps omitted [llength $missing] of the [llength $owed] Procs alive throughout it: {$missing} (3)"
}
lc_pass "ps-many(3): ps listed all [llength $owed] Procs alive throughout it ([llength $shown] rows)"

# ---- (4) a file name with a space: one alphabet for the name ----------------
lc_send {cp /bin/sleep '/tmp/a b'}
lc_send {chmod 755 '/tmp/a b'}
set odd [start_job {'/tmp/a b' 900} "the program named `a b`"]
lc_send "cat /proc/$odd/status"
lc_expect_re {name: +a\?b\r*\n} "the status shows the space in the file name as ? (4)"
lc_send "ps --color=never --beacon=never; echo many-name-end"
set timeout 60
set saw_row 0
expect {
    -re "\n$odd {4}\[0-9\]+ {4}a\\?b {4}ALIVE {4}" { set saw_row 1; exp_continue }
    -re "\[\r\n\]many-name-end" {}
    -re {EXTINCTION:} { lc_extinction_fail "extinction during ps (4)" }
    timeout           { lc_fail "no end of ps (4)" }
    eof               { lc_fail "qemu exited during ps (4)" }
}
if {!$saw_row} { lc_fail "no row for pid $odd named a?b in ps (4)" }
lc_pass "ps-many(4): a space in a program's file name shows as ? in its status and its ps row"

lc_pass "ps-many: ps lists every Proc where /ctl/procs is cut, the cut is said, and a name has one alphabet"
lc_quit
exit 0
