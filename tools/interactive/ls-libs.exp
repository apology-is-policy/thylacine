#!/usr/bin/expect -f
# tools/interactive/ls-libs.exp -- Boosty B-3 over a real PTY: the browser
# libraries' compiled upstream test programs run on the device as the logged-in
# user, from the pool's /var (THYLACINE_BAKE_LIBS=1; build_lib_tests stages
# them). The exit bar is dec-2026-10-14-b3-test-bar: each library's compiled C
# tests, with their data; the suites an interpreter drives are listed as
# skipped in docs/browser-status.md. docs/BROWSER-DESIGN.md section 9.
#
# Each leg runs one program with its output in a file under /tmp (a full run
# prints thousands of lines, which the console need not carry), then asserts
# TWO things, because either alone is satisfied by a broken run:
#   - the exit status is 0 (a crash, a snare, or a counted failure is not), and
#   - the program's own all-passed verdict is in its log (a program that exits
#     0 having run nothing prints no verdict).
# Every leg runs, so one boot reports each program; a red leg prints its log's
# last 40 lines (each program ends with its failure summary) -- a muster leg
# first prints every `muster: FAIL` line, since one failing test's output can
# push the others out of a tail -- and the scenario fails after the last leg if
# any was red.
#
#   icu-c   ICU's C API tests (cintltst): "[All tests passed successfully...]"
#   icu-cxx ICU's C++ API tests (intltest): "OK: All tests passed without error."
#           Data errors count: intltest runs without -w, so a test that cannot
#           find its data fails rather than warns.
#   libpng, libjpeg-turbo, libwebp (B-3d), libxml2 (B-3e), freetype and
#   harfbuzz (B-3f), fontconfig (B-3g):
#           /var/lib_tests/bin/muster runs each library's CTest or meson list
#           (tools/libtests-manifest.py wrote it from upstream's registration;
#           libwebp's from tools/libtests-webp.json),
#           ending "muster: <lib>: N of N passed". N is read from the host's
#           build/pouch/lib-tests/<lib>.count, the build's own count of the
#           manifest, so a device run of fewer tests than the build listed
#           cannot match.
#   fontconfig  (B-3g) fontconfig itself on the device's own config
#           (/etc/fonts) and faces (/lib/font), as the logged-in user, whose
#           font cache starts empty: each generic family resolves to the face
#           upstream's 60-latin.conf prefers among /lib/font's (sans-serif
#           DejaVu Sans, serif DejaVu Serif, monospace DejaVu Sans Mono; a
#           native build of the pinned fontconfig over the same faces answers
#           the same); fc-list lists every face the bake staged and
#           fc-conflist loads every conf.d link (the build's fonts.count and
#           confd.count); the first lookup scans /lib/font and writes one
#           cache file and its CACHEDIR.TAG into $home/.cache/fontconfig,
#           leaving no lock, and nothing under /var/cache (there is no system
#           cache); the second reads that cache rather than scanning. One
#           file, where Linux shows four names: fontconfig also links each
#           older cache version's name to it with symlink(), which this
#           system does not make (dec-2026-10-20-native-lstat-readlink),
#           and goes on.
#           fontconfig takes its cache lock with link() and falls back to a
#           directory only on EPERM, ENOTSUP or EACCES, so a libc whose link
#           answers ENOSYS writes no cache (Pouch 0062): the cache checks go
#           red while the families stay green.
#
# EVERY verdict is grepped in lower case (the device's grep matches a literal,
# -i for case) and asserted in UPPER case through `tr`: the terminal echoes
# what is typed, and an expect the echo can satisfy proves nothing. ut
# word-splits `icuc-$status` into two words, so the status reads "ICUC- 0".
#
# G-3: HVF -- CPU-bound and boot-dominated, with no GIC/timer/BAR surface of
# its own.
set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

if {![lc_pool_has ICUTEST]} {
    puts "LS-CI SKIP: this pool holds no library tests (build/pool-contents has no\
          ICUTEST payload -- THYLACINE_BAKE_LIBS unset, or a pool baked before it existed)"
    exit 77
}
foreach need {ICUDATA MF2DATA MUSTER PNGTESTS JPEGTESTS WEBPTESTS XMLTESTS XMLCONF FTTESTS FTFONT HBTESTS HBFONTS
              FCTESTS FCDATA FCCONF FCAVAIL FCDTD FCMATCH FONTSANS FONTSERIF FONTMONO FONTPLEX} {
    if {![lc_pool_has $need]} {
        puts "LS-CI FAIL: this pool holds ICU's tests but not their $need payload\
              (a partial bake; rebake with THYLACINE_BAKE_LIBS=1)"
        exit 1
    }
}

lc_boot
lc_login michael correct-horse-battery-staple-v1
lc_send "cd /tmp"

# One program's leg: run it into its log, read back the status, then the
# verdict line. `verdict` is lower case as typed; the log holds it in mixed
# case, so the grep is case-blind and the match is on the upper-cased line.
set ::lib_red {}
proc lib_leg {tag prog log verdict {fails {}}} {
    global lc_cmd_timeout
    set tagU [string toupper $tag]
    lc_send "$prog > $log; echo $tag-\$status | tr a-z A-Z"
    expect {
        -ex "$tagU- 0\r"           { lc_step "saw: $prog exited 0" }
        -re "$tagU- (\[1-9\]\[0-9\]*)" {
            set rc $expect_out(1,string)
            set show "tail -n 40 $log"
            if {$fails ne {}} { set show "grep '$fails' $log; $show" }
            lc_send $show
            # Read (and so log) the tail: output nobody expects for never
            # reaches the transcript.
            expect -timeout 5 timeout {}
            lappend ::lib_red "$prog exited $rc"
            return 0
        }
        -re {EXTINCTION:}          { lc_extinction_fail "kernel extinction during $prog" }
        timeout                    { lc_fail "timeout (${lc_cmd_timeout}s) waiting for $prog's exit" }
        eof                        { lc_fail "unexpected EOF during $prog" }
    }
    lc_run_expect "grep -i '$verdict' $log | tr a-z A-Z" [string toupper $verdict]
    return 1
}

# The test trees are SYSTEM's, on the pool, and a create through the pool's 9P
# session is admitted only to the session's two ends, both system
# (IDENTITY-DESIGN 9.7 M7). So each directory a test writes into takes a layer
# this user owns: `bind -bc` puts it first in a union whose creates land in it,
# while reads still find the baked files beneath. The binds are this shell's,
# and every leg's program inherits them.
#
# A refused bind prints ut's $errstr and the shell's mount table, and before
# each bind the layer records the state a refusal would be judged in: how many
# entries the shell's mount table holds (a union's first mount installs two;
# the cap is PGRP_MOUNT_CAP, 1024) and whether the point resolves for this
# user. A child inherits the shell's table, so `ns` run from the shell counts
# the shell's entries.
proc lib_ns_count {tag} {
    set c -1
    set up [string toupper $tag]
    lc_send "echo nsn$tag-\$(ns --color=never | grep -c 'mount ') | tr a-z A-Z"
    expect {
        -re "NSN$up- ?(\[0-9\]+)\r"  { set c $expect_out(1,string) }
        -re {EXTINCTION:}             { lc_extinction_fail "kernel extinction counting mount entries" }
        timeout                       { lc_fail "timeout counting mount entries ($tag)" }
        eof                           { lc_fail "unexpected EOF counting mount entries ($tag)" }
    }
    lc_step "saw: $c mount entries ($tag)"
    return $c
}
proc lib_layer {n dir} {
    set layer /tmp/ls-libs/w$n
    set before [lib_ns_count $n]
    set resolves unknown
    lc_send "stat --color=never $dir; echo pt$n-\$status | tr a-z A-Z"
    expect {
        -ex "PT$n- 0\r"        { set resolves yes }
        -re "PT$n- \[1-9\]"    { set resolves no }
        -re {EXTINCTION:}      { lc_extinction_fail "kernel extinction resolving $dir" }
        timeout                { lc_fail "timeout resolving $dir" }
        eof                    { lc_fail "unexpected EOF resolving $dir" }
    }
    lc_send "mkdir -p $layer; bind -bc $layer $dir; echo layer$n-\$status | tr a-z A-Z"
    expect {
        -ex "LAYER$n- 0\r"     { lc_step "saw: $layer layered over $dir" }
        -re "LAYER$n- \[1-9\]" {
            lc_send "echo \$errstr"
            expect -timeout 5 timeout {}
            lc_send "ns --color=never"
            expect -timeout 5 timeout {}
            lc_fail "bind -bc $layer $dir failed with $before mount entries before it and the point resolving: $resolves (its errstr and the table are above)"
        }
        -re {EXTINCTION:}      { lc_extinction_fail "kernel extinction while layering $dir" }
        timeout                { lc_fail "timeout layering $dir" }
        eof                    { lc_fail "unexpected EOF layering $dir" }
    }
}
set wf [file join $::lc_repo build pouch lib-tests writable]
if {[catch {set fh [open $wf r]; set wdirs [split [string trim [read $fh]] "\n"]; close $fh}] || [llength $wdirs] < 1} {
    lc_fail "no list of the directories the tests write into at $wf (the bake and this tree disagree; rebake)"
}
set n 0
foreach d [linsert $wdirs 0 /var/icu_tests/test/testdata/out] {
    lib_layer [incr n] $d
}
lib_ns_count end

# A full ICU run is minutes, not seconds.
set ::lc_cmd_timeout 1800
set timeout 1800

if {[lib_leg icuc /var/icu_tests/bin/cintltst /tmp/icu-c.log "all tests passed successfully"]} {
    lc_pass "ls-libs(icu-c): cintltst exit 0, all tests passed"
}
if {[lib_leg icux /var/icu_tests/bin/intltest /tmp/icu-cxx.log "all tests passed without error"]} {
    lc_pass "ls-libs(icu-cxx): intltest exit 0, all tests passed"
}
# The muster lists: each manifest's count as the build wrote it.
# A count the build wrote beside the stage (build/pouch/lib-tests/<name>).
proc lib_build_count {name} {
    set cf [file join $::lc_repo build pouch lib-tests $name]
    if {[catch {set fh [open $cf r]; set n [string trim [read $fh]]; close $fh}] || ![string is integer -strict $n] || $n < 1} {
        lc_fail "no count at $cf (the bake and this tree disagree; rebake)"
    }
    return $n
}
foreach lib {libpng libjpeg-turbo libwebp libxml2 freetype harfbuzz fontconfig} tag {png jpg webp xml ft hb fc} {
    set n [lib_build_count $lib.count]
    if {[lib_leg $tag "/var/lib_tests/bin/muster /var/lib_tests/$lib.manifest" /tmp/muster-$lib.log "$lib: $n of $n passed" "muster: FAIL"]} {
        lc_pass "ls-libs($lib): muster exit 0, $n of $n passed"
    }
}

# fontconfig on the device's own config and faces (the header). The muster
# tests above have already written a cache as this user, so the leg removes
# it first. FC_DEBUG reaches fc-list through /env, which every child copies
# at spawn (ut passes no envp): 128 prints each directory scanned, 16 each
# cache's validity check.
set ::lc_cmd_timeout 300
set timeout 300
# One value a device command prints, read through a tag of its own and
# upper-cased, so the typed command's echo cannot satisfy it.
proc lib_value {tag cmd} {
    set up [string toupper $tag]
    lc_send "echo $tag-\$($cmd) | tr a-z A-Z"
    expect {
        -re "$up- ?(\[^\r\n\]*)\r"  { set v [string trim $expect_out(1,string)] }
        -re {EXTINCTION:}          { lc_extinction_fail "kernel extinction during $cmd" }
        timeout                    { lc_fail "timeout waiting for $cmd ($tag)" }
        eof                        { lc_fail "unexpected EOF during $cmd ($tag)" }
    }
    lc_step "saw: $tag = $v"
    return $v
}
# "yes" when a count is at least n; else what it was.
proc lib_atleast {v n} {
    if {[string is integer -strict $v] && $v >= $n} { return yes }
    return "no ($v)"
}
# A value against what it must be; a miss is a red leg, not an abort.
proc lib_check {what got want} {
    if {$got eq $want} {
        lc_pass "ls-libs(fontconfig): $what"
    } else {
        lappend ::lib_red "fontconfig: $what -- got '$got'"
    }
}
proc lib_fc_list {tag log} {
    lc_send "echo 144 > /env/FC_DEBUG; /usr/bin/fc-list > $log; echo $tag-\$status | tr a-z A-Z; rm /env/FC_DEBUG"
    expect {
        -ex "[string toupper $tag]- 0\r"     { lc_step "saw: fc-list exited 0 ($tag)" }
        -re "[string toupper $tag]- \[1-9\]" { lappend ::lib_red "fontconfig: fc-list ($tag) exited non-zero" }
        -re {EXTINCTION:}                   { lc_extinction_fail "kernel extinction during fc-list ($tag)" }
        timeout                             { lc_fail "timeout waiting for fc-list ($tag)" }
        eof                                 { lc_fail "unexpected EOF during fc-list ($tag)" }
    }
}
set fcfaces [lib_build_count fonts.count]
set fcconfd [lib_build_count confd.count]
# ut joins a variable to the text after it only through ^ (UTOPIA-SHELL-DESIGN
# 6.7): `$home/.cache` is two words, and `rm -rf` would take the whole home.
set fccache "\$home^/.cache/fontconfig"
lc_send "rm -rf $fccache; echo fcrm-\$status | tr a-z A-Z"
expect {
    -ex "FCRM- 0\r"  { lc_step "saw: $fccache removed" }
    -re "FCRM- \[1-9\]" { lc_fail "could not remove $fccache before the fontconfig leg" }
    timeout          { lc_fail "timeout removing $fccache" }
    eof              { lc_fail "unexpected EOF removing $fccache" }
}
lib_fc_list fccold /tmp/fc-cold.log
lib_check "the first lookup scans /lib/font" [lib_atleast [lib_value fcscan1 "grep -c 'Scanning dir /lib/font' /tmp/fc-cold.log"] 1] yes
lib_check "the first lookup writes one cache file" [lib_value fccf "ls --color=never $fccache | grep -c cache-"] 1
lib_check "the first lookup writes CACHEDIR.TAG" [lib_value fctag "ls --color=never $fccache | grep -c CACHEDIR.TAG"] 1
lib_check "the cache lock is released" [lib_value fclck "ls --color=never $fccache | grep -c .LCK"] 0
lib_check "no temporary file is left" [lib_value fctmp "ls --color=never $fccache | grep -c .TMP"] 0
lc_send "stat --color=never /var/cache/fontconfig; echo fcsys-\$status | tr a-z A-Z"
expect {
    -re "FCSYS- \[1-9\]"  { lc_pass "ls-libs(fontconfig): no system cache directory" }
    -ex "FCSYS- 0\r"      { lappend ::lib_red "fontconfig: /var/cache/fontconfig exists" }
    timeout              { lc_fail "timeout looking for /var/cache/fontconfig" }
    eof                  { lc_fail "unexpected EOF looking for /var/cache/fontconfig" }
}
lib_fc_list fcwarm /tmp/fc-warm.log
lib_check "the second lookup checks the cache" [lib_atleast [lib_value fcvalid "grep -c 'FcCacheTimeValid dir' /tmp/fc-warm.log"] 1] yes
lib_check "the second lookup scans nothing" [lib_value fcscan2 "grep -c 'Scanning dir /lib/font' /tmp/fc-warm.log"] 0
lib_check "fc-list lists the $fcfaces faces" [lib_value fcfaces "/usr/bin/fc-list -f '%{file}\\n' | grep -c /lib/font/"] $fcfaces
lib_check "fc-conflist loads the $fcconfd conf.d configs" [lib_value fcconf "/usr/bin/fc-conflist | grep -c '+ /etc/fonts/conf.d/'"] $fcconfd
foreach {tag family face} {fcsans sans-serif DejaVuSans.ttf fcserif serif DejaVuSerif.ttf fcmono monospace DejaVuSansMono.ttf} {
    lib_check "fc-match $family is /lib/font/$face" [lib_value $tag "/usr/bin/fc-match -f '%{file}' $family"] [string toupper /lib/font/$face]
}
if {[llength $::lib_red]} {
    lc_fail "[join $::lib_red {; }] (each log's tail is above)"
}

lc_quit
exit 0
