#!/usr/bin/env expect
# ls-gpu-dead -- the compositor rides out a stalled GPU engine, and a dead one.
#
# A GPU command that misses lictor's 500 ms synchronous deadline STALLS the
# engine: the command fails, submissions are refused, and a retirement (a
# surface's detach or unref) parks. The engine revives when the late chain
# retires and dies when none has retired after 30 s (GPU-DESIGN 4.5.15).
# Until 2026-10-29 the first miss latched the engine dead for the boot and the
# next retirement parked forever, hanging the compositor (OPEN-BUGS
# 2026-10-29T03:54Z); then a dead engine refused at once, but a healthy device
# behind a host stall still lost the display (vote 29).
#
# THYLACINE_TEST_LATCH_DEAD=1 puts thylacine.test-latch-dead on the kernel
# command line: tapestryd arms lictor's two-shot lever, which stalls the
# engine through a synchronous query at a retirement of a resource created at
# the lever's size (97x89), so no boot probe's retirement fires it. The first
# shot's chain retires normally; the second's retirement is withheld.
#
# Leg 1 (revive) needs: the injected stall; the engine revived by the late
# chain (the instrument that tells a slow device from a dead one); the parked
# retirement run to completion, its pins released; no refusal. Leg 2 (dead),
# on a surface created after the revival (so the engine took new work), needs:
# the injected stall with its retirement withheld; the engine declared dead;
# the retirement refused with its pins kept. The compositor must answer its
# ctl before and after. The destroy write is answered either way -- the
# compositor degrades rather than failing the shell -- so only lictor's own
# lines tell the legs apart.
#
# What leg 2 cannot show: the retirement parks a few ms before the stall
# begins, so the 30 s park bound admits it at about the moment the engine
# dies, and the unreachable-quiescence arm is not what answers it here. The
# host tests pin that arm (gpu_api admission_tests).
#
# Runs under HVF on the ci image. Any GPU device will do: the park is the
# broker's, not the renderer's.

set ::env(THYLACINE_ACCEL) hvf
set ::env(THYLACINE_TEST_LATCH_DEAD) 1

source [file join [file dirname [info script]] lib.exp]

lc_boot
lc_login michael correct-horse-battery-staple-v1

# The arm is asked of the compositor's state, not of its boot line, which
# can land on either side of the login prompt.
set timeout 30
lc_send "cat /dev/tapestry/ctl; echo ctl-before"
expect {
    -re {display [0-9]+ [0-9]+[^\n]*\n(.|\n)*test-latch-dead armed[^\n]*\n(.|\n)*\nctl-before} {
        lc_step "the compositor answers before the stall, with the lever armed"
    }
    -re {\nctl-before} { lc_fail "the compositor's ctl carries no display line or no armed lever (did the broker refuse the arm?)" }
    timeout { lc_fail "the compositor's ctl never answered, before any stall (30s)" }
}

# The surface ids in a plain listing, read up to the tag that ends it. A
# surface minted and never created is retired when its ctl clunks, so the
# create rides an echo of its own and the destroy needs the id the create
# made: a diff of two listings (ut redirects no brace block and duplicates
# no fd, so one fid cannot carry both verbs).
proc gd_surfaces {tag} {
    global timeout
    lc_send "ls --color=never --beacon=never /dev/tapestry/surface; echo $tag"
    set timeout 30
    expect {
        -re "\n$tag" {}
        -re {EXTINCTION:} { lc_extinction_fail "kernel extinction listing surfaces ($tag)" }
        timeout { lc_fail "the surface listing never ended ($tag, 30s)" }
        eof { lc_fail "unexpected EOF listing surfaces ($tag)" }
    }
    set buf $expect_out(buffer)
    regsub -all {\x1b\[[0-9;?]*[A-Za-z]} $buf "" buf
    set ids {}
    foreach line [split [string map [list "\r" "\n"] $buf] "\n"] {
        if {[regexp {^\s*([0-9]+)/?\s*$} $line -> n]} { lappend ids $n }
    }
    return $ids
}

# Create one surface at the lever's size; return its id.
proc gd_create {leg} {
    set before [gd_surfaces surfaces-before-$leg]
    lc_send "echo 'create 97 89' > /dev/tapestry/surface/new"
    set after [gd_surfaces surfaces-after-$leg]
    set made {}
    foreach n $after {
        if {[lsearch -exact $before $n] < 0} { lappend made $n }
    }
    if {[llength $made] != 1} {
        lc_fail "$leg: the create made [llength $made] new surfaces (before: $before; after: $after), want exactly one"
    }
    return [lindex $made 0]
}

# ---- leg 1: a stall the device recovers from ----
set sid [gd_create revive]
lc_step "revive: the create made surface $sid at the lever's size"
lc_send "echo destroy > /dev/tapestry/surface/$sid/ctl && echo destroy-ok-1; echo destroy-returned-1"
set timeout 60
expect {
    -ex "INJECTED by test-latch-dead, retirement withheld" {
        lc_fail "revive: the first shot withheld its retirement -- the lever fired out of order"
    }
    -ex "INJECTED by test-latch-dead) -- engine stalled" {
        lc_step "revive: lictor stalled the engine at the retirement"
    }
    -re {\ndestroy-returned-1} { lc_fail "revive: the destroy returned with no injected stall -- did the create make a 97x89 resource?" }
    -re {EXTINCTION:} { lc_extinction_fail "kernel extinction during the first destroy" }
    timeout { lc_fail "revive: no injected stall within 60s of the destroy -- did the create make a 97x89 resource?" }
}
# The chain retires within milliseconds, so the parked retirement runs at
# once. 15 s is well under the 30 s park bound: a retirement only the bound
# answered would be refused, which is the revival missing.
set revived 0
set retired 0
set returned 0
set timeout 15
expect {
    -ex "lictor: retirement refused on a non-quiescent engine" {
        lc_fail "revive: lictor refused the retirement -- the engine never revived"
    }
    -re {gpu synchronous chain retired [0-9]+ ms after its deadline -- engine revived} {
        set revived 1
        lc_step "revive: the late chain retired and the engine revived"
        exp_continue
    }
    -re "latch-lever resource \[0-9\]+ retired after its stall \\(pins released\\)" {
        set retired 1
        lc_step "revive: the parked retirement ran to completion, its pins released"
        if {!$returned} { exp_continue }
    }
    -re {\ndestroy-returned-1} {
        set returned 1
        if {!$retired} { exp_continue }
    }
    -re {EXTINCTION:} { lc_extinction_fail "kernel extinction after the first stall" }
    timeout { lc_fail "revive: within 15s of the stall: revived=$revived retired=$retired returned=$returned (a retirement still parked, or the compositor hung)" }
}
if {!$revived} {
    lc_fail "revive: the retirement completed but lictor never said the engine revived -- which path ran it?"
}
lc_step "revive: the destroy write was answered"

# ---- leg 2: a stall that never ends ----
set sid [gd_create dead]
lc_step "dead: the revived engine took new work (surface $sid created)"
lc_send "echo destroy > /dev/tapestry/surface/$sid/ctl && echo destroy-ok-2; echo destroy-returned-2"
set timeout 60
expect {
    -ex "INJECTED by test-latch-dead, retirement withheld" {
        lc_step "dead: lictor stalled the engine with the chain's retirement withheld"
    }
    -ex "INJECTED by test-latch-dead) -- engine stalled" {
        lc_fail "dead: the second shot did not withhold its retirement"
    }
    -re {\ndestroy-returned-2} { lc_fail "dead: the destroy returned with no injected stall" }
    -re {EXTINCTION:} { lc_extinction_fail "kernel extinction during the second destroy" }
    timeout { lc_fail "dead: no injected stall within 60s of the destroy" }
}
set withheld 0
set dead 0
set refused 0
set returned 0
set timeout 45
expect {
    -ex "retirement WITHHELD (test-latch-dead hold)" {
        set withheld 1
        exp_continue
    }
    -re {engine revived} { lc_fail "dead: the engine revived although its chain's retirement was withheld" }
    -re "latch-lever resource \[0-9\]+ retired after its stall" {
        lc_fail "dead: a retirement completed on an engine whose chain never retired"
    }
    -re {gpu engine stalled [0-9]+ ms without a retirement -- engine dead} {
        set dead 1
        lc_step "dead: the stall outlived the abandonment bound and the engine died"
        if {!($refused && $returned)} { exp_continue }
    }
    -ex "lictor: retirement refused on a non-quiescent engine" {
        set refused 1
        lc_step "dead: lictor refused the retirement, its pins kept"
        if {!($dead && $returned)} { exp_continue }
    }
    -re {\ndestroy-returned-2} {
        set returned 1
        if {!($dead && $refused)} { exp_continue }
    }
    -re {EXTINCTION:} { lc_extinction_fail "kernel extinction after the second stall" }
    timeout { lc_fail "dead: within 45s of the stall: withheld=$withheld dead=$dead refused=$refused returned=$returned" }
}
if {!$withheld} {
    lc_fail "dead: the engine died but the withheld retirement was never seen -- did the chain retire at all?"
}

set timeout 30
lc_send "cat /dev/tapestry/ctl; echo ctl-after"
expect {
    -re {display [0-9]+ [0-9]+[^\n]*\n(.|\n)*ctl-after} { lc_step "the compositor still answers its ctl" }
    -re {\nctl-after} { lc_fail "the ctl read returned without its display line" }
    timeout { lc_fail "the compositor stopped answering its ctl after the engine died (30s)" }
}
lc_pass "gpu-dead: a stalled engine revives and finishes the parked retirement; a dead one refuses it, and the compositor degrades instead of hanging"
