#!/usr/bin/expect -f
# tools/interactive/ls-gfx-session.exp -- KT-1.5d: the per-user session
# compositor (HALCYON.md 14.12). d-1a: the login-spawned bootstrap. d-1b: the
# clean display handoff (tapestryd BACKGROUNDS the console renderer aurora when
# the session leaf appears -> Direct(halcyond); FOREGROUNDS it on logout). d-2:
# ONE SESSION TILE -- the per-user halcyond spawns one kaua-term hosting `ut`,
# folds its up-pipe into the unified poll, ingests the record stream into the
# ii-a Tile model + renders it (grid tail + scrollback), routes tapestryd TEV_KEY
# to the tile, and the tile's `ut` EXITING is the REAL logout (14.11 / 14.12).
#
# GATED ON THE BAKED LEVER (the cfg-4 / ls-halcyon precedent): the pool carries
# /lib/halcyon/session = "on" only under THYLACINE_HALCYON_SESSION=1. On a
# default image login spawns ut and this scenario SKIPs cleanly (lc_quit + exit
# 0); on a lever image it proves the whole d-arc chain end to end:
#
#   d-1a  login -> per-user compositor: login authenticates, then spawns
#         /bin/halcyond --session AS the user; the session halcyond connects to
#         the SYSTEM tapestryd + presents -- "halcyond: session up NxN px",
#         printed only inside Ok(present), so the marker witnesses connect +
#         present (the M-PIN post-present-marker rule).
#   d-1b  the handoff: the session leaf appears -> tapestryd backgrounds aurora
#         (a SYSTEM leaf) -> Direct(halcyond); the full-display takeover.
#   d-2   the tile: halcyond spawns a kaua-term hosting ut, drains its up-pipe in
#         the unified poll, decodes the record stream into the Tile model --
#         "halcyond: session tile ingest live" (the ingest witness).
#   d-2   input + the REAL logout: QMP types `exit\n`; tapestryd routes it as
#         TEV_KEY to the FOCUSED session halcyond (a backgrounded console renderer
#         no longer holds input focus -- the reconcile focus transfer), halcyond
#         map_keys it down the tile's pts, ut runs `exit` -> Control::Exit ->
#         "halcyond: session tile exited (code 0) -- logout" -> halcyond returns.
#         This leg is ALSO the input-routing witness: `exit` reaches ut only if
#         focus reached the session halcyond and the down-channel works.
#   d-1b  resume: login's wait() returns -> getty -> tapestryd retires the
#         session leaf -> aurora un-backgrounds, its FRAME loop resumes, and the
#         scanout returns to Direct on the console.
#
# aurora is the pre-login console renderer (renderer absent -> aurora) and does
# NOT silence serial (no thylacine.display=gpu bootarg), so login is drivable
# over serial exactly as ls-ci; halcyond's markers ride the kernel diagnostic
# UART (t_putstr) regardless of any renderer silence. HVF like the gfx siblings;
# the GPU environment (virtio-gpu + tapestryd) is required for halcyond to
# present and is present by default (THYLACINE_DISPLAY unset -> virtio-gpu on).

set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

set repo $lc_repo
set qmp [lc_qmp_sock]

lc_boot

# Login drive (lc_login's prompt/password steps -- but the session path never
# reaches the ut "Thylacine textual shell" banner, so the shell-up arm below is
# replaced by the session/default DISCRIMINATION).
global lc_boot_timeout timeout
set timeout $lc_boot_timeout
expect {
    -ex "Thylacine login: " { lc_step "login prompt" }
    -re {EXTINCTION:}       { lc_extinction_fail "extinction before login prompt" }
    timeout                 { lc_fail "no login prompt within ${lc_boot_timeout}s" }
    eof                     { lc_fail "qemu exited before login prompt" }
}
lc_raw_send "michael\r" "login user"
expect {
    -ex "password: "  { lc_step "password prompt" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction at password prompt" }
    timeout           { lc_fail "no password prompt (username not received?)" }
    eof               { lc_fail "qemu exited at password prompt" }
}
lc_raw_send "correct-horse-battery-staple-v1\r" "login password"

# DISCRIMINATE: the session lever (proceed) vs a default image (SKIP). The two
# markers are mutually exclusive -- login spawns EITHER the session halcyond OR
# ut, never both.
expect {
    -ex "login: session compositor (halcyond) spawned" {
        lc_step "session path taken (lever image)"
    }
    -ex "Thylacine textual shell" {
        lc_step "default (ut) image -- session lever absent; SKIP"
        lc_quit
        exit 0
    }
    -ex "login incorrect"  { lc_fail "auth rejected for michael -- see ls-ci's #233 note (an echoed byte after 'password: ' truncated the passphrase)" }
    -re {EXTINCTION:}      { lc_extinction_fail "extinction during login/session spawn" }
    timeout                { lc_fail "neither session nor ut path within ${lc_boot_timeout}s" }
    eof                    { lc_fail "qemu exited during login" }
}

# --- d-1b: the handoff -- tapestryd backgrounds the console renderer ---
#
# ORDER (measured, d-1b): the background fires when halcyond's surface is HOSTED
# (during fullscreen_on), which PRECEDES halcyond's first-present "session up"
# marker -- so assert background -> Direct(halcyond) -> session up, in that order.
expect {
    -re {tapestryd: background surface [0-9]+ \(session took the display\)} {
        lc_step "tapestryd backgrounded the console renderer under the session"
    }
    -re {halcyond: FAIL session} { lc_fail "halcyond --session failed to connect/present (tapestryd absent or the present was refused)" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction before the renderer backgrounded" }
    timeout { lc_fail "tapestryd never backgrounded the console renderer (session leaf not seen?)" }
    eof     { lc_fail "qemu exited before the renderer backgrounded" }
}
expect {
    -re {tapestryd: scanout pending-direct} {
        lc_step "tapestryd -> Direct(halcyond): the full-display handoff"
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during the Direct handoff" }
    timeout { lc_fail "scanout never went Direct after backgrounding (stuck Composed?)" }
    eof     { lc_fail "qemu exited during the Direct handoff" }
}
expect {
    -ex "halcyond: session up" { lc_step "d-1a: per-user compositor connected + presented" }
    -re {halcyond: FAIL session} { lc_fail "halcyond --session failed to connect/present" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during session bringup" }
    timeout { lc_fail "halcyond: session up never appeared (the per-user compositor did not present)" }
    eof     { lc_fail "qemu exited during session bringup" }
}

# --- d-2: the tile ingests its kaua-term's record stream ---
#
# The kaua-term hosts ut on a pts, parses ut's output to a cell grid, and streams
# CellDiff/Control records up the pipe; halcyond decodes them into the Tile model
# and marks the first live ingest. This witnesses spawn + the up-pipe fold + the
# decode (the render is graphical -- proven by the present above + the boot, not
# a serial marker; pixel proof is deferred to a screendump leg).
expect {
    -ex "halcyond: session tile ingest live" {
        lc_step "d-2: the session tile spawned + its records ingested"
    }
    -re {halcyond: FAIL session tile} { lc_fail "the session tile failed to spawn (kaua-term or the pipes)" }
    -re {halcyond: session tile .* wire error} { lc_fail "the tile record stream was malformed (the ingest trust boundary tripped)" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during tile ingest" }
    timeout { lc_fail "the session tile never ingested (no kaua-term output reached halcyond)" }
    eof     { lc_fail "qemu exited during tile ingest" }
}

# --- d-2: input routing + the REAL logout -- QMP types `exit`, ut exits ---
#
# Give ut a moment to settle at a prompt, then type `exit\n` over QMP. tapestryd
# routes it as TEV_KEY to the FOCUSED session halcyond; halcyond map_keys it down
# the tile's pts; ut runs `exit` and exits, so the kaua-term emits Control::Exit
# and halcyond logs out. This proves input reaches the tile (focus + map_key +
# the down-channel) AND the real logout (tile exit -> session_main returns).
after 1200
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp "exit\n"} err]} {
    lc_fail "qmp-sendtext exit failed: $err"
}
set timeout 90
expect {
    -re {halcyond: session tile exited \(code 0\) -- logout} {
        lc_step "d-2: input `exit` reached ut -> ut exited -> REAL logout"
    }
    -re {halcyond: session tile exited \(code [0-9]+\) -- logout} {
        lc_fail "the tile exited non-zero (ut did not run `exit` cleanly)"
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during the tile-exit logout" }
    timeout { lc_fail "no logout after `exit` -- input never reached the tile's ut (focus not on the session? map_key/down-channel broken?)" }
    eof     { lc_fail "qemu exited before the logout marker" }
}

# --- d-1b: resume -- aurora foregrounds + the console reclaims Direct ---
expect {
    -re {tapestryd: foreground surface [0-9]+ \(session gone\)} {
        lc_step "tapestryd FOREGROUNDED the console renderer on logout"
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during renderer foreground" }
    timeout { lc_fail "the console renderer never foregrounded after logout (retire->reconcile broken?)" }
    eof     { lc_fail "qemu exited before renderer foreground" }
}
expect {
    -re {tapestryd: scanout pending-direct} {
        lc_step "tapestryd -> Direct(console): the display returned to the console"
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction returning the display to the console" }
    timeout { lc_fail "scanout never returned to Direct on the console after logout" }
    eof     { lc_fail "qemu exited before the console reclaimed Direct" }
}

lc_pass "KT-1.5d-2: session tile spawn+ingest+render -> input `exit` -> real logout -> console resumes"

# lc_quit's `exit` line lands on the resumed console login prompt; it is
# harmlessly unread (wrong creds) and Ctrl-A x tears the VM down.
lc_quit
