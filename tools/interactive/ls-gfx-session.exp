#!/usr/bin/expect -f
# tools/interactive/ls-gfx-session.exp -- KT-1.5d-1a/b: the per-user session
# compositor (HALCYON.md 14.12). d-1a: the login-spawned bootstrap (login ->
# halcyond --session presents). d-1b: the clean display handoff -- tapestryd's
# reconcile BACKGROUNDS the console renderer (aurora) when the session leaf
# appears (-> Direct(halcyond); aurora keeps its surface but goes FRAME-dormant),
# and FOREGROUNDS it again on logout. The logout is a scripted test lever (below).
#
# GATED ON THE BAKED LEVER (the cfg-4 / ls-halcyon precedent): the pool carries
# /lib/halcyon/session = "on" only under THYLACINE_HALCYON_SESSION=1. On a
# default image login spawns ut and this scenario SKIPs cleanly (lc_quit + exit
# 0); on a lever image it proves:
#
#   login -> the per-user compositor. login authenticates, then spawns
#   /bin/halcyond --session AS the user (NOT ut on /dev/cons) -- "login: session
#   compositor (halcyond) spawned" -- and the per-user halcyond connects to the
#   SYSTEM tapestryd + presents a fullscreen surface: "halcyond: session up NxN
#   px", printed only inside Ok(present), so the marker witnesses connect +
#   present (not merely that the line ran -- the M-PIN post-present-marker rule).
#
# aurora is the pre-login console renderer here (renderer absent -> aurora), and
# does NOT silence serial (no thylacine.display=gpu bootarg -- aurora only
# silences under that arg, cons.c 1b), so login is drivable over serial exactly
# as ls-ci; halcyond's markers ride the kernel diagnostic UART (t_puts), immune
# to any renderer silence regardless. d-1b proves the handoff: tapestryd
# backgrounds the console renderer when the session leaf appears and switches to
# Direct(halcyond); the scripted logout foregrounds it again.
#
# THE SCRIPTED LOGOUT (test lever). A real logout needs a session tile that can
# exit (d-2/d-3); until then THYLACINE_HALCYON_SESSION_AUTOEXIT=1 -> run-vm.sh
# appends `thylacine.halcyon.session.autoexit` -> the per-user halcyond returns
# after a bounded frame count. It is a test DRIVER, not a behaviour double: it
# only makes halcyond exit (the logout login already waits for), leaving aurora's
# resume path under test untouched.
#
# HVF like the gfx siblings; the GPU environment (virtio-gpu + tapestryd) is
# required for halcyond to present, and is present by default (THYLACINE_DISPLAY
# unset -> virtio-gpu on, no display=gpu bootarg -> serial stays loud).

set ::env(THYLACINE_ACCEL) hvf
set ::env(THYLACINE_HALCYON_SESSION_AUTOEXIT) 1

source [file join [file dirname [info script]] lib.exp]

lc_boot

# Login drive (lc_login's prompt/password steps -- but the session path never
# reaches the ut "Thylacine textual shell" banner, so the shell-up arm below is
# replaced by the session/default DISCRIMINATION).
global lc_boot_timeout timeout
set timeout $lc_boot_timeout
expect {
    -ex "Thylacine login: " { lc_step "login prompt" }
    -re {EXTINCTION:}       { lc_extinction_fail "extinction before login prompt" }
    timeout                 { lc_fail "no login prompt within ${lc_boot_timeout}s" }
    eof                     { lc_fail "qemu exited before login prompt" }
}
lc_raw_send "michael\r" "login user"
expect {
    -ex "password: "  { lc_step "password prompt" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction at password prompt" }
    timeout           { lc_fail "no password prompt (username not received?)" }
    eof               { lc_fail "qemu exited at password prompt" }
}
lc_raw_send "correct-horse-battery-staple-v1\r" "login password"

# DISCRIMINATE: the session lever (proceed) vs a default image (SKIP). The two
# markers are mutually exclusive -- login spawns EITHER the session halcyond OR
# ut, never both.
expect {
    -ex "login: session compositor (halcyond) spawned" {
        lc_step "session path taken (lever image)"
    }
    -ex "Thylacine textual shell" {
        lc_step "default (ut) image -- session lever absent; SKIP"
        lc_quit
        exit 0
    }
    -ex "login incorrect"  { lc_fail "auth rejected for michael -- see ls-ci's #233 note (an echoed byte after 'password: ' truncated the passphrase)" }
    -re {EXTINCTION:}      { lc_extinction_fail "extinction during login/session spawn" }
    timeout                { lc_fail "neither session nor ut path within ${lc_boot_timeout}s" }
    eof                    { lc_fail "qemu exited during login" }
}

# --- d-1b: the handoff -- tapestryd backgrounds the console renderer ---
#
# ORDER (measured): the background fires when halcyond's surface is HOSTED (during
# fullscreen_on), which PRECEDES halcyond's first-present "session up" marker --
# so assert background -> Direct(halcyond) -> session up, in that order. Asserting
# "session up" first would consume the background line and the d-1b arm would miss.

# halcyond is a SESSION leaf (a real user principal); the moment its surface is
# hosted, tapestryd's reconcile BACKGROUNDS the console renderer aurora (a SYSTEM
# leaf) -- dropped from the scanout decision + FRAME-ticked no more, so aurora goes
# dormant while KEEPING its surface (HALCYON 14.12 step 4). Marker on the
# diagnostic UART (t_puts). halcyond's own FAIL line is a RED arm (#186-safe).
expect {
    -re {tapestryd: background surface [0-9]+ \(session took the display\)} {
        lc_step "tapestryd backgrounded the console renderer under the session"
    }
    -re {halcyond: FAIL session} { lc_fail "halcyond --session failed to connect/present (tapestryd absent or the present was refused)" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction before the renderer backgrounded" }
    timeout { lc_fail "tapestryd never backgrounded the console renderer (session leaf not seen?)" }
    eof     { lc_fail "qemu exited before the renderer backgrounded" }
}

# With the console renderer backgrounded, the session is the only ACTIVE leaf and
# the scanout switches to Direct -- the full-display takeover. Earlier aurora
# pending-directs were consumed during the login drive, so this one is the session's.
expect {
    -re {tapestryd: scanout pending-direct} {
        lc_step "tapestryd -> Direct(halcyond): the full-display handoff"
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during the Direct handoff" }
    timeout { lc_fail "scanout never went Direct after backgrounding (stuck Composed?)" }
    eof     { lc_fail "qemu exited during the Direct handoff" }
}

# The bootstrap witness (d-1a): halcyond PRESENTED. "session up" prints inside
# Ok(present) (connect + present) and lands AFTER the handoff (the present
# completes after the surface was hosted + backgrounded aurora above).
expect {
    -ex "halcyond: session up" { lc_step "d-1a: per-user compositor connected + presented" }
    -re {halcyond: FAIL session} { lc_fail "halcyond --session failed to connect/present" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during session bringup" }
    timeout { lc_fail "halcyond: session up never appeared (the per-user compositor did not present)" }
    eof     { lc_fail "qemu exited during session bringup" }
}

# --- d-1b: logout -> the renderer foregrounds + resumes (scripted test logout) ---

# The scripted logout: halcyond --session returns after a bounded frame count.
# login's wait() returns -> getty -> tapestryd retires the session leaf ->
# reconcile re-runs -> no session leaf -> the console renderer FOREGROUNDS.
expect {
    -ex "halcyond: session autoexit" {
        lc_step "session logout (test lever) -- halcyond exits"
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction before session logout" }
    timeout { lc_fail "session autoexit never fired (halcyond did not log out)" }
    eof     { lc_fail "qemu exited before session logout" }
}

# THE RESUME WITNESS: reconcile foregrounds the console renderer (session gone);
# the FRAME clock then ticks aurora again and it repaints.
expect {
    -re {tapestryd: foreground surface [0-9]+ \(session gone\)} {
        lc_step "tapestryd FOREGROUNDED the console renderer on logout"
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during renderer foreground" }
    timeout { lc_fail "the console renderer never foregrounded after logout (retire->reconcile broken?)" }
    eof     { lc_fail "qemu exited before renderer foreground" }
}

# And the scanout returns to Direct on the console renderer -- the full cycle.
expect {
    -re {tapestryd: scanout pending-direct} {
        lc_step "tapestryd -> Direct(console): the display returned to the console"
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction returning the display to the console" }
    timeout { lc_fail "scanout never returned to Direct on the console after logout" }
    eof     { lc_fail "qemu exited before the console reclaimed Direct" }
}

lc_pass "KT-1.5d-1b: background renderer -> Direct(halcyond) -> logout -> foreground -> Direct(console)"

# lc_quit's `exit` line lands on the resumed console login prompt; it is
# harmlessly unread (wrong creds) and Ctrl-A x tears the VM down.
lc_quit
