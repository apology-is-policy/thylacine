#!/usr/bin/expect -f
# tools/interactive/ls-ci.exp -- the LS-CI headline regression net.
#
# Proves, over a real PTY, the two interactive gaps that shipped silently
# because CI structurally could not drive a keyboard:
#   LS-1  the kernel console RECEIVES keystrokes  -> reaching the shell banner
#         requires login (username + password) to have been received char-for-
#         char; if RX is dead (the LS-1 bug) we never get past the prompt.
#   LS-2  external command OUTPUT reaches the console -> three independent,
#         echo-ambiguity-proof assertions across both LS-2 code paths:
#           (a) exec_external stdout : `echo` output (double-expect).
#           (b) pipeline stdout      : `... | tr a-z A-Z` upper-cased token
#                                      (appears ONLY in output).
#           (c) exec_external stderr : `cat: /missing` (the `cat: ` prefix
#                                      appears ONLY in stderr).
# Pre-LS-2 all three were dropped by the U-6c "Piped-then-drop" convention.

# G-3: HVF. MEASURED ~200s -> ~40s (this scenario is boot-dominated, and a
# TCG boot is ~5x an HVF one). Coverage argument, because a green run under a
# different accel is NOT the same as the same coverage: accel also picks the
# CPU model and the GIC version (hvf -> -cpu host + GICv2; tcg -> -cpu max +
# GICv3, tools/run-vm.sh), so a flip moves this scenario off those axes. It is
# safe HERE because the original LS-CI smoke leg (login + rendered output); nothing hardware-specific, and because the GICv3 + `-cpu max` axes stay covered
# by the TCG anchor set the wrapper enforces (freeze-172, flood-174, split173,
# nora-demo, idle-probe, ls-7, pty-4). Set THYLACINE_ACCEL=tcg to A/B it.
set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

lc_boot
lc_login michael correct-horse-battery-staple-v1

# (a) exec_external stdout -- the headline LS-2 path.
lc_run_expect "echo lsci-stdout-9421" "lsci-stdout-9421"
lc_pass "LS-2(a): external stdout visible (exec_external)"

# (b) pipeline stdout -- spawn_pipeline_elements. The upper-cased token cannot
# appear in the editor's lower-case echo of the typed line, so a single exact
# match is unambiguous.
lc_send "echo lsci-pipe-low | tr a-z A-Z"
lc_expect "LSCI-PIPE-LOW" "pipeline stdout"
lc_pass "LS-2(b): pipeline stdout visible (spawn_pipeline_elements + tr)"

# (c) exec_external stderr -- `cat` of a missing file prints `cat: <path>: ...`
# to stderr. Match only the `cat:` prefix: it is stderr-only (the typed line is
# `cat /...`, no colon) and contiguous at the line start. We do NOT require the
# whole `cat: <path>` contiguously -- the line editor's per-keystroke prompt
# redraw interleaves the byte stream, so longer spans aren't guaranteed
# contiguous. (Verified: the session survives a missing-file cat.)
lc_send "cat /lsci-no-such-file"
lc_expect "cat:" "stderr"
lc_pass "LS-2(c): external stderr visible (cat error)"

# (d) #139 -- a POST-LOGIN program can acquire CAP_JIT.
#
# This rides here rather than in its own scenario for one reason and one only:
# the only other place it is proven is ls-gfx-gl, which SKIPs on any tree
# without the ~365 MB of Mesa/LLVM archives. A fix whose sole coverage can
# silently skip is a fix with no coverage.
#
# `self` selects the SELF form (verb 18): no AUTH, no token -- corvus authorizes
# the connection's kernel-stamped principal. It is the ONLY form reachable from
# here; login's session is bound, so handle_auth refuses, which is what made
# every user-launched GL program unable to JIT. The bearer form is asserted
# separately at boot, where jit-prover runs as PRINCIPAL_SYSTEM.
#
# `(SELF)` cannot appear in the line editor's echo of the typed command (which
# is lower-case and has no parentheses), so a single match is unambiguous -- and
# it discriminates: a run that fell back to the bearer form would print
# `(bearer)` and fail here rather than passing as "acquired".
lc_send "/bin/jit-prover self"
lc_expect "CAP_JIT acquired (SELF)" "#139 self-form clearance"
lc_expect "jit-prover: PASS" "I-42 end-to-end after a self-form acquisition"
lc_pass "#139: a post-login program acquired CAP_JIT on its own kernel-stamped\
         principal and JIT-executed (no bearer token anywhere in the path)"

# (e) TH-4c -- `halcyon theme lint` reads a theme file and reports it.
#
# Rides here for exactly #139's reason: the lint's pure half is host-tested to
# death, but nothing else in the tree ever RUNS the binary, and a new scenario
# would buy one boot's worth of coverage at one boot's worth of wall clock.
# What only a guest can prove is the I/O half -- that a missing file maps to
# "absent" rather than to an error (HALCYON-THEME 4.1, the DEFAULT
# installation's path), that $HOME joins to a real user-tier path, and that the
# exit status a script would branch on is the one the tool documents.

# The no-argument form walks both tiers. Which verdict is correct depends on
# what the harness baked, so it follows the LS_THEME contract ls-halcyon
# already uses rather than assuming the default image.
set ls_theme ""
if {[info exists ::env(LS_THEME)]} { set ls_theme $::env(LS_THEME) }
if {$ls_theme eq ""} {
    lc_run_expect_hardfail "halcyon theme lint" "active: built-in (Daylight)" "REFUSED"
    lc_pass "TH-4c(a): with no theme file in either tier both report absent (4.1)\
             and the built-in is named active"
} else {
    # Assert the NAME, not just the tier. `active: system` alone passes against
    # an image baked with any theme under any name, so `LS_THEME=nightjar`
    # would have been satisfied by a completely different theme being in force
    # (TH-6 F8). The tool prints the `[meta] name`, which is title-case where
    # the gallery filename is not.
    set want [string totitle $ls_theme]
    lc_run_expect_hardfail "halcyon theme lint" "active: system -- \"$want\"" "REFUSED"
    lc_pass "TH-4c(a): the lever-baked system theme is named active AS $want --\
             the tier and the identity, not just the tier"
}

# The shipped dark theme, linted by path. `keys set` appears ONLY on the
# complete-file line -- a theme that had lost a key would be refused outright
# (it carries no `base`), so this leg is also the standing check that
# nightjar.toml still sets every key the schema defines.
lc_run_expect_hardfail "halcyon theme lint /lib/halcyon/themes/nightjar.toml" \
    "keys set" "REFUSED"
lc_pass "TH-4c(b): the shipped Nightjar theme lints COMPLETE (every key set)"

# A path NAMED on the command line and not found is an error -- the deliberate
# contrast with leg (a)'s absent TIER, which is not one. The two legs together
# are the claim; either alone is satisfied by a tool that treats both the same.
# The tokens below are typed lower-case and upper-cased by `tr`, so a match
# cannot be the line editor's echo of the command (the (b) discipline above).
lc_send "halcyon theme lint /lib/halcyon/no-such-theme.toml || echo th4c-missing | tr a-z A-Z"
lc_expect "TH4C-MISSING" "a named path that is missing exits non-zero"
lc_pass "TH-4c(c): a theme file named on the command line and not found is an\
         ERROR, where an absent tier is not"

# A file that IS present and is NOT a theme -- the refusal path proper.
#
# The fixture is WRITTEN here rather than picked out of the image, and that is
# the lesson rather than a preference: the first version of this leg linted
# /lib/halcyon/layouts/default, which turned out to ride the session lever.
# With the lever off the file did not exist, so the lint took the missing-file
# path above and the leg passed while proving nothing about a refusal. It was
# testing an unconstructed state, and only reading the guest's actual output
# showed it. The hard-fail arm names the write's failure immediately instead of
# burning the command timeout on it.
lc_send "echo th4c-not-a-theme > /home/michael/th4c-bad.toml"
lc_run_expect_hardfail \
    "halcyon theme lint /home/michael/th4c-bad.toml || echo th4c-refused | tr a-z A-Z" \
    "REFUSED -- line 1" "no such file"
lc_expect "TH4C-REFUSED" "a refused file exits non-zero"
lc_pass "TH-4c(d): a file that is present and is not a theme is REFUSED at its\
         line, and the tool exits non-zero"

lc_send "halcyon theme lint /lib/halcyon/themes/nightjar.toml && echo th4c-ok | tr a-z A-Z"
lc_expect "TH4C-OK" "a clean lint exits zero"
lc_pass "TH-4c(e): a clean lint exits zero"

lc_quit
lc_pass "LS-CI ls-ci: login (LS-1) + stdout/pipeline/stderr (LS-2) + post-login\
         CAP_JIT (#139) + theme lint (TH-4c) all verified"
exit 0
