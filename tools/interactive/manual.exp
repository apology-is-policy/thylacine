#!/usr/bin/expect -f
# tools/interactive/manual.exp -- the Operator's Manual reader over a real PTY
# (docs/MANUAL-DESIGN.md 8.2).
#
# No section is installed yet (MANUAL-DESIGN 10), so the scenario writes small
# fixture sections under /tmp from the shell and drives the reader against them.
# Each leg matches a token that only the command's OUTPUT can produce (the
# LS-CI discipline, lib.exp), and no two legs share one:
#   (a) `manual` with nothing installed -> "No sections are installed.", exit 0
#   (b) --check on the fixture           -> no diagnostic, exit 0
#   (c) the fixture by path, plain tier  -> its title "Fixture Reader Title" and
#                                           "body has emphasis and ends." (both
#                                           typed with asterisks, rendered
#                                           without), exit 0
#   (d) an unknown section name          -> "no section named", exit 1
#   (e) --check on a fixture with a link -> "links are not supported", exit 1
#   (f) that fixture by path             -> the same diagnostic, exit 1, and none
#                                           of its rendering: the fixture also
#                                           holds `mf*bad*body`, which only a
#                                           rendering could print as "mfbadbody",
#                                           so that string fails the leg at once
#                                           (MANUAL-DESIGN 5: a file that fails
#                                           the check is not displayed)
#
# Each exit status is read back with `echo <tag> $status` on the same line: the
# typed line carries `$status`, never the digit, so only the shell's expansion
# can produce `<tag> 1`. The two exit-0 legs are the controls for the two exit-1
# legs -- a shell whose `$status` read a constant would fail one pair or the
# other. (Before 2026-09-16 every such read in ut came out 0, whatever the
# command returned; that defect is why these legs were once withheld.)
#
# The RICH tier is not driven here. `echo -n rich > /env/BEACON` cannot set it
# from the shell: ut opens the target and truncates ITS OWN BEACON, while echo's
# write lands in echo's copy of the environment and dies with it (measured
# 2026-09-16: children saw `cells` before the redirect and an empty value
# after). Rich output is pinned byte-for-byte by the host tests (`cargo test -p
# manual`) and is seen for real in a Halcyon tile, whose pts advertises `rich`
# (MANUAL-DESIGN.md 8.3).
#
# This image's console advertises the `cells` tier (ut exports BEACON=cells,
# measured 2026-09-16), which the reader renders exactly as plain -- a
# host-tested identity -- so every leg matches plain text.

# HVF: the scenario is boot-dominated, and nothing the reader does depends on
# the CPU model or the GIC version that the TCG anchor set covers.
set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

# Wait for `<tag> <code>` at the end of a line; a different code for the same
# tag fails at once instead of waiting out the timeout, and so does `failpat`
# (exact text no correct run prints at all). expect picks the FIRST listed
# pattern that matches anywhere in what has arrived, so `failpat` is listed
# before the status: output and status that arrive in one read then fail, where
# the other order would pass on the status (lib.exp's rule for hardfail).
proc manual_status {tag code phase {failpat ""}} {
    global lc_cmd_timeout timeout
    set timeout $lc_cmd_timeout
    if {$failpat eq ""} {
        expect {
            -ex "$tag $code\r"      { lc_step "saw: $phase" }
            -re "$tag (\[0-9\]+)\r" { lc_fail "$phase: exit status $expect_out(1,string), want $code" }
            -re {EXTINCTION:}       { lc_extinction_fail "kernel extinction during '$phase'" }
            timeout                 { lc_fail "timeout (${lc_cmd_timeout}s) waiting for \[$tag $code\] during '$phase'" }
            eof                     { lc_fail "unexpected EOF during '$phase'" }
        }
        return
    }
    expect {
        -ex $failpat            { lc_fail "$phase: \[$failpat\] was printed" }
        -ex "$tag $code\r"      { lc_step "saw: $phase" }
        -re "$tag (\[0-9\]+)\r" { lc_fail "$phase: exit status $expect_out(1,string), want $code" }
        -re {EXTINCTION:}       { lc_extinction_fail "kernel extinction during '$phase'" }
        timeout                 { lc_fail "timeout (${lc_cmd_timeout}s) waiting for \[$tag $code\] during '$phase'" }
        eof                     { lc_fail "unexpected EOF during '$phase'" }
    }
}

lc_boot
lc_login michael correct-horse-battery-staple-v1

lc_run_expect {manual; echo mfnone $status} "No sections are installed."
manual_status mfnone 0 "manual(a) exit status"
lc_pass "manual(a): the contents listing reports that no sections are installed, exit 0"

# Braces keep Tcl from substituting; single quotes keep ut from globbing.
lc_send {echo '# Fixture *Reader* Title' > /tmp/mf.md; echo '' >> /tmp/mf.md; echo 'The fixture body has *emphasis* and ends.' >> /tmp/mf.md}
# A diagnostic would begin `manual: `; the typed line never holds that string.
lc_send {manual --check /tmp/mf.md; echo mfok $status}
manual_status mfok 0 "manual(b) exit status" "manual: "
lc_pass "manual(b): --check accepts the fixture with no diagnostic, exit 0"

lc_run_expect {manual /tmp/mf.md; echo mfshow $status} "Fixture Reader Title"
lc_expect "body has emphasis and ends." "manual(c) body"
manual_status mfshow 0 "manual(c) exit status"
lc_pass "manual(c): a section renders by path, title and body, with its inline markup removed at the plain tier, exit 0"

lc_run_expect {manual nosuch-mf; echo mfmiss $status} "no section named"
manual_status mfmiss 1 "manual(d) exit status"
lc_pass "manual(d): an unknown section name is a diagnostic, exit 1"

lc_send {echo '# Bad Fixture' > /tmp/mfbad.md; echo '' >> /tmp/mfbad.md; echo 'Its mf*bad*body is never shown.' >> /tmp/mfbad.md; echo '' >> /tmp/mfbad.md; echo 'See [x](y) here.' >> /tmp/mfbad.md}
lc_run_expect_hardfail {manual --check /tmp/mfbad.md; echo mfcheck $status} "links are not supported" "mfbadbody"
manual_status mfcheck 1 "manual(e) exit status" "mfbadbody"
lc_pass "manual(e): --check rejects a link with a diagnostic, exit 1"

lc_run_expect_hardfail {manual /tmp/mfbad.md; echo mfbadshow $status} "links are not supported" "mfbadbody"
manual_status mfbadshow 1 "manual(f) exit status" "mfbadbody"
lc_pass "manual(f): a file that fails the check is not displayed: its diagnostic, exit 1, none of its rendering"

lc_quit
lc_pass "LS-CI manual: the listing, check, render, lookup and refusal legs verified, with their exit statuses"
exit 0
