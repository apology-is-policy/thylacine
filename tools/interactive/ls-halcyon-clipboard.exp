#!/usr/bin/expect -f
# Real session clipboard through authenticated foreground processes and physical SAK.
# Requires HALCYON_SESSION=y and THYLACINE_HALCYON_PROFILE=instrument.
set ::env(THYLACINE_ACCEL) [expr {[info exists ::env(LS_CI_GFX_ACCEL)] ? $::env(LS_CI_GFX_ACCEL) : "hvf"}]
source [file join [file dirname [info script]] lib.exp]
set repo $lc_repo
set qmp [lc_qmp_sock]
proc key {chord} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k $chord} e]} { lc_fail $e }
    after 700
}
proc type {text} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp $text} e]} { lc_fail $e }
}
proc capture {name} {
    global repo qmp
    after 1000
    set out $repo/build/session-media-$name.png
    if {[catch {exec $repo/tools/screendump.sh -s $qmp $out} e]} { lc_fail $e }
    lc_step "captured $out"
    return $out
}
proc colour_count {png} {
    global repo
    return [exec python3 $repo/tools/interactive/gfx_media.py $png]
}
lc_boot
set timeout $lc_boot_timeout
expect {
    -ex "Thylacine login: " {}
    -re {EXTINCTION:} { lc_extinction_fail "boot" }
    timeout { lc_fail "no login" }
    eof { lc_fail "EOF before login" }
}
lc_raw_send "michael\r" "login user"
expect {
    -ex "password: " {}
    timeout { lc_fail "no password prompt" }
    eof { lc_fail "EOF before password" }
}
lc_raw_send "correct-horse-battery-staple-v1\r" "login password"
expect {
    -ex "login: session compositor (halcyond) spawned" {}
    -ex "Thylacine textual shell" {
        # A lever the image lacks is a SKIP, never a FAIL: a full fleet run on
        # the gate image must not be red for a reason that is not a defect.
        puts "\nLS-CI SKIP: default (ut) image -- this scenario drives the session\
 compositor. Bake with: THYLACINE_HALCYON_SESSION=1 tools/build.sh kernel --config ci"
        lc_quit
        exit 77
    }
    timeout { lc_fail "no graphical session" }
    eof { lc_fail "EOF at session start" }
}
set timeout 60
expect {
    -re {halcyond: theme [^\r\n]*; profile (instrument|legacy) } {
        if {$expect_out(1,string) ne "instrument"} {
            lc_fail "theme picker requires THYLACINE_HALCYON_PROFILE=instrument in the pool fixture"
        }
    }
    timeout { lc_fail "session did not report its graphics profile" }
    eof { lc_fail "EOF before profile" }
}
expect {
    -re {halcyond: status bar [^\r\n]*running false panes 2} {}
    -re {EXTINCTION:} { lc_extinction_fail "session" }
    timeout { lc_fail "welcome and shell did not become ready" }
}
if {![info exists ::env(THYLACINE_INTERACTION_QUALIFICATION)] || $::env(THYLACINE_INTERACTION_QUALIFICATION) ne "1"} {
    puts "\nLS-CI SKIP: requires explicit THYLACINE_INTERACTION_QUALIFICATION=1 build"
    lc_quit
    exit 77
}
after 1500
key "meta_l+f"
type "kaua-term-probe --clipboard copy\n"
lc_expect "clipboard-probe: copy PASS" "20KiB native copy and byte-verified readback"
after 500
type "kaua-term-probe --clipboard read\n"
lc_expect "clipboard-probe: read PASS" "second process reads published clipboard"
after 500
type "kaua-term-probe --clipboard hold\n"
lc_expect "clipboard-probe: SAK READY" "live read snapshot ready for cancellation"
capture clipboard-held
key "ctrl+alt+f10"
capture clipboard-sak
key "ret"
lc_expect "corvus: imperium: SAK with nothing pending" "trusted episode completed"
after 1500
key "ret"
lc_expect "clipboard-probe: hold PASS" "old connection retired; fresh binding after SAK reads intact clipboard"
capture clipboard-restored
lc_pass "native clipboard: two process identities, fragmented20KiB, physical F10 cancellation and reconnect"
lc_quit
