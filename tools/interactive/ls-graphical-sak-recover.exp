#!/usr/bin/expect -f
# Graphical Lex curiata: a FAILED seat gives the workspace back. Requires
# HALCYON_SESSION=y. The attention chord is held past the kernel's quiesce
# deadline (the acknowledgement needs every key up), which fails the seat with
# nothing conferred. The failure notice must show, normal output and input must
# return once the keys are up, and the seat must then work again -- a benign
# timeout used to leave the display dark until both seat processes died.
set ::env(THYLACINE_ACCEL) [expr {[info exists ::env(LS_CI_GFX_ACCEL)] ? $::env(LS_CI_GFX_ACCEL) : "hvf"}]
set ::env(THYLACINE_SERIAL_SAK) 0
source [file join [file dirname [info script]] lib.exp]
set repo $lc_repo
set qmp [lc_qmp_sock]


proc key {chord} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k $chord} e]} { lc_fail $e }
    after 700
}
proc type {text} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp $text} e]} { lc_fail $e }
}
proc capture {name} {
    global repo qmp
    after 1000
    set dir [expr {[info exists ::env(SAK_SCREENSHOT_DIR)] ? $::env(SAK_SCREENSHOT_DIR) : [file join $repo build]}]
    set out [file join $dir halcyon-sak-$name.png]
    if {[info exists ::env(THYLACINE_EGL_VNC_SOCKET)]} {
        if {[catch {exec python3 $repo/tools/interactive/vnc_capture.py $::env(THYLACINE_EGL_VNC_SOCKET) $out} e]} { lc_fail $e }
    } else {
        if {[catch {exec $repo/tools/screendump.sh -s $qmp $out} e]} { lc_fail $e }
    }
    lc_step "captured $out"
    return $out
}
proc witness {stage} {
    type "caps-probe --seat-$stage\n"
    global timeout
    set timeout 30
    expect {
        -ex "seat-probe: PASS $stage (endpoint denied; GPU denied; DAC verified)" { lc_pass "seat $stage authority" }
        -ex "seat-probe: FAIL" { lc_fail "guest authority witness failed ($stage)" }
        -re {EXTINCTION:} { lc_extinction_fail "seat $stage" }
        timeout { lc_fail "no authority witness ($stage)" }
        eof { lc_fail "EOF ($stage)" }
    }
}
lc_boot
set timeout $lc_boot_timeout
expect {
    -ex "Thylacine login: " {}
    -re {EXTINCTION:} { lc_extinction_fail "boot" }
    timeout { lc_fail "no login" }
    eof { lc_fail "EOF before login" }
}
lc_raw_send "michael\r" "login user"
expect {
    -ex "password: " {}
    timeout { lc_fail "no password prompt" }
    eof { lc_fail "EOF before password" }
}
lc_raw_send "correct-horse-battery-staple-v1\r" "login password"
expect {
    -ex "login: session compositor (halcyond) spawned" {}
    -ex "Thylacine textual shell" {
        # A lever the image lacks is a SKIP, never a FAIL: a full fleet run on
        # the gate image must not be red for a reason that is not a defect.
        puts "\nLS-CI SKIP: default (ut) image -- this scenario drives the session\
 compositor. Bake with: THYLACINE_HALCYON_SESSION=1 THYLACINE_HALCYON_PROFILE=instrument tools/build.sh kernel --config ci"
        lc_quit
        exit 77
    }
    timeout { lc_fail "no graphical session" }
    eof { lc_fail "EOF at session start" }
}
set timeout 60
expect {
    -re {halcyond: status bar [^\r\n]*running false panes 2} {}
    -re {EXTINCTION:} { lc_extinction_fail "session" }
    timeout { lc_fail "welcome and shell did not become ready" }
}
after 1500
key "meta_l+f"
witness baseline
# Hold the chord for 9 s against a 5 s deadline. In the background: the
# capture below has to land WHILE the keys are still down.
set hold [open "|$repo/tools/qmp-sendtext.sh -s $qmp -k ctrl+alt+f10@9000" r]
set timeout 20
expect {
    -ex "lictor: trusted scanout active" { lc_pass "takeover happened under the held chord" }
    -re {EXTINCTION:} { lc_extinction_fail "takeover" }
    timeout { lc_fail "no takeover under a held chord" }
}
capture preparing
expect {
    -ex "lictor: kernel closed trusted seat (scanout private)" { lc_pass "held chord failed the seat at its deadline" }
    -re {EXTINCTION:} { lc_extinction_fail "held chord" }
    timeout { lc_fail "the seat never failed under a held chord" }
}
capture failed
# Drain to EOF first: closing the read end under a live helper hands it EPIPE
# on its own status line, which is a harness failure and not the guest's.
if {[catch {read $hold; close $hold} e]} { lc_fail "held chord helper: $e" }
expect {
    -ex "lictor: trusted seat recovered; nothing was conferred" { lc_pass "seat recovered after release" }
    -re {EXTINCTION:} { lc_extinction_fail "recovery" }
    timeout { lc_fail "the failed seat never recovered" }
}
after 1500
capture recovered
# The workspace is live again: the probe's output crosses the compositor, the
# PTY and the shell, and no authority leaked out of the failed episode.
witness restored
# And the seat itself works again, end to end, through a real conferral.
type "imperium chown dac\n"
after 1200
key "ctrl+alt+delete"
after 1000
type "imperium-key-michael-v1"
key "ret"
after 2200
key "ret"
lc_expect "corvus: imperium: CONFERRED to michael" "a recovered seat confers"
after 1000
witness elevated
type "abdicate\n"
after 1200
witness cancelled
lc_pass "graphical SAK: a failed seat recovers, confers nothing, and works again"
lc_quit
