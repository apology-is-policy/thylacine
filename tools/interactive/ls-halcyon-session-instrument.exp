#!/usr/bin/expect -f
# tools/interactive/ls-halcyon-session-instrument.exp -- HALCYON-INSTRUMENT
# I-4: the SESSION path under the Instrument profile (docs/HALCYON-INSTRUMENT
# .md 8 / 8.1 / 8.2 / 14.1 / 14.3 / 14.6 / 14.9; the I-4 status row) -- the
# fifth gate image, the one the I-3 residue named: the session compositor's
# own rails and the Instrument tile states no console-lever image can show.
#
# GATED ON TWO BAKED LEVERS: the per-user session (THYLACINE_HALCYON_SESSION=1
# -> /lib/halcyon/session = on, as ls-gfx-session) AND the profile word
# (THYLACINE_HALCYON_PROFILE=instrument -> /lib/halcyon/profile). On a default
# image login spawns ut and this SKIPs (exit 77); on a session image under
# `legacy` it SKIPs too. On the lever image it proves:
#
#   rails   : the SESSION minted the `role=rail` surface (the declared seat's
#             admission, the bar's gate) at the display width by 34 -- the
#             compositor's `rail N created ... for principal <session>` line
#             and halcyond's `rail N minted (Wx34)`; the bottom rail (the
#             session's status bar) paints the footer: two panes after the
#             welcome (the tour beside the shell).
#   prompt  : (I-5c, 7.4 / 13 ruling 14) the shell's prompt is `λ <cwd> ⊢`
#             in the session's inks -- read off a screendump of the root
#             tile's content column: the lambda ON amber's blend line, the
#             cwd on terminal_path's, the turnstile on secondary's, no amber
#             beside the lambda; and a second prompt GROWS each count (the
#             delta is the prompt's glyphs, never the raw output's).
#   footer  : the four conditions from the shell tile's own facts -- READY,
#             RUNNING while `sleep` runs, EXIT 0 after it, EXIT 1 after
#             `false` -- read off the bar's say line (`condition`, `exit`,
#             `running`, `panes`).
#   split   : the rail's SPLIT H button is the chord's twin under the session's
#             OWN authority (the layout file): a third tile spawns (leaf B),
#             the pane count follows.
#   retained: `exit` typed into B RETAINS it (14.6: `ended (exit 0) --
#             retained`, no close, no logout); the tile menu summoned on B's
#             header offers Restart first, and Enter restarts it in the same
#             leaf (`tile B restarted`); Super+Q then closes B structurally
#             (the 9.3 delta recorded at I-3).
#   list    : the mark opens the workspace list (14.1) as a 14.2 menu on the
#             session's seat; Esc dismisses it.
#   logout  : Super+Q twice more empties the session -> `session logout` ->
#             the login prompt returns (the compositor's rail and bar retire
#             with the seat).
#
# aurora is the pre-login console renderer and does NOT silence serial, so
# login is drivable over serial exactly as ls-gfx-session; the session's
# markers ride the kernel diagnostic UART. HVF like the gfx siblings.

set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

set repo $lc_repo
set qmp [lc_qmp_sock]

set transcript /tmp/ls-halcyon-session-instrument-[pid].log
catch {file delete -force $transcript}
log_file -a $transcript

proc tgrep {pat what} {
    global transcript
    if {[catch {exec grep -q -- $pat $transcript}]} {
        lc_fail "transcript missing: $what ($pat)"
    }
    lc_pass "session-instrument: $what"
}

proc hkey {chord} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k $chord} err]} {
        lc_fail "qmp-sendtext -k $chord failed: $err"
    }
    after 1500
}
proc htype {text} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp $text} err]} {
        lc_fail "qmp-sendtext '$text' failed: $err"
    }
}

# The virtio tablet: the axis value for the CENTRE of display pixel x is
# (2x + 1) * 32767 / (2 (W - 1)) (the ls-halcyon-instrument idiom).
proc ptr_op {op} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -p $op} err]} {
        lc_fail "qmp-sendtext -p $op failed: $err"
    }
}
proc ptr_to {x y} {
    global W H
    set ax [expr {((2 * $x + 1) * 32767) / (2 * ($W - 1))}]
    set ay [expr {((2 * $y + 1) * 32767) / (2 * ($H - 1))}]
    ptr_op "abs $ax $ay"
    after 400
}
proc click {x y {btn left}} {
    ptr_to $x $y
    ptr_op "btn $btn down"
    after 250
    ptr_op "btn $btn up"
    after 900
}

# The rail's targets, off halcyond's LAST `rail N painted` say line.
proc rail_zones {} {
    global transcript
    set lines [split [exec grep -a {halcyond: rail [0-9]* painted} $transcript] "\n"]
    set line [lindex $lines end]
    if {![regexp {rail (\d+) painted brand \[(\d+) (\d+) (\d+) (\d+)\] ctx \[(\d+) (\d+)\] splith \[(\d+) (\d+) (\d+) (\d+)\] splitv \[(\d+) (\d+) (\d+) (\d+)\] theme \[(\d+) (\d+) (\d+) (\d+)\] reset \[(\d+) (\d+) (\d+) (\d+)\] help \[(\d+) (\d+) (\d+) (\d+)\] clock \[(\d+) (\d+)\]} $line -> id bx by bw bh cx cw shx shy shw shh svx svy svw svh tx ty tw th rx ry rw rh hx hy hw hh kx kw]} {
        lc_fail "no rail zones line in the transcript (last: '$line')"
    }
    return [dict create id $id brand [list $bx $by $bw $bh] ctx [list $cx $cw] splith [list $shx $shy $shw $shh] splitv [list $svx $svy $svw $svh] theme [list $tx $ty $tw $th] reset [list $rx $ry $rw $rh] help [list $hx $hy $hw $hh] clock [list $kx $kw]]
}
proc zone_centre {z} {
    return [list [expr {[lindex $z 0] + [lindex $z 2] / 2}] [expr {[lindex $z 1] + [lindex $z 3] / 2}]]
}
# A header's strip, off halcyond's LAST `chrome N for pane <id>` say line.
proc header_of {id} {
    global transcript
    set lines [split [exec grep -a "halcyond: chrome \[0-9\]* for pane $id at" $transcript] "\n"]
    set line [lindex $lines end]
    if {![regexp "chrome (\\d+) for pane $id at (\\d+),(\\d+) (\\d+)x(\\d+)" $line -> sid x y w h]} {
        lc_fail "no chrome line for pane $id in the transcript (last: '$line')"
    }
    return [list $x $y $w $h]
}

lc_boot

global lc_boot_timeout timeout
set timeout $lc_boot_timeout
expect {
    -ex "Thylacine login: " { lc_step "login prompt" }
    -re {EXTINCTION:}       { lc_extinction_fail "extinction before login prompt" }
    timeout                 { lc_fail "no login prompt within ${lc_boot_timeout}s" }
    eof                     { lc_fail "qemu exited before login prompt" }
}
lc_raw_send "michael\r" "login user"
expect {
    -ex "password: "  { lc_step "password prompt" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction at password prompt" }
    timeout           { lc_fail "no password prompt (username not received?)" }
    eof               { lc_fail "qemu exited at password prompt" }
}
lc_raw_send "correct-horse-battery-staple-v1\r" "login password"

# DISCRIMINATE: the session lever (proceed) vs a default image (SKIP).
expect {
    -ex "login: session compositor (halcyond) spawned" {
        lc_step "session path taken (lever image)"
    }
    -ex "Thylacine textual shell" {
        puts "\nLS-CI SKIP: default (ut) image -- bake with THYLACINE_HALCYON_SESSION=1\
 THYLACINE_HALCYON_PROFILE=instrument to run this scenario."
        lc_quit
        exit 77
    }
    -ex "login incorrect"  { lc_fail "auth rejected for michael -- see ls-ci's #233 note" }
    -re {EXTINCTION:}      { lc_extinction_fail "extinction during login/session spawn" }
    timeout                { lc_fail "neither session nor ut path within ${lc_boot_timeout}s" }
    eof                    { lc_fail "qemu exited during login" }
}
# The profile lever: the session's own resolve line names it.
expect {
    -re {halcyond: theme [^\r\n]*; profile (instrument|legacy) } {
        set profile $expect_out(1,string)
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction before the session resolved its theme" }
    timeout { lc_fail "the session never said its profile" }
    eof     { lc_fail "qemu exited before the session resolved its theme" }
}
if {$profile ne "instrument"} {
    puts "\nLS-CI SKIP: the session runs the '$profile' profile -- bake with\
 THYLACINE_HALCYON_PROFILE=instrument to run this scenario."
    lc_quit
    exit 77
}
lc_step "profile lever baked: the session resolved `instrument`"

# --- The session comes up: the display, the root tile, the rails -------------
set W 0; set H 0
set A ""
expect {
    -re {halcyond: session up (\d+)x(\d+) px} {
        set W $expect_out(1,string); set H $expect_out(2,string)
    }
    -re {halcyond: FAIL session} { lc_fail "halcyond --session failed to connect/present" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during session bringup" }
    timeout { lc_fail "halcyond: session up never appeared" }
    eof     { lc_fail "qemu exited during session bringup" }
}
if {$W < 840 || $H < 300} { lc_fail "display ${W}x$H is below the carve's minima" }
lc_step "session up on ${W}x$H"
# The rails: the session's rail admitted by the compositor (the seat rule),
# minted at the display width by rail_h; its bar too. The bar is minted
# BEFORE the rail in the owner's pass, and the compositor's admission line
# precedes each mint: ONE alternation over the four markers, in any order
# (the ls-gfx-session idiom).
set timeout 60
set saw_rail_created 0; set saw_rail_minted 0; set saw_bar_created 0; set saw_bar_minted 0
set tries 0
# The welcome leg below waits for a `running false panes >= 2` bar say, and
# that say is EDGE-TRIGGERED: statusset emits only when its key CHANGES. This
# `expect` scans past everything that is not one of its own four markers, so
# if the bar's say lands HERE it is consumed and the later leg can never see
# it -- re-expecting cannot recover output already eaten.
#
# MEASURED, not theorised (2026-09-15): in a burned attempt the say sat at log
# line 3022 and this leg matched at 3027 -- five lines later. The passing
# attempt had the same say at 3036, after the leg. Same image, same code, only
# the interleaving differed.
#
# So the state is hoisted ABOVE this leg and the branch below records it in
# passing. The witness is captured wherever it lands.
set saw_panes2 0; set N 0
while {(!$saw_rail_created || !$saw_rail_minted || !$saw_bar_created || !$saw_bar_minted) && $tries < 12} {
    incr tries
    expect {
        -re {tapestryd: rail (\d+) created \((\d+)x(\d+)\) for principal (\d+); the display carves 34|halcyond: rail (\d+) minted \((\d+)x34\)|tapestryd: status bar (\d+) created \((\d+)x(\d+)\) for principal (\d+); the display carves 25|halcyond: status bar (\d+) minted} {
            set m $expect_out(0,string)
            if {[string match "tapestryd: rail*" $m]} {
                if {$expect_out(2,string) != $W || $expect_out(3,string) != 34} { lc_fail "the rail is $expect_out(2,string)x$expect_out(3,string), not ${W}x34" }
                lc_step "the compositor admitted the session's rail (surface $expect_out(1,string), principal $expect_out(4,string))"
                set saw_rail_created 1
            } elseif {[string match "halcyond: rail*" $m]} {
                set saw_rail_minted 1
            } elseif {[string match "tapestryd: status bar*" $m]} {
                if {$expect_out(8,string) != $W} { lc_fail "the bar is $expect_out(8,string) wide, not $W" }
                set saw_bar_created 1
            } else {
                set saw_bar_minted 1
            }
        }
        -re {halcyond: rail failed} { lc_fail "the session's rail mint was refused: $expect_out(0,string)" }
        -re {halcyond: status bar failed} { lc_fail "the session's bar mint was refused: $expect_out(0,string)" }
        # COOPERATIVE: record the welcome leg's witness if it flies past here,
        # then KEEP SCANNING. `exp_continue` is load-bearing -- without it this
        # branch would satisfy the enclosing expect and become a consumer
        # itself, swallowing the rails markers it sits beside.
        -re {halcyond: status bar \d+ painted [^\r\n]*running false panes (\d+)} {
            if {$expect_out(1,string) >= 2} {
                set N $expect_out(1,string)
                set saw_panes2 1
                lc_step "the footer's pane count ($N) arrived before the welcome leg; recorded in passing"
            }
            exp_continue
        }
        -re {EXTINCTION:} { lc_extinction_fail "extinction before the rails" }
        timeout { lc_fail "the rails never came up (rail created=$saw_rail_created minted=$saw_rail_minted; bar created=$saw_bar_created minted=$saw_bar_minted)" }
        eof     { lc_fail "qemu exited before the rails" }
    }
}
if {!$saw_rail_created || !$saw_rail_minted || !$saw_bar_created || !$saw_bar_minted} {
    lc_fail "the rails never came up (rail created=$saw_rail_created minted=$saw_rail_minted; bar created=$saw_bar_created minted=$saw_bar_minted)"
}
lc_pass "session-instrument: the session minted both rails under the Instrument profile (8)"

# --- The welcome: two panes, the footer says so ----------------------------------
# H-4d's default restore puts the tour beside the shell; the footer's pane
# count follows the layout (a say per change of the right group). The
# restore tool's exit and the count's paint interleave freely: one
# alternation until both are seen.
set timeout 90
# The count the parse reports for the welcome's tree is read, not assumed
# (the tree carries the leaves the restore left, visible or not); the
# split and the close below are asserted RELATIVE to it.
# `saw_panes2` and `N` are NOT reset here: the rails leg above may already
# have recorded them in passing, and re-initialising would erase exactly the
# capture that fix exists for.
set saw_init 0; set tries 0
while {(!$saw_panes2 || !$saw_init) && $tries < 12} {
    incr tries
    expect {
        -re {halcyond: status bar \d+ painted [^\r\n]*running false panes (\d+)|halcyond: session init exited \(code ([0-9-]+)\)} {
            set m $expect_out(0,string)
            if {[string match "halcyond: status bar*" $m]} {
                set N $expect_out(1,string)
                if {$N >= 2} { set saw_panes2 1 }
            } else {
                if {$expect_out(2,string) ne "0"} { lc_fail "the restore tool exited $expect_out(2,string)" }
                set saw_init 1
            }
        }
        -re {halcyond: session tile leaf=[0-9]+ crashed} { lc_fail "a tile crashed during the welcome" }
        -re {EXTINCTION:} { lc_extinction_fail "extinction during the welcome" }
        timeout { lc_fail "the welcome never settled (panes2=$saw_panes2 init=$saw_init)" }
        eof     { lc_fail "qemu exited during the welcome" }
    }
}
if {!$saw_panes2 || !$saw_init} { lc_fail "the welcome never settled (panes2=$saw_panes2 init=$saw_init)" }
lc_pass "session-instrument: the footer counts the welcome's panes ($N by the parse; the tour beside the shell) (8.2)"
set N1 [expr {$N + 1}]
after 2500
set rz [rail_zones]
lc_step "the rail's targets: splith [dict get $rz splith] reset [dict get $rz reset] theme [dict get $rz theme] clock [dict get $rz clock]"

# --- The prompt's shape and inks (7.4 / 13 ruling 14; I-5c) --------------------
# The shell is the root leaf -- the session's FIRST spawn, before the
# restore's tour -- and its header strip's x is the content column's x (the
# same inner rect). The transcript's left padding is 3 vw of the display
# (I-5b, `Sheet.pad_x`: clamp 20..48, rounded), so the prompt's first glyph
# sits at x = header.x + pad_x. At the body size (Plex 15) the lambda
# advances 7.6, a space 3.5, the tilde 9.0 and the turnstile 7.5 (served
# from the mono), so `λ ~ ⊢ ` puts the lambda in [0, 8), nothing in [8, 11),
# the tilde in [11, 20) and the turnstile in [24, 31): x-bands, scanned
# down the tile's first rows.
#
# gfx_region.py --ink counts pixels ON the blend line from the tile's
# ground (Carbon `open`) to an ink -- the antialiased witness. Amber's line
# is 11 degrees off the neutral inks' (separable at half coverage), while
# terminal_path, secondary and text lie within 3 degrees of one another:
# collinear to this instrument, and the terminal view's text (its rows
# share these columns, 16 in from the pad) sits on the same lines. So a
# STATIC count of a neutral ink proves little; the leg reads the counts
# BEFORE and AFTER a second prompt from a command with no output, and the
# DELTA is the prompt's glyphs alone: the lambda's amber grows, the cwd's
# path-ink count grows, the turnstile's secondary-ink count grows, and no
# amber ever appears beside the lambda (the legacy shape fails the first
# band: its tilde is Bonfire's grey; an ember turnstile fails the last).
# The exact neutral roles are pinned by the export's host test and the
# layout's pass-through test.
proc dump_screen {} {
    global repo qmp
    set out /tmp/ls-halcyon-session-instrument-[pid].png
    file delete -force $out
    if {[catch {exec $repo/tools/screendump.sh -s $qmp $out} err]} { lc_fail "screendump failed: $err" }
    if {![file exists $out]} { lc_fail "screendump produced no file" }
    return $out
}
proc line_count {png x0 y0 x1 y1 ground ink} {
    global repo
    if {[catch {exec python3 $repo/tools/interactive/gfx_region.py --ink $png $x0 $y0 $x1 $y1 {*}$ground {*}$ink} n]} { lc_fail "gfx_region --ink failed: $n" }
    return $n
}
set OPEN {18 21 22}; set AMBER {199 185 139}; set PATH_INK {150 170 166}; set SECONDARY {175 180 176}
# One dump, six counts: lambda-band amber, gap-band amber, cwd-band path
# ink, cwd-band amber, turnstile-band secondary ink, turnstile-band amber.
proc prompt_counts {cx ry0 ry1} {
    global OPEN AMBER PATH_INK SECONDARY
    set png [dump_screen]
    set a  [line_count $png $cx $ry0 [expr {$cx + 8}] $ry1 $OPEN $AMBER]
    set g  [line_count $png [expr {$cx + 8}] $ry0 [expr {$cx + 11}] $ry1 $OPEN $AMBER]
    set b  [line_count $png [expr {$cx + 11}] $ry0 [expr {$cx + 20}] $ry1 $OPEN $PATH_INK]
    set ba [line_count $png [expr {$cx + 11}] $ry0 [expr {$cx + 20}] $ry1 $OPEN $AMBER]
    set c  [line_count $png [expr {$cx + 24}] $ry0 [expr {$cx + 31}] $ry1 $OPEN $SECONDARY]
    set ca [line_count $png [expr {$cx + 24}] $ry0 [expr {$cx + 31}] $ry1 $OPEN $AMBER]
    return [list $a $g $b $ba $c $ca]
}
if {[catch {exec grep -a -m 1 {halcyond: session tile leaf=[0-9]* spawned pid=} $transcript} first]} {
    lc_fail "no root tile spawn line in the transcript"
}
set A [lindex [regexp -inline {leaf=(\d+) spawned} $first] 1]
if {$A eq ""} { lc_fail "no leaf id in the root tile's spawn line ('$first')" }
set ha [header_of $A]
set pad_x [expr {int(round(max(20.0, min(48.0, 0.03 * $W))))}]
set cx [expr {[lindex $ha 0] + $pad_x}]
set ry0 [expr {[lindex $ha 1] + [lindex $ha 3] + 4}]
set ry1 [expr {$ry0 + 480}]
# The first prompt, retried until the lambda's amber is there (the tile
# composes on its own cadence after the welcome).
set before ""
for {set i 0} {$i < 12} {incr i} {
    set before [prompt_counts $cx $ry0 $ry1]
    if {[lindex $before 0] >= 6} break
    after 500
}
lassign $before a0 g0 b0 ba0 c0 ca0
if {$a0 < 6} { lc_fail "no amber lambda at the prompt column x=$cx rows $ry0..$ry1 (counts $before): the shell did not take the lambda shape, or not in amber" }
# ONE prompt at start (r2): the tile's first CONFIGURE resizes the pts and
# the kernel posts tty:winch; ut once answered every idle note with a
# newline and a fresh prompt, so two prompt zones stood before anything was
# typed (42 amber pixels here, one prompt's 21 doubled). A silent note now
# leaves the prompt in place: one lambda's worth, never two.
if {$a0 > 32} { lc_fail "more than one prompt at start ($a0 amber pixels in the lambda band: a doubled prompt, the idle note service moved the prompt)" }
if {$g0 != 0} { lc_fail "amber past the lambda's advance ($g0 pixels in \[8, 11) at x=$cx)" }
if {$ba0 != 0 || $ca0 != 0} { lc_fail "amber at the cwd ($ba0) or the turnstile ($ca0): the one-amber-glyph rule (13 ruling 14)" }
lc_step "the first prompt at x=$cx rows $ry0..$ry1: lambda $a0 amber, cwd $b0 on the path ink, turnstile $c0 on the secondary ink"
# A second prompt from a command with no output.
htype "true\n"
set after ""
for {set i 0} {$i < 12} {incr i} {
    set after [prompt_counts $cx $ry0 $ry1]
    if {[lindex $after 0] >= $a0 + 6} break
    after 500
}
lassign $after a1 g1 b1 ba1 c1 ca1
if {$a1 < $a0 + 6} { lc_fail "a second prompt did not add a lambda in amber ($a0 -> $a1)" }
if {$b1 < $b0 + 4} { lc_fail "a second prompt did not add its cwd on the path ink ($b0 -> $b1)" }
if {$c1 < $c0 + 4} { lc_fail "a second prompt did not add its turnstile on the secondary ink ($c0 -> $c1)" }
if {$g1 != 0 || $ba1 != 0 || $ca1 != 0} { lc_fail "amber beside the lambda after the second prompt (gap $g1, cwd $ba1, turnstile $ca1)" }
lc_pass "session-instrument: the prompt is `λ <cwd> ⊢` in the session's inks -- the lambda amber ($a0 -> $a1 across a second prompt), the cwd on the path ink ($b0 -> $b1), the turnstile on the secondary ink ($c0 -> $c1), no amber beside the lambda (7.4 / 13 ruling 14)"

# --- The footer's conditions from the shell's facts (8.2 / 14.3) -----------
set timeout 60
htype "sleep 3\n"
expect {
    -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*running true panes $N" {}
    -re {EXTINCTION:} { lc_extinction_fail "extinction during sleep" }
    timeout { lc_fail "the footer never showed RUNNING for the shell's sleep" }
    eof     { lc_fail "qemu exited during sleep" }
}
lc_step "RUNNING while sleep runs"
expect {
    -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*condition Ok \[^\\r\\n\]*exit 0 \[^\\r\\n\]*running false panes $N" {}
    -re {EXTINCTION:} { lc_extinction_fail "extinction after sleep" }
    timeout { lc_fail "the footer never showed EXIT 0 after sleep" }
    eof     { lc_fail "qemu exited after sleep" }
}
htype "false\n"
expect {
    -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*condition Err \[^\\r\\n\]*exit 1 \[^\\r\\n\]*running false panes $N" {}
    -re {EXTINCTION:} { lc_extinction_fail "extinction after false" }
    timeout { lc_fail "the footer never showed EXIT 1 after false" }
    eof     { lc_fail "qemu exited after false" }
}
lc_pass "session-instrument: the footer shows RUNNING, EXIT 0 and EXIT 1 from the tile's own facts (8.2 / 14.3)"

# --- I-7b (9.5 / 9.3): the keyboard reference on the session's seat ------------
exec $repo/tools/qmp-sendtext.sh -s $qmp -k "meta_l+slash"
expect {
    -re {tapestryd: chord help -> rail owner} {}
    -re {tapestryd: chord help: no rail} { lc_fail "the session had no rail for the help chord" }
    timeout { lc_fail "Super+/ did not deliver a help chord to the rail owner" }
    eof     { lc_fail "EOF waiting for the help chord" }
}
expect {
    -re {halcyond: menu (\d+) placed at (\d+) (\d+) \((\d+)x(\d+)\) for help (\d+) rows} {
        if {$expect_out(4,string) != 540} { lc_fail "the reference is $expect_out(4,string) wide, expected 540 (9.5)" }
        if {$expect_out(6,string) < 12} { lc_fail "the reference has only $expect_out(6,string) rows: not read from the compositor's chords (9.5)" }
        lc_step "the reference ($expect_out(4,string) x $expect_out(5,string)) placed, $expect_out(6,string) rows from the chords in force"
    }
    -re {halcyond: no chords published} { lc_fail "the compositor published no chords, so the reference had no rows (9.5)" }
    timeout { lc_fail "Super+/ did not open the reference on the session seat" }
    eof     { lc_fail "EOF waiting for the session reference" }
}
hkey "esc"
expect {
    -re {tapestryd: menu \d+ dismissed \(esc\)} {}
    timeout { lc_fail "Esc did not dismiss the reference" }
    eof     { lc_fail "EOF waiting for the reference dismiss" }
}
lc_pass "session-instrument: Super+/ opens the 540-wide keyboard reference on the session's seat, its rows read from the compositor's chords (9.5 / 9.3)"

# --- Section 10 as revised 2026-09-16: a DIALOG dims the display, and NOTHING
# behind it freezes ----------------------------------------------------------
# The operator found the frozen full-viewport backdrop "too dramatic for a
# menu -- it feels like a SAK episode"; a dialog keeps the kit's backdrop, a
# menu carries only its shadow, and the compositor lays both on at UPLOAD, so
# programs behind them keep drawing. Read off screendumps with gfx_region.py's
# DOMINANT colour. The sample rect sits left of the centred 540-wide reference
# by 80 px -- beyond the shadow's 32 px of blur -- at mid-height, inside the
# shell tile: flat ground but for glyphs, so its dominant colour is the ground.
#   dim  : with the reference up the rect reads EXACTLY rgb(3,4,4) at 184/256
#          over that ground (a box blur of a constant field is the field). The
#          frozen design read the same colour, so this alone separates nothing
#          from it -- the live leg does.
#   live : a job ENDS while the reference stands, and the footer strip's ink
#          changes under the dim. The frozen design uploaded nothing outside
#          the card until the dismiss, so the strip read the same before and
#          after -- the failure this leg exists to see.
#   back : after Esc the rect reads the ground it read before.
proc region_off {png x0 y0 x1 y1 rgb} {
    global repo
    if {[catch {exec python3 $repo/tools/interactive/gfx_region.py $png $x0 $y0 $x1 $y1 {*}$rgb} v]} { lc_fail "gfx_region failed: $v" }
    if {![regexp {^(\d+) (\d+) (\d+) (\d+) (\d+)$} $v -> off tot r g b]} { lc_fail "gfx_region said '$v'" }
    return [list $off $r $g $b]
}
proc dom_of {png x0 y0 x1 y1} {
    return [lrange [region_off $png $x0 $y0 $x1 $y1 {0 0 0}] 1 3]
}
set sx0 40
set sx1 [expr {($W - 540) / 2 - 80}]
set sy0 [expr {$H / 2 - 40}]
set sy1 [expr {$H / 2 + 40}]
if {$sx1 - $sx0 < 60} { lc_fail "no room left of the reference for the sample rect (W=$W)" }
set ground [dom_of [dump_screen] $sx0 $sy0 $sx1 $sy1]
lassign $ground gr gg gb
set dimmed [list [expr {(3 * 184 + $gr * 72) >> 8}] [expr {(4 * 184 + $gg * 72) >> 8}] [expr {(4 * 184 + $gb * 72) >> 8}]]
set timeout 60
htype "sleep 12\n"
expect {
    -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*running true panes $N" {}
    -re {EXTINCTION:} { lc_extinction_fail "extinction during the dim leg's sleep" }
    timeout { lc_fail "the footer never showed RUNNING for the dim leg's sleep" }
    eof     { lc_fail "qemu exited during the dim leg's sleep" }
}
exec $repo/tools/qmp-sendtext.sh -s $qmp -k "meta_l+slash"
expect {
    -re {tapestryd: menu (\d+) class dialog} {}
    -re {tapestryd: menu (\d+) class menu} { lc_fail "the reference was placed as a MENU: halcyond did not send the dialog word (section 10 as revised 2026-09-16)" }
    timeout { lc_fail "the reference's placement named no class" }
    eof     { lc_fail "EOF waiting for the reference's class" }
}
expect {
    -re {halcyond: menu (\d+) placed at (\d+) (\d+) \((\d+)x(\d+)\) for help} {}
    timeout { lc_fail "Super+/ did not open the reference for the dim leg" }
    eof     { lc_fail "EOF waiting for the reference (dim leg)" }
}
set v ""
for {set i 0} {$i < 12} {incr i} {
    set v [dom_of [dump_screen] $sx0 $sy0 $sx1 $sy1]
    if {$v eq $dimmed} break
    after 500
}
if {$v ne $dimmed} { lc_fail "with the reference up the sample rect read {$v}, not the backdrop over its ground {$ground} = {$dimmed}" }
lc_step "the reference dims the display: the ground {$ground} reads {$dimmed} beside it"
set fy0 [expr {$H - 25}]
set fpng [dump_screen]
set fground [dom_of $fpng 0 $fy0 $W $H]
set fbefore [lindex [region_off $fpng 0 $fy0 $W $H $fground] 0]
expect {
    -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*running false panes $N" {}
    -re {EXTINCTION:} { lc_extinction_fail "extinction while the reference stood" }
    timeout { lc_fail "the job never ended while the reference stood" }
    eof     { lc_fail "qemu exited while the reference stood" }
}
set fafter $fbefore
for {set i 0} {$i < 12} {incr i} {
    set fafter [lindex [region_off [dump_screen] 0 $fy0 $W $H $fground] 0]
    if {$fafter != $fbefore} break
    after 500
}
if {$fafter == $fbefore} { lc_fail "the footer strip kept $fbefore ink pixels across the job's end under the reference: the scene behind a dialog is FROZEN (section 10 as revised 2026-09-16)" }
lc_step "the footer drew under the reference as the job ended ($fbefore -> $fafter ink pixels)"
hkey "esc"
expect {
    -re {tapestryd: menu \d+ dismissed \(esc\)} {}
    timeout { lc_fail "Esc did not dismiss the reference (dim leg)" }
    eof     { lc_fail "EOF waiting for the reference dismiss (dim leg)" }
}
set v ""
for {set i 0} {$i < 12} {incr i} {
    set v [dom_of [dump_screen] $sx0 $sy0 $sx1 $sy1]
    if {$v eq $ground} break
    after 500
}
if {$v ne $ground} { lc_fail "after Esc the sample rect read {$v}, not the ground {$ground} it read before the reference" }
lc_pass "session-instrument: a DIALOG dims the whole display ({$ground} -> {$dimmed}), the scene behind it keeps drawing (the footer changed as a job ended under it), and Esc puts the ground back (section 10 as revised 2026-09-16)"

# --- I-7b (9.5 / 14.5): Super+Q ASKS while a job runs; Cancel keeps both -------
# The chord is no longer the compositor's act: it is DELIVERED to the rail's
# owner with the focused pane's id, because only the owner knows a command is
# running. Cancel (the compositor's Esc dismiss) must keep the tile AND its
# job -- the ^C below is the positive witness for both, since it can only be
# taken by a shell that is still alive in a tile that was not closed.
set timeout 60
htype "sleep 30\n"
expect {
    -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*running true panes $N" {}
    -re {EXTINCTION:} { lc_extinction_fail "extinction during the long sleep" }
    timeout { lc_fail "the footer never showed RUNNING for the long sleep" }
    eof     { lc_fail "qemu exited during the long sleep" }
}
hkey "meta_l+shift+q"
expect {
    -re {tapestryd: chord close -> rail owner} {}
    -re {tapestryd: chord close: no rail} { lc_fail "the session had no rail for the close chord (I-7b)" }
    timeout { lc_fail "Super+Q was not delivered to the rail owner (I-7b)" }
    eof     { lc_fail "qemu exited on the close chord" }
}
expect {
    -re {halcyond: menu (\d+) placed at (\d+) (\d+) \((\d+)x(\d+)\) for dialog close} {
        lc_step "Super+Q over a running job opened the 14.5 confirmation"
    }
    -re "halcyond: tile \\d+ hung up" { lc_fail "Super+Q CLOSED a running tile without asking (9.5 / 14.5)" }
    timeout { lc_fail "Super+Q over a running job did not ask (9.5 / 14.5)" }
    eof     { lc_fail "qemu exited waiting for the close confirmation" }
}
hkey "esc"
expect {
    -re {tapestryd: menu \d+ dismissed \(esc\)} {}
    timeout { lc_fail "Esc did not dismiss the close confirmation" }
    eof     { lc_fail "EOF waiting for the confirmation dismiss" }
}
# Cancel kept the tile AND its job. The witness is the sleep reaching its own
# end: only a live tile whose shell was never hung up can report that exit, and
# the footer must still count $N panes when it does.
#
# An explicit ^C would be the faster witness, but this seat's input arrives as
# QMP KEY EVENTS: `htype` goes through qmp-sendtext's text path, which has no
# mapping for a control byte (measured -- it exits with "unsupported char
# '\x03'"), and `lc_ctrlc` writes raw 0x03 to the SERIAL console, which is not
# this seat's input path at all. Waiting out the job needs neither.
set timeout 90
expect {
    -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*running false panes $N" {}
    -re "halcyond: tile \\d+ hung up" { lc_fail "the CANCELLED close closed the tile anyway (9.5 / 14.5)" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction after the cancelled close" }
    timeout { lc_fail "after Cancel the tile never reported its job finishing on $N panes: the cancel did not keep it" }
    eof     { lc_fail "qemu exited after the cancelled close" }
}
set timeout 60
lc_pass "session-instrument: Super+Q over a RUNNING job asks first (the 14.5 dialog) and Cancel keeps the tile AND its job (9.5 / 14.5 / I-7b)"

# --- A divider drag reaches the tiles as a resize (9.2 / I-6) ------------------
# The welcome root is [tour | shell] (tour-left, shell-right: `halcyon
# welcome`'s shape); the track sits after the first child's frame, the
# pair's usable extent P is the two frames' widths (each header's width
# plus the frame), the full extent F adds the 7 px track. The two headers'
# say lines carry their minted rects (both minted after the welcome split,
# so they are current); the order is read off their x, never assumed, and
# the second's start is checked against the track before anything is
# pressed. A drag 100 px right re-lays both tiles through the existing
# CONFIGURE -> fit -> pts winsize path: halcyond says each fit with the new
# surface width (the frame less 2), and the shell's prompt count -- read at
# the prompt column MOVED by the same delta -- must NOT grow: r2 made a
# winch a silent note, so the prompt stays where it was.
set lines [split [exec grep -a {halcyond: session tile leaf=[0-9]* spawned pid=} $transcript] "\n"]
set T [lindex [regexp -inline {leaf=(\d+) spawned} [lindex $lines 1]] 1]
if {$T eq "" || $T eq $A} { lc_fail "no second tile (the tour) in the transcript (leaves: $lines)" }
set ha [header_of $A]
set ht [header_of $T]
if {[lindex $ht 0] < [lindex $ha 0]} {
    set h1 $ht; set h2 $ha; set L1 $T; set L2 $A
} else {
    set h1 $ha; set h2 $ht; set L1 $A; set L2 $T
}
set origin 3
set first [expr {[lindex $h1 2] + 2}]
set second [expr {[lindex $h2 2] + 2}]
set P [expr {$first + $second}]
set F [expr {$P + 7}]
set track [expr {$origin + $first}]
if {[lindex $h1 0] != $origin + 1} { lc_fail "the first child's header does not start at the pad plus the frame ([lindex $h1 0] vs [expr {$origin + 1}])" }
if {[lindex $h2 0] - 1 != $track + 7} { lc_fail "the second child's frame does not start after the first's track ([lindex $h2 0] - 1 vs [expr {$track + 7}]; headers $ha / $ht)" }
set ty [expr {(34 + $H - 25) / 2}]
set pre [prompt_counts $cx $ry0 $ry1]
set p2 [expr {$track + 3 + 100}]
set a2 [expr {(2 * ($p2 - $origin) * $P + $F) / (2 * $F)}]
set delta [expr {$a2 - $first}]
ptr_to [expr {$track + 3}] $ty
ptr_op "btn left down"
set timeout 30
expect {
    -re {tapestryd: divider drag start pane (\d+) track 0 at} {}
    timeout { lc_fail "the press on the welcome's track at x=[expr {$track + 3}] did not start a drag (headers $ha / $ht)" }
    eof     { lc_fail "EOF waiting for the drag start" }
}
ptr_to $p2 $ty
ptr_op "btn left up"
# The fits land DURING the drag (one relayout per frame fans the CONFIGUREs
# before the release), so the three witnesses -- both fits and the drag's
# end -- are one alternation, never a sequence (a sequence's first expect
# would swallow the fits with the end line).
set fit1 0; set fit2 0; set ended 0; set tries 0
while {(!$fit1 || !$fit2 || !$ended) && $tries < 12} {
    incr tries
    expect {
        -re "halcyond: session tile leaf=($L1|$L2) fit (\\d+)x(\\d+) px -> (\\d+) cols (\\d+) rows" {
            set who $expect_out(1,string); set fw $expect_out(2,string)
            if {$who eq $L1} {
                if {$fw != $a2 - 2} { lc_fail "the first tile (leaf $L1) fit at $fw wide, expected [expr {$a2 - 2}] (the frame less 2)" }
                set fit1 1
            } else {
                if {$fw != $P - $a2 - 2} { lc_fail "the second tile (leaf $L2) fit at $fw wide, expected [expr {$P - $a2 - 2}]" }
                set fit2 1
            }
        }
        -re "tapestryd: divider drag end pane (\\d+) track 0 release -> (\\d+):(\\d+)\r" {
            if {$expect_out(2,string) != $a2 || $expect_out(3,string) != $P - $a2} {
                lc_fail "the drag ended at $expect_out(2,string):$expect_out(3,string), expected $a2:[expr {$P - $a2}] (origin $origin, P $P, F $F)"
            }
            set ended 1
        }
        -re {EXTINCTION:} { lc_extinction_fail "extinction during the drag" }
        timeout { lc_fail "the drag's witnesses did not all arrive (first fit $fit1, second fit $fit2, end $ended)" }
        eof     { lc_fail "qemu exited during the drag" }
    }
}
# The shell's prompt column moved with its frame iff the shell is the
# second child (the first child's origin is the pad, unmoved).
set cx2 [expr {$L2 eq $A ? $cx + $delta : $cx}]
after 1500
set post ""
for {set i 0} {$i < 8} {incr i} {
    set post [prompt_counts $cx2 $ry0 $ry1]
    if {[lindex $post 0] == [lindex $pre 0]} break
    after 500
}
if {[lindex $post 0] != [lindex $pre 0]} { lc_fail "the shell's prompt count changed across the drag's resizes ($pre -> $post at x=$cx2): the winch moved the prompt" }
if {[lindex $post 3] != 0 || [lindex $post 5] != 0} { lc_fail "amber beside the lambda after the drag ($post)" }
set cx $cx2
lc_pass "session-instrument: a divider drag re-fits both tiles through the CONFIGURE path (first [expr {$a2 - 2}] wide, second [expr {$P - $a2 - 2}]) and the shell's prompt stays put across the winch (9.2 / r2)"
ptr_to [expr {$W / 2}] [expr {$H / 2}]

# --- SPLIT H on the rail: the session splits under its own authority ------------
after 1000
set shc [zone_centre [dict get $rz splith]]
click [lindex $shc 0] [lindex $shc 1]
expect {
    -re {tapestryd: ptr btn 272 1 -> chrome (\d+) at (\d+),(\d+)} {}
    timeout { lc_fail "the press on SPLIT H was not routed to the rail" }
    eof     { lc_fail "EOF waiting for the SPLIT H press" }
}
expect {
    -re {halcyond: rail press SplitH} {}
    timeout { lc_fail "halcyond did not act on SPLIT H" }
    eof     { lc_fail "EOF waiting for the rail action" }
}
set B ""
expect {
    -re {halcyond: session tile leaf=([0-9]+) spawned pid=} {
        set B $expect_out(1,string)
    }
    -re {halcyond: split h on pane [0-9]+ refused} { lc_fail "the session's split was refused: $expect_out(0,string)" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction after SPLIT H" }
    timeout { lc_fail "no new tile spawned after the rail's SPLIT H" }
    eof     { lc_fail "qemu exited after SPLIT H" }
}
expect {
    -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*panes $N1" {}
    timeout { lc_fail "the footer never counted the new pane ($N1)" }
    eof     { lc_fail "EOF waiting for the pane count" }
}
lc_pass "session-instrument: the rail's SPLIT H spawned a new tile (leaf $B) under the session's authority; the footer counts $N1 (8.1 / 9.5)"

# --- HALCYON-WORKSPACES W-3: the switch, and the bar's two numbers ---------------
# Super+2 CREATES workspace 2 and switches to it. The session's tiles go
# DORMANT with the root they live in rather than closing, so the bar is the
# thing that can report the move: it reads the compositor's `layout` header,
# the ratified channel.
#
# S4: the header carries the ascending LIST of live numbers, so a dense pair
# reads `workspaces 1,2`, and `active0` is the model's DERIVED POSITION into
# that list, printed raw. Printing the active NUMBER instead would merely echo
# the compositor and agree with itself -- the position is a value the
# compositor never sends, so a broken number-to-position resolution fails
# here. (The i3 rule this comment used to cite -- "only the next free number
# may be made" -- was retired by S4: a number is an identity, so Super+5 makes
# workspace 5 whether or not 2..4 exist.)
hkey "meta_l+2"
expect {
    -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*workspaces 1,2 active0 1" {}
    -re {EXTINCTION:} { lc_extinction_fail "extinction after Super+2" }
    timeout { lc_fail "the bar never read workspace 2 after Super+2 (the switch, the header, or the feed)" }
    eof     { lc_fail "qemu exited after Super+2" }
}
lc_pass "session-instrument: Super+2 created workspace 2 and the bar reads it (W-1a's switch through W-2a's feed)"

# --- The workspace list, opened WHILE two workspaces exist (14.1; round 1 F6) ----
# Opened HERE, before the return, because the row COUNT is the only thing that
# separates a list built from the header from the hardcoded `workspace_menu(1, 0)`
# this leg used to accept. Round 1 found both owners opening the list with that
# literal while `RailModel::empty()` pinned the chips at one -- and this leg
# asserted only that the menu opened and Esc dismissed it, so it passed with the
# count stuck at 1 forever: an assertion that cannot fail.
#
# The placement say already carries the menu's pixel size, so no new witness is
# needed in the guest: a two-row list is TALLER than a one-row list. Taking both
# heights makes this a control ONE VARIABLE AWAY -- hardcode the count again and
# h2 == h1, which is the failure the old leg could not see.
after 1000
click 15 15
expect {
    -re {halcyond: rail press Workspaces} {}
    timeout { lc_fail "the press on the mark did not reach halcyond in workspace 2" }
    eof     { lc_fail "EOF waiting for the mark press in workspace 2" }
}
set h2 0
expect {
    -re {halcyond: menu (\d+) placed at (\d+) (\d+) \((\d+)x(\d+)\) for Workspaces} {
        set h2 $expect_out(5,string)
    }
    -re {halcyond: menu (surface failed|place refused)} { lc_fail "the session could not place the workspace list in workspace 2: $expect_out(0,string)" }
    timeout { lc_fail "the workspace list was not placed in workspace 2" }
    eof     { lc_fail "EOF waiting for the workspace list in workspace 2" }
}
lc_step "the workspace list with TWO workspaces is ${h2}px tall"
hkey "esc"
expect {
    -re {tapestryd: menu \d+ dismissed \(esc\)} {}
    timeout { lc_fail "Esc did not dismiss the workspace list in workspace 2" }
    eof     { lc_fail "EOF waiting for the dismiss in workspace 2" }
}

hkey "meta_l+1"
expect {
    -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*workspaces 1 active0 0" {}
    -re {EXTINCTION:} { lc_extinction_fail "extinction after Super+1" }
    timeout { lc_fail "the bar never returned to workspace 1, or the EMPTY workspace 2 did not vanish" }
    eof     { lc_fail "qemu exited after Super+1" }
}
lc_pass "session-instrument: Super+1 returned and the empty workspace 2 VANISHED -- the bar reads 1/1 (the i3 rule)"

# --- The same list with ONE workspace: the control half (14.1 / 14.2) -----------
after 1000
click 15 15
expect {
    -re {halcyond: rail press Workspaces} {}
    timeout { lc_fail "the press on the mark did not reach halcyond" }
    eof     { lc_fail "EOF waiting for the mark press" }
}
set h1 0
expect {
    -re {tapestryd: menu (\d+) class dialog} { lc_fail "the workspace list was placed as a DIALOG (section 10 as revised 2026-09-16: a menu carries only its shadow)" }
    -re {tapestryd: menu (\d+) class menu} {}
    timeout { lc_fail "the workspace list's placement named no class" }
    eof     { lc_fail "EOF waiting for the workspace list's class" }
}
expect {
    -re {halcyond: menu (\d+) placed at (\d+) (\d+) \((\d+)x(\d+)\) for Workspaces} {
        set lx $expect_out(2,string); set ly $expect_out(3,string)
        set lw $expect_out(4,string); set h1 $expect_out(5,string)
    }
    -re {halcyond: menu (surface failed|place refused)} { lc_fail "the session could not place the workspace list: $expect_out(0,string)" }
    timeout { lc_fail "the workspace list was not placed" }
    eof     { lc_fail "EOF waiting for the workspace list" }
}
lc_step "the workspace list with ONE workspace is ${h1}px tall"
# A MENU dims nothing and casts its shadow (section 10 as revised 2026-09-16).
# Two rects, read with the list up and again after Esc: one right of the list
# by 100 px -- beyond the 32 px of blur -- must read the SAME dominant colour
# both times (the frozen full-viewport design dimmed it); one inside the
# shadow just under the card must read DARKER with the list up. The after-Esc
# read is the scene without the card, so no pre-card dump has to guess where
# the list will land.
set fx0 [expr {$lx + $lw + 100}]; set fx1 [expr {$fx0 + 200}]
set fy0 [expr {$ly + 40}];        set fy1 [expr {$fy0 + 100}]
set shx0 [expr {$lx + 40}];       set shx1 [expr {$lx + $lw - 40}]
set shy0 [expr {$ly + $h1 + 4}];  set shy1 [expr {$ly + $h1 + 16}]
if {$fx1 > $W || $shx1 - $shx0 < 20} { lc_fail "no room for the menu's sample rects (list at $lx,$ly ${lw}x$h1, W=$W)" }
after 800
set upng [dump_screen]
set far_up [dom_of $upng $fx0 $fy0 $fx1 $fy1]
set shade_up [dom_of $upng $shx0 $shy0 $shx1 $shy1]
hkey "esc"
expect {
    -re {tapestryd: menu \d+ dismissed \(esc\)} {}
    timeout { lc_fail "Esc did not dismiss the workspace list" }
    eof     { lc_fail "EOF waiting for the dismiss" }
}
after 800
set dpng [dump_screen]
set far_down [dom_of $dpng $fx0 $fy0 $fx1 $fy1]
set shade_down [dom_of $dpng $shx0 $shy0 $shx1 $shy1]
if {$far_up ne $far_down} { lc_fail "a MENU dimmed the display: {$far_up} beside the list, {$far_down} once it went (section 10 as revised 2026-09-16)" }
lassign $shade_up su_r su_g su_b; lassign $shade_down sd_r sd_g sd_b
if {!($su_r + $su_g + $su_b < $sd_r + $sd_g + $sd_b)} { lc_fail "the list cast no shadow: {$shade_up} under it, {$shade_down} once it went" }
lc_step "the list dims nothing ({$far_up} beside it either way) and casts its shadow ({$shade_down} -> {$shade_up} under it)"
if {$h2 <= $h1} {
    lc_fail "the workspace list did not grow with the workspace count (two-workspace list ${h2}px, one-workspace list ${h1}px): it is still reading a hardcoded count rather than the compositor's header (round 1 F6)"
}
lc_pass "session-instrument: the workspace list is BUILT FROM THE HEADER -- two workspaces give a taller list than one (${h2}px vs ${h1}px) -- and Esc dismisses it (14.1 / 14.2 / round 1 F6)"

# --- Super+T: the picker, a live commit, and the durable write (9.4 / I-7) ------
after 800
exec $repo/tools/qmp-sendtext.sh -s $qmp -k "meta_l+t"
expect {
    -re {tapestryd: chord picker -> rail owner} {}
    -re {tapestryd: chord picker: no rail} { lc_fail "the session had no rail for the picker chord" }
    timeout { lc_fail "Super+T did not deliver a picker chord to the rail owner" }
    eof     { lc_fail "EOF waiting for the picker chord" }
}
expect {
    -re {halcyond: menu (\d+) placed at (\d+) (\d+) \((\d+)x(\d+)\) for picker (\S+)} {
        lc_step "the picker ($expect_out(4,string) x $expect_out(5,string)) placed, current [string trim $expect_out(6,string)]"
    }
    -re {halcyond: menu (surface failed|place refused)} { lc_fail "the session could not place the picker: $expect_out(0,string)" }
    timeout { lc_fail "Super+T did not open the picker on the session seat" }
    eof     { lc_fail "EOF waiting for the session picker" }
}
# Home selects Signal (rank 1 of DARK FIELD); Enter commits it live AND, on
# the session seat, persists it to $HOME/lib/halcyon/theme (the durable write).
hkey "home"
hkey "ret"
expect {
    -re {halcyond: theme signal applied} {}
    -re {halcyond: theme signal refused} { lc_fail "the session picker commit refused signal" }
    timeout { lc_fail "the session picker did not commit signal live" }
    eof     { lc_fail "EOF waiting for the session theme commit" }
}
expect {
    -re {halcyond: theme signal written} {}
    -re {halcyond: theme signal not written} { lc_fail "the session did not persist the pick (no home or write failed)" }
    timeout { lc_fail "the session did not write $HOME/lib/halcyon/theme" }
    eof     { lc_fail "EOF waiting for the durable write" }
}
lc_pass "session-instrument: Super+T opens the picker; a commit switches the theme live and the session persists the pick to \$HOME/lib/halcyon/theme (9.4)"

# --- The retained tile and its Restart (14.6 / 14.9) ---------------------------
# B is focused since the split: `exit` ends its shell; under Instrument the
# tile is RETAINED (no close, no logout). Its header's secondary press
# summons the tile menu with Restart first; Enter restarts it in place.
after 1000
htype "exit\n"
set timeout 60
expect {
    -re "halcyond: session tile leaf=$B ended \\(exit 0\\) -- retained" {}
    -re "halcyond: session tile leaf=$B exited \\(code 0\\) -- closing" { lc_fail "leaf $B CLOSED on exit: the legacy tmux rule ran under Instrument" }
    -re {halcyond: session logout} { lc_fail "the session logged out on one tile's exit" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction on the tile's exit" }
    timeout { lc_fail "leaf $B was neither retained nor closed after exit" }
    eof     { lc_fail "qemu exited on the tile's exit" }
}
lc_pass "session-instrument: an ended tile is RETAINED under Instrument (14.6)"
after 1500
set hb [header_of $B]
set hx [expr {[lindex $hb 0] + 39 + 40}]
set hy [expr {[lindex $hb 1] + 16}]
click $hx $hy right
expect {
    -re "halcyond: header $B press Menu" {}
    timeout { lc_fail "the secondary press on leaf $B's header did not reach halcyond (header at [join $hb { }])" }
    eof     { lc_fail "EOF waiting for the header press" }
}
expect {
    -re {halcyond: menu (\d+) placed at (\d+) (\d+) \((\d+)x(\d+)\) for tile } {}
    timeout { lc_fail "the tile menu was not placed" }
    eof     { lc_fail "EOF waiting for the tile menu" }
}
after 600
hkey "ret"
# The spawn says first (inside the spawn), then the caller says restarted.
expect {
    -re "halcyond: session tile leaf=$B spawned pid=" {}
    -re "halcyond: tile $B is live; restart refused" { lc_fail "Restart was refused: the tile read as live" }
    -re "halcyond: tile $B restart failed" { lc_fail "the restart failed: $expect_out(0,string)" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction on Restart" }
    timeout { lc_fail "Enter on the tile menu did not respawn leaf $B" }
    eof     { lc_fail "qemu exited on Restart" }
}
expect {
    -re "halcyond: tile $B restarted" {}
    timeout { lc_fail "the respawned tile was not reported restarted" }
    eof     { lc_fail "EOF waiting for the restart line" }
}
lc_pass "session-instrument: the tile menu's Restart respawned the retained tile in its leaf (14.9 / 14.6)"

# --- Super+Q: the structural close, then the logout ------------------------------
after 1500
hkey "meta_l+shift+q"
# The structural close HANGS the tile UP (the I-4 r1 B-F4 fix): the session
# closes the tile's down channel, the kaua-term ends its program and REAPS
# it, then exits by itself -- so no zombie of the user's escapes to joey
# holding the home mount (the logout stall's mechanism on main, ARM-6's
# class). The hangup witness and the footer's count interleave freely.
set saw_hup 0; set saw_panes 0; set tries 0
while {(!$saw_hup || !$saw_panes) && $tries < 6} {
    incr tries
    expect {
        -re "halcyond: tile $B hung up \\((\\d+) ms\\)" { set saw_hup 1; lc_step "leaf $B hung up in $expect_out(1,string) ms" }
        -re "halcyond: tile $B killed after the hangup grace" { lc_fail "leaf $B's terminal did not come down on the hangup: killed after the grace" }
        -re "halcyond: status bar \\d+ painted \[^\\r\\n\]*panes $N" { set saw_panes 1 }
        -re {EXTINCTION:} { lc_extinction_fail "extinction on Super+Q" }
        timeout { lc_fail "Super+Q did not close leaf $B (hung up=$saw_hup, the footer counted $N again=$saw_panes)" }
        eof     { lc_fail "qemu exited on Super+Q" }
    }
}
if {!$saw_hup || !$saw_panes} { lc_fail "Super+Q did not close leaf $B (hung up=$saw_hup, counted=$saw_panes)" }
lc_pass "session-instrument: Super+Q closed the restarted tile structurally (the 9.3 delta) and hung it up; $N panes again"
after 1000
hkey "meta_l+shift+q"
after 1500
hkey "meta_l+shift+q"
set timeout 90
expect {
    -re {halcyond: session logout \(code (\d+)\)} {
        if {$expect_out(1,string) ne "0"} { lc_fail "the session logged out with code $expect_out(1,string)" }
    }
    -re {EXTINCTION:} { lc_extinction_fail "extinction at logout" }
    timeout { lc_fail "the session did not log out after closing every tile" }
    eof     { lc_fail "qemu exited at logout" }
}
expect {
    -re {tapestryd: rail (\d+) retired} {}
    timeout { lc_fail "the compositor did not retire the session's rail with the seat" }
    eof     { lc_fail "EOF waiting for the rail's retire" }
}
# The logout completes: login's own steps say so (the home proxy's reap is
# the step that STALLED while a killed tile's shell survived as an orphan
# zombie pinning the home mount -- measured 3/3 on 2026-09-14 and fixed by
# the hangup teardown above), then the getty's prompt returns.
set timeout 45
expect {
    -ex "login: logout: home proxy reaped" { lc_step "login reaped the home proxy: nothing of the session pins the home" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction after logout" }
    timeout { lc_fail "login never reaped the home proxy after the logout: a process of the session still pins the home mount (the ARM-6 class)" }
    eof     { lc_fail "qemu exited after logout" }
}
expect {
    -ex "Thylacine login: " { lc_step "the login prompt returned" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction after logout" }
    timeout { lc_fail "the login prompt did not return after the logout" }
    eof     { lc_fail "qemu exited after logout" }
}
lc_pass "session-instrument: closing every tile logs the session out, the rail retires with the seat, and the login prompt returns"

lc_pass "ls-halcyon-session-instrument: the session path under Instrument verified end to end -- both rails minted by the seat, the lambda prompt in the session's inks, the footer's pane count and its four conditions from the tile's facts, SPLIT H under the session's authority, the workspace list, the retained tile and its Restart, the structural close, the logout; Super+T opens the picker, a commit switches the theme live and persists the pick (9.4)"
# The session is gone; quit qemu from the login prompt.
lc_step "quit qemu (Ctrl-A x)"
catch {send -- "\001x"}
exit 0
