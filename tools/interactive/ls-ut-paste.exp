#!/usr/bin/expect -f
# The paste key in a real ut (ASYNC-SERVICE-LIFECYCLE, AS-4e). The probe hosts the shell
# on a pts of its own against loom-fixture's interaction node over the private ring,
# since ut cannot give a child an environment and the session's service cannot be
# stopped. The real session's half is ls-halcyon-clipboard.exp's kind of run, owed.
#
# Image and boot:
#   tools/build.sh kernel --config ci --set PRIVATE_ASYNC_QUAL=y
#   THYLACINE_BUILD_DIR=build/kernel-private-async-qual tools/test-interactive.sh ls-ut-paste
#
# What the run must show (usr/kaua-term-probe/src/ut_paste.rs):
#   - The key puts the text in the line and nothing runs until Enter, two lines included.
#   - Past the line's 64 KiB limit, or with a tab, it refuses whole and says so, and the
#     line is still usable.
#   - With the server stopped at the paste, typing runs, a second key says the first is
#     out, and Enter or Ctrl-C ends the fetch at once.
#   - Left alone, the client gives up at its deadline and the shell says so. Leaving
#     with one parked is not held up by it.
#   - The fixture exits 77: no violation and every session ended.
set ::env(THYLACINE_SERIAL_SAK) 1
source [file join [file dirname [info script]] lib.exp]
lc_boot
lc_login michael correct-horse-battery-staple-v1
lc_send "imperium post"
lc_expect "as pid" "post request"
lc_raw_send "\001b" "serial SAK fixture"
lc_expect "CONFERRING IMPERIUM" "trusted provincia"
lc_expect "CAP_POST_SERVICE" "posting authority"
lc_expect "imperium key: " "trusted key prompt"
lc_raw_send "imperium-key-michael-v1\r" "fixture key"
lc_expect "imperium: conferred" "post capability conferred"
lc_send "kaua-term-probe --ut-paste"
set timeout 300
expect {
    -ex "ut-paste: UNAVAILABLE" {
        puts "\nLS-CI SKIP: no private ring in this kernel -- see this scenario's header for the bake"
        lc_quit
        exit 77
    }
    -ex "ut-paste: PASS" {}
    -re {ut-paste: FAIL -- ([^\r\n]+)[\r\n]} { lc_fail "probe: $expect_out(1,string)" }
    -re {EXTINCTION:} { lc_extinction_fail "ut-paste" }
    timeout { lc_fail "the probe did not finish" }
    eof { lc_fail "EOF during the probe" }
}
lc_run_expect "echo ut-paste-shell-live | tr a-z A-Z" "UT-PASTE-SHELL-LIVE"
lc_pass "the paste key fetched over a private ring, submitted nothing, and a stopped server stopped nothing"
lc_quit
exit 0
