#!/usr/bin/expect -f
# tools/interactive/ls-display-follow-declared.exp -- a declared scale through
# every way the compositor comes by a mode (HALCYON-SCALE.md section 3 and
# AURORA-CONFIG.md section 3.4, as amended 2026-11-12).
#
# One boot of the gate image (`tools/build.sh kernel --config ci`: the settings
# panel that asks for a mode by size is the console renderer's). The platform
# declares 200 percent for a display of 3456x2160, which cannot be a mode. The
# declaration is the display's: a mode the compositor fitted carries it by the
# mode's width over the display's, and a mode asked for by size keeps it as it
# is. Each leg reads the compositor's own line for the scale and the size of
# the scanout QEMU dumps:
#
#   the boot:    the first mode is half the display, and the scale is 100.
#   a follow:    the host becomes 2000x1280 (a VNC viewer's resize, as in
#                ls-display-follow), which can be a mode: the scale is 200.
#                This leg knows whether a follow records the display its mode
#                was fitted from. Carried from the boot's display the scale
#                would be 125.
#   a follow:    the host becomes 5120x2880 and the mode half of it: 100.
#   by size:     the settings panel asks for 1600x900: 200. This leg knows
#                whether a mode asked for by size forgets the fit before it.
#                Carried from 5120x2880 the scale would stay 100.
#   auto again:  the panel asks for `mode auto`. The mode is half the display
#                again and the scale 100.
#
# NOT asserted: the console's cells and its redraw (ls-display-follow's); what
# a mode asked for by size should be under a host that scales it to a window
# (this holds section 3 as it reads today); the `scale auto` verb, which no
# program in the tree sends; a follow whose EDID is not answered.
#
# The panel writes the mode it applied to this pool's /lib/aurora/config. When
# the leg by size fails one of its own two checks, the panel is asked for auto
# before the failure is reported, so that a later boot of the pool is not
# pinned. Any other failure between that leg and the end of the next leaves
# 1600x900 there until the pool is made again; a run on such a pool fails its
# first follow, by the compositor's line that the mode is pinned.
#
# HVF like its ls-gfx siblings.

set ::env(THYLACINE_ACCEL) [expr {[info exists ::env(LS_CI_GFX_ACCEL)] ? $::env(LS_CI_GFX_ACCEL) : "hvf"}]
set ::env(THYLACINE_GPU_RES) 3456x2160
set ::env(THYLACINE_SCALE) 200
catch {unset ::env(THYLACINE_HIDPI)}
set ::env(THYLACINE_VNC_SOCKET) /tmp/ls-display-follow-declared-[pid].sock
set ::env(THYLACINE_DISPLAY) vnc-unix

source [file join [file dirname [info script]] lib.exp]

lc_require_image {shell}

set repo $lc_repo
set qmp [lc_qmp_sock]
set ppm /tmp/ls-display-follow-declared-[pid].ppm

source [file join [file dirname [info script]] display-follow.tcl]

proc key {chord} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k $chord} err]} {
        lc_fail "qmp-sendtext -k $chord failed: $err"
    }
}
# The compositor's line for a scale that changed, read whole: the pattern ends
# with the line's last character, so a line still arriving is not read short.
# Answers what is wrong, or nothing: the caller may have a panel to put back
# before it fails.
proc scale_went {from to label} {
    global timeout
    set ::what "the scale $label"
    set timeout 30
    expect {
        -re {tapestryd: scale (\d+) -> (\d+) \(([a-z-]+)\)} {
            set got "$expect_out(1,string) -> $expect_out(2,string) ($expect_out(3,string))"
            if {$got ne "$from -> $to (mode)"} {
                return "the scale went $got $label, want $from -> $to (mode)"
            }
            lc_step "saw: the scale went $got $label"
            return ""
        }
        -re {tapestryd: display event \d+: followed, \d+x\d+ at (\d+)%} {
            return "the event was followed at $expect_out(1,string)% and the scale did not change $label, want $from -> $to (mode)"
        }
        timeout { return "the scale did not change in 30 s $label, want $from -> $to (mode)" }
        eof     { lc_fail "qemu exited while waiting for the scale $label" }
    }
}
# wait_dims, answering what is wrong instead of failing.
proc dims_are {want label} {
    set d "(no dump)"
    for {set i 0} {$i < 20} {incr i} {
        set d [dims]
        if {[lrange $d 0 1] eq $want && [lindex $d 2] > 1} {
            lc_step "scanout $want, [lindex $d 2] colours in the sample ($label)"
            return ""
        }
        after 700
    }
    return "the scanout never became $want with a picture on it ($label; last: width height colours = $d; $::dims_why)"
}
# The panel is open on its mode row with 1600x900 chosen, four to the right
# of auto.
proc panel_auto {} {
    key "left"
    key "left"
    key "left"
    key "left"
    key "ret"
}

# ---------- the boot: half the display, at half the declaration ----------
lc_boot
# What must not be said, in every wait of the run (as in ls-display-follow).
set what "the boot"
expect_before {
    -re {tapestryd: [^\r\n]*t_dma_create_weave\((\d+)\) failed -?\d+} { lc_fail "a surface or a screen could not be allocated during '$::what': $expect_out(0,string)" }
    -re {tapestryd: mode rebind failed; old geometry retained} { lc_fail "the scanout was not rebound during '$::what'" }
    -re {tapestryd: mode (\d+x\d+) is set; the display is not bound to its screen} { lc_fail "mode $expect_out(1,string) was set and the device is not known to scan its screen, during '$::what'" }
    -re {tapestryd: mode (\d+x\d+) refused -- (screen|surface) weave} { lc_fail "$expect_out(1,string) could not be allocated ($expect_out(2,string)) during '$::what'" }
    -re {tapestryd: no mode for a display of (\d+x\d+);} { lc_fail "no mode was found for a host of $expect_out(1,string) during '$::what'" }
    -re {tapestryd: display event \d+: not followed[^\r\n]*[\r\n]} { lc_fail "during '$::what': [string trim $expect_out(0,string)]" }
    -re {tapestryd: display event \d+: the mode is \d+x\d+, not finished[^\r\n]*[\r\n]} { lc_fail "during '$::what': [string trim $expect_out(0,string)]" }
    -re {tapestryd: display event \d+: the mode is pinned and stands} { lc_fail "the mode is pinned during '$::what': this pool's /lib/aurora/config holds a fixed mode" }
    -re {EXTINCTION:} { lc_extinction_fail "extinction during '$::what'" }
}
set timeout $lc_boot_timeout
set what "the boot's first mode"
expect {
    -re {tapestryd: mode 1728x1080 for a display of 3456x2160} { lc_step "saw: the first mode is fitted" }
    -re {tapestryd: serving /srv/tapestry \+ /srv/warp \((\d+x\d+)\)} {
        lc_fail "the compositor serves $expect_out(1,string) with no fitted mode said before it"
    }
    timeout { lc_fail "the boot did not get to a fitted mode" }
    eof     { lc_fail "qemu exited during boot" }
}
set what "the boot's scale"
expect {
    -re {tapestryd: scale (\d+) \(([a-z]+)\)} { set said "$expect_out(1,string) ($expect_out(2,string))" }
    -re {tapestryd: serving /srv/tapestry \+ /srv/warp \((\d+x\d+)\)} {
        lc_fail "the compositor serves $expect_out(1,string) with no scale said before it"
    }
    timeout { lc_fail "the compositor never said its scale" }
    eof     { lc_fail "qemu exited during boot" }
}
if {$said ne "100 (declared)"} {
    lc_fail "the boot's scale is $said, want 100 (declared): the 200 declared is the display's, and the first mode is half of it"
}
set what "the login"
lc_login michael correct-horse-battery-staple-v1
wait_dims "1728 1080" "the boot's fitted mode"
lc_pass "declared: half a display of 3456x2160 boots at 100, half the 200 declared"

# ---------- a follow to a size that can be the mode ----------
tell 2000x1280
follow_expect {tapestryd: display event \d+: asking the host} "the event is taken up"
follow_expect [up 2000x1280] "a size that can be a mode is the mode"
set err [scale_went 100 200 "after the host became 2000x1280"]
if {$err ne ""} { lc_fail "$err: a follow carries the declaration by the display it has now" }
follow_expect {tapestryd: display event \d+: followed, 2000x1280 at 200%} "the event is followed, at 200"
wait_dims "2000 1280" "followed to 2000x1280"
lc_pass "declared: a display that is its own mode has the scale declared (200 at 2000x1280)"

# ---------- a follow to a size that is halved ----------
tell 5120x2880
follow_expect {tapestryd: mode 2560x1440 for a display of 5120x2880} "a size that cannot be a mode is halved"
follow_expect [up 2560x1440] "the halved mode is up"
set err [scale_went 200 100 "after the host became 5120x2880"]
if {$err ne ""} { lc_fail "$err: half a display has half the declaration" }
follow_expect {tapestryd: display event \d+: followed, 2560x1440 at 100%} "the event is followed, at 100"
wait_dims "2560 1440" "followed to half of 5120x2880"
lc_pass "declared: half a display of 5120x2880 is followed at 100"

# ---------- a mode asked for by size keeps the declaration ----------
# F10 -> Tab (the mode row) -> Right x4 (auto -> 1024x768 -> 1280x800 ->
# 1280x720 -> 1600x900) -> Enter: ls-gfx-mode's recipe.
key "f10"
key "tab"
key "right"
key "right"
key "right"
key "right"
key "ret"
follow_expect {tapestryd: mode 1600x900 is up \(scanout [a-z]+\)} "the panel's mode is up"
set err [scale_went 100 200 "after 1600x900 was asked for by size"]
if {$err ne ""} {
    set err "$err: a mode asked for by size keeps the declaration, whatever was fitted before it"
} else {
    set err [dims_are "1600 900" "the mode asked for by size"]
}
if {$err ne ""} {
    panel_auto
    key "esc"
    after 3000
    lc_fail $err
}
lc_pass "declared: a mode asked for by size has the scale declared (200 at 1600x900)"

# ---------- mode auto fits again ----------
panel_auto
follow_expect {tapestryd: mode 2560x1440 for a display of 5120x2880} "mode auto asks the host and fits its size"
follow_expect {tapestryd: mode 2560x1440 is up \(scanout [a-z]+\)} "the fitted mode is up"
set err [scale_went 200 100 "after mode auto"]
key "esc"
if {$err ne ""} { lc_fail "$err: a mode fitted again carries the declaration again" }
wait_dims "2560 1440" "mode auto"
lc_pass "declared: mode auto fits half the display again, at 100"

file delete -force $ppm
set what "the shutdown"
lc_quit
file delete -force $::env(THYLACINE_VNC_SOCKET)
lc_pass "ls-display-follow-declared: the boot, two follows, a mode by size and mode auto, each at the scale the declaration gives it"
exit 0
