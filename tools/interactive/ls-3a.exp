#!/usr/bin/expect -f
# tools/interactive/ls-3a.exp -- the LS-3a navigate+inspect coreutils.
#
# Proves, over a real PTY, that the three coreutils adopted in LS-3a resolve
# from the session shell and produce correct output:
#   ls     enumerate a populated directory: `ls /var` -> `lib` (host-baked
#          /var/lib/corvus chain). This fully exercises ls (readdir + sort +
#          output) on the live Stratum pivot FS.
#   stat   `stat /thylacine-version` reports metadata for the host-baked root
#          sentinel; asserts the type line "regular file".
#   clear  runs the ANSI screen-clear without error; a follow-up echo proves
#          the shell survived (clear's own output is escape codes, unmatchable
#          cleanly, so we assert liveness-after).
#
# `ls /` (the pivot ROOT) enumerates too -- guards the #955 regression: a
# Stratum dirent resume-cookie > INT64_MAX wrapped negative in the kernel's s64
# readdir cursor and dev9p clamped it to 0, so a paginating reader re-fetched
# offset 0 forever (the root showed nothing / hung). Asserted below.
#
# Honors the three LS-CI portability facts (see lib.exp): run under script(1)
# (the wrapper), global spawn_id (lc_boot), match OUTPUT not typed input.

# G-3: HVF. MEASURED ~200s -> ~40s (this scenario is boot-dominated, and a
# TCG boot is ~5x an HVF one). Coverage argument, because a green run under a
# different accel is NOT the same as the same coverage: accel also picks the
# CPU model and the GIC version (hvf -> -cpu host + GICv2; tcg -> -cpu max +
# GICv3, tools/run-vm.sh), so a flip moves this scenario off those axes. It is
# safe HERE because LS-3 console/line-discipline assertions; the hardware paths it rides are anchored elsewhere, and because the GICv3 + `-cpu max` axes stay covered
# by the TCG anchor set the wrapper enforces (freeze-172, flood-174, split173,
# nora-demo, idle-probe, ls-7, pty-4). Set THYLACINE_ACCEL=tcg to A/B it.
set ::env(THYLACINE_ACCEL) hvf

source [file join [file dirname [info script]] lib.exp]

# H-1 (audit F1): full-session transcript so the Beacon transport canary --
# which prints BEFORE the first prompt, inside the region lc_login consumes
# -- can be asserted at the end (the ls-gfx-live log_file idiom).
set transcript /tmp/ls-3a-[pid].log
file delete -force $transcript
log_file -a $transcript

lc_boot
lc_login michael correct-horse-battery-staple-v1

# ls a populated directory -- readdir + sort + output, end to end. /var is
# host-baked (the corvus dir chain), so `lib` is a stable, distinctive entry.
lc_send "ls /var"
lc_expect "lib" "ls /var output"
lc_pass "LS-3a(a): ls enumerates a directory (ls /var -> lib)"

# ls the pivot ROOT itself (#955 regression): /thylacine-version is the stable
# host-baked root sentinel. Pre-fix this spun re-fetching offset 0 and rendered
# nothing; post-fix the cookie advances to EOD and the entry appears.
lc_send "ls /"
lc_expect "thylacine-version" "ls / output (#955 root readdir cookie)"
lc_pass "LS-3a(a2): ls enumerates the pivot root (ls / -> thylacine-version)"

# stat the host-baked root sentinel (world-readable: cat reads it). "regular
# file" is stat's type line.
lc_send "stat /thylacine-version"
lc_expect "regular file" "stat output"
lc_pass "LS-3a(b): stat reports file metadata"

# clear runs (ANSI), then the shell must still execute commands.
lc_send "clear"
lc_run_expect "echo ls3a-screen-ok-9461" "ls3a-screen-ok-9461"
lc_pass "LS-3a(c): clear runs; shell alive afterwards"

# H-1 (audit F1): the Beacon tier transport canary. ut fresh-opens the
# ungated /dev/beacon leaf, exports /env/BEACON, and says so EVERY session
# (the serial console advertises nothing -> none). A regression to the
# dead-read shape (the shared-offset consctl read the round-1 P1 found)
# silences this line. (log_file buffers; close before grepping.)
log_file
if {[catch {exec grep -q "ut: beacon none exported" $transcript}]} {
    lc_fail "the Beacon tier transport canary is missing (ut: beacon none exported)"
}
lc_pass "LS-3a(d): the Beacon tier transport is alive (none exported)"
file delete -force $transcript

lc_quit
lc_pass "LS-CI ls-3a: ls + stat + clear + beacon-transport all verified"
exit 0
