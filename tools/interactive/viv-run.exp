#!/usr/bin/expect -f
# tools/interactive/viv-run.exp -- `viv run` from a SESSION SHELL runs a
# container (the interactive path every boot gate used to bypass).
#
# Until 2026-08-17 an interactive `viv run` never ran anything: viv asked
# SPAWN_PERM_MAY_POST_SERVICE for its per-container diorama (which posted the
# fixed /srv/viv-dio) and nothing past login holds that bit, so the diorama
# spawn was refused and viv printed `viv: spawn /bin/diorama` -- its ERROR
# line, misread as progress for eighteen days. Every boot gate spawned viv
# WITH the bit, so no gate ran the path a person runs. The diorama channel is
# a private pipe pair now (VIVARIUM 7.2.1) and this scenario is the regression
# net for the path itself: a plain user shell, no privilege, a container that
# provably assembles and runs.
#
# Two vantages, because their stdio substrates differ:
#   1. the CONSOLE ut (fds = the cons handle): `viv run /vivarium/probe`. The
#      probe bundle is always baked; its manifest expects the JOEY gate's
#      principal (VIV_EXPECT_UID = SYSTEM), so from a user the FIRST failing
#      leg is #6, "principal is not the invoker's" -- and that exact line is
#      the witness: legs 1-5 (rootfs is /, /proc + /sys serve from the
#      diorama, pid view == {self}, host /srv unreachable, /net absent) held
#      under a user principal from a plain shell before it was reached. A
#      viv that cannot spawn its diorama never prints a probe line at all.
#   2. the PTS (a ptyhost'ed ut): `viv run /vivarium/alpine-ash` -- the
#      interactive phenotype ash (args /bin/sh -i; ioctl is unserved so
#      isatty() is false and ash needs the flag). Its prompt on the pts, a
#      command answered through stdin/stdout, `exit` back to ut. SKIPs when
#      the bundle is not staged (it needs the Alpine minirootfs + busybox
#      apk in build/cache, like the L-6c gate).
#
# The creation mask (IDENTITY-DESIGN 9.7 M8) rides both vantages: the console
# ut prints it, sets it and creates under it; the mask it leaves (027) is
# inherited through ptyhost, the hosted ut and viv into the container, where
# ash must print it and its own creates take ash's mask.
#
# Echo discipline: the pts ldisc echoes typed text, so every control matches
# an UPPERCASE token only a `| tr a-z A-Z` pipeline can produce (pty-4). A
# built-in cannot sit in a pipeline, so `umask`'s own output is matched as a
# whole line of digits, which no typed command line here contains.

source [file join [file dirname [info script]] lib.exp]

set repo $lc_repo
set ash_bundle "$repo/build/vivarium/alpine-ash/config.json"
set have_ash [file exists $ash_bundle]

lc_boot
lc_login michael correct-horse-battery-staple-v1

# --- 1. the console ut ------------------------------------------------------
lc_send "viv run /vivarium/probe"
lc_expect "viv-probe: FAIL: principal is not the invoker's" \
    "the probe container ran from the console shell (legs 1-5 held; leg 6 is the fixture's SYSTEM expectation)"
sleep 1
lc_run_expect "echo viv-console | tr a-z A-Z" "VIV-CONSOLE"

# --- M8 at the console ut ----------------------------------------------------
# A native touch asks 0666; under 277 it is 0400, which no directory's bound
# alone gives (a 0700 /tmp leaves 0600, a 0755 one 0644).
lc_send "umask"
lc_expect_re {\n0022\r?\n} "a bare umask prints the default mask as four digits"
lc_run_expect "umask 277 && touch /tmp/m8-ut && ls -l /tmp/m8-ut | tr a-z A-Z" "-R--------"
lc_send "rm /tmp/m8-ut && umask"
lc_expect_re {\n0277\r?\n} "the mask set reads back"
lc_run_expect "umask 027 && echo m8-set | tr a-z A-Z" "M8-SET"

# --- 2. the pts (ptyhost) --------------------------------------------------
if {$have_ash} {
    lc_send "ptyhost"
    lc_expect "job control active" "the hosted ut's session dance"
    sleep 1
    lc_run_expect "echo pts-up | tr a-z A-Z" "PTS-UP"

    lc_send "viv run /vivarium/alpine-ash"
    lc_expect_re {/ [#$] } "the phenotype ash prompt on the pts"
    # `uname -s` inside the container answers LINUX (the phenotype's uname row);
    # the outer ut's coreutil answers THYLACINE -- so the token names WHICH
    # shell answered, not just that one did.
    lc_send "uname -s | tr a-z A-Z"
    lc_expect "LINUX" "ash answers through the pts (stdin in, stdout out; the phenotype's uname)"
    # M8: the console ut's 027 crossed ptyhost, the hosted ut and viv; ash
    # reads it with Linux umask (166) and prints it as busybox does, "%04o".
    lc_send "echo m=\$(umask) | tr a-z A-Z"
    lc_expect "M=0027" "the container inherits the invoker's creation mask"

    # --- #50: the path-mutation family, end-to-end from EL0 (VIVARIUM.md
    # 6.24). One pipeline per row, each witnessed by an UPPERCASE token only
    # the pipeline can produce (the echo discipline above). The container's
    # /tmp is this user's own /tmp/.viv/vivarium/alpine-ash/rootfs/tmp, which
    # viv binds over the rootfs's, so the writes are the user's.
    #   >file        = openat(O_CREAT|O_WRONLY|O_TRUNC) -- the keystone
    #   mkdir        = mkdirat
    #   mv           = renameat (busybox mv -> musl rename -> renameat(38))
    #   rm / rmdir   = unlinkat (0 / AT_REMOVEDIR)
    lc_send "echo mut-created > /tmp/f50 && cat /tmp/f50 | tr a-z A-Z"
    lc_expect "MUT-CREATED" "openat(O_CREAT) created the file and wrote through it"
    lc_send "mkdir /tmp/d50 && mv /tmp/f50 /tmp/d50/g50 && cat /tmp/d50/g50 | tr a-z A-Z"
    lc_expect "MUT-CREATED" "mkdirat made the dir; renameat moved the file INTO it with content intact"
    #   ls           = getdents64 (busybox ls -> musl readdir; the 61 row)
    lc_send "ls /tmp/d50 | tr a-z A-Z"
    lc_expect "G50" "getdents64 lists the moved name (dirent64 encode + cursor from EL0)"
    lc_send "rm /tmp/d50/g50 && rmdir /tmp/d50 && ls /tmp/d50 2>&1 | tr a-z A-Z"
    lc_expect "NO SUCH FILE" "unlinkat removed the file and (AT_REMOVEDIR) the dir; the name is gone"
    # G12: file times through Linux utimensat (88, VIVARIUM.md 6.30). busybox
    # touch -d sets an explicit time, cp -p copies it, and a bare touch takes
    # the clock (the both-to-now form); stat -c %Y reads each back as epoch
    # seconds. Braces keep Tcl off the shell's $ and [.
    lc_send {touch -d @1000000000 /tmp/t12 && echo t=$(stat -c %Y /tmp/t12) | tr a-z A-Z}
    lc_expect "T=1000000000" "touch -d set an explicit mtime (utimensat with times)"
    lc_send {cp -p /tmp/t12 /tmp/t12p && echo p=$(stat -c %Y /tmp/t12p) | tr a-z A-Z}
    lc_expect "P=1000000000" "cp -p kept the source's mtime"
    lc_send {a=$(date +%s); touch /tmp/t12; d=$(( $(stat -c %Y /tmp/t12) - a )); [ $d -ge -2 ] && [ $d -le 2 ] && echo touch-now | tr a-z A-Z}
    lc_expect "TOUCH-NOW" "a bare touch took the clock (utimensat with null times)"
    # A denied search is the walk's refusal, never ownership's: EACCES, which
    # busybox prints as "Permission denied" ("Operation not permitted" would
    # be EPERM, the answer for a time only the owner may set).
    lc_send {mkdir /tmp/sd12 && touch /tmp/sd12/f && chmod 0 /tmp/sd12 && touch -d @5 /tmp/sd12/f 2>&1 | tr a-z A-Z; chmod 755 /tmp/sd12}
    lc_expect "PERMISSION DENIED" "a search-denied component answers EACCES, not EPERM"
    lc_send {rm -r /tmp/t12 /tmp/t12p /tmp/sd12 && echo t12-gone | tr a-z A-Z}
    lc_expect "T12-GONE" "the times files are removed"
    # `>/dev/null` inside a container (the curl-demo census item, 2026-08-25:
    # ash's `>` is openat(O_WRONLY|O_CREAT|O_TRUNC); the openat then refused
    # O_CREAT outright and the staged /dev/null was a plain file). Two things
    # closed it since: #50's open-create core is OPEN-FIRST (an existing
    # target is opened, never re-created -- no parent-write permission needed
    # on the read-only rootfs), and viv binds the kernel's real /dev/null leaf
    # over the rootfs anchor. The witness is the redirect's own rc: DN=0 only
    # if the open succeeded; a failed redirect makes ash print "can't create
    # /dev/null" and $? = 1, so DN=1 and this leg times out.
    lc_send "echo dn-probe >/dev/null; echo DN=\$? | tr a-z A-Z"
    lc_expect "DN=0" ">/dev/null works inside the container (open-first create on the bound null leaf)"
    # ^C at the ash prompt: the pts's `interrupt` reaches the whole foreground
    # pgrp -- viv, its diorama and ash. Before 2026-08-18 the two NATIVE members
    # died of it (LS-5's uncaught-interrupt default), orphaning ash into a
    # terminal it then shared with the outer ut; now viv masks `interrupt` and
    # the diorama masks it plus the tty family, and only ash decides what ^C
    # means (a fresh prompt). The witness is the shell still ANSWERING through
    # the same viv afterwards -- a dead runner returns the terminal to ut, whose
    # own `uname` would answer THYLACINE (if the orphaned ash let it answer at
    # all).
    #
    # The settle below is LOAD-BEARING, not politeness (counter-instrumented
    # 2026-08-26): a ^C sent the instant the prior leg's output matches lands
    # inside busybox-ash's reap window, where a job-control shell still holds
    # SIGINT=SIG_IGN -- and the kernel's V-6b ignore-drop then discards the
    # note AT POST TIME, exactly as Linux would (POSIX: a signal ignored at
    # generation is discarded). The leg's claim is "^C at the ash PROMPT";
    # the settle enforces that precondition. At the prompt the full chain is
    # live and was measured end-to-end: fan -> caught-note arm -> wake of the
    # parked elected 9P reader -> SLEEP_NOTEINTR unwind -> CLIENT_WAIT_NOTEINTR
    # -> EINTR -> handler -> fresh prompt (5/5 with this shape).
    sleep 1
    send "\x03"
    sleep 1
    lc_send "uname -s | tr a-z A-Z"
    lc_expect "LINUX" "ash still answers after ^C (the runner survived it; ut would say THYLACINE)"
    # M8 inside the container: ash's `>` asks 0666, and under ash's 277 it is
    # 0400 -- the container /tmp (0700) bound alone would leave 0600.
    lc_send "umask 277; echo m8 > /tmp/m8; ls -l /tmp/m8 | tr a-z A-Z; rm -f /tmp/m8"
    lc_expect "-R--------" "a container create takes ash's own mask (Linux umask sets the Proc's)"
    lc_send "exit"
    sleep 1
    lc_run_expect "echo pts-after | tr a-z A-Z" "PTS-AFTER"
    lc_send "exit"
    sleep 1
    lc_run_expect "echo viv-outer | tr a-z A-Z" "VIV-OUTER"
    lc_pass "VIV-RUN: a plain user shell runs a container on the console and on a pts, ^C reaches the container, not the runner, and the creation mask reaches the container"
} else {
    lc_step "alpine-ash bundle not staged ($ash_bundle) -- the pts half is skipped"
    lc_pass "VIV-RUN: console half PASS (with the creation mask); the pts half needs the Alpine bundle staged"
}
