#!/usr/bin/expect -f
# ls-graphical-sak-dead -- a trusted takeover that fails part-way, and one
# whose GPU engine dies under the trusted scanout (TRUSTED-PATH section 7,
# operator vote 30).
#
# THYLACINE_TEST_LATCH_DEAD=1 puts thylacine.test-latch-dead on the kernel
# command line: tapestryd arms lictor's lever, whose seat half fires one shot
# per trusted takeover, in the order of the legs below.
#
# Leg S (stall): shot 1 stalls the engine after the outputs are disabled and
# before the trusted image is bound, and the device retires the chain. A stall is
# no answer from the device, so the takeover starts over once the engine revives,
# and the trusted scanout comes up (vote 50's audit, F1), which the glass must show.
# A seat that failed the episode here would deny the SAK to any client with work
# queued ahead of it.
#
# Leg 1 (part-way): shot 2 is the same stall with its retirement withheld, so the
# takeover fails at the kernel's deadline with the outputs already dark. lictor
# must restore normal output once the engine revives -- until 2026-10-29 it
# restored only after a completed takeover, so this seat went back to normal with
# no restore (OPEN-BUGS 08:39Z) -- and typing must reach the shell again.
#
# Leg A (answer): shot 3 has the device refuse the trusted bind. That is an answer,
# not a stall, so the takeover fails at once and does not start over.
#
# Leg W (wait): shot 4 stands a readback ahead of the takeover for longer than a
# command's ordinary bound, with no client or host involved. No wait in an episode
# may widen behind it, since the serve loop would stop with the kernel's deadline
# running: the command must stall at its bound and the takeover must start over.
#
# Leg F (frame): shot 5 stalls the engine on the episode's first frame, and the
# device retires the chain. The frame stays owed: the next pass paints it, and the
# episode goes on.
#
# Leg C (cursor): shot 6 stalls the cursor queue inside the takeover and
# holds its retirement until the seat has restored. The restore needs only
# the control queue, so it must go through with the cursor chain still
# outstanding; a restore that waited on the cursor queue would wait until the
# cursor lane died at 30 s, and then forever.
#
# Leg X (abandoned): shot 7 is that stall held past the abandonment bound. The lane
# is abandoned, not lost: tapestryd keeps being refused and keeps retrying a pointer
# update, the late retirement frees the lane, and the update goes through. The next
# leg's chord shows that takeover is back as well.
#
# Leg R (refused): shot 8 has the kernel's RESTORED refused after a completed
# restore (as the kernel refuses it when a grantee exits before the commit).
# Restoration must stay owed -- lictor rebinds again before the seat returns
# -- and the NEXT takeover (leg 2) must exclude and bind afresh: a seat that
# carried "active" across the refusal skipped both and acknowledged a frame
# that was on no scanout (vote-30 audit F1).
#
# Leg 2 (dead): shot 9 stalls the engine with the trusted scanout up and its
# chain's retirement withheld, so the engine dies 30 s later. Until vote 30
# the failed seat retried its restore forever: every compositor request
# parked for good and the serial SAK was refused (OPEN-BUGS 04:20Z). The seat
# must come back without its display, and a key typed afterwards must reach
# no one, because a frozen trusted frame may still be on the glass. lictor's
# own line proves the withholding gate fired; the shell's silence alone would
# be satisfied by a compositor that had simply stopped.
#
# Requires HALCYON_SESSION=y: the seat runs under the session compositor.
set ::env(THYLACINE_ACCEL) [expr {[info exists ::env(LS_CI_GFX_ACCEL)] ? $::env(LS_CI_GFX_ACCEL) : "hvf"}]
set ::env(THYLACINE_SERIAL_SAK) 0
set ::env(THYLACINE_TEST_LATCH_DEAD) 1
source [file join [file dirname [info script]] lib.exp]
set repo $lc_repo
set qmp [lc_qmp_sock]

lc_require_image {SESSION}

proc key {chord} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k $chord} e]} { lc_fail $e }
    after 700
}
proc type {text} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp $text} e]} { lc_fail $e }
}
proc witness {stage} {
    type "caps-probe --seat-$stage\n"
    global timeout
    set timeout 30
    expect {
        -ex "seat-probe: PASS $stage (endpoint denied; GPU denied; DAC verified)" { lc_step "typing reaches the shell ($stage)" }
        -ex "seat-probe: FAIL" { lc_fail "guest authority witness failed ($stage)" }
        -re {EXTINCTION:} { lc_extinction_fail "seat $stage" }
        timeout { lc_fail "no authority witness ($stage) -- typing did not reach the shell" }
        eof { lc_fail "EOF ($stage)" }
    }
}

# How much of the glass is the trusted screen's ground. A log line says what lictor
# asked the device for; this reads what reached the glass.
proc ground {name} {
    global repo qmp
    after 1000
    set out [file join $repo build sak-dead-$name.png]
    if {[info exists ::env(THYLACINE_EGL_VNC_SOCKET)]} {
        if {[catch {exec python3 $repo/tools/interactive/vnc_capture.py $::env(THYLACINE_EGL_VNC_SOCKET) $out} e]} { lc_fail $e }
    } else {
        if {[catch {exec $repo/tools/screendump.sh -s $qmp $out} e]} { lc_fail $e }
    }
    if {[catch {exec python3 $repo/tools/interactive/sak_glass.py $repo/usr/lictor/src/render.rs $out} r]} { lc_fail $r }
    if {![regexp {^ground ([0-9]+)\n(.*)$} $r -> pct top]} { lc_fail "an unread capture: $r" }
    lc_pass "SAK-DEAD glass $name ground=$pct% $top"
    return $pct
}
proc pointer {x y} {
    global repo qmp
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -p "abs $x $y"} e]} { lc_fail $e }
}

# The seat's return re-enables the session's own participant, not only the
# pixels: typing proves the shell, and this proves the link. A recovery moves the
# generation under whatever the link has in flight, so this leg is where a client
# that treats that as fatal, or never rejoins, turns red.
proc rejoined {stage} {
    global timeout
    set timeout 15
    expect {
        -re {halcyond: seat link rejoined generation=[0-9]+} { lc_step "the session's seat link rejoined ($stage)" }
        -re {EXTINCTION:} { lc_extinction_fail "rejoin ($stage)" }
        timeout { lc_fail "no seat link rejoin within 15s ($stage) -- the session's participant stayed disabled" }
        eof { lc_fail "EOF ($stage)" }
    }
}

# A failure here can be rare, and the kill erases the state it left. Before the
# kill, ask what still works: a line typed now says whether input reaches the
# shell, and a second chord whether it reaches the seat.
set ::lc_fail_probe {
    type "caps-probe --seat-denied\n"
    set timeout 12
    expect {
        -ex "seat-probe: PASS denied" { lc_step "fail-probe: typing reaches the shell" }
        -ex "seat-probe: FAIL" { lc_step "fail-probe: the shell ran the probe and it failed" }
        -ex "lictor: input withheld" { lc_step "fail-probe: lictor withheld the keys" }
        timeout { lc_step "fail-probe: typing did not reach the shell within 12s" }
        eof { lc_step "fail-probe: EOF after typing" }
    }
    key "ctrl+alt+f10"
    set timeout 12
    expect {
        -re {lictor: trusted scanout active|lictor: seat failed[^\r\n]*|INJECTED by test-latch-dead[^\r\n]*} {
            lc_step "fail-probe: a second chord took: $expect_out(0,string)"
        }
        timeout { lc_step "fail-probe: a second chord took nothing within 12s" }
        eof { lc_step "fail-probe: EOF after the chord" }
    }
}

lc_boot
set timeout $lc_boot_timeout
expect {
    -ex "Thylacine login: " {}
    -re {EXTINCTION:} { lc_extinction_fail "boot" }
    timeout { lc_fail "no login" }
    eof { lc_fail "EOF before login" }
}
lc_raw_send "michael\r" "login user"
expect {
    -ex "password: " {}
    timeout { lc_fail "no password prompt" }
    eof { lc_fail "EOF before password" }
}
lc_raw_send "correct-horse-battery-staple-v1\r" "login password"
expect {
    -ex "login: session compositor (halcyond) spawned" {}
    timeout { lc_fail "no graphical session" }
    eof { lc_fail "EOF at session start" }
}
set timeout 60
expect {
    -re {halcyond: status bar [^\r\n]*running false panes 2} {}
    -re {EXTINCTION:} { lc_extinction_fail "session" }
    timeout { lc_fail "welcome and shell did not become ready" }
}
after 1500
key "meta_l+f"
# The positive control for leg 2's silence: the same keys reach the shell.
witness baseline

# ---- leg S: a stall inside the takeover delays it ----
key "ctrl+alt+f10"
set timeout 30
expect {
    -ex "INJECTED by test-latch-dead, retirement withheld" {
        lc_fail "stall: the first takeover withheld its retirement -- the lever fired out of order"
    }
    -ex "INJECTED by test-latch-dead) -- engine stalled" {
        lc_step "stall: lictor stalled the engine inside the takeover"
    }
    -ex "lictor: trusted scanout active" { lc_fail "stall: the takeover completed -- no shot fired inside it (was the lever armed?)" }
    -re {EXTINCTION:} { lc_extinction_fail "first takeover" }
    timeout { lc_fail "stall: no injected stall within 30s of the chord (was the lever armed?)" }
}
set revived 0
set stalls 0
expect {
    -re {lictor: seat failed: [^\r\n]*[\r\n]} { lc_fail "stall: the seat failed the episode on a stall the device retired: $expect_out(0,string)" }
    -re {input withheld|engine dead} { lc_fail "stall: the engine died or input was withheld on a stall the device retired" }
    -re {lictor: takeover met a stall, starting over generation=[0-9]+} {
        incr stalls
        exp_continue
    }
    -re {gpu synchronous chain retired [0-9]+ ms after its deadline -- engine revived} {
        set revived 1
        exp_continue
    }
    -ex "lictor: trusted scanout active" {
        if {!$revived} { lc_fail "stall: the takeover completed although lictor never said the engine revived" }
    }
    -re {EXTINCTION:} { lc_extinction_fail "after the stall" }
    timeout { lc_fail "stall: within 30s: revived=$revived and no trusted scanout" }
}
if {!$stalls} { lc_fail "stall: the takeover completed although lictor never said it started over" }
if {[ground stall] < 30} { lc_fail "stall: lictor said the scanout is up, and the glass is not the trusted screen" }
after 1000
key "ret"
expect {
    -re {lictor: seat failed: [^\r\n]*[\r\n]} { lc_fail "stall: the episode failed after the takeover: $expect_out(0,string)" }
    -re {lictor: kernel closed trusted seat \(scanout [a-z]+\)} { lc_fail "stall: the episode failed instead of ending: $expect_out(0,string)" }
    -ex "lictor: trusted seat recovered; nothing was conferred" { lc_fail "stall: the seat recovered from a failure instead of ending the episode" }
    -ex "corvus: imperium: SAK with nothing pending" { lc_step "stall: the empty episode ended" }
    -re {EXTINCTION:} { lc_extinction_fail "the end of the stalled episode" }
    timeout { lc_fail "stall: the episode did not end within 30s" }
}
after 1500
witness control

# ---- leg 1: a takeover that fails part-way ----
key "ctrl+alt+f10"
set timeout 30
expect {
    -ex "INJECTED by test-latch-dead) -- engine stalled" {
        lc_fail "part-way: the retirement was not withheld -- the lever fired out of order"
    }
    -ex "INJECTED by test-latch-dead, retirement withheld" {
        lc_step "part-way: lictor stalled the engine inside the takeover"
    }
    -ex "lictor: trusted scanout active" { lc_fail "part-way: the takeover completed -- no shot fired inside it (was the lever armed?)" }
    -re {EXTINCTION:} { lc_extinction_fail "part-way takeover" }
    timeout { lc_fail "part-way: no injected stall within 30s of the chord (was the lever armed?)" }
}
set closed 0
set revived 0
set restored 0
expect {
    -re {lictor: seat failed: [^\r\n]*[\r\n]} { lc_fail "part-way: the seat failed at once on a stall, not at the kernel's deadline: $expect_out(0,string)" }
    -ex "lictor: trusted scanout active" { lc_fail "part-way: the takeover completed although its chain never retired" }
    -re {input withheld|engine dead} { lc_fail "part-way: the engine died or input was withheld on a stall the device retired" }
    -ex "lictor: kernel closed trusted seat (scanout displaced)" {
        set closed 1
        exp_continue
    }
    -re {gpu synchronous chain retired [0-9]+ ms after its deadline -- engine revived} {
        set revived 1
        exp_continue
    }
    -re {lictor: normal scanout restored generation=[0-9]+} {
        set restored 1
        lc_step "part-way: lictor restored normal output after the failed takeover"
        exp_continue
    }
    -ex "lictor: trusted seat recovered; nothing was conferred" {
        if {!$restored} {
            lc_fail "part-way: the seat went back to normal with no restore of the outputs it had disabled"
        }
    }
    -re {EXTINCTION:} { lc_extinction_fail "after the first takeover" }
    timeout { lc_fail "part-way: within 30s: revived=$revived restored=$restored and no recovery" }
}
if {!$closed} { lc_fail "part-way: the seat recovered, but the kernel never closed it with its output displaced" }
if {!$revived} { lc_fail "part-way: the seat restored, but lictor never said the engine revived -- which path ran it?" }
rejoined part-way
after 1500
witness restored

# ---- leg A: the device answers the takeover ----
key "ctrl+alt+f10"
set timeout 30
expect {
    -ex "lictor: trusted bind refused (INJECTED by test-latch-dead)" { lc_step "answer: the device refused the trusted bind" }
    -ex "INJECTED by test-latch-dead" { lc_fail "answer: another shot fired where the refusal was due" }
    -ex "lictor: trusted scanout active" { lc_fail "answer: the takeover completed -- the refusal did not fire inside it" }
    -re {EXTINCTION:} { lc_extinction_fail "answered takeover" }
    timeout { lc_fail "answer: no refusal within 30s of the chord" }
}
set failed 0
set restored 0
expect {
    -re {lictor: takeover met a stall, starting over generation=[0-9]+} { lc_fail "answer: the seat took the device's answer for a stall" }
    -ex "lictor: trusted scanout active" { lc_fail "answer: the takeover started over after the device refused it" }
    -ex "lictor: seat failed: private scanout activation" {
        set failed 1
        exp_continue
    }
    -re {lictor: normal scanout restored generation=[0-9]+} {
        set restored 1
        exp_continue
    }
    -ex "lictor: trusted seat recovered; nothing was conferred" {
        if {!$failed} { lc_fail "answer: the seat recovered, but never said it failed the takeover" }
        if {!$restored} { lc_fail "answer: the seat went back to normal with no restore of the outputs it had disabled" }
    }
    -re {EXTINCTION:} { lc_extinction_fail "after the refusal" }
    timeout { lc_fail "answer: within 30s: failed=$failed restored=$restored and no recovery" }
}
rejoined answered
after 1500
witness answered

# ---- leg W: a wait behind a readback in an episode ----
key "ctrl+alt+f10"
set timeout 30
expect {
    -ex "lictor: a readback stands ahead of the takeover (INJECTED by test-latch-dead)" { lc_step "wait: a readback stands ahead of the takeover" }
    -ex "INJECTED by test-latch-dead" { lc_fail "wait: another shot fired where the readback was due" }
    -ex "lictor: trusted scanout active" { lc_fail "wait: the takeover completed -- the shot did not fire inside it" }
    -re {EXTINCTION:} { lc_extinction_fail "the takeover behind a readback" }
    timeout { lc_fail "wait: no shot within 30s of the chord" }
}
set missed 0
set stalls 0
expect {
    -re {lictor: seat failed: [^\r\n]*[\r\n]} { lc_fail "wait: the seat failed the episode on a stall: $expect_out(0,string)" }
    -re {lictor: gpu synchronous command missed its [0-9]+ ms deadline} {
        set missed 1
        exp_continue
    }
    -re {lictor: takeover met a stall, starting over generation=[0-9]+} {
        incr stalls
        exp_continue
    }
    -ex "lictor: trusted scanout active" {
        if {!$missed || !$stalls} { lc_fail "wait: the takeover waited out the readback instead of stalling at its bound (missed=$missed stalls=$stalls)" }
    }
    -re {EXTINCTION:} { lc_extinction_fail "the takeover's stall behind a readback" }
    timeout { lc_fail "wait: within 30s: missed=$missed stalls=$stalls and no trusted scanout" }
}
after 1000
key "ret"
expect {
    -re {lictor: seat failed: [^\r\n]*[\r\n]} { lc_fail "wait: the episode failed after the takeover: $expect_out(0,string)" }
    -re {lictor: kernel closed trusted seat \(scanout [a-z]+\)} { lc_fail "wait: the episode failed instead of ending: $expect_out(0,string)" }
    -ex "lictor: trusted seat recovered; nothing was conferred" { lc_fail "wait: the seat recovered from a failure instead of ending the episode" }
    -ex "corvus: imperium: SAK with nothing pending" { lc_step "wait: the empty episode ended" }
    -re {EXTINCTION:} { lc_extinction_fail "the end of the episode behind a readback" }
    timeout { lc_fail "wait: the episode did not end within 30s" }
}
after 1500
witness readback

# ---- leg F: a stall on the episode's first frame ----
key "ctrl+alt+f10"
set timeout 30
expect {
    -ex "lictor: trusted scanout active" { lc_step "frame: the trusted scanout is up" }
    -ex "INJECTED by test-latch-dead" { lc_fail "frame: a shot fired inside the takeover where the frame's was due" }
    -re {EXTINCTION:} { lc_extinction_fail "frame takeover" }
    timeout { lc_fail "frame: no takeover within 30s of the chord" }
}
set stalled 0
set revived 0
expect {
    -re {lictor: seat failed: [^\r\n]*[\r\n]} { lc_fail "frame: the seat failed the episode on a stall the device retired: $expect_out(0,string)" }
    -ex "INJECTED by test-latch-dead) -- engine stalled" {
        set stalled 1
        exp_continue
    }
    -re {gpu synchronous chain retired [0-9]+ ms after its deadline -- engine revived} {
        set revived 1
    }
    -re {EXTINCTION:} { lc_extinction_fail "after the frame's stall" }
    timeout { lc_fail "frame: within 30s: stalled=$stalled and no revival" }
}
if {!$stalled} { lc_fail "frame: the engine revived, but lictor never stalled it on the frame" }
after 2500
key "ret"
expect {
    -re {lictor: seat failed: [^\r\n]*[\r\n]} { lc_fail "frame: the episode failed after the stall: $expect_out(0,string)" }
    -re {lictor: kernel closed trusted seat \(scanout [a-z]+\)} { lc_fail "frame: the episode failed instead of ending: $expect_out(0,string)" }
    -ex "lictor: trusted seat recovered; nothing was conferred" { lc_fail "frame: the seat recovered from a failure instead of ending the episode" }
    -ex "corvus: imperium: SAK with nothing pending" { lc_step "frame: the episode went on and ended" }
    -re {EXTINCTION:} { lc_extinction_fail "the end of the frame's episode" }
    timeout { lc_fail "frame: the episode did not end within 30s" }
}
after 1500
witness framed

# ---- leg C: a cursor chain stalls inside the takeover ----
key "ctrl+alt+f10"
set timeout 30
expect {
    -ex "cursor chain missed its deadline (INJECTED by test-latch-dead, retirement held)" {
        lc_step "cursor: lictor stalled the cursor queue inside the takeover"
    }
    -ex "synchronous command missed its deadline (INJECTED" { lc_fail "cursor: a control-queue shot fired where the cursor shot was due" }
    -ex "lictor: trusted scanout active" { lc_fail "cursor: the takeover completed -- the cursor shot did not fire inside it" }
    -re {EXTINCTION:} { lc_extinction_fail "cursor takeover" }
    timeout { lc_fail "cursor: no injected cursor stall within 30s of the chord" }
}
set restored 0
set timeout 20
expect {
    -re {cursor queue abandoned|cursor queue failed} { lc_fail "cursor: the cursor queue died before the seat restored past it" }
    -ex "lictor: trusted scanout active" { lc_fail "cursor: the takeover completed although the cursor chain never retired" }
    -re {lictor: normal scanout restored generation=[0-9]+} {
        set restored 1
        lc_step "cursor: normal output restored with the cursor chain still outstanding"
        exp_continue
    }
    -ex "lictor: trusted seat recovered; nothing was conferred" {
        if {!$restored} { lc_fail "cursor: the seat went back to normal with no restore" }
    }
    -re {EXTINCTION:} { lc_extinction_fail "after the cursor stall" }
    timeout { lc_fail "cursor: within 20s: restored=$restored and no recovery (the restore waits on the stalled cursor queue)" }
}
set timeout 15
expect {
    -re {cursor chain retired [0-9]+ ms after its deadline -- cursor queue revived} {
        lc_step "cursor: the released chain retired and the cursor queue revived"
    }
    -re {cursor queue abandoned|cursor queue failed} { lc_fail "cursor: the cursor queue died after its retirement was released" }
    -re {EXTINCTION:} { lc_extinction_fail "cursor revival" }
    timeout { lc_fail "cursor: the cursor queue never revived after its retirement was released (15s)" }
}

# ---- leg X: a cursor chain outlives the abandonment bound ----
key "ctrl+alt+f10"
set timeout 30
expect {
    -ex "cursor chain missed its deadline (INJECTED by test-latch-dead, retirement held)" {
        lc_step "abandon: lictor stalled the cursor queue inside the takeover"
    }
    -ex "synchronous command missed its deadline (INJECTED" { lc_fail "abandon: a control-queue shot fired where the cursor shot was due" }
    -ex "lictor: trusted scanout active" { lc_fail "abandon: the takeover completed -- the cursor shot did not fire inside it" }
    -re {EXTINCTION:} { lc_extinction_fail "abandon takeover" }
    timeout { lc_fail "abandon: no injected cursor stall within 30s of the chord" }
}
set restored 0
set timeout 20
expect {
    -re {cursor queue abandoned|cursor queue failed} { lc_fail "abandon: the cursor queue gave up before the seat restored past it" }
    -ex "lictor: trusted scanout active" { lc_fail "abandon: the takeover completed although the cursor chain never retired" }
    -re {lictor: normal scanout restored generation=[0-9]+} {
        set restored 1
        exp_continue
    }
    -ex "lictor: trusted seat recovered; nothing was conferred" {
        if {!$restored} { lc_fail "abandon: the seat went back to normal with no restore" }
    }
    -re {EXTINCTION:} { lc_extinction_fail "after the abandon stall" }
    timeout { lc_fail "abandon: within 20s: restored=$restored and no recovery" }
}
after 1500
pointer 9000 9000
set refused 0
set never 0
set revived 0
set timeout 45
expect {
    -ex "tapestryd: pointer backend refused an update; retrying" {
        set refused 1
        exp_continue
    }
    -re {cursor chain never retired in [0-9]+ ms -- cursor queue abandoned until it retires} {
        set never 1
        exp_continue
    }
    -ex "abandoned cursor chain retired -- cursor queue revived" {
        set revived 1
        exp_continue
    }
    -ex "tapestryd: pointer backend accepted an update again" {
        lc_step "abandon: the late retirement freed the lane and the pointer update went through"
    }
    -re {cursor queue failed} { lc_fail "abandon: a well-formed late retirement failed the cursor queue" }
    -re {EXTINCTION:} { lc_extinction_fail "abandon revival" }
    timeout { lc_fail "abandon: within 45s: refused=$refused never=$never revived=$revived and no accepted update" }
}
if {!$refused} { lc_fail "abandon: the update was accepted, but tapestryd never said it had been refused" }
if {!$never} { lc_fail "abandon: the lane came back, but lictor never said it abandoned the chain" }
if {!$revived} { lc_fail "abandon: the update was accepted, but lictor never said the lane revived" }

# ---- leg R: the kernel refuses RESTORED after a completed restore ----
key "ctrl+alt+f10"
set timeout 30
expect {
    -ex "lictor: trusted scanout active" { lc_step "refused: the trusted scanout is up" }
    -ex "INJECTED by test-latch-dead" { lc_fail "refused: a stall fired where the RESTORED shot was due" }
    -re {EXTINCTION:} { lc_extinction_fail "refused takeover" }
    timeout { lc_fail "refused: no takeover within 30s of the chord" }
}
after 1000
key "ret"
expect {
    -ex "lictor: RESTORED refused (INJECTED by test-latch-dead)" {
        lc_step "refused: the kernel's RESTORED was refused after the restore"
    }
    -re {EXTINCTION:} { lc_extinction_fail "refused RESTORED" }
    timeout { lc_fail "refused: the empty episode never reached its RESTORED within 30s -- did Enter end it?" }
}
set restored 0
expect {
    -re {lictor: normal scanout restored generation=[0-9]+} {
        set restored 1
        exp_continue
    }
    -ex "lictor: trusted seat recovered; nothing was conferred" {
        if {!$restored} { lc_fail "refused: the seat returned without rebinding -- restoration was no longer owed after the refusal" }
        lc_step "refused: restoration stayed owed, and the seat recovered"
    }
    -re {EXTINCTION:} { lc_extinction_fail "after the refused RESTORED" }
    timeout { lc_fail "refused: within 30s: restored=$restored and no recovery" }
}
rejoined refused
after 1500
witness cancelled

# ---- leg 2: the engine dies under the trusted scanout ----
# A fresh "trusted scanout active" here is also leg R's verdict: a seat that
# carried "active" across the refused RESTORED skips the takeover entirely.
key "ctrl+alt+f10"
set timeout 30
expect {
    -ex "lictor: trusted scanout active" { lc_step "dead: the trusted scanout is up (a fresh takeover)" }
    -re {EXTINCTION:} { lc_extinction_fail "second takeover" }
    timeout { lc_fail "dead: no takeover within 30s of the chord (did the seat carry 'active' across leg R's refused RESTORED?)" }
}
expect {
    -ex "INJECTED by test-latch-dead, retirement withheld" { lc_step "dead: lictor stalled the engine with the chain's retirement withheld" }
    -ex "INJECTED by test-latch-dead) -- engine stalled" { lc_fail "dead: the second shot did not withhold its retirement" }
    -re {EXTINCTION:} { lc_extinction_fail "second shot" }
    timeout { lc_fail "dead: no injected stall within 30s of the takeover" }
}
set dead 0
set returned 0
set timeout 60
expect {
    -re {engine revived|lictor: normal scanout restored} {
        lc_fail "dead: the engine revived or the scanout was restored although the chain's retirement was withheld"
    }
    -re {gpu engine stalled [0-9]+ ms without a retirement -- engine dead} {
        set dead 1
        lc_step "dead: the stall outlived the abandonment bound and the engine died"
        exp_continue
    }
    -re {GPU engine dead with normal output displaced -- the seat returns without its display; input withheld for the rest of the boot generation=[0-9]+} {
        set returned 1
        exp_continue
    }
    -ex "lictor: trusted seat recovered; nothing was conferred" {
        if {!$returned} { lc_fail "dead: the seat recovered without saying its display was lost" }
        lc_step "dead: the seat is normal again, nothing conferred, its display lost"
    }
    -re {EXTINCTION:} { lc_extinction_fail "after the engine died" }
    timeout { lc_fail "dead: within 60s: dead=$dead returned=$returned and no recovery (the failed seat is still retrying its restore)" }
}
if {!$dead} { lc_fail "dead: the seat returned without its display, but lictor never said the engine died" }

# A key typed now must reach no one. lictor's line is the gate firing; a
# seat-probe PASS is a key that reached the shell through the compositor.
type "caps-probe --seat-denied\n"
set withheld 0
set timeout 15
expect {
    -ex "lictor: input withheld from the compositor (display lost in a trusted episode)" {
        set withheld 1
        exp_continue
    }
    -ex "seat-probe: PASS denied" { lc_fail "dead: a key typed after the display was lost reached the shell" }
    -re {EXTINCTION:} { lc_extinction_fail "after typing into a lost display" }
    timeout {}
}
if {!$withheld} { lc_fail "dead: lictor never withheld the keys typed after the display was lost" }
lc_pass "graphical SAK dead: a stalled takeover starts over; a stalled frame stays owed; part-way, answered, cursor-stalled, abandoned and refused-RESTORED takeovers restore normal output; a dead engine returns the seat without its display and withholds input"
lc_quit
