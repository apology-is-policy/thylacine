#!/usr/bin/expect -f
# #240 observation run: is a vrend-REJECTED command stream observable from the
# guest, and after how long?
#
# Separate from warp-prove.exp because the leg spends 45 s waiting out a 30 s
# timeout, and the Warp-2 gate's value is being cheap enough to run every time.
# This scenario MEASURES -- it has no red path of its own beyond "the leg never
# ran". The verdict lives in the ANSWER= line the leg prints; warp-host.sh reads
# it. Do NOT key a pass on "C0-REJECT DONE": lc_expect writes its own pattern
# into its timeout message ("waiting for [C0-REJECT DONE]"), so that token
# appears in the FAILURE text too (#186).
#
# Runs ON the GL host (Linux; lib.exp takes the direct-pty transport there).
# env: WARP_REPO (default ~/projects/thylacine), WARP_WORK (default ~/warp).

set repo [expr {[info exists ::env(WARP_REPO)] ? $::env(WARP_REPO) : "$::env(HOME)/projects/thylacine"}]
set work [expr {[info exists ::env(WARP_WORK)] ? $::env(WARP_WORK) : "$::env(HOME)/warp"}]

if {![info exists ::env(THYLACINE_ACCEL)]} { set ::env(THYLACINE_ACCEL) tcg }
set ::env(THYLACINE_NOSTORM) 1
set ::env(THYLACINE_NO_QMP) 1
set ::env(THYLACINE_NO_SHARE) 1
set ::env(THYLACINE_GPU_DEV) virtio-gpu-gl-pci
set ::env(THYLACINE_DISPLAY) egl-headless
if {![info exists ::env(LS_CI_BOOT_TIMEOUT)] || $::env(LS_CI_BOOT_TIMEOUT) < 900} {
    set ::env(LS_CI_BOOT_TIMEOUT) 900
}

file mkdir $work
# Per-attempt fixture isolation (#78/#85): the synced images are never booted
# directly.
file delete -force $work/pool-reject.img $work/disk-reject.img
exec cp --sparse=always $repo/build/fixtures/pool.img $work/pool-reject.img
exec cp $repo/build/disk.img $work/disk-reject.img
set ::env(THYLACINE_POOL_IMG) $work/pool-reject.img
set ::env(THYLACINE_DISK_IMG) $work/disk-reject.img

source $repo/tools/interactive/lib.exp

lc_boot
lc_login michael correct-horse-battery-staple-v1

# The leg's own window is 45 s; the floor covers it plus the boot's slack.
# `set timeout` is dead here -- lc_expect resets it from lc_cmd_timeout.
if {$lc_cmd_timeout < 180} { set lc_cmd_timeout 180 }
# Wait on the LAST line the leg prints, not on ANSWER=: expect stops consuming
# at its match, so anchoring on ANSWER= truncated the answer's own text out of
# the transcript. Waiting for DONE lets every measured line land first. The
# host-side verdict then greps ANSWER= -- which this timeout message cannot
# contain, so the #186 direction still holds (a timeout can never read as a
# pass).
lc_run_expect "warp-prove reject" "C0-REJECT DONE"

lc_pass "warp-prove reject: the #240 observation leg ran to completion"
