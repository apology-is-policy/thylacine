#!/usr/bin/expect -f
# Warp W-4: vkQuake on venus -- the first Vulkan GAME on the Thylacine
# display, and the vk half of the ratified FPS comparison (compose is
# gated on these numbers; the GL half is glq-virgl.exp re-run FRESH the
# same day -- a figure quoted across days/lanes is a different number in
# the same units, #236). The fps figure is REPORTED, never gated.
#
# One boot on the venus GL device, one timedemo through the BARE ramfs
# name (vkquake is ramfs-resident; its DATA is the pool's /quake). The
# choreography mirrors glq-virgl.exp with the img-family differences:
#
#   launch  -window -width DW -height DH  -> the window's arrival splits
#           the layout (post-pivot clients split -- pane.rs host());
#           the compositor enters Composed painting the CONSOLE leaf
#           (the img family has NO composed arm yet -- the game's leaf
#           carries its untouched 2D weave); presents poke display-inert;
#   zoom    (Super+F over QMP) -> one visible display-sized leaf ->
#           pending-direct -> the game's next vkQueuePresentKHR poke
#           completes the switch: "scanout direct N img res R" -- the
#           W-3e first-frame path, now under a real engine at game rate;
#   ^C      -> the game dies mid-session: wimg display-safe teardown
#           (unbind-BEFORE-unref) hands the scanout back; the console's
#           re-paint chain completes pending-direct -- driven by echo
#           ticks exactly as the GL leg drives it.
#
# Verdict lines (#186: each printed by THIS script on its own positive
# evidence; no failure text contains a success pattern):
#   VKQ-VENUS DEVICE: <name>          VkPhysicalDevice name (must name
#                                     Venus -- lavapipe/llvmpipe = the
#                                     host fell back, FAIL)
#   VKQ-VENUS DIRECT: surface N img res R   the img bind say line fired
#   VKQ-VENUS FPS: N S F              timedemo figures (REPORTED; the
#                                     comparator is the SAME host's
#                                     same-day glq-virgl figure)
#   VKQ-VENUS POKES: n sum_us max_us  the present-poke-img cost row
#                                     (the r6-F7 census under a real
#                                     game's present rate)
#   VKQ-VENUS PASS                    all gated legs held
#
# Runs ON the GL host (Linux; lib.exp takes the direct-pty transport).
# env: WARP_REPO (default ~/projects/thylacine), WARP_WORK (~/warp).

set repo [expr {[info exists ::env(WARP_REPO)] ? $::env(WARP_REPO) : "$::env(HOME)/projects/thylacine"}]
set work [expr {[info exists ::env(WARP_WORK)] ? $::env(WARP_WORK) : "$::env(HOME)/warp"}]

if {![info exists ::env(THYLACINE_ACCEL)]} { set ::env(THYLACINE_ACCEL) tcg }
set ::env(THYLACINE_NOSTORM) 1
set ::env(THYLACINE_NO_SHARE) 1
# The venus device: blob + hostmem are venus's own preconditions (QEMU
# refuses the device without them rather than degrading -- the V-0 gate).
set ::env(THYLACINE_GPU_DEV) "virtio-gpu-gl-pci,venus=on,blob=on,hostmem=256M"
set ::env(THYLACINE_DISPLAY) egl-headless
# QMP stays ON: the zoom chord rides it.
if {![info exists ::env(LS_CI_BOOT_TIMEOUT)] || $::env(LS_CI_BOOT_TIMEOUT) < 900} {
    set ::env(LS_CI_BOOT_TIMEOUT) 900
}

set DW 1280
set DH 800

# Host-side swap sampling (the bench lesson): a figure measured while
# swapping is a measurement of swapping.
proc pswp {} {
    set f [open /proc/vmstat r]
    set d [read $f]
    close $f
    set in 0
    set out 0
    regexp {pswpin (\d+)} $d -> in
    regexp {pswpout (\d+)} $d -> out
    return [list $in $out]
}

file mkdir $work
# Per-attempt fixture isolation (#78/#85): the synced images are never
# booted directly.
file delete -force $work/pool-vkq.img $work/disk-vkq.img
exec cp --sparse=always $repo/build/fixtures/pool.img $work/pool-vkq.img
exec cp $repo/build/disk.img $work/disk-vkq.img
set ::env(THYLACINE_POOL_IMG) $work/pool-vkq.img
set ::env(THYLACINE_DISK_IMG) $work/disk-vkq.img

source $repo/tools/interactive/lib.exp

set qmp [lc_qmp_sock]

lc_boot
lc_login michael correct-horse-battery-staple-v1

set s0 [pswp]

# The BARE name: vkquake is ramfs-resident (no launcher detour -- it
# carries no LLVM, unlike the GL build); -basedir names the pool data.
lc_send "vkquake -basedir /quake -window -width $DW -height $DH -nosound +timedemo demo1"

# Device leg. vkQuake prints `Device: <VkPhysicalDevice deviceName>` in
# GL_InitDevice; on this host it must name Venus (V3D behind it). A
# lavapipe/llvmpipe name means the HOST fell back to software vulkan.
set timeout 900
expect {
    -re {Device: ([^\r\n]*)[\r\n]} {
        set dev $expect_out(1,string)
        if {[string match "*lavapipe*" $dev] || [string match "*llvmpipe*" $dev]} {
            lc_fail "software vulkan device: '$dev'"
        }
        if {![string match "*Venus*" $dev]} {
            lc_fail "device names neither Venus nor a known fallback: '$dev'"
        }
        puts "\nVKQ-VENUS DEVICE: $dev\n"
        lc_step "vulkan device is live on venus"
    }
    "user fault" { lc_fail "vkquake segv during vulkan init" }
    -re {QUAKE ERROR|Sys_Error} { lc_fail "vkquake error during vulkan init" }
    timeout      { lc_fail "no Device: line within 900s" }
}

expect {
    "Quake Initialized" { lc_step "engine init complete" }
    "user fault" { lc_fail "vkquake segv during engine init" }
    -re {QUAKE ERROR|Sys_Error} { lc_fail "vkquake error during engine init" }
    timeout      { lc_fail "no 'Quake Initialized' within 900s" }
}

# The zoom (Super+F, default chord; the game's pane holds focus from
# host()). The img switch defers to the game's next present-COMPLETE --
# the poke (img_poke_complete) -- so the running demo completes it
# within a frame or two.
if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k meta_l+f} err]} {
    lc_fail "qmp zoom chord failed: $err"
}
set timeout 120
expect {
    -re {scanout direct (\d+) img res (\d+) \((\d+)x(\d+)\)} {
        puts "\nVKQ-VENUS DIRECT: surface $expect_out(1,string) img res $expect_out(2,string) ($expect_out(3,string)x$expect_out(4,string))\n"
        lc_step "direct switch fired -- SET_SCANOUT_BLOB of the presentable"
    }
    "user fault" { lc_fail "segv around the zoom/direct switch" }
    timeout      { lc_fail "no img direct-switch say line within 120s of the zoom (surface not display-sized? head != ${DW}x${DH}?)" }
}

# The demo runs out under the Direct img arm; figures REPORTED, not
# gated. A TIMEOUT falls through to teardown + census FIRST and fails at
# the end (the glq lesson: a dying run still reports its census).
set fps_wait 1800
if {[info exists ::env(VKQ_FPS_WAIT)]} { set fps_wait $::env(VKQ_FPS_WAIT) }
set timeout $fps_wait
set fps_seen 0
expect {
    -re {([0-9]+) frames +([0-9.]+) seconds +([0-9.]+) fps} {
        puts "\nVKQ-VENUS FPS: $expect_out(1,string) frames $expect_out(2,string)s $expect_out(3,string) fps (comparator: the SAME host's same-day glq-virgl figure)\n"
        lc_step "timedemo complete"
        set fps_seen 1
    }
    "user fault" { lc_fail "segv during the timedemo" }
    -re {QUAKE ERROR|Sys_Error} { lc_fail "engine error during the timedemo" }
    timeout {
        puts "\nVKQ-VENUS FPS-TIMEOUT after ${fps_wait}s -- proceeding to teardown + census, FAIL at the end\n"
    }
}

# Teardown leg: ^C kills the game mid-session -- the wimg display-safe
# teardown (unbind-BEFORE-unref) hands the scanout back; the console's
# re-paint chain completes pending-direct. Driven with echo ticks (the
# glq-virgl chain lesson: every hop needs console OUTPUT).
send -- "\003"
# Measure-then-bound (W-4 run 11): the old hard 6-tick bound was
# calibrated on the GL teardown; the vk teardown additionally pays the
# venus double-ctx-destroy + the console's 3-texture re-attach witness,
# and the promotion completed unforced a few seconds past the bound in
# every run. The tick count is now the DATUM (reported), and the FAIL
# is a generous cap that means genuinely wedged, not merely late.
set restore_cap 20
if {[info exists ::env(VKQ_RESTORE_TICKS)]} { set restore_cap $::env(VKQ_RESTORE_TICKS) }
set restored 0
set restored_at -1
for {set i 0} {$i < $restore_cap && !$restored} {incr i} {
    lc_send "echo vkq-tick-$i"
    set timeout 20
    expect {
        -re {scanout direct (\d+) (?:slot \d+ )?\((\d+)x(\d+)\)} { set restored 1; set restored_at $i }
        "vkq-tick-$i" { }
        timeout { }
    }
}
# DEFERRED (the glq deferred-fps lesson, re-learned at run 5: this assert
# used to lc_fail HERE, which ate the census below -- the one number that
# discriminates a stalled game from a glacial one died with it). The
# restoration verdict is recorded now and FAILS the lane at the end.
if {$restored} {
    puts "\nVKQ-VENUS RESTORE: console direct after $restored_at driven tick(s) of ^C (cap $restore_cap)\n"
    lc_step "console scanout restored after the game died (display-safe teardown leg)"
} else {
    puts "\nVKQ-VENUS RESTORE-FAIL: console direct scanout not restored within $restore_cap driven ticks of ^C (deferred; census first)\n"
}
lc_send "echo vkq-cleanup-ok"
set timeout 30
expect {
    "vkq-cleanup-ok" { lc_step "prompt back after ^C" }
    timeout          { lc_fail "prompt never returned after ^C" }
}

# Census: the present-poke-img cost row (r6-F7) under a real game's
# present rate -- the round-7 preamble (iii) number, and the
# stalled-vs-glacial discriminator when the demo never finishes
# (n ~ a handful = the game parked after the first frames; n in the
# thousands = presenting but slow). REPORTED, not gated. Via
# warp-prove's TCTL mode (W-4: the cost rows live on the TAPESTRY
# tree's ctl, not warp's -- `warp-prove ctl` read the wrong ctl for
# three runs and this leg reported "unreadable" every time).
lc_send "warp-prove tctl present-poke-img"
set timeout 30
expect {
    -re {cost present-poke-img (\d+) (\d+) (\d+)} {
        puts "\nVKQ-VENUS POKES: n=$expect_out(1,string) sum_us=$expect_out(2,string) max_us=$expect_out(3,string)\n"
        lc_step "present-poke-img census read"
    }
    timeout {
        puts "\nVKQ-VENUS POKES: unreadable (pre-tctl server or ctl timeout; census missed, not gated)\n"
    }
}

set s1 [pswp]
set din  [expr {[lindex $s1 0] - [lindex $s0 0]}]
set dout [expr {[lindex $s1 1] - [lindex $s0 1]}]
puts "VKQ-VENUS swap-delta: pswpin +$din pswpout +$dout"
if {$din > 64} {
    puts "VKQ-VENUS SWAPPED -- the fps figure measures swapping, DISCARD IT"
}

if {!$fps_seen} {
    lc_fail "no timedemo fps line within ${fps_wait}s (teardown + census reported above)"
}
if {!$restored} {
    lc_fail "console direct scanout not restored within $restore_cap driven ticks of ^C (census reported above)"
}

puts "\nVKQ-VENUS PASS\n"
lc_quit
lc_pass "vkq-venus: vkQuake on venus through the img Direct arm (the W-4 vk half of the FPS comparison)"
exit 0
