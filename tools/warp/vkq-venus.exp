#!/usr/bin/expect -f
# Warp W-4: vkQuake on venus -- the first Vulkan GAME on the Thylacine
# display, and the vk half of the ratified FPS comparison (compose is
# gated on these numbers; the GL half is glq-virgl.exp re-run FRESH the
# same day -- a figure quoted across days/lanes is a different number in
# the same units, #236). The fps figure is REPORTED, never gated.
#
# One boot on the venus GL device, one timedemo through the BARE ramfs
# name (vkquake is ramfs-resident; its DATA is the pool's /quake). The
# choreography mirrors glq-virgl.exp with the img-family differences:
#
#   launch  -window -width DW -height DH  -> the window's arrival splits
#           the layout (post-pivot clients split -- pane.rs host());
#           the compositor enters Composed painting the CONSOLE leaf
#           (the img family has NO composed arm yet -- the game's leaf
#           carries its untouched 2D weave); presents poke display-inert;
#   zoom    (Super+F over QMP) -> one visible display-sized leaf ->
#           pending-direct -> the game's next vkQueuePresentKHR poke
#           completes the switch: "scanout direct N img res R" -- the
#           W-3e first-frame path, now under a real engine at game rate;
#   ^C      -> the game dies mid-session: wimg display-safe teardown
#           (unbind-BEFORE-unref) hands the scanout back; the console's
#           re-paint chain completes pending-direct -- driven by echo
#           ticks exactly as the GL leg drives it.
#
# Verdict lines (#186: each printed by THIS script on its own positive
# evidence; no failure text contains a success pattern):
#   VKQ-VENUS DEVICE: <name>          VkPhysicalDevice name (must name
#                                     Venus -- lavapipe/llvmpipe = the
#                                     host fell back, FAIL)
#   VKQ-VENUS DIRECT: surface N img res R   the img bind say line fired
#   VKQ-VENUS FPS: N S F              timedemo figures (REPORTED; the
#                                     comparator is the SAME host's
#                                     same-day glq-virgl figure)
#   VKQ-VENUS POKES: n sum_us max_us  the present-poke-img cost row
#                                     (the r6-F7 census under a real
#                                     game's present rate)
#   VKQ-VENUS RESIZE: ...             the r6-F1 resize driver: the blit
#                                     leg's menu is unzoomed (composed
#                                     transition witnessed = we LEFT
#                                     direct) then re-zoomed, and the
#                                     recreated swapchain re-promotes
#                                     (a resize_ack wedge fails here)
#   VKQ-VENUS PASS                    all gated legs held
#
# Runs ON the GL host (Linux; lib.exp takes the direct-pty transport).
# env: WARP_REPO (default ~/projects/thylacine), WARP_WORK (~/warp).

set repo [expr {[info exists ::env(WARP_REPO)] ? $::env(WARP_REPO) : "$::env(HOME)/projects/thylacine"}]
set work [expr {[info exists ::env(WARP_WORK)] ? $::env(WARP_WORK) : "$::env(HOME)/warp"}]

if {![info exists ::env(THYLACINE_ACCEL)]} { set ::env(THYLACINE_ACCEL) tcg }
set ::env(THYLACINE_NOSTORM) 1
set ::env(THYLACINE_NO_SHARE) 1
# The venus device: blob + hostmem are venus's own preconditions (QEMU
# refuses the device without them rather than degrading -- the V-0 gate).
set ::env(THYLACINE_GPU_DEV) "virtio-gpu-gl-pci,venus=on,blob=on,hostmem=256M"
set ::env(THYLACINE_DISPLAY) egl-headless
# QMP stays ON: the zoom chord rides it.
if {![info exists ::env(LS_CI_BOOT_TIMEOUT)] || $::env(LS_CI_BOOT_TIMEOUT) < 900} {
    set ::env(LS_CI_BOOT_TIMEOUT) 900
}

set DW 1280
set DH 800

# Host-side swap sampling (the bench lesson): a figure measured while
# swapping is a measurement of swapping.
proc pswp {} {
    set f [open /proc/vmstat r]
    set d [read $f]
    close $f
    set in 0
    set out 0
    regexp {pswpin (\d+)} $d -> in
    regexp {pswpout (\d+)} $d -> out
    return [list $in $out]
}

file mkdir $work
# Per-attempt fixture isolation (#78/#85): the synced images are never
# booted directly.
file delete -force $work/pool-vkq.img $work/disk-vkq.img
exec cp --sparse=always $repo/build/fixtures/pool.img $work/pool-vkq.img
exec cp $repo/build/disk.img $work/disk-vkq.img
set ::env(THYLACINE_POOL_IMG) $work/pool-vkq.img
set ::env(THYLACINE_DISK_IMG) $work/disk-vkq.img

source $repo/tools/interactive/lib.exp

set qmp [lc_qmp_sock]

lc_boot
lc_login michael correct-horse-battery-staple-v1

set s0 [pswp]

# TWO LEGS (the W-4 section-8 tiling A/B, one boot): `linear` = the
# default NO_BLIT chain (the image IS the presentable, LINEAR-tiled);
# `blit` = -wsiblit (patch 0005 -> THY_WSI_BLIT in-process) = the
# BUFFER_BLIT chain (tiled images + a per-present resolve-blit into the
# linear presentable). Same demo, same boot, same host state -- the
# cleanest form of the ratified comparison. The zoom fires once (a
# HOST-window property); the teardown + census run once, after leg B.
set fps_wait 1800
if {[info exists ::env(VKQ_FPS_WAIT)]} { set fps_wait $::env(VKQ_FPS_WAIT) }
set fps_seen 0
foreach leg {linear blit} {
    set extra ""
    if {$leg eq "blit"} { set extra " -wsiblit" }
    # The BARE name: vkquake is ramfs-resident (no launcher detour -- it
    # carries no LLVM, unlike the GL build); -basedir names the pool data.
    lc_send "vkquake -basedir /quake -window -width $DW -height $DH -nosound$extra +timedemo demo1"

    # Device leg. vkQuake prints `Device: <VkPhysicalDevice deviceName>` in
    # GL_InitDevice; on this host it must name Venus (V3D behind it). A
    # lavapipe/llvmpipe name means the HOST fell back to software vulkan.
    set timeout 900
    expect {
        -re {Device: ([^\r\n]*)[\r\n]} {
            set dev $expect_out(1,string)
            if {[string match "*lavapipe*" $dev] || [string match "*llvmpipe*" $dev]} {
                lc_fail "software vulkan device ($leg leg): '$dev'"
            }
            if {![string match "*Venus*" $dev]} {
                lc_fail "device names neither Venus nor a known fallback ($leg leg): '$dev'"
            }
            puts "\nVKQ-VENUS DEVICE ($leg): $dev\n"
            lc_step "vulkan device is live on venus ($leg leg)"
        }
        "user fault" { lc_fail "vkquake segv during vulkan init ($leg leg)" }
        -re {QUAKE ERROR|Sys_Error} { lc_fail "vkquake error during vulkan init ($leg leg)" }
        timeout      { lc_fail "no Device: line within 900s ($leg leg)" }
    }

    expect {
        "Quake Initialized" { lc_step "engine init complete ($leg leg)" }
        "user fault" { lc_fail "vkquake segv during engine init ($leg leg)" }
        -re {QUAKE ERROR|Sys_Error} { lc_fail "vkquake error during engine init ($leg leg)" }
        timeout      { lc_fail "no 'Quake Initialized' within 900s ($leg leg)" }
    }

    # The zoom (Super+F, default chord; the game's pane holds focus from
    # host()). PER LEG, not once: the zoom belongs to the game's PANE and
    # dies with it at the ^C between legs -- run 2 measured leg B sitting
    # in a 2-pane COMPOSED layout for its whole demo (reconcile computes
    # Direct only for a single visible display-sized leaf), so the
    # direct-switch witness could never fire. The img switch defers to
    # the game's next present-COMPLETE -- the poke (img_poke_complete) --
    # so the running demo completes it within a frame or two.
    if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k meta_l+f} err]} {
        lc_fail "qmp zoom chord failed: $err ($leg leg)"
    }
    set timeout 120
    expect {
        -re {scanout direct (\d+) img res (\d+) \((\d+)x(\d+)\)} {
            puts "\nVKQ-VENUS DIRECT ($leg): surface $expect_out(1,string) img res $expect_out(2,string) ($expect_out(3,string)x$expect_out(4,string))\n"
            lc_step "direct switch fired ($leg leg) -- SET_SCANOUT_BLOB of the presentable"
        }
        "user fault" { lc_fail "segv around the direct switch ($leg leg)" }
        timeout      { lc_fail "no img direct-switch say line within 120s ($leg leg; surface not display-sized? head != ${DW}x${DH}?)" }
    }

    # The demo runs out under the Direct img arm; figures REPORTED, not
    # gated. A TIMEOUT falls through (leg B: to teardown + census FIRST)
    # and fails at the end (the glq lesson: a dying run still reports).
    set timeout $fps_wait
    expect {
        -re {([0-9]+) frames +([0-9.]+) seconds +([0-9.]+) fps} {
            puts "\nVKQ-VENUS FPS ($leg): $expect_out(1,string) frames $expect_out(2,string)s $expect_out(3,string) fps (comparator: the SAME host's same-day glq-virgl figure)\n"
            lc_step "timedemo complete ($leg leg)"
            incr fps_seen
        }
        "user fault" { lc_fail "segv during the timedemo ($leg leg)" }
        -re {QUAKE ERROR|Sys_Error} { lc_fail "engine error during the timedemo ($leg leg)" }
        timeout {
            puts "\nVKQ-VENUS FPS-TIMEOUT ($leg) after ${fps_wait}s -- proceeding, FAIL at the end\n"
        }
    }

    if {$leg eq "linear"} {
        # Between legs: kill leg A, wait the prompt (fast -- the serial
        # prompt is independent of the display's slower re-promotion),
        # launch leg B into the same session.
        send -- "\003"
        lc_send "echo vkq-legswap"
        set timeout 60
        expect {
            "vkq-legswap" { lc_step "prompt back between legs" }
            timeout       { lc_fail "prompt never returned between the legs" }
        }
    }

    if {$leg eq "blit"} {
        # The r6-F1 RESIZE DRIVER (the owed regression leg): the audit's
        # target scenario was a resizable pure-vk window under pane
        # management -- the displaced-generation pin + the resize_ack
        # E_AGAIN wedge left the window stuck at pane size, never
        # Direct-eligible again, with every present display-inert. Drive
        # the round trip at the post-demo menu (it presents continuously,
        # so promotions complete within a frame): UNZOOM -> the game's
        # pane shrinks (a real resize: CONFIGURE -> OUT_OF_DATE ->
        # swapchain recreate) and the scanout must LEAVE direct (the
        # composed transition is the proof the chord landed -- without it
        # a later direct say is the OLD state, not a recovery); then
        # RE-ZOOM -> the recreated swapchain's presentable must be
        # promoted again. A wedged resize path fails the second half.
        if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k meta_l+f} err]} {
            lc_fail "qmp unzoom chord failed: $err (resize driver)"
        }
        set timeout 45
        expect {
            -re {scanout composed \((\d+)x(\d+)\)} {
                lc_step "resize driver: left direct (composed entry after unzoom)"
            }
            "user fault" { lc_fail "segv on the unzoom resize (resize driver)" }
            -re {QUAKE ERROR|Sys_Error} { lc_fail "engine error on the unzoom resize (resize driver)" }
            timeout { lc_fail "no composed transition within 45s of unzoom -- the chord or the resize path is dead (resize driver)" }
        }
        if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k meta_l+f} err]} {
            lc_fail "qmp re-zoom chord failed: $err (resize driver)"
        }
        set timeout 90
        expect {
            -re {scanout direct (\d+) img res (\d+) \((\d+)x(\d+)\)} {
                puts "\nVKQ-VENUS RESIZE: re-promoted after unzoom/re-zoom -- surface $expect_out(1,string) img res $expect_out(2,string) ($expect_out(3,string)x$expect_out(4,string))\n"
                lc_step "resize driver: re-promoted (the r6-F1 wedge did not fire)"
            }
            "user fault" { lc_fail "segv on the re-zoom resize (resize driver)" }
            -re {QUAKE ERROR|Sys_Error} { lc_fail "engine error on the re-zoom resize (resize driver)" }
            timeout { lc_fail "no direct re-promotion within 90s of re-zoom -- the r6-F1 resize-wedge class (resize driver)" }
        }
    }
}

# Teardown leg: ^C kills the game mid-session -- the wimg display-safe
# teardown (unbind-BEFORE-unref) hands the scanout back; the console's
# re-paint chain completes pending-direct. Driven with echo ticks (the
# glq-virgl chain lesson: every hop needs console OUTPUT).
send -- "\003"
# Measure-then-bound (W-4 run 11; UNITS fixed at round-7 F5): the old
# hard 6-tick bound was GL-calibrated, and a TICK is an elastic unit --
# each is one console round-trip (~0.5-2 s), so "20 ticks" was 10-40 s
# of wall clock, straddling the measured 30-40 s restore latency: the
# cap discriminated LOAD from wedge, not late from wedged. The bound is
# now WALL CLOCK (VKQ_RESTORE_SECS, default 90 -- comfortably past the
# known latency; a miss means genuinely wedged), ticks keep driving the
# console, and BOTH figures are reported as the datum.
set restore_secs 90
if {[info exists ::env(VKQ_RESTORE_SECS)]} { set restore_secs $::env(VKQ_RESTORE_SECS) }
set restore_t0 [clock seconds]
set restored 0
set i 0
while {!$restored && [expr {[clock seconds] - $restore_t0}] < $restore_secs} {
    lc_send "echo vkq-tick-$i"
    set timeout 20
    expect {
        -re {scanout direct (\d+) (?:slot \d+ )?\((\d+)x(\d+)\)} { set restored 1 }
        "vkq-tick-$i" { }
        timeout { }
    }
    incr i
}
set restore_dt [expr {[clock seconds] - $restore_t0}]
# DEFERRED (the glq deferred-fps lesson, re-learned at run 5: this assert
# used to lc_fail HERE, which ate the census below -- the one number that
# discriminates a stalled game from a glacial one died with it). The
# restoration verdict is recorded now and FAILS the lane at the end.
if {$restored} {
    puts "\nVKQ-VENUS RESTORE: console direct after ${restore_dt}s / $i driven tick(s) of ^C (bound ${restore_secs}s)\n"
    lc_step "console scanout restored after the game died (display-safe teardown leg)"
} else {
    puts "\nVKQ-VENUS RESTORE-FAIL: console direct scanout not restored within ${restore_secs}s (${i} driven ticks) of ^C (deferred; census first)\n"
}
lc_send "echo vkq-cleanup-ok"
set timeout 30
expect {
    "vkq-cleanup-ok" { lc_step "prompt back after ^C" }
    timeout          { lc_fail "prompt never returned after ^C" }
}

# Census: the present-poke-img cost row (r6-F7) under a real game's
# present rate -- the round-7 preamble (iii) number, and the
# stalled-vs-glacial discriminator when the demo never finishes
# (n ~ a handful = the game parked after the first frames; n in the
# thousands = presenting but slow). REPORTED, not gated. Via
# warp-prove's TCTL mode (W-4: the cost rows live on the TAPESTRY
# tree's ctl, not warp's -- `warp-prove ctl` read the wrong ctl for
# three runs and this leg reported "unreadable" every time).
lc_send "warp-prove tctl poke"
set timeout 30
expect {
    -re {cost present-poke-img (\d+) (\d+) (\d+)} {
        puts "\nVKQ-VENUS POKES: n=$expect_out(1,string) sum_us=$expect_out(2,string) max_us=$expect_out(3,string)\n"
        lc_step "present-poke-img census read"
    }
    timeout {
        puts "\nVKQ-VENUS POKES: unreadable (pre-tctl server or ctl timeout; census missed, not gated)\n"
    }
}
# The poke DECOMPOSITION (the display-present hunt's instrument): the
# same substring read carries the bind/flush split rows -- which of the
# two synchronous device steps holds the ~17 ms/frame the displayed
# figure loses against the undisplayed one. REPORTED, not gated: a
# pre-decomposition server simply has no rows.
set timeout 10
expect {
    -re {cost poke-bind (\d+) (\d+) (\d+)} {
        puts "\nVKQ-VENUS POKE-BIND: n=$expect_out(1,string) sum_us=$expect_out(2,string) max_us=$expect_out(3,string)\n"
    }
    timeout { puts "\nVKQ-VENUS POKE-BIND: no row (pre-decomposition server)\n" }
}
set timeout 10
expect {
    -re {cost poke-flush (\d+) (\d+) (\d+)} {
        puts "\nVKQ-VENUS POKE-FLUSH: n=$expect_out(1,string) sum_us=$expect_out(2,string) max_us=$expect_out(3,string)\n"
    }
    timeout { puts "\nVKQ-VENUS POKE-FLUSH: no row (pre-decomposition server)\n" }
}

set s1 [pswp]
set din  [expr {[lindex $s1 0] - [lindex $s0 0]}]
set dout [expr {[lindex $s1 1] - [lindex $s0 1]}]
puts "VKQ-VENUS swap-delta: pswpin +$din pswpout +$dout"
if {$din > 64} {
    puts "VKQ-VENUS SWAPPED -- the fps figure measures swapping, DISCARD IT"
}

if {$fps_seen < 2} {
    lc_fail "only $fps_seen of 2 leg fps lines within ${fps_wait}s each (teardown + census reported above)"
}
if {!$restored} {
    lc_fail "console direct scanout not restored within ${restore_secs}s of ^C (census reported above)"
}

puts "\nVKQ-VENUS PASS\n"
lc_quit
lc_pass "vkq-venus: vkQuake on venus through the img Direct arm (the W-4 vk half of the FPS comparison)"
exit 0
