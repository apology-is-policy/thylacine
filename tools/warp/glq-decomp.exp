#!/usr/bin/expect -f
# #196: the virgl throughput decomposition -- one boot, two unpaced
# 1280x800 timedemos (Composed-only, then Direct-only), each with a
# host-side qemu %CPU sample across the demo window. Run twice by the
# warp-host `decomp` verb: WARP_DECOMP_DEV=gl (virgl, both present arms)
# and WARP_DECOMP_DEV=2d (llvmpipe on the default 2D device -- the
# resolution-matched software control on the SAME host, and the pegged-CPU
# calibration for the discriminator below).
#
# THE QUESTION (premise corrected 2026-08-10): the 192.8 fps anchor was
# macOS/HVF and DOES NOT TRANSFER (phase7-status Warp-1 row; the honest
# thyla-gl llvmpipe band is single-digit). So the virgl figure is not
# self-evidently an indictment; the decomposition discriminates STALL vs
# COMPUTE:
#   - qemu %CPU PEGGED during the demo (~= the llvmpipe control's value)
#     -> the guest is compute-bound: TCG-amplified encode, no stall;
#   - qemu %CPU well BELOW the control -> the guest is WAITING per frame
#     (fence/pump/sync round-trip) -- a real stall to hunt.
# The Composed-vs-Direct delta prices the per-present readback
# (transfer_from_3d_sync + blit) against the flush-only arm.
#
# %CPU is measured as a /proc/<pid>/stat utime+stime DELTA over each ~3 s
# interval (Linux `ps -o %cpu` is a lifetime average -- after a 300 s TCG
# boot storm it barely moves, so it cannot attribute a demo window).
#
# Both demos ride rp6, the FORWARDING /env wrapper: rp5 (glq-bench) has no
# signal forward, so its ^C killed the wrapper and ORPHANED the unpaced
# game (#197 one level up) -- the suspected #168 demo-3 contaminant. rp6
# carries the launcher's proven shape (signal forward + WNOHANG reap,
# ctrlc-probe PASS) so leg 2 never runs against leg 1's ghost. Two demos
# per boot stays inside the bench's clean demo-1/2 envelope.
#
# Verdict lines (#186: each printed by THIS script only on its own
# positive evidence; figures REPORTED, never gated):
#   GLQ-DECOMP RENDERER-<leg>: <GL_RENDERER>
#   GLQ-DECOMP FPS-<dev>-<leg>: N frames Ss F fps
#   GLQ-DECOMP CPU-<dev>-<leg>: n=K mean=M min=A max=B  (qemu %CPU)
#   GLQ-DECOMP SWAP-<leg>: pswpin +X pswpout +Y [+ SWAPPED discard marker]
#   GLQ-DECOMP PASS <dev>
#
# Runs ON the GL host (Linux). env: WARP_DECOMP_DEV=gl|2d (required),
# WARP_REPO, WARP_WORK as the sibling scenarios.

set repo [expr {[info exists ::env(WARP_REPO)] ? $::env(WARP_REPO) : "$::env(HOME)/projects/thylacine"}]
set work [expr {[info exists ::env(WARP_WORK)] ? $::env(WARP_WORK) : "$::env(HOME)/warp"}]

if {![info exists ::env(WARP_DECOMP_DEV)]} {
    puts "GLQ-DECOMP USAGE: WARP_DECOMP_DEV=gl|2d is required"
    exit 2
}
set dev $::env(WARP_DECOMP_DEV)
if {$dev ne "gl" && $dev ne "2d"} {
    puts "GLQ-DECOMP USAGE: WARP_DECOMP_DEV must be gl or 2d (got '$dev')"
    exit 2
}

# tcg unless the caller pins an accel (KVM GL hosts ride warp-host.sh WARP_ACCEL)
if {![info exists ::env(THYLACINE_ACCEL)]} { set ::env(THYLACINE_ACCEL) tcg }
set ::env(THYLACINE_NOSTORM) 1
set ::env(THYLACINE_NO_SHARE) 1
if {$dev eq "gl"} {
    set ::env(THYLACINE_GPU_DEV) virtio-gpu-gl-pci
    set ::env(THYLACINE_DISPLAY) egl-headless
}
# QMP stays ON for both devices: the zoom chord rides it.
if {![info exists ::env(LS_CI_BOOT_TIMEOUT)] || $::env(LS_CI_BOOT_TIMEOUT) < 900} {
    set ::env(LS_CI_BOOT_TIMEOUT) 900
}

set DW 1280
set DH 800

proc pswp {} {
    set f [open /proc/vmstat r]
    set d [read $f]
    close $f
    set in 0
    set out 0
    regexp {pswpin (\d+)} $d -> in
    regexp {pswpout (\d+)} $d -> out
    return [list $in $out]
}

file mkdir $work
file delete -force $work/pool-decomp.img $work/disk-decomp.img
exec cp --sparse=always $repo/build/fixtures/pool.img $work/pool-decomp.img
exec cp $repo/build/disk.img $work/disk-decomp.img
set ::env(THYLACINE_POOL_IMG) $work/pool-decomp.img
set ::env(THYLACINE_DISK_IMG) $work/disk-decomp.img

source $repo/tools/interactive/lib.exp

set qmp [lc_qmp_sock]

# The interval sampler script (written once; per-leg invocations). The
# comm field of qemu's stat has no spaces, so $14+$15 are utime+stime.
set sampf $work/cpusample.sh
set sf [open $sampf w]
puts $sf {#!/bin/sh
# $1 = pid, $2 = out; one "uptime_s total_ticks" line per ~3 s.
while kill -0 "$1" 2>/dev/null; do
  u=$(cut -d' ' -f1 /proc/uptime)
  t=$(awk '{print $14+$15}' "/proc/$1/stat" 2>/dev/null)
  [ -n "$t" ] || break
  echo "$u $t"
  sleep 3
done > "$2"}
close $sf

# CLK_TCK=100 (Debian aarch64); rates are per-interval deltas.
proc cpu_report {tag file} {
    if {[catch {open $file r} f]} {
        puts "\nGLQ-DECOMP CPU-$tag: n=0 (sampler produced nothing)\n"
        return
    }
    set pu -1.0
    set pt 0
    set rates {}
    while {[gets $f line] >= 0} {
        if {[scan $line "%f %d" u t] != 2} { continue }
        if {$pu >= 0 && $u > $pu} {
            lappend rates [expr {($t - $pt) / 100.0 / ($u - $pu) * 100.0}]
        }
        set pu $u
        set pt $t
    }
    close $f
    set n [llength $rates]
    if {$n == 0} {
        puts "\nGLQ-DECOMP CPU-$tag: n=0 (fewer than 2 samples)\n"
        return
    }
    set sum 0.0
    set mn [lindex $rates 0]
    set mx [lindex $rates 0]
    foreach r $rates {
        set sum [expr {$sum + $r}]
        if {$r < $mn} { set mn $r }
        if {$r > $mx} { set mx $r }
    }
    puts [format "\nGLQ-DECOMP CPU-%s: n=%d mean=%.1f min=%.1f max=%.1f\n" \
        $tag $n [expr {$sum / $n}] $mn $mx]
}

lc_boot
lc_login michael correct-horse-battery-staple-v1

# The qemu pid for the sampler: the sock transport records ::lc_vm_pid;
# the Linux direct-pty arm has no such variable, but its spawn chain
# (env -> run-vm.sh -> qemu) execs in place, so exp_pid IS qemu there.
# A wrong pid degrades announced (the sampler's kill -0 ends the loop and
# cpu_report prints n=0), never crashes the leg.
set qpid [expr {[info exists ::lc_vm_pid] ? $::lc_vm_pid : [exp_pid]}]

# rp6: the FORWARDING unpace wrapper (the launcher's #197/#199 shape --
# signal forward + WNOHANG/usleep reap -- grafted onto rp5's /env write).
lc_send "echo 'int open(const char*,int,int);long write(int,const void*,long);int close(int);long strlen(const char*);' > rp6.c"
sleep 1
lc_send "echo 'int posix_spawn(int*,const char*,void*,void*,char*const*,char*const*);int waitpid(int,int*,int);' >> rp6.c"
sleep 1
lc_send "echo 'int kill(int,int);int usleep(unsigned);typedef void(*sh)(int);sh signal(int,sh);' >> rp6.c"
sleep 1
lc_send "echo 'int gp=0;void fwd(int s){if(gp>0)kill(gp,s);}' >> rp6.c"
sleep 1
lc_send "echo 'int wf(const char*p,const char*s){int f=open(p,65,438);if(f<0)return 1;write(f,s,strlen(s));close(f);return 0;}' >> rp6.c"
sleep 1
lc_send "echo 'int main(int c,char**v){if(wf(\"/env/SDL_THYLACINE_NOPACE\",\"1\"))return 8;write(1,\"nopace set\\n\",11);' >> rp6.c"
sleep 1
lc_send "echo 'signal(2,fwd);signal(15,fwd);int p=0;if(posix_spawn(&p,v\[1\],0,0,v+1,0))return 9;gp=p;' >> rp6.c"
sleep 1
lc_send "echo 'for(;;){int st=0;int r=waitpid(p,&st,1);if(r==p)break;if(r<0)return 1;usleep(50000);}return 0;}' >> rp6.c"
sleep 1
lc_send "/clade/bin/clang -w -O1 --sysroot /clade/sysroot -o rp6 rp6.c"
set timeout 600
lc_send "echo rp6-ready"
expect {
    "rp6-ready" { lc_step "rp6 built (forwarding unpace wrapper)" }
    timeout     { lc_fail "clang on rp6.c never returned (600s)" }
}

# One leg: launch through rp6 + the ramfs launcher, expect the arm's
# structural evidence, sample CPU across the demo window, report figures,
# tear down through the forward chain.
proc run_leg {leg zoom} {
    global dev qmp repo work DW DH sampf qpid
    set d0 [pswp]
    lc_send "./rp6 /bin/tyr-glquake -window -width $DW -height $DH -nosound +timedemo demo1"
    set timeout 60
    expect {
        "nopace set" { lc_step "$leg: rp6 env write confirmed" }
        timeout      { lc_fail "$leg: rp6 never confirmed the /env write (60s)" }
    }
    # The window's arrival splits the layout: two visible leaves.
    set timeout 900
    expect {
        -re {scanout composed \((\d+)x(\d+)\)} { lc_step "$leg: composed entry (two leaves)" }
        "user fault" { lc_fail "$leg: segv before the game window opened" }
        "Sys_Error"  { lc_fail "$leg: Sys_Error before the game window opened" }
        timeout      { lc_fail "$leg: no composed-entry line within 900s" }
    }
    # Renderer discrimination BOTH WAYS: the gl boot must be on virgl (a
    # llvmpipe string means the launcher probe or the seam died); the 2d
    # boot must be on llvmpipe (a virgl string means the auto-detect wrote
    # virpipe on a device that cannot back it).
    set timeout 900
    expect {
        -re {GL_RENDERER: ([^\r\n]*)[\r\n]} {
            set rend $expect_out(1,string)
            if {$dev eq "gl"} {
                if {[string match "llvmpipe*" $rend]} {
                    lc_fail "$leg: gl boot fell back to the software rasteriser: '$rend'"
                }
                if {![string match "*virgl*" $rend]} {
                    lc_fail "$leg: gl boot renderer names neither virgl nor a fallback: '$rend'"
                }
            } else {
                if {[string match "*virgl*" $rend]} {
                    lc_fail "$leg: 2d boot claims virgl -- the launcher auto-detect misfired: '$rend'"
                }
                if {![string match "llvmpipe*" $rend]} {
                    lc_fail "$leg: 2d boot renderer is not llvmpipe: '$rend'"
                }
            }
            puts "\nGLQ-DECOMP RENDERER-$leg: $rend\n"
            lc_step "$leg: renderer discriminated for $dev"
        }
        "user fault" { lc_fail "$leg: segv during GL init" }
        "Sys_Error"  { lc_fail "$leg: Sys_Error during GL init" }
        timeout      { lc_fail "$leg: no GL_RENDERER line within 900s" }
    }
    expect {
        "Quake Initialized" { lc_step "$leg: engine init complete" }
        "user fault" { lc_fail "$leg: segv during engine init" }
        "Sys_Error"  { lc_fail "$leg: Sys_Error during engine init" }
        timeout      { lc_fail "$leg: no 'Quake Initialized' within 900s" }
    }
    if {$zoom} {
        # Early zoom: the switch fires at the game's next present-COMPLETE,
        # so at these frame rates <=2 frames of the 969 run composed.
        if {[catch {exec $repo/tools/qmp-sendtext.sh -s $qmp -k meta_l+f} err]} {
            lc_fail "$leg: qmp zoom chord failed: $err"
        }
        set timeout 120
        if {$dev eq "gl"} {
            expect {
                -re {scanout direct (\d+) GL res (\d+) \((\d+)x(\d+)\)} {
                    lc_step "$leg: direct switch fired (GL arm, res $expect_out(2,string))"
                }
                "user fault" { lc_fail "$leg: segv around the zoom/direct switch" }
                timeout      { lc_fail "$leg: no GL direct-switch line within 120s of the zoom" }
            }
        } else {
            expect {
                -re {scanout direct (\d+) \((\d+)x(\d+)\)} {
                    lc_step "$leg: direct switch fired (2D arm)"
                }
                "user fault" { lc_fail "$leg: segv around the zoom/direct switch" }
                timeout      { lc_fail "$leg: no 2D direct-switch line within 120s of the zoom" }
            }
        }
    }
    # Sample the demo window only (attribution: post-init, post-switch).
    set cpufile $work/cpu-$dev-$leg.txt
    file delete -force $cpufile
    set spid [exec sh $sampf $qpid $cpufile &]
    set timeout 1800
    if {$zoom} {
        expect {
            -re {([0-9]+) frames +([0-9.]+) seconds +([0-9.]+) fps} {
                puts "\nGLQ-DECOMP FPS-$dev-$leg: $expect_out(1,string) frames $expect_out(2,string)s $expect_out(3,string) fps\n"
                lc_step "$leg: timedemo complete"
            }
            "user fault" { lc_fail "$leg: segv during the timedemo" }
            "Sys_Error"  { lc_fail "$leg: Sys_Error during the timedemo" }
            timeout      { lc_fail "$leg: no timedemo fps line within 1800s" }
        }
    } else {
        # The no-zoom leg must STAY composed: any direct line before the
        # fps line means the split died (game crash) or a zoom leaked.
        expect {
            -re {([0-9]+) frames +([0-9.]+) seconds +([0-9.]+) fps} {
                puts "\nGLQ-DECOMP FPS-$dev-$leg: $expect_out(1,string) frames $expect_out(2,string)s $expect_out(3,string) fps\n"
                lc_step "$leg: timedemo complete (stayed composed)"
            }
            -re {scanout direct (\d+) GL res} {
                lc_fail "$leg: composed leg went GL-direct mid-demo -- zoom leaked?"
            }
            -re {scanout direct (\d+) \(} {
                lc_fail "$leg: composed leg lost its split mid-demo -- game window died?"
            }
            "user fault" { lc_fail "$leg: segv during the timedemo" }
            "Sys_Error"  { lc_fail "$leg: Sys_Error during the timedemo" }
            timeout      { lc_fail "$leg: no timedemo fps line within 1800s" }
        }
    }
    catch {exec kill $spid}
    cpu_report "$dev-$leg" $cpufile
    # Teardown through the forward chain (ut -> rp6 -> launcher -> game);
    # the console's return to the direct scanout is the game-death witness
    # (it re-inflates only once the game's leaf retired). Tick-driven: every
    # hop of the restore chain needs console output (the 4c run-2 lesson).
    send -- "\003"
    set restored 0
    for {set i 0} {$i < 6 && !$restored} {incr i} {
        lc_send "echo decomp-tick-$leg-$i"
        set timeout 20
        expect {
            -re {scanout direct (\d+) \((\d+)x(\d+)\)} { set restored 1 }
            "decomp-tick-$leg-$i" { }
            timeout { }
        }
    }
    if {!$restored} {
        lc_fail "$leg: console direct scanout not restored within 6 driven ticks of ^C"
    }
    lc_step "$leg: console restored -- game + wrappers down"
    lc_send "echo decomp-$leg-ok"
    set timeout 30
    expect {
        "decomp-$leg-ok" { lc_step "$leg: prompt back" }
        timeout          { lc_fail "$leg: prompt never returned after ^C" }
    }
    set d1 [pswp]
    set din  [expr {[lindex $d1 0] - [lindex $d0 0]}]
    set dout [expr {[lindex $d1 1] - [lindex $d0 1]}]
    puts "GLQ-DECOMP SWAP-$leg: pswpin +$din pswpout +$dout"
    # The 4c calibration: steady writeout is pressure, not stall; >64 pages
    # of READBACK across the window is the figure-polluting signature.
    if {$din > 64} {
        puts "GLQ-DECOMP SWAPPED-$leg -- this figure measures swapping, DISCARD IT"
    }
}

run_leg composed 0
run_leg direct 1

puts "\nGLQ-DECOMP PASS $dev\n"
lc_quit
lc_pass "glq-decomp-$dev: composed + direct unpaced figures at ${DW}x${DH} with per-demo qemu CPU attribution"
exit 0
