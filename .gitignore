# Build artifacts
build/
target/
*.o
*.a
*.elf
*.img
*.bin

# QEMU + dev tooling
share/
.qemu_state/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Rust
Cargo.lock.*
**/target/

# TLA+ tools state
*.toolbox/
states/
*.dot
specs/*_TTrace_*.tla

# Sysroot (built once, cached)
sysroot/

# Snapshot images (large; machine-specific)
snapshots/

# Log files
*.log
# ...except committed test fixtures. Several of these ARE real captured logs
# (tools/testdata/smp-classify holds a genuine passing harness log and a
# genuinely externally-SIGKILLed one), and the blanket rule above would drop
# them silently -- shipping tools/test-smp-classify.sh without the artifacts
# its two real-sample cases rest on.
!tools/testdata/**

# Generated docs
docs/_build/

# Python tooling cache (tools/*.py: the HX-2 symtab generator, etc.)
__pycache__/
*.pyc

# Local config overrides
.env.local
*.local

# Obsidian workspace state (the repo root is the Obsidian root)
.obsidian/

# Vault operator scratch (Obsidian dailies, canvases) -- never load-bearing (R8)
vault/journal/
vault/**/*.canvas
# Per-checkout agent relay config (yip): host-specific absolute paths,
# so it is joined per checkout with `yip install` rather than committed.
.mcp.json
.claude/settings.local.json

# quaestor build artifact (go build ./... drops the binary in-package)
vault/meta/quaestor/quaestor

# --- Vendored third_party/rust: track the precompiled subset ---
# The broad *.o / *.a / *.bin / target/ rules above would exclude files the
# vendored crates SHIP: ring's precompiled crypto objects + test fixtures, the
# windows/aegis static libs, and the cc crate's `src/target` SOURCE module.
# Excluding them breaks a FRESH checkout's userspace build (Cargo's per-crate
# vendored checksum fails one file at a time). Track them so a clean clone / CI /
# thyla-pi sync is reproducible. Build output stays under build/ (unaffected).
!third_party/rust/**/*.a
!third_party/rust/**/*.bin
!third_party/rust/**/*.o
!third_party/rust/cc/src/target/
!third_party/rust/cc/src/target/**
