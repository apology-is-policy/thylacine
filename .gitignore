# Build artifacts
build/
target/
*.o
*.a
*.elf
*.img
*.bin

# QEMU + dev tooling
share/
.qemu_state/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Rust
Cargo.lock.*
**/target/

# TLA+ tools state
*.toolbox/
states/
*.dot
specs/*_TTrace_*.tla

# Sysroot (built once, cached)
sysroot/

# Snapshot images (large; machine-specific)
snapshots/

# Log files
*.log

# Generated docs
docs/_build/

# Python tooling cache (tools/*.py: the HX-2 symtab generator, etc.)
__pycache__/
*.pyc

# Local config overrides
.env.local
*.local

# Obsidian workspace state (the repo root is the Obsidian root)
.obsidian/

# Vault operator scratch (Obsidian dailies, canvases) -- never load-bearing (R8)
vault/journal/
vault/**/*.canvas
# Per-checkout agent relay config (yip): host-specific absolute paths,
# so it is joined per checkout with `yip install` rather than committed.
.mcp.json
.claude/settings.local.json

# quaestor build artifact (go build ./... drops the binary in-package)
vault/meta/quaestor/quaestor
