# Build artifacts
build/
target/
*.o
*.a
*.elf
*.img
*.bin

# QEMU + dev tooling
share/
.qemu_state/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Rust
Cargo.lock.*
**/target/

# TLA+ tools state
*.toolbox/
states/
*.dot
specs/*_TTrace_*.tla

# Sysroot (built once, cached)
sysroot/

# Snapshot images (large; machine-specific)
snapshots/

# Log files
*.log
# ...except committed test fixtures. Several of these ARE real captured logs
# (tools/testdata/smp-classify holds a genuine passing harness log and a
# genuinely externally-SIGKILLed one), and the blanket rule above would drop
# them silently -- shipping tools/test-smp-classify.sh without the artifacts
# its two real-sample cases rest on.
!tools/testdata/**

# Generated docs
docs/_build/

# Python tooling cache (tools/*.py: the HX-2 symtab generator, etc.)
__pycache__/
*.pyc

# Local config overrides
.env.local
*.local

# Per-checkout agent relay config (yip): host-specific absolute paths,
# so it is joined per checkout with `yip install` rather than committed.
.mcp.json
.claude/settings.local.json
