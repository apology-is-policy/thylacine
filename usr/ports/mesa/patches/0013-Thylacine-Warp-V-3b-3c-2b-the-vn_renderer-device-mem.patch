 int warp_ring_destroy(struct warp_conn *w, uint32_t ridx);
 
+/* ---- Warp-6 V-3b-3c device memory (HOST_VISIBLE VkDeviceMemory) ---- */
+
+/*
+ * A device-memory blob is a host3d backing exactly like a ring, but named by a
+ * CLIENT-OWNED handle (0..255, MAX_WARP_MEMS_PER_CTX) rather than a ridx, and
+ * bound to a Venus VkDeviceMemory: `blob_id = mem_id` (the memory's Venus
+ * object id), so the host's virglrenderer maps THAT allocation's pages into the
+ * shared backing. One write mints it -- there is no separate build step and no
+ * unbuilt corpse (unlike bo/create3d).
+ *
+ * Mint at `handle` on the connection's ctx: writes "<bytes> <handle> <mem_id>"
+ * to ctx/<id>/mem/new and reads the device-global res_id back from
+ * mem/<handle>/info ("res <id> size <sz>"). `bytes` must be a nonzero page
+ * multiple <= WARP_CTX_BACKING_MAX (64 MiB, server-enforced) and the caller
+ * owns handle allocation (a duplicate is refused server-side). The mint ZEROES
+ * the backing server-side (the disclosure floor), so the caller MUST mint at
+ * vkAllocateMemory time, before any device write to mem_id -- a lazy mint after
+ * a GPU copy INTO the memory would zero the results (server audit F4).
+ * Three-valued return (V-3b-3c-2b F2): 0 = success (+ *res_id_out); 1 = failed,
+ * server slot provably NOT installed (a wedged/ctx-less conn or a refused
+ * mem/new Twrite -- the routine E_NOMEM at the holistic cap) -> the caller
+ * SHOULD free its handle; -1 = failed, slot MAYBE installed (Twrite ok, info
+ * read failed) -> the caller MUST keep the handle marked, else a re-handed
+ * handle collides with the still-installed slot (the ring-F1 wedge). Freeing on
+ * 1 keeps a memory-pressure loop from burning the 256-slot space on routine cap
+ * refusals. */
+int warp_mem_new(struct warp_conn *w, uint32_t handle, uint32_t bytes,
+                 uint64_t mem_id, uint32_t *res_id_out);
+
+/* Map a minted device-memory blob's coherent backing: opens mem/<handle>/map
+ * and t_weft_map's it (the ring/bo map-atomic path). The client holds no PCI
+ * handle -- a Venus app is not the device owner -- so this is the weft map, not
+ * SYS_BURROW_FROM_HOSTMEM. RW + host-coherent; lives until *map_fd_out closes.
+ * NULL on failure. */
+void *warp_mem_map(struct warp_conn *w, uint32_t handle, long *map_fd_out);
+
+/* Drop a device-memory mapping: closes the map fid. Drops the client's MAPPING
+ * + the transferred pin, NOT the server slot (retired by warp_mem_destroy or
+ * ctx death). Safe on a wedged connection. */
+void warp_mem_unmap(long map_fd);
+
+/* Retire a device-memory blob server-side and free its handle slot. Writes
+ * "destroy" to mem/<handle>/ctl (disarm the share + observe-and-reap the
+ * hostmem backing). Call AFTER warp_mem_unmap so the server takes the
+ * immediate-reclaim arm. Returns 0 on success (the caller then frees its
+ * handle -- "guest handle free <=> server slot free"), -1 on refusal (leave the
+ * handle marked; a stale server slot is bounded by ctx death). */
+int warp_mem_destroy(struct warp_conn *w, uint32_t handle);
+
 /* Submit one opaque Venus command stream (raw SUBMIT_CMD/execbuffer bytes) to
  * the ctx's submit file. With a host3d ring armed the server routes this to
  * warp_venus_submit on the venus device-ctx; tapestryd never parses the
diff --git a/src/virtio/vulkan/thylacine_prove.c b/src/virtio/vulkan/thylacine_prove.c
index d0c16b2..c86561e 100644
--- a/src/virtio/vulkan/thylacine_prove.c
+++ b/src/virtio/vulkan/thylacine_prove.c
@@ -42,9 +42,39 @@ gipa(VkInstance instance, const char *name)
    return vk_icdGetInstanceProcAddr(instance, name);
 }
 
+/* Loader-less direct entrypoints (V-3b-3c-2b). The mesa runtime dispatch
+ * trampolines (vk_tramp_*) that vk_icdGetInstanceProcAddr returns are built for
+ * the Vulkan LOADER's object layout: vk_tramp_CreateDevice loads a
+ * physical-device dispatch slot and tail-branches to it, but the ICD populates
+ * that slot only under a real loader, so via gipa it branches to NULL here
+ * (pc=0). We statically link the Venus driver, so -- exactly as this file
+ * already does for vk_icdGetInstanceProcAddr -- we call the post-instance
+ * entrypoints directly by symbol, bypassing the trampolines. */
+extern VKAPI_ATTR VkResult VKAPI_CALL
+vn_CreateDevice(VkPhysicalDevice, const VkDeviceCreateInfo *,
+                const VkAllocationCallbacks *, VkDevice *);
+extern VKAPI_ATTR void VKAPI_CALL
+vn_DestroyDevice(VkDevice, const VkAllocationCallbacks *);
+extern VKAPI_ATTR VkResult VKAPI_CALL
+vn_AllocateMemory(VkDevice, const VkMemoryAllocateInfo *,
+                  const VkAllocationCallbacks *, VkDeviceMemory *);
+/* Venus implements the Vulkan 1.4 map/unmap forms; the flat vn_MapMemory /
+ * vn_UnmapMemory are not defined symbols, so use the 2 variants directly. */
+extern VKAPI_ATTR VkResult VKAPI_CALL
+vn_MapMemory2(VkDevice, const VkMemoryMapInfo *, void **);
+extern VKAPI_ATTR VkResult VKAPI_CALL
+vn_UnmapMemory2(VkDevice, const VkMemoryUnmapInfo *);
+extern VKAPI_ATTR void VKAPI_CALL
+vn_FreeMemory(VkDevice, VkDeviceMemory, const VkAllocationCallbacks *);
+
 int
 main(void)
 {
+   /* Unbuffered: the guest console is not a TTY, so musl fully-buffers stdout
+    * and a fault before exit loses the buffer -- which would hide exactly where
+    * a bring-up step dies. Every printf below must be immediately visible. */
+   setvbuf(stdout, NULL, _IONBF, 0);
+
    /* Step 1 (V-3b-3a): the loader-less global-command proof. */
    PFN_vkEnumerateInstanceVersion enum_ver =
       (PFN_vkEnumerateInstanceVersion)gipa(VK_NULL_HANDLE,
@@ -149,11 +179,177 @@ main(void)
           VK_API_VERSION_PATCH(props.apiVersion),
           mem.memoryTypeCount, mem.memoryHeapCount);
 
+   /* Step 3 (V-3b-3c-2b): create a logical device and allocate + map a
+    * HOST_VISIBLE VkDeviceMemory over the mem/ device-memory path. This drives
+    * the new renderer bo_ops: create_from_device_memory at vkAllocateMemory
+    * (mints the ctx/<id>/mem/<handle> host3d blob, blob_id = the memory's Venus
+    * object id) and bo_map at vkMapMemory (weft-maps the coherent backing). */
+   /* get_qf resolves fine via gipa (a physical-device query trampoline whose
+    * slot IS populated); the object-creating vkCreateDevice is the trampoline
+    * that branches to a null slot, so it + the device-memory calls go direct. */
+   PFN_vkGetPhysicalDeviceQueueFamilyProperties get_qf =
+      (PFN_vkGetPhysicalDeviceQueueFamilyProperties)gipa(
+         instance, "vkGetPhysicalDeviceQueueFamilyProperties");
+   if (!get_qf) {
+      printf("THYLACINE-VENUS-PROVE FAIL: vkGetPhysicalDeviceQueueFamilyProperties "
+             "unresolved\n");
+      destroy_instance(instance, NULL);
+      return 1;
+   }
+
+   uint32_t qf_count = 0;
+   get_qf(pds[0], &qf_count, NULL);
+   if (qf_count == 0) {
+      printf("THYLACINE-VENUS-PROVE FAIL: dev0 exposes no queue families\n");
+      destroy_instance(instance, NULL);
+      return 1;
+   }
+
+   const float prio = 1.0f;
+   const VkDeviceQueueCreateInfo qci = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &prio,
+   };
+   const VkDeviceCreateInfo dci = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &qci,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   printf("venus-prove: qf_count=%u; creating logical device (direct vn_CreateDevice)...\n",
+          qf_count);
+   r = vn_CreateDevice(pds[0], &dci, NULL, &device);
+   if (r != VK_SUCCESS || device == VK_NULL_HANDLE) {
+      printf("THYLACINE-VENUS-PROVE FAIL: vkCreateDevice rc=%d\n", r);
+      destroy_instance(instance, NULL);
+      return 1;
+   }
+   printf("venus-prove: logical device created\n");
+
+   /* Device-memory + destroy entrypoints: direct vn_ symbols (see the extern
+    * block -- the device-level trampolines share the loader-layout issue).
+    * map/unmap use the Vulkan 1.4 vn_MapMemory2/vn_UnmapMemory2 at the call
+    * sites below (the flat forms are not defined symbols). */
+   PFN_vkAllocateMemory alloc_mem = vn_AllocateMemory;
+   PFN_vkFreeMemory free_mem = vn_FreeMemory;
+   PFN_vkDestroyDevice destroy_device = vn_DestroyDevice;
+
+   /* Prefer HOST_VISIBLE | HOST_COHERENT (the weft backing is host-coherent, so
+    * bo_flush/invalidate are no-ops -- a non-coherent type would need real
+    * flushes the backend does not perform). Fall back to bare HOST_VISIBLE. */
+   int mt = -1;
+   for (uint32_t i = 0; i < mem.memoryTypeCount; i++) {
+      const VkMemoryPropertyFlags pf = mem.memoryTypes[i].propertyFlags;
+      if ((pf & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) &&
+          (pf & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) {
+         mt = (int)i;
+         break;
+      }
+   }
+   if (mt < 0) {
+      for (uint32_t i = 0; i < mem.memoryTypeCount; i++)
+         if (mem.memoryTypes[i].propertyFlags &
+             VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) {
+            mt = (int)i;
+            break;
+         }
+   }
+   if (mt < 0) {
+      /* A device with no HOST_VISIBLE type cannot exercise this path; degrade
+       * to ABSENT rather than FAIL (the milestone is host-visible memory). */
+      printf("THYLACINE-VENUS-PROVE ABSENT (dev0 exposes no HOST_VISIBLE memory "
+             "type -- cannot exercise device-memory map)\n");
+      destroy_device(device, NULL);
+      destroy_instance(instance, NULL);
+      return 0;
+   }
+
+   const VkDeviceSize memsize = 4096;
+   const VkMemoryAllocateInfo mai = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = memsize,
+      .memoryTypeIndex = (uint32_t)mt,
+   };
+   VkDeviceMemory memory = VK_NULL_HANDLE;
+   r = alloc_mem(device, &mai, NULL, &memory);
+   if (r != VK_SUCCESS || memory == VK_NULL_HANDLE) {
+      printf("THYLACINE-VENUS-PROVE FAIL: vkAllocateMemory(type %d, %llu B) "
+             "rc=%d\n", mt, (unsigned long long)memsize, r);
+      destroy_device(device, NULL);
+      destroy_instance(instance, NULL);
+      return 1;
+   }
+
+   const VkMemoryUnmapInfo umi = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_UNMAP_INFO,
+      .memory = memory,
+   };
+   const VkMemoryMapInfo mmi = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_MAP_INFO,
+      .memory = memory,
+      .offset = 0,
+      .size = memsize,
+   };
+   void *ptr = NULL;
+   r = vn_MapMemory2(device, &mmi, &ptr);
+   if (r != VK_SUCCESS || !ptr) {
+      printf("THYLACINE-VENUS-PROVE FAIL: vkMapMemory rc=%d ptr=%p\n", r, ptr);
+      free_mem(device, memory, NULL);
+      destroy_device(device, NULL);
+      destroy_instance(instance, NULL);
+      return 1;
+   }
+
+   /* The backend mints the backing ZEROED (the server's disclosure floor), so a
+    * fresh map reads zero before any write -- a cross-boundary observation of
+    * server-written state through the weft mapping. Then a CPU sentinel proves
+    * the mapping is writable + coherent. NOTE: this is the ALLOCATE+MAP
+    * milestone -- it proves the map is real, writable, weft-backed memory (a
+    * non-NULL map went through t_weft_map; there is no anonymous fallback). It
+    * does NOT claim GPU visibility of these bytes; a GPU round-trip is the next
+    * milestone (V-3b-3c-2c). */
+   volatile uint32_t *word = (volatile uint32_t *)ptr;
+   const uint32_t pre0 = word[0], pre1 = word[(memsize / 4) - 1];
+   const uint32_t sentinel = 0xC0DEFACEu;
+   word[0] = sentinel;
+   word[(memsize / 4) - 1] = ~sentinel;
+   const uint32_t got0 = word[0], got1 = word[(memsize / 4) - 1];
+   if (pre0 != 0 || pre1 != 0) {
+      printf("THYLACINE-VENUS-PROVE FAIL: device-memory not zero at map "
+             "(pre %08x/%08x -- disclosure-floor breach or disconnected map)\n",
+             pre0, pre1);
+      vn_UnmapMemory2(device, &umi);
+      free_mem(device, memory, NULL);
+      destroy_device(device, NULL);
+      destroy_instance(instance, NULL);
+      return 1;
+   }
+   if (got0 != sentinel || got1 != ~sentinel) {
+      printf("THYLACINE-VENUS-PROVE FAIL: device-memory sentinel mismatch "
+             "(wrote %08x/%08x read %08x/%08x)\n",
+             sentinel, ~sentinel, got0, got1);
+      vn_UnmapMemory2(device, &umi);
+      free_mem(device, memory, NULL);
+      destroy_device(device, NULL);
+      destroy_instance(instance, NULL);
+      return 1;
+   }
+   printf("venus-prove: device-memory sentinel OK (type %d size %llu, "
+          "zero-at-map + %08x round-tripped)\n",
+          mt, (unsigned long long)memsize, sentinel);
+
+   vn_UnmapMemory2(device, &umi);
+   free_mem(device, memory, NULL);
+   destroy_device(device, NULL);
+
    destroy_instance(instance, NULL);
 
-   printf("THYLACINE-VENUS-PROVE PASS (bring-up over /srv/warp: instance "
-          "created, %u physical device(s) enumerated, dev0 '%s', %u memory "
-          "heap(s), instance destroyed -- V-3b-3b)\n",
-          pd_count, props.deviceName, mem.memoryHeapCount);
+   printf("THYLACINE-VENUS-PROVE PASS (bring-up + device-memory over /srv/warp: "
+          "instance + logical device created, %u physical device(s), dev0 '%s', "
+          "HOST_VISIBLE VkDeviceMemory allocated + mapped + sentinel "
+          "round-tripped + freed -- V-3b-3c-2b)\n",
+          pd_count, props.deviceName);
    return 0;
 }
