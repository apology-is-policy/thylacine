diff --git a/src/gallium/winsys/virgl/thylacine/warp_client.c b/src/gallium/winsys/virgl/thylacine/warp_client.c
index 8d902c2..095919b 100644
--- a/src/gallium/winsys/virgl/thylacine/warp_client.c
+++ b/src/gallium/winsys/virgl/thylacine/warp_client.c
@@ -518,6 +518,88 @@ int warp_ring_destroy(struct warp_conn *w, uint32_t ridx)
    return write_verb(w->root, path, "destroy");
 }
 
+/* ---- Warp-6 V-3b-3c device memory (HOST_VISIBLE VkDeviceMemory) ---- */
+
+int warp_mem_new(struct warp_conn *w, uint32_t handle, uint32_t bytes,
+                 uint64_t mem_id, uint32_t *res_id_out)
+{
+   char path[64];
+   char verb[64];
+   char info[160];
+   long long rid;
+
+   /* Three-valued failure so the caller frees the handle iff the server slot is
+    * provably NOT installed (F2): the server installs the mem slot ONLY on the
+    * Ok path of the mem/new Twrite, so a wedged/ctx-less conn OR a refused Twrite
+    * (the routine E_NOMEM at the holistic ctx cap is exactly this) leaves NO slot
+    * -> return 1 = not-installed, free the handle. A Twrite that SUCCEEDED but
+    * whose info read failed MAY have a live slot -> return -1 = maybe-installed,
+    * keep the handle marked (the bounded-leak posture; converging it with a
+    * destroy is the ring/mem F2 follow-on). 0 = success. */
+   if (w->wedged || w->ctx == 0)
+      return 1;
+
+   /* "<bytes> <handle> <mem_id>" -> ctx/<id>/mem/new. blob_id = mem_id binds
+    * the host allocation; the server parses bytes:u64 handle:u32 mem_id:u64.
+    * bytes is a nonzero page multiple <= WARP_CTX_BACKING_MAX; the caller
+    * rounds up. Minting the first host3d blob (ring or mem) lazily arms the
+    * ctx's venus device-context. */
+   snprintf(path, sizeof(path), "ctx/%u/mem/new", w->ctx);
+   snprintf(verb, sizeof(verb), "%u %u %llu", bytes, handle,
+            (unsigned long long)mem_id);
+   if (write_verb(w->root, path, verb) != 0)
+      return 1; /* refused Twrite -> no slot installed -> free the handle */
+
+   /* res_id (the value the vkAllocateMemory command names in resourceId) reads
+    * back from mem/<handle>/info: "res <id> size <sz>". */
+   snprintf(path, sizeof(path), "ctx/%u/mem/%u/info", w->ctx, handle);
+   if (open_read_snapshot(w->root, path, info, sizeof(info)) <= 0)
+      return -1; /* slot installed but unreadable -> keep the handle marked */
+   rid = parse_field(info, "res");
+   if (rid <= 0)
+      return -1;
+
+   *res_id_out = (uint32_t)rid;
+   return 0;
+}
+
+void *warp_mem_map(struct warp_conn *w, uint32_t handle, long *map_fd_out)
+{
+   char path[64];
+   long fd, va;
+
+   if (w->ctx == 0)
+      return NULL;
+
+   snprintf(path, sizeof(path), "ctx/%u/mem/%u/map", w->ctx, handle);
+   fd = open_at(w->root, path, T_OREAD);
+   if (fd < 0)
+      return NULL;
+   va = t_weft_map(fd, 0); /* RW + coherent regardless of the open mode */
+   if (va < 0) {
+      t_close(fd);
+      return NULL;
+   }
+   *map_fd_out = fd;
+   return (void *)(uintptr_t)va;
+}
+
+void warp_mem_unmap(long map_fd)
+{
+   if (map_fd >= 0)
+      t_close(map_fd); /* the clunk drops the client's MAPPING + pin; the server
+                        * slot is retired by warp_mem_destroy (or ctx death). */
+}
+
+int warp_mem_destroy(struct warp_conn *w, uint32_t handle)
+{
+   char path[64];
+   if (w->wedged || w->ctx == 0)
+      return -1;
+   snprintf(path, sizeof(path), "ctx/%u/mem/%u/ctl", w->ctx, handle);
+   return write_verb(w->root, path, "destroy");
+}
+
 uint64_t warp_venus_submit(struct warp_conn *w, const void *bytes, uint32_t len)
 {
    uint64_t seq;
