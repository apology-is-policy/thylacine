+#define FAIL(...)                                       \
+   do {                                                 \
+      printf("THYLACINE-VK-SDL-PROVE FAIL: " __VA_ARGS__); \
+      printf("\n");                                     \
+      return 1;                                         \
+   } while (0)
+
+int
+main(int argc, char **argv)
+{
+   (void)argc;
+   (void)argv;
+   /* Unbuffered: the guest console is not a TTY; a fault before exit must
+    * not eat the step that died (thylacine_prove.c's argument). */
+   setvbuf(stdout, NULL, _IONBF, 0);
+
+   /* ---- SDL bring-up: window sized to the display ----
+    * The pre-window failures degrade to ABSENT, not FAIL: this probe runs
+    * on every THYLA_BOOT_PROBES boot, including boots with no compositor
+    * or no GPU, and "no display to present to" is the same non-signal as
+    * venus-prove's device-less stub.  The venus gate closes the loophole:
+    * it asserts the PASS line on the venus boot, so a wrongly-ABSENT
+    * there still fails the gate (#212 -- a skip must not report as pass
+    * where the capability is required). */
+   if (SDL_Init(SDL_INIT_VIDEO) != 0) {
+      printf("THYLACINE-VK-SDL-PROVE ABSENT (SDL_Init: %s)\n",
+             SDL_GetError());
+      return 0;
+   }
+
+   SDL_DisplayMode dm;
+   if (SDL_GetDesktopDisplayMode(0, &dm) != 0 || dm.w <= 0 || dm.h <= 0) {
+      printf("THYLACINE-VK-SDL-PROVE ABSENT (no display mode: %s)\n",
+             SDL_GetError());
+      SDL_Quit();
+      return 0;
+   }
+   const uint32_t W = (uint32_t)dm.w, H = (uint32_t)dm.h;
+   if (W > 4096 || H > 4096)
+      FAIL("display %ux%u exceeds the WSI extent cap (4096) -- a "
+           "display-sized DIRECT-bindable swapchain is impossible here",
+           W, H);
+
+   SDL_Window *win =
+      SDL_CreateWindow("thylacine-vk", SDL_WINDOWPOS_UNDEFINED,
+                       SDL_WINDOWPOS_UNDEFINED, (int)W, (int)H,
+                       SDL_WINDOW_VULKAN);
+   if (!win) {
+      printf("THYLACINE-VK-SDL-PROVE ABSENT (SDL_CreateWindow: %s)\n",
+             SDL_GetError());
+      SDL_Quit();
+      return 0;
+   }
+   if (!(SDL_GetWindowFlags(win) & SDL_WINDOW_VULKAN))
+      FAIL("window created without SDL_WINDOW_VULKAN");
+
+   int dw = 0, dh = 0;
+   SDL_Vulkan_GetDrawableSize(win, &dw, &dh);
+   if (dw != (int)W || dh != (int)H)
+      FAIL("drawable size %dx%d != window %ux%u", dw, dh, W, H);
+
+   PFN_vkGetInstanceProcAddr gipa =
+      (PFN_vkGetInstanceProcAddr)SDL_Vulkan_GetVkGetInstanceProcAddr();
+   if (!gipa)
+      FAIL("SDL_Vulkan_GetVkGetInstanceProcAddr: %s", SDL_GetError());
+
+   unsigned ext_count = 0;
+   if (!SDL_Vulkan_GetInstanceExtensions(win, &ext_count, NULL) ||
+       ext_count == 0 || ext_count > 8)
+      FAIL("SDL_Vulkan_GetInstanceExtensions(count) -> %u: %s", ext_count,
+           SDL_GetError());
+   const char *ext_names[8];
+   if (!SDL_Vulkan_GetInstanceExtensions(win, &ext_count, ext_names))
+      FAIL("SDL_Vulkan_GetInstanceExtensions(names): %s", SDL_GetError());
+   bool have_surface = false, have_headless = false;
+   for (unsigned i = 0; i < ext_count; i++) {
+      if (!strcmp(ext_names[i], "VK_KHR_surface"))
+         have_surface = true;
+      if (!strcmp(ext_names[i], "VK_EXT_headless_surface"))
+         have_headless = true;
+   }
+   if (!have_surface || !have_headless)
+      FAIL("instance extension set lacks the surface class "
+           "(surface=%d headless=%d of %u)",
+           (int)have_surface, (int)have_headless, ext_count);
+   printf("vk-sdl-prove: SDL window %ux%u SDL_WINDOW_VULKAN; %u instance "
+          "ext(s) via SDL_Vulkan_GetInstanceExtensions\n", W, H, ext_count);
+
+   /* ---- instance (via the SDL-handed gipa) ---- */
+   PFN_vkCreateInstance create_instance =
+      (PFN_vkCreateInstance)gipa(VK_NULL_HANDLE, "vkCreateInstance");
