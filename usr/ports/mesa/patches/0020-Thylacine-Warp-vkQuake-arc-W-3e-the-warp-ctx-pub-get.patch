+         .sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR,
+         .swapchainCount = 1,
+         .pSwapchains = &sc,
+         .pImageIndices = &idx,
+      };
+      r = vn_QueuePresentKHR(q, &pi);
+      if (r != VK_SUCCESS)
+         FAIL("present round %d rc=%d", round, r);
+      presented++;
+   }
+
+   /* ---- teardown (vk first, SDL last) ---- */
+   vn_DestroyFence(dev, fence, NULL);
+   vn_DestroyCommandPool(dev, pool, NULL);
+   vn_DestroyBuffer(dev, rb_buf, NULL);
+   vn_FreeMemory(dev, rb_mem, NULL);
+   vn_DestroyPipeline(dev, pipe, NULL);
+   vn_DestroyPipelineLayout(dev, layout, NULL);
+   vn_DestroyShaderModule(dev, vs, NULL);
+   vn_DestroyShaderModule(dev, fs, NULL);
+   for (uint32_t i = 0; i < sc_count; i++) {
+      vn_DestroyFramebuffer(dev, fbs[i], NULL);
+      vn_DestroyImageView(dev, views[i], NULL);
+   }
+   vn_DestroyRenderPass(dev, rp, NULL);
+   vn_DestroySwapchainKHR(dev, sc, NULL);
+   wsi_DestroySurfaceKHR(instance, surface, NULL);
+   vn_DestroyDevice(dev, NULL);
+   destroy_instance(instance, NULL);
+   SDL_DestroyWindow(win);
+   SDL_Quit();
+
+   printf("THYLACINE-VK-SDL-PROVE PASS (SDL window %ux%u SDL_WINDOW_VULKAN "
+          "-> SDL_Vulkan glue -> headless surface + display consent armed, "
+          "swapchain of %u presentables, W-1 SPIR-V triangle rendered INTO "
+          "presentable %u + read back (center red corner blue), %u presents "
+          "through vkQueuePresentKHR each poking present-to -- the "
+          "vkQuake-arc W-3e first-Vulkan-frame witness)\n",
+          W, H, sc_count, checked_idx, presented);
+   return 0;
+}
