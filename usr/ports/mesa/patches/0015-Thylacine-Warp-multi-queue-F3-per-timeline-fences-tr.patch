+vn_DestroyBuffer(VkDevice, VkBuffer, const VkAllocationCallbacks *);
+extern VKAPI_ATTR void VKAPI_CALL
+vn_GetBufferMemoryRequirements2(VkDevice,
+                                const VkBufferMemoryRequirementsInfo2 *,
+                                VkMemoryRequirements2 *);
+extern VKAPI_ATTR VkResult VKAPI_CALL
+vn_BindBufferMemory2(VkDevice, uint32_t, const VkBindBufferMemoryInfo *);
+extern VKAPI_ATTR VkResult VKAPI_CALL
+vn_CreateCommandPool(VkDevice, const VkCommandPoolCreateInfo *,
