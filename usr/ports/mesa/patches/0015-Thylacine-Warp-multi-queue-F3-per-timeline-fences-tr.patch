+/* Submit one opaque Venus command stream (raw SUBMIT_CMD/execbuffer bytes) on
+ * `timeline` (0 = the ctx-global lane -> the ctx's submit file; 1..3 = a
+ * VkQueue lane -> submit<t>, so the server fences it on that virtio-gpu
+ * per-context timeline). The server routes a Venus client's stream to the
+ * venus device-ctx; tapestryd never parses the bytes. One write = one atomic
+ * fenced submission; `len` must be <= the seam chunk bound (the opaque stream
+ * cannot be split at a CCMD boundary the way warp_submit splits, so it must
+ * ride one Twrite).
+ *
+ * NON-PARKING (unlike warp_submit's fenced_write): the fence file admits ONE
+ * parked reader (single per-ctx report cursor), and the renderer's one-parker
+ * protocol owns it -- an internal throttle park here would be a second
+ * reader, parked while holding the renderer's transport mutex (the deadlock
+ * corner WARP-MULTIQUEUE-DESIGN E.1 closes). A full throttle or a momentarily
+ * full lane sets *again (returns 0, nothing latched): the caller runs one
+ * parker cycle and retries. A hard failure latches the wedge (a lost command
+ * stream poisons the ring) with *again false. Returns the PER-TIMELINE issue
+ * seq (> 0) or 0 -- completion is `t_signaled[timeline] >= seq`
+ * (warp_timelines_refresh), with the fence file as the park primitive. */
 uint64_t warp_venus_submit(struct warp_conn *w, const void *bytes,
-                           uint32_t len);
+                           uint32_t len, uint32_t timeline, bool *again);
+
+/* Refresh t_signaled[] from the timelines fd (one t_pread). 0 / -1. */
+int warp_timelines_refresh(struct warp_conn *w);
+
+/* ONE blocking park on the fence file -- no refresh, no state mutation.
+ * Built for the multi-queue one-parker protocol: the caller parks WITHOUT
+ * its transport mutex (a park with it held would block every submit) and
+ * does all bookkeeping -- the refreshes, the wedge latch -- after retaking
+ * it. At most ONE thread may be parked at a time (the server's fence file
+ * has a single per-ctx reported cursor; two parked readers would steal each
+ * other's wakes). Only sound with in-flight > 0 on some timeline the caller
+ * is tracking. Returns 0 on a wake, -1 on EOF/error (the caller latches). */
+int warp_fence_park(struct warp_conn *w);
 
 /* Warp-4, the adoption's ctx half: consent to displaying `bo_pub` on
  * tapestry surface `surface_id` ("present-to <surface> <bo>" on the ctx
diff --git a/src/virtio/vulkan/thylacine_prove.c b/src/virtio/vulkan/thylacine_prove.c
index c86561e..a9342a1 100644
