+extern VKAPI_ATTR VkResult VKAPI_CALL
+vn_EnumerateDeviceExtensionProperties(VkPhysicalDevice, const char *,
+                                      uint32_t *, VkExtensionProperties *);
 
 int
 main(void)
@@ -342,14 +389,415 @@ main(void)
 
    vn_UnmapMemory2(device, &umi);
    free_mem(device, memory, NULL);
+
+   /* Step 4 (multi-queue chunk, F4 witness): VK_EXT_map_memory_placed must
+    * NOT be advertised -- the backend cannot honor a caller-chosen VA (the
+    * weft map picks it), so it sets cannot_map_placed and the extension is
+    * suppressed. An advertised-but-discarded placed map was the V-3b-3c-2b
+    * F4 silent corruption; this pins the de-advertisement. */
+   {
+      uint32_t ext_count = 0;
+      r = vn_EnumerateDeviceExtensionProperties(pds[0], NULL, &ext_count, NULL);
+      if (r != VK_SUCCESS) {
+         printf("THYLACINE-VENUS-PROVE FAIL: EnumerateDeviceExtensionProperties "
+                "rc=%d\n", r);
+         destroy_device(device, NULL);
+         destroy_instance(instance, NULL);
+         return 1;
+      }
+      static VkExtensionProperties exts[256];
+      if (ext_count > 256) {
+         /* A partial scan could MISS the extension and false-pass; say so
+          * loudly instead of pretending the negative was checked (#184). */
+         printf("venus-prove: ext list %u wide (> 256); placed-map check "
+                "SKIPPED\n", ext_count);
+      } else {
+         uint32_t n = ext_count;
+         r = vn_EnumerateDeviceExtensionProperties(pds[0], NULL, &n, exts);
+         if (r != VK_SUCCESS && r != VK_INCOMPLETE) {
+            printf("THYLACINE-VENUS-PROVE FAIL: ext list rc=%d\n", r);
+            destroy_device(device, NULL);
+            destroy_instance(instance, NULL);
+            return 1;
+         }
+         for (uint32_t i = 0; i < n; i++) {
+            if (!strcmp(exts[i].extensionName, "VK_EXT_map_memory_placed")) {
+               printf("THYLACINE-VENUS-PROVE FAIL: VK_EXT_map_memory_placed "
+                      "is advertised but the backend cannot place (F4)\n");
+               destroy_device(device, NULL);
+               destroy_instance(instance, NULL);
+               return 1;
+            }
+         }
+         printf("venus-prove: placed-map de-advertised OK (%u device exts)\n",
+                n);
+      }
+   }
+
+   /* Step 5 (multi-queue chunk, the F1 fix-proof): allocate two HOST_VISIBLE
+    * memories, bind buffers, CPU-write a pattern into src, vkCmdCopyBuffer
+    * src->dst on the queue, vkWaitForFences, then FIRST-map dst and require
+    * the pattern. Under the pre-F1 lazy mint (bo created at first map) the
+    * mint's zeroing would destroy the GPU-written bytes -- reify-at-alloc
+    * (bo_must_init_at_alloc) is what makes this pass. This is the witness
+    * the allocate+map E2E structurally could not provide. */
+   {
+      const VkDeviceSize psize = 4096;
+      const VkBufferCreateInfo src_bci = {
+         .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+         .size = psize,
+         .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+         .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      };
+      const VkBufferCreateInfo dst_bci = {
+         .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+         .size = psize,
+         .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+         .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      };
+      VkBuffer src_buf = VK_NULL_HANDLE, dst_buf = VK_NULL_HANDLE;
+      if (vn_CreateBuffer(device, &src_bci, NULL, &src_buf) != VK_SUCCESS ||
+          vn_CreateBuffer(device, &dst_bci, NULL, &dst_buf) != VK_SUCCESS) {
+         printf("THYLACINE-VENUS-PROVE FAIL: vkCreateBuffer\n");
+         destroy_device(device, NULL);
+         destroy_instance(instance, NULL);
+         return 1;
+      }
+
+      const VkBufferMemoryRequirementsInfo2 bmri = {
+         .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_REQUIREMENTS_INFO_2,
+         .buffer = src_buf,
+      };
+      VkMemoryRequirements2 req2 = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+      };
+      vn_GetBufferMemoryRequirements2(device, &bmri, &req2);
+      const VkMemoryRequirements req = req2.memoryRequirements;
+      /* Need a type that is both buffer-compatible and HOST_VISIBLE (mt is
+       * HOST_VISIBLE from step 3; require the bits agree). */
+      int cmt = -1;
+      for (uint32_t i = 0; i < mem.memoryTypeCount; i++) {
+         if (!(req.memoryTypeBits & (1u << i)))
+            continue;
+         const VkMemoryPropertyFlags pf = mem.memoryTypes[i].propertyFlags;
+         if ((pf & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) &&
+             (pf & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) {
+            cmt = (int)i;
+            break;
+         }
+      }
+      if (cmt < 0) {
+         printf("THYLACINE-VENUS-PROVE ABSENT (no HOST_VISIBLE|COHERENT type "
+                "backs a transfer buffer -- copy proof not exercisable)\n");
+         vn_DestroyBuffer(device, src_buf, NULL);
+         vn_DestroyBuffer(device, dst_buf, NULL);
+         destroy_device(device, NULL);
+         destroy_instance(instance, NULL);
+         return 0;
+      }
+      const VkDeviceSize asize = req.size > psize ? req.size : psize;
+      const VkMemoryAllocateInfo cp_mai = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+         .allocationSize = asize,
+         .memoryTypeIndex = (uint32_t)cmt,
+      };
