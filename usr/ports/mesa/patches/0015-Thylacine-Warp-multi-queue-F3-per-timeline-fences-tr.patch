@@ -66,6 +66,53 @@ extern VKAPI_ATTR VkResult VKAPI_CALL
 vn_UnmapMemory2(VkDevice, const VkMemoryUnmapInfo *);
 extern VKAPI_ATTR void VKAPI_CALL
 vn_FreeMemory(VkDevice, VkDeviceMemory, const VkAllocationCallbacks *);
+/* The GPU round-trip proof (multi-queue chunk) -- all device-level, so all
+ * direct symbols (the same trampoline-layout reason as above). */
+/* Venus defines the `2` forms only (the link is the census -- the flat
+ * GetBufferMemoryRequirements / BindBufferMemory are not symbols in
+ * libvulkan_virtio.a), and the queue getter is not venus code at all: it is
+ * the common runtime's vk_common_GetDeviceQueue2 (nm: the only defined
+ * queue-getter T symbol), which walks the vk_device's queue list directly. */
+extern VKAPI_ATTR void VKAPI_CALL
+vk_common_GetDeviceQueue2(VkDevice, const VkDeviceQueueInfo2 *, VkQueue *);
