@@ -44,16 +53,33 @@
 #include <stdbool.h>
 #include <stdint.h>
 
+/* Venus fence timelines (multi-queue F3; mirrors the server's
+ * WARP_TIMELINES): 0 = the ctx-global lane (every fenced op counts there),
+ * 1..3 = VkQueue lanes. A queue timeline is a pure fence lane -- it has NO
+ * host3d ring behind it (WARP-MULTIQUEUE-DESIGN section E.1); do not confuse
+ * this index with a ring slot (ridx). */
+#define WARP_TIMELINES 4u
+
 struct warp_conn {
    long root;         /* the /srv/warp connection (open = connect) */
    long ctx_ctl_fd;   /* kept open; fence-signaled polls are one t_pread */
    long submit_fd;
    long fence_fd;
+   long timelines_fd; /* kept open; per-timeline polls are one t_pread */
+   /* per-timeline submit fds (submit<t>), opened lazily on the first
+    * submit to that timeline; [0] unused (timeline 0 = submit_fd). */
+   long submit_t_fd[WARP_TIMELINES];
    uint32_t ctx;      /* the minted context's public id */
    uint32_t bo_cap;   /* ctl `bo-cap`: per-ctx BO capacity (discovery) */
    uint32_t max_inflight; /* ctl `fence-lane`: the throttle depth (#204) */
    uint64_t issued;   /* fenced ops issued (submits + transfers) */
    uint64_t signaled; /* last read of ctl `fence-signaled` */
+   /* The per-timeline ledger (multi-queue F3): venus submits issued on each
+    * timeline / last read of ctx/<id>/timelines. The ctx-wide pair above
+    * stays the throttle's ledger (every fenced op, transfers included);
+    * these refine venus completion per queue lane. */
+   uint64_t t_issued[WARP_TIMELINES];
+   uint64_t t_signaled[WARP_TIMELINES];
    bool wedged;       /* latched on transport failure / poison EOF */
    bool ledger_warned; /* one-shot: the #210 conservation clamp fired */
    bool build_diag_said; /* one-shot: first refused BO create named */
@@ -205,17 +231,40 @@ void warp_mem_unmap(long map_fd);
  * handle marked; a stale server slot is bounded by ctx death). */
 int warp_mem_destroy(struct warp_conn *w, uint32_t handle);
 
-/* Submit one opaque Venus command stream (raw SUBMIT_CMD/execbuffer bytes) to
- * the ctx's submit file. With a host3d ring armed the server routes this to
- * warp_venus_submit on the venus device-ctx; tapestryd never parses the
- * bytes. One write = one atomic fenced submission (completion observed on
