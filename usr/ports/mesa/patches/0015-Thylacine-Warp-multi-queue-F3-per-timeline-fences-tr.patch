+extern VKAPI_ATTR VkResult VKAPI_CALL
+vn_EndCommandBuffer(VkCommandBuffer);
+extern VKAPI_ATTR VkResult VKAPI_CALL
+vn_CreateFence(VkDevice, const VkFenceCreateInfo *,
+               const VkAllocationCallbacks *, VkFence *);
+extern VKAPI_ATTR void VKAPI_CALL
+vn_DestroyFence(VkDevice, VkFence, const VkAllocationCallbacks *);
+extern VKAPI_ATTR VkResult VKAPI_CALL
+vn_QueueSubmit(VkQueue, uint32_t, const VkSubmitInfo *, VkFence);
+extern VKAPI_ATTR VkResult VKAPI_CALL
