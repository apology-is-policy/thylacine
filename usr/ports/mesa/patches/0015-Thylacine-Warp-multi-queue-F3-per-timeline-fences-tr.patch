@@ -620,11 +620,14 @@ int warp_mem_destroy(struct warp_conn *w, uint32_t handle)
    return write_verb(w->root, path, "destroy");
 }
 
-uint64_t warp_venus_submit(struct warp_conn *w, const void *bytes, uint32_t len)
+uint64_t warp_venus_submit(struct warp_conn *w, const void *bytes, uint32_t len,
+                           uint32_t timeline, bool *again)
 {
-   uint64_t seq;
+   long fd;
+   long n;
 
-   if (w->wedged)
+   *again = false;
+   if (w->wedged || timeline >= WARP_TIMELINES)
       return 0;
 
    /* One Twrite = one atomic submission. Past the chunk bound the kernel 9P
@@ -644,13 +647,70 @@ uint64_t warp_venus_submit(struct warp_conn *w, const void *bytes, uint32_t len)
       return 0;
    }
 
-   seq = fenced_write(w, w->submit_fd, bytes, len);
-   if (seq == 0 && !w->wedged) {
-      fprintf(stderr, "warp: venus submit failed -- a dropped command "
-                      "stream poisons the ring; latching\n");
-      w->wedged = true;
+   /* The timeline rides the FILE (submit<t>), not the payload: the stream is
+    * opaque bytes (an in-band index would change the byte format) and a
+    * Twrite offset cannot carry it (t_write's implicit offset arrives
+    * nonzero). Lazy-open: most apps drive one queue, so the other lanes'
+    * fids are never spent. */
+   fd = w->submit_fd;
+   if (timeline > 0) {
+      if (w->submit_t_fd[timeline] < 0) {
+         char path[64];
+         snprintf(path, sizeof(path), "ctx/%u/submit%u", w->ctx, timeline);
+         w->submit_t_fd[timeline] = open_at(w->root, path, T_OWRITE);
+         if (w->submit_t_fd[timeline] < 0)
+            return 0; /* server refuses the lane; not a wedge -- no stream lost */
+      }
+      fd = w->submit_t_fd[timeline];
    }
-   return seq;
+
+   /* The throttle check rides the CACHED ledger: a stale-high in-flight only
+    * produces a spurious *again, and the caller's parker cycle is itself the
+    * refresh, so it converges. */
+   if (inflight_depth(w) >= w->max_inflight) {
+      *again = true;
+      return 0;
+   }
+   n = t_write(fd, bytes, len);
+   if (n == (long)len) {
+      ++w->issued; /* the ctx-wide throttle ledger */
+      return ++w->t_issued[timeline];
+   }
+   if (n == -EAGAIN) {
+      /* Lane momentarily full (another client's chains, or our own share
+       * raced): retryable, nothing was consumed. */
+      *again = true;
+      return 0;
+   }
+   fprintf(stderr, "warp: venus submit failed -- a dropped command "
+                   "stream poisons the ring; latching\n");
+   w->wedged = true;
+   return 0;
+}
+
+int warp_timelines_refresh(struct warp_conn *w)
+{
+   char buf[256];
+   char key[24];
+   uint32_t t;
+   if (w->timelines_fd < 0 || read_snapshot(w->timelines_fd, buf, sizeof(buf)) < 0)
+      return -1;
+   for (t = 0; t < WARP_TIMELINES; t++) {
+      long long v;
+      snprintf(key, sizeof(key), "timeline %u", t);
+      v = parse_field(buf, key);
+      if (v < 0)
+         return -1;
+      w->t_signaled[t] = (uint64_t)v;
+   }
+   return 0;
+}
+
+int warp_fence_park(struct warp_conn *w)
+{
+   char rec[64];
+   long n = t_read(w->fence_fd, rec, sizeof(rec));
+   return (n <= 0) ? -1 : 0;
 }
 
 static long read_caps_path(struct warp_conn *w, const char *path, void *buf,
@@ -695,6 +755,9 @@ int warp_open(struct warp_conn *w)
 
    memset(w, 0, sizeof(*w));
    w->root = w->ctx_ctl_fd = w->submit_fd = w->fence_fd = -1;
+   w->timelines_fd = -1;
+   for (unsigned t = 0; t < WARP_TIMELINES; t++)
+      w->submit_t_fd[t] = -1;
 
    w->root = t_open(T_WALK_OPEN_FROM_ROOT, "/srv/warp", 9, T_OREAD);
    if (w->root < 0)
@@ -733,7 +796,13 @@ int warp_open(struct warp_conn *w)
    w->submit_fd = open_at(w->root, path, T_OWRITE);
    snprintf(path, sizeof(path), "ctx/%u/fence", w->ctx);
    w->fence_fd = open_at(w->root, path, T_OREAD);
-   if (w->ctx_ctl_fd < 0 || w->submit_fd < 0 || w->fence_fd < 0)
+   /* Eager like the other hot fds: server + client ship paired in one ramfs
+    * (no skew support), so an absent timelines file is a broken server, not
+    * a version to accommodate. */
+   snprintf(path, sizeof(path), "ctx/%u/timelines", w->ctx);
+   w->timelines_fd = open_at(w->root, path, T_OREAD);
+   if (w->ctx_ctl_fd < 0 || w->submit_fd < 0 || w->fence_fd < 0 ||
+       w->timelines_fd < 0)
       goto fail;
 
    /* The promoted counter is load-bearing (the whole fence model rides
@@ -758,10 +827,18 @@ void warp_close(struct warp_conn *w)
       t_close(w->fence_fd);
    if (w->submit_fd >= 0)
       t_close(w->submit_fd);
+   for (unsigned t = 0; t < WARP_TIMELINES; t++) {
+      if (w->submit_t_fd[t] >= 0)
+         t_close(w->submit_t_fd[t]);
+      w->submit_t_fd[t] = -1;
+   }
+   if (w->timelines_fd >= 0)
+      t_close(w->timelines_fd);
    if (w->ctx_ctl_fd >= 0)
       t_close(w->ctx_ctl_fd);
    if (w->root >= 0)
       t_close(w->root);
    w->root = w->ctx_ctl_fd = w->submit_fd = w->fence_fd = -1;
+   w->timelines_fd = -1;
    w->ctx = 0;
 }
