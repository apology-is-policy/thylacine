+static int
+lane_submit(struct copy_lane *ln, const VkPhysicalDeviceMemoryProperties *mp)
+{
+   const VkDeviceSize sz = 4096;
+   if (mk_copybuf(ln->dev, mp, sz, VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+                  &ln->src, &ln->src_mem) != 0 ||
