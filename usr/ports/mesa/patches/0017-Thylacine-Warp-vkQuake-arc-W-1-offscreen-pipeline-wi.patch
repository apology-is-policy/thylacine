+   const VkCommandPoolCreateInfo cpci = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = 0,
+   };
+   if (vn_CreateCommandPool(ln->dev, &cpci, NULL, &ln->pool) != VK_SUCCESS)
+      return -1;
