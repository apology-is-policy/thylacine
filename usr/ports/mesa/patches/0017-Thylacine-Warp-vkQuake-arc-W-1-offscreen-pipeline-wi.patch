diff --git a/src/gallium/winsys/virgl/thylacine/warp_client.c b/src/gallium/winsys/virgl/thylacine/warp_client.c
index 7b4d60a..857bb8e 100644
--- a/src/gallium/winsys/virgl/thylacine/warp_client.c
+++ b/src/gallium/winsys/virgl/thylacine/warp_client.c
@@ -520,6 +520,53 @@ int warp_ring_destroy(struct warp_conn *w, uint32_t ridx)
 
 /* ---- Warp-6 V-3b-3c device memory (HOST_VISIBLE VkDeviceMemory) ---- */
 
+/* The F9 convergence (vkQuake-arc W-1): on a MAYBE-installed mint failure,
+ * resolve the ambiguity with a best-effort destroy instead of leaking the
+ * handle. Returns 1 (free) iff the server CONFIRMED the teardown (a full
+ * "destroy" write -- the server's success Rwrite always carries the full
+ * count, and wmem_destroy is the only reachable verb) OR asserted absence.
+ *
+ * The two -ENOENT legs are NOT equally exact, and only the write leg matters
+ * for correctness. The WRITE-leg -ENOENT is exact: dev9p_write propagates the
+ * raw Rlerror ecode, so it is genuinely wmem_destroy's owner-scan miss. The
+ * OPEN-leg -ENOENT is BEST-EFFORT: the kernel's Dev.walk vtable has no errno
+ * channel, so dev9p_walk collapses EVERY walk failure (a server Rlerror of any
+ * ecode, a dead transport, a kernel OOM) to NULL, which stalk reports as
+ * T_E_NOENT. So a mint that installed the slot, then failed its info read for
+ * an environmental reason (server fid-table full, transport pressure), can see
+ * reclaim's open fail for the SAME reason and manufacture a -ENOENT -> free a
+ * bit whose slot IS installed. That residue is BOUNDED and self-healing, not a
+ * leak-to-wedge: the freed bit is the lowest free index, so the next
+ * vkAllocateMemory re-hands it, the mint hits `taken` FIRST (the F8 order) ->
+ * E_INVAL -> rc=-1 -> the bit re-marks, costing exactly one spurious
+ * VK_ERROR_OUT_OF_DEVICE_MEMORY. The DESTRUCTIVE direction stays closed
+ * regardless (below).
+ *
+ * NEVER call this on the duplicate -EINVAL arm: there the slot is LIVE and
+ * belongs to an earlier successful mint, and this destroy would tear down real
+ * memory under it (the ring-F1 wedge's data-loss twin). The reclaim sites
+ * (info-read-fail / malformed-info / non-ENOMEM-non-EINVAL write failure) can
+ * only ever name the just-minted orphan's own handle -- a live earlier mint at
+ * the same handle would have failed THIS mint with E_INVAL before reaching
+ * here -- so a confirmed teardown tears down only the failed allocation's own
+ * slot. */
+static int warp_mem_reclaim(struct warp_conn *w, uint32_t handle)
+{
+   char path[64];
+   static const char verb[] = "destroy";
+   long fd, n;
+
+   snprintf(path, sizeof(path), "ctx/%u/mem/%u/ctl", w->ctx, handle);
+   fd = open_at(w->root, path, T_OWRITE);
+   if (fd < 0)
+      return (fd == -ENOENT) ? 1 : -1; /* best-effort: see the open-leg note */
+   n = t_write(fd, verb, sizeof(verb) - 1);
+   t_close(fd);
+   if (n == (long)(sizeof(verb) - 1) || n == -ENOENT)
+      return 1;
+   return -1;
+}
+
 int warp_mem_new(struct warp_conn *w, uint32_t handle, uint32_t bytes,
                  uint64_t mem_id, uint32_t *res_id_out)
 {
@@ -533,17 +580,22 @@ int warp_mem_new(struct warp_conn *w, uint32_t handle, uint32_t bytes,
     * Ok path of the mem/new Twrite. The decision turns on WHICH failure it was
     * (V-3b-3c-2b F5/F6 -- the round-1 "refused Twrite -> free" was too coarse):
     *   rc=1  (free)  = provably not installed: a wedged/ctx-less conn, an open
-    *                   failure (the Twrite never reached the server), or the
+    *                   failure (the Twrite never reached the server), the
     *                   routine -ENOMEM holistic-cap refusal (Rlerror = nothing
-    *                   installed; keeping F2's "cap loop must not burn slots").
-    *   rc=-1 (keep)  = MAYBE installed: a duplicate handle -EINVAL (the slot IS
-    *                   installed -- e.g. a concurrent-alloc race loser, F6), an
-    *                   -EINTR whose Twrite may have committed before the ack
-    *                   (F5), an info-read failure, any unrecognized errno. NEVER
-    *                   free a handle whose server slot may be live (re-handing it
-    *                   collides with the still-installed slot, the ring-F1 wedge).
+    *                   installed; keeping F2's "cap loop must not burn slots"),
+    *                   OR a maybe-installed failure RESOLVED by warp_mem_reclaim
+    *                   (the F9 convergence: server asserted absence or confirmed
+    *                   the teardown -- covers E_IO device faults under global
+    *                   hostmem pressure, -EINTR maybe-commits, info-read fails).
+    *   rc=-1 (keep)  = the residue: the duplicate handle -EINVAL (the slot IS
+    *                   installed and LIVE -- a reclaim there would destroy an
+    *                   earlier mint's real memory, so it is never attempted;
+    *                   the transport mutex makes this arm defense-in-depth
+    *                   only, F6/F8), or a reclaim whose own transport failed
+    *                   (bounded leak, ctx-death reaped).
     *   rc=0          = success.
-    * Converging the rc<0 arm with a destroy is the ring/mem F2 follow-on. This
+    * The ring twin (warp_ring_create_host3d) is NOT converged -- its failures
+    * are device faults, its leak stays documented-bounded (tracked). This
     * relies on dev9p propagating the real Rlerror ecode (t_write returns the
     * negative errno, never a collapsed -1). */
    if (w->wedged || w->ctx == 0)
@@ -566,18 +618,23 @@ int warp_mem_new(struct warp_conn *w, uint32_t handle, uint32_t bytes,
       size_t vlen = strlen(verb);
       long n = t_write(fd, verb, vlen);
       t_close(fd);
-      if (n != (long)vlen)
-         return (n == -ENOMEM) ? 1 : -1;
+      if (n != (long)vlen) {
+         if (n == -ENOMEM)
+            return 1;  /* holistic-cap refusal: provably nothing installed */
+         if (n == -EINVAL)
+            return -1; /* duplicate: the slot is LIVE -- never reclaim */
+         return warp_mem_reclaim(w, handle); /* F9: resolve maybe-installed */
+      }
    }
 
    /* res_id (the value the vkAllocateMemory command names in resourceId) reads
     * back from mem/<handle>/info: "res <id> size <sz>". */
    snprintf(path, sizeof(path), "ctx/%u/mem/%u/info", w->ctx, handle);
    if (open_read_snapshot(w->root, path, info, sizeof(info)) <= 0)
-      return -1; /* slot installed but unreadable -> keep the handle marked */
+      return warp_mem_reclaim(w, handle); /* installed but unreadable */
    rid = parse_field(info, "res");
    if (rid <= 0)
-      return -1;
+      return warp_mem_reclaim(w, handle); /* installed but info malformed */
 
    *res_id_out = (uint32_t)rid;
    return 0;
