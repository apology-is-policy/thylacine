+   const VkMemoryMapInfo mmi = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_MAP_INFO,
+      .memory = ln->src_mem,
+      .offset = 0,
+      .size = sz,
+   };
+   void *p = NULL;
+   if (vn_MapMemory2(ln->dev, &mmi, &p) != VK_SUCCESS || !p)
+      return -1;
