+/* One timeline lane of the F3 interleave witness: a 4 KiB fenced pattern
+ * copy on `queue`, submitted by lane_submit and waited + verified + torn
+ * down by lane_finish. Two lanes on two logical devices ride two fence
+ * timelines; waiting them in reverse submit order is what discriminates a
+ * misrouted per-timeline retirement (the stranded lane's fence times out). */
+struct copy_lane {
+   VkDevice dev;
+   VkQueue queue;
+   uint32_t base; /* pattern word i = base | i */
+   VkBuffer src, dst;
+   VkDeviceMemory src_mem, dst_mem;
+   VkCommandPool pool;
+   VkFence fence;
+};
