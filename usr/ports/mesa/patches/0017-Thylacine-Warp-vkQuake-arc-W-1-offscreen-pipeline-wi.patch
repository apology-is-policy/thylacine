+      .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+   };
+   if (vn_CreateFence(ln->dev, &fci, NULL, &ln->fence) != VK_SUCCESS)
+      return -1;
+   const VkSubmitInfo si = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cmd,
+   };
+   return vn_QueueSubmit(ln->queue, 1, &si, ln->fence) == VK_SUCCESS ? 0 : -1;
+}
+
+static int
+lane_finish(struct copy_lane *ln)
+{
+   const VkDeviceSize sz = 4096;
+   if (vn_WaitForFences(ln->dev, 1, &ln->fence, VK_TRUE,
+                        10ull * 1000 * 1000 * 1000) != VK_SUCCESS)
+      return -1;
+   const VkMemoryMapInfo mmi = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_MAP_INFO,
+      .memory = ln->dst_mem,
+      .offset = 0,
+      .size = sz,
+   };
+   void *p = NULL;
+   if (vn_MapMemory2(ln->dev, &mmi, &p) != VK_SUCCESS || !p)
+      return -1;
+   int ok = 0;
+   for (uint32_t i = 0; i < sz / 4; i++)
+      if (((volatile uint32_t *)p)[i] != (ln->base | i)) {
+         ok = -1;
+         break;
+      }
+   const VkMemoryUnmapInfo umi = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_UNMAP_INFO,
+      .memory = ln->dst_mem,
+   };
+   vn_UnmapMemory2(ln->dev, &umi);
+   vn_DestroyFence(ln->dev, ln->fence, NULL);
+   vn_DestroyCommandPool(ln->dev, ln->pool, NULL);
+   vn_DestroyBuffer(ln->dev, ln->src, NULL);
+   vn_DestroyBuffer(ln->dev, ln->dst, NULL);
+   vn_FreeMemory(ln->dev, ln->src_mem, NULL);
+   vn_FreeMemory(ln->dev, ln->dst_mem, NULL);
+   return ok;
