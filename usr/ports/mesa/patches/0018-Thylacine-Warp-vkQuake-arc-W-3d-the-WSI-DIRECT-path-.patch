+                            struct vn_device_memory *mem);
+
+#ifdef __thylacine__
+/* Thylacine WSI (W-3d): the no-eager-mint marker.  Chained at the HEAD of a
+ * swapchain-image allocation's pNext by vn_wsi_thylacine.c's create_mem and
+ * stripped by vn_device_memory_alloc before anything is encoded -- it never
+ * reaches the wire.  A marked allocation routes to alloc_simple: venus-side
