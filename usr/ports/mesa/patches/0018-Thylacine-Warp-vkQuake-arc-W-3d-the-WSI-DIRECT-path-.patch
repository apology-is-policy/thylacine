@@ -248,6 +248,39 @@ void warp_mem_unmap(long map_fd);
  * handle marked; a stale server slot is bounded by ctx death). */
 int warp_mem_destroy(struct warp_conn *w, uint32_t handle);
 
+/* Register a venus device memory as a compositor PRESENTABLE (W-3d, the
+ * WSI-DESIGN 4.1 declaration): "<handle> <w> <h> <format> <stride> <mem_id>"
+ * -> ctx/<id>/img/new, then read the accepted shape back from
+ * img/<handle>/info ("res <id> w .. bound .. mem .."). The server validates
+ * the DECLARED shape against its structural limits and mints the never-mapped
+ * HOST3D blob bound to mem_id -- consuming that memory's ONE vkr blob export,
+ * which is why the caller's allocation path must not have minted a mem blob
+ * for it (the no-eager-mint marker; a consumed export makes this refuse).
+ * `format` is the virtio-gpu format code (BGRA8=1 / BGRX8=2 -- the stage-0
+ * accept set); `stride` covers a row at 4 B/px.
+ *
+ * Same three-valued contract as warp_mem_new, with one caveat this family
+ * adds: the server's img/new returns E_INVAL for BOTH a duplicate handle
+ * (slot LIVE -- must keep) and a validation refusal (nothing installed --
+ * could free), indistinguishable at the client. The caller keeps its inputs
+ * client-valid (dims/stride from a successfully created LINEAR image, handles
+ * from its own bitmap under its own lock), so the validation arm is
+ * unreachable and E_INVAL is treated as the duplicate: -1 (keep). E_IO --
+ * which includes the server's clean create_presentable refusal, where the
+ * ONE-EXPORT violation lands (nothing installed: the img record inserts only
+ * after the blob mint succeeds) -- is indistinguishable from a transport EIO
+ * after a commit, so it and every other maybe-committed failure resolve via
+ * the img/<h>/ctl destroy reclaim, exactly as the mem family (F9). */
+int warp_img_new(struct warp_conn *w, uint32_t handle, uint32_t width,
+                 uint32_t height, uint32_t format, uint32_t stride,
+                 uint64_t mem_id, uint32_t *res_id_out);
+
+/* Retire a presentable server-side ("destroy" -> img/<handle>/ctl; the
+ * display-safe teardown -- unbind + consent-clear before unref -- rides the
+ * server's wimg_destroy). Returns 0 on success (free the handle), -1 on
+ * refusal (keep it marked; bounded by ctx death). */
+int warp_img_destroy(struct warp_conn *w, uint32_t handle);
+
 /* Submit one opaque Venus command stream (raw SUBMIT_CMD/execbuffer bytes) on
  * `timeline` (0 = the ctx-global lane -> the ctx's submit file; 1..3 = a
  * VkQueue lane -> submit<t>, so the server fences it on that virtio-gpu
@@ -291,6 +324,15 @@ int warp_fence_park(struct warp_conn *w);
  * resize reallocation mints a new BO). Returns 0 / -1. */
 int warp_present_to(struct warp_conn *w, uint32_t surface_id, uint32_t bo_pub);
 
+/* The img-family present consent (W-3c-2's generalized verb): "present-to
+ * <surface> img <handle>" names a PRESENTABLE by its handle (the server
+ * resolves handle -> pub id at the verb, so a freed handle's later tenant
+ * can never inherit the consent). Same standing-consent semantics as
+ * warp_present_to: re-issue when the FRONT buffer changes (every present in
+ * a rotating swapchain), not per frame of the same buffer. 0 / -1. */
+int warp_present_to_img(struct warp_conn *w, uint32_t surface_id,
+                        uint32_t img_handle);
+
 /* Withdraw the consent ("present-to off"). Best-effort; 0 / -1. */
 int warp_present_off(struct warp_conn *w);
 
