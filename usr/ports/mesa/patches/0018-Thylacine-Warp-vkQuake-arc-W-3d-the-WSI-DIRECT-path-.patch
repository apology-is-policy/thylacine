    return write_verb(w->root, path, "destroy");
 }
 
+/* The img-family reclaim twin of warp_mem_reclaim: resolve a maybe-installed
+ * img/new failure by a best-effort img/<h>/ctl destroy. Same open-leg caveat
+ * (dev9p_walk collapses walk failures to -ENOENT, so the -ENOENT arm is
+ * exact on the write leg, best-effort on the open leg -- the residue is a
+ * self-healing spurious registration failure, never a live-slot free). */
+static int warp_img_reclaim(struct warp_conn *w, uint32_t handle)
+{
+   char path[64];
+   static const char verb[] = "destroy";
+   long fd, n;
+
+   snprintf(path, sizeof(path), "ctx/%u/img/%u/ctl", w->ctx, handle);
+   fd = open_at(w->root, path, T_OWRITE);
+   if (fd < 0)
+      return (fd == -ENOENT) ? 1 : -1;
+   n = t_write(fd, verb, sizeof(verb) - 1);
+   t_close(fd);
+   if (n == (long)(sizeof(verb) - 1) || n == -ENOENT)
+      return 1;
+   return -1;
+}
+
+int warp_img_new(struct warp_conn *w, uint32_t handle, uint32_t width,
+                 uint32_t height, uint32_t format, uint32_t stride,
+                 uint64_t mem_id, uint32_t *res_id_out)
+{
+   char path[64];
+   char verb[96];
+   char info[192];
+   long long rid;
+
+   /* The mem-family three-valued contract, transplanted (see the header for
+    * the one img-specific caveat: E_INVAL covers duplicate AND validation,
+    * so the caller must keep its inputs client-valid and E_INVAL is treated
+    * as the duplicate -- keep). */
+   if (w->wedged || w->ctx == 0)
+      return 1;
+
+   snprintf(path, sizeof(path), "ctx/%u/img/new", w->ctx);
+   snprintf(verb, sizeof(verb), "%u %u %u %u %u %llu", handle, width, height,
+            format, stride, (unsigned long long)mem_id);
+   {
+      long fd = open_at(w->root, path, T_OWRITE);
+      if (fd < 0)
+         return 1; /* never reached the server -> nothing installed -> free */
+      size_t vlen = strlen(verb);
+      long n = t_write(fd, verb, vlen);
+      t_close(fd);
+      if (n != (long)vlen) {
+         if (n == -ENOMEM)
+            return 1;  /* backing-cap refusal: provably nothing installed
+                        * (the server checks taken BEFORE over, F8) */
+         if (n == -EINVAL)
+            return -1; /* duplicate (or a validation refusal the caller's
+                        * client-valid inputs make unreachable): keep */
+         /* -EIO includes the server's clean create_presentable refusal
+          * (the one-export refusal lands there; nothing installed) -- but
+          * the client cannot distinguish it from a transport EIO after a
+          * commit, so it resolves via the reclaim like every other
+          * maybe-installed failure (the mem family's F9 shape). */
+         return warp_img_reclaim(w, handle);
+      }
+   }
+
+   snprintf(path, sizeof(path), "ctx/%u/img/%u/info", w->ctx, handle);
+   if (open_read_snapshot(w->root, path, info, sizeof(info)) <= 0)
+      return warp_img_reclaim(w, handle); /* installed but unreadable */
+   rid = parse_field(info, "res");
+   if (rid <= 0)
+      return warp_img_reclaim(w, handle); /* installed but info malformed */
+
+   *res_id_out = (uint32_t)rid;
+   return 0;
+}
+
+int warp_img_destroy(struct warp_conn *w, uint32_t handle)
+{
+   char path[64];
+   if (w->wedged || w->ctx == 0)
+      return -1;
+   snprintf(path, sizeof(path), "ctx/%u/img/%u/ctl", w->ctx, handle);
+   return write_verb(w->root, path, "destroy");
+}
+
 uint64_t warp_venus_submit(struct warp_conn *w, const void *bytes, uint32_t len,
                            uint32_t timeline, bool *again)
 {
