+{
+   if (handle < THY_IMG_SLOTS)
+      tly->img_bitmap &= (uint16_t)~(1u << handle);
+}
+
 /* ---- shmem: the coherent HOST3D ring the Venus driver lays its ring in ---- */
 
 /* Caller holds tly->mutex (audit F1): this mutates ring_bitmap (an unguarded
@@ -454,6 +488,9 @@ thylacine_bo_create_from_device_memory(
    };
 
    *out_bo = &bo->base;
+   /* The W-3d no-eager-mint witness: every device-memory bo mint counts, so
+    * the prove can assert a swapchain creation minted NONE. */
+   vn_thylacine_bo_create_count++;
    result = VK_SUCCESS;
 
 out:
@@ -461,6 +498,92 @@ out:
    return result;
 }
 
+/* ---- presentables (W-3d): the WSI registration surface ---- */
+
+uint64_t vn_thylacine_bo_create_count;
+
+/* The tapestry surface consent target, +1-encoded (0 = unset; tapestry
+ * surface slots start at 0).  Written by the window glue's set_surface,
+ * read under the transport mutex at present time. */
+static uint32_t thylacine_present_surface_plus1;
+
+void
+vn_renderer_thylacine_set_surface(uint32_t surface_id)
+{
+   p_atomic_set(&thylacine_present_surface_plus1, surface_id + 1);
+}
+
+VkResult
+vn_renderer_thylacine_img_new(struct vn_renderer *renderer,
+                              uint64_t mem_id,
+                              uint32_t width,
+                              uint32_t height,
+                              uint32_t virtio_format,
+                              uint32_t stride,
+                              uint32_t *img_handle_out)
+{
+   struct thylacine *tly = (struct thylacine *)renderer;
+   VkResult result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   mtx_lock(&tly->mutex);
+   int handle = thylacine_img_alloc(tly);
+   if (handle >= 0) {
+      uint32_t res_id = 0;
+      int rc = warp_img_new(&tly->warp, (uint32_t)handle, width, height,
+                            virtio_format, stride, mem_id, &res_id);
+      if (rc == 0) {
+         *img_handle_out = (uint32_t)handle;
+         result = VK_SUCCESS;
+      } else if (rc > 0) {
+         thylacine_img_free(tly, (uint32_t)handle);
+      }
+      /* rc < 0: keep the handle marked -- the slot may be live (the
+       * mem-family two-sided invariant; bounded, ctx-death reaped). */
+   }
+   mtx_unlock(&tly->mutex);
+   return result;
+}
+
+void
+vn_renderer_thylacine_img_destroy(struct vn_renderer *renderer,
+                                  uint32_t img_handle)
+{
+   struct thylacine *tly = (struct thylacine *)renderer;
+
+   mtx_lock(&tly->mutex);
+   /* A dying presentable must not stay the consent target: the server
+    * clears the consent itself (wimg_destroy's consent-clear arm), so only
+    * the local dedup latch needs dropping -- a later present of a NEW
+    * front buffer must re-issue rather than read as "unchanged". */
+   if (tly->last_present_img == img_handle + 1)
+      tly->last_present_img = 0;
+   if (warp_img_destroy(&tly->warp, img_handle) == 0)
+      thylacine_img_free(tly, img_handle);
+   /* refusal: keep marked (bounded, ctx-death reaped) */
+   mtx_unlock(&tly->mutex);
+}
+
+void
+vn_renderer_thylacine_present_poke(struct vn_renderer *renderer,
+                                   uint32_t img_handle)
+{
+   struct thylacine *tly = (struct thylacine *)renderer;
+   const uint32_t sid_plus = p_atomic_read(&thylacine_present_surface_plus1);
+
+   if (!sid_plus)
+      return; /* no window glue has named a surface (W-3e's seam) */
+
+   mtx_lock(&tly->mutex);
+   if (tly->last_present_img != img_handle + 1 ||
+       tly->last_present_sid != sid_plus) {
+      if (warp_present_to_img(&tly->warp, sid_plus - 1, img_handle) == 0) {
+         tly->last_present_img = img_handle + 1;
+         tly->last_present_sid = sid_plus;
+      }
+   }
+   mtx_unlock(&tly->mutex);
+}
+
 static bool
 thylacine_bo_destroy(struct vn_renderer *renderer, struct vn_renderer_bo *_bo)
 {
