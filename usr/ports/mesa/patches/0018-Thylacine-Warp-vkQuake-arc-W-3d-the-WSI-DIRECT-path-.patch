diff --git a/src/virtio/vulkan/vn_wsi_thylacine.c b/src/virtio/vulkan/vn_wsi_thylacine.c
new file mode 100644
index 0000000..196c3f7
--- /dev/null
+++ b/src/virtio/vulkan/vn_wsi_thylacine.c
@@ -0,0 +1,649 @@
+/*
+ * Copyright 2026 The Thylacine Authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The Thylacine WSI backend (Warp vkQuake-arc W-3d, WARP-WSI-DESIGN
+ * section 5): venus swapchain images as compositor PRESENTABLES.
+ *
+ * The surface class is stock VK_EXT_headless_surface -- Thylacine has no
+ * window-system handle to put in a surface, and the headless ICD surface is
+ * exactly "a surface with no intrinsic identity".  What changes is the
+ * interface BEHIND the platform slot: vn_wsi_init replaces
+ * wsi[VK_ICD_WSI_PLATFORM_HEADLESS] with this one, so swapchains created on
+ * a headless surface get Thylacine presentables instead of CPU images.
+ *
+ * wsi_common keeps the entire swapchain state machine (wsi_swapchain_init,
+ * the per-image throttle fences, the present submit that waits the app's
+ * semaphores, present_id).  Only the IMAGE PATH is ours, injected through
+ * the designed wsi_image_info hooks:
+ *
+ *   create_mem    -- a MARKED dedicated vkAllocateMemory (the chain-head
+ *                    pNext marker routes vn_device_memory_alloc to
+ *                    alloc_simple: venus-side memory, NO renderer bo, never
+ *                    mappable).  The ONE blob export of the memory (vkr's
+ *                    mem->exported is one-shot) is deliberately left for the
+ *                    compositor's img registration.
+ *   finish_create -- registers the memory as a presentable
+ *                    (ctx/<id>/img/new via the renderer) with the LINEAR
+ *                    stride vkGetImageSubresourceLayout reported.
+ *
+ * One-export makes both wrong orders fail loudly rather than tear: an
+ * eagerly-minted bo consumes the export and img/new refuses (swapchain
+ * creation fails); a later vkMapMemory needs a bo whose mint the
+ * registration's export refuses (map fails -- the presentable is never-map
+ * by design, W-3c-1 4.1 as amended).
+ *
+ * The I-40 stage-0 bracket: on the designed path venus itself drains the
+ * queue before the vtable queue_present runs (vn_wsi_fence_wait at the tail
+ * of every vn_QueueSubmit* detects the async-present tid and does the
+ * empty-submit + fence + wait -- the vtest-class flow; our renderer reports
+ * has_external_sync = has_implicit_fencing = false).  queue_present still
+ * waits the per-image throttle fence itself so the bracket also holds under
+ * VN_PERF=no_async_present, where that drain never runs.
+ *
+ * Present is a CONSENT poke, not a copy: `present-to <surface> img <n>` on
+ * the warp ctx names the new front buffer; the display binds it DIRECT
+ * (SET_SCANOUT_BLOB) server-side.  The surface id comes from the process
+ * global vn_renderer_thylacine_set_surface -- the W-3e SDL glue's seam;
+ * until something sets it the poke is a no-op and the swapchain behaves as
+ * a headless rotation (which is exactly what thylacine-venus-prove
+ * exercises).
+ */
+
+#include "vn_wsi.h"
+
+#include "vk_util.h"
+#include "wsi_common_private.h"
+
+#include "util/bitscan.h"
+#include "util/timespec.h"
+
+#include "vn_device.h"
+#include "vn_device_memory.h"
+#include "vn_instance.h"
+#include "vn_physical_device.h"
+#include "vn_renderer.h"
+
+/* The compositor holds MAX_WARP_IMGS_PER_CTX = 16 img slots per warp ctx,
+ * shared by every swapchain on the connection.  8 per swapchain lets a lazy
+ * old-chain retire overlap a full recreate without exhausting the table. */
+#define VN_THYLACINE_WSI_MAX_IMAGES 8
+
+struct vn_thylacine_wsi {
+   struct wsi_interface base;
+};
+
+struct vn_thylacine_wsi_image {
+   struct wsi_image base;
+
+   /* the ctx/<id>/img/<handle> slot; valid iff registered */
+   uint32_t img_handle;
+   bool registered;
+
+   /* the headless free-list pattern: host ownership + a one-present
+    * avoidance flag so acquire steers away from the just-presented image */
+   bool busy_on_host;
+   bool busy_on_device;
+};
+
+struct vn_thylacine_swapchain {
+   struct wsi_swapchain base;
+
+   struct vn_thylacine_wsi_image images[];
+};
+
+static VkResult
+vn_thylacine_surface_get_support(VkIcdSurfaceBase *surface,
+                                 struct wsi_device *wsi_device,
+                                 uint32_t queueFamilyIndex,
+                                 VkBool32 *pSupported)
+{
+   *pSupported = true;
+   return VK_SUCCESS;
+}
+
+/* FIFO only at stage 0: the DIRECT scanout has no queue to run MAILBOX
+ * against, and an honest small set beats an aspirational one. */
+static const VkPresentModeKHR vn_thylacine_present_modes[] = {
+   VK_PRESENT_MODE_FIFO_KHR,
+};
+
+static VkResult
+vn_thylacine_surface_get_capabilities(VkIcdSurfaceBase *surface,
+                                      struct wsi_device *wsi_device,
+                                      VkSurfaceCapabilitiesKHR *caps)
+{
+   caps->minImageCount = 2;
+   caps->maxImageCount = VN_THYLACINE_WSI_MAX_IMAGES;
+
+   /* No intrinsic extent -- the surface is sized by the swapchain (the SDL
+    * glue passes the tapestry surface geometry).  The compositor's
+    * registration gate re-validates against its own structural limits. */
+   caps->currentExtent = (VkExtent2D){ -1, -1 };
+   caps->minImageExtent = (VkExtent2D){ 1, 1 };
+   caps->maxImageExtent = (VkExtent2D){ 8192, 8192 };
+
+   caps->supportedTransforms = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   caps->currentTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   caps->maxImageArrayLayers = 1;
+   caps->supportedCompositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+   caps->supportedUsageFlags = wsi_caps_get_image_usage();
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+vn_thylacine_surface_get_capabilities2(VkIcdSurfaceBase *surface,
+                                       struct wsi_device *wsi_device,
+                                       const void *info_next,
+                                       VkSurfaceCapabilities2KHR *caps)
+{
+   assert(caps->sType == VK_STRUCTURE_TYPE_SURFACE_CAPABILITIES_2_KHR);
+
+   const VkSurfacePresentModeKHR *present_mode =
+      vk_find_struct_const(info_next, SURFACE_PRESENT_MODE_EXT);
+
+   VkResult result = vn_thylacine_surface_get_capabilities(
+      surface, wsi_device, &caps->surfaceCapabilities);
+
+   vk_foreach_struct(ext, caps->pNext) {
+      switch (ext->sType) {
+      case VK_STRUCTURE_TYPE_SURFACE_PROTECTED_CAPABILITIES_KHR: {
+         VkSurfaceProtectedCapabilitiesKHR *protected = (void *)ext;
+         protected->supportsProtected = VK_FALSE;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_SURFACE_PRESENT_SCALING_CAPABILITIES_KHR: {
+         VkSurfacePresentScalingCapabilitiesKHR *scaling = (void *)ext;
+         scaling->supportedPresentScaling = 0;
+         scaling->supportedPresentGravityX = 0;
+         scaling->supportedPresentGravityY = 0;
+         scaling->minScaledImageExtent = caps->surfaceCapabilities.minImageExtent;
+         scaling->maxScaledImageExtent = caps->surfaceCapabilities.maxImageExtent;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_SURFACE_PRESENT_MODE_COMPATIBILITY_KHR: {
+         VkSurfacePresentModeCompatibilityKHR *compat = (void *)ext;
+         if (compat->pPresentModes == NULL) {
+            if (!present_mode) {
+               wsi_common_vk_warn_once(
+                  "Use of VkSurfacePresentModeCompatibilityKHR without a "
+                  "VkSurfacePresentModeKHR set. This is an application bug.\n");
+            }
+            compat->presentModeCount = 1;
+         } else if (compat->presentModeCount) {
+            assert(present_mode);
+            compat->presentModeCount = 1;
+            compat->pPresentModes[0] = present_mode->presentMode;
+         }
+         break;
+      }
+      case VK_STRUCTURE_TYPE_PRESENT_TIMING_SURFACE_CAPABILITIES_EXT: {
+         VkPresentTimingSurfaceCapabilitiesEXT *wait = (void *)ext;
+         wait->presentStageQueries = 0;
+         wait->presentTimingSupported = VK_FALSE;
+         wait->presentAtAbsoluteTimeSupported = VK_FALSE;
+         wait->presentAtRelativeTimeSupported = VK_FALSE;
+         break;
+      }
+      default:
+         break;
+      }
+   }
+
+   return result;
+}
+
+static const struct {
+   VkFormat format;
+   VkColorSpaceKHR color_space;
+} vn_thylacine_formats[] = {
+   /* Both map to virtio BGRA8 (= 1): the 4-byte layout is identical and the
+    * scanout applies no transfer function, so SRGB here means "the app's
+    * rendering is sRGB-encoded", which is what a scanned-out framebuffer
+    * carries anyway. */
+   { VK_FORMAT_B8G8R8A8_UNORM, VK_COLOR_SPACE_SRGB_NONLINEAR_KHR },
+   { VK_FORMAT_B8G8R8A8_SRGB, VK_COLOR_SPACE_SRGB_NONLINEAR_KHR },
+};
+
+static VkResult
+vn_thylacine_surface_get_formats(VkIcdSurfaceBase *surface,
+                                 struct wsi_device *wsi_device,
+                                 uint32_t *pSurfaceFormatCount,
+                                 VkSurfaceFormatKHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormatKHR, out, pSurfaceFormats,
+                          pSurfaceFormatCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(vn_thylacine_formats); i++) {
+      vk_outarray_append_typed(VkSurfaceFormatKHR, &out, f) {
+         f->format = vn_thylacine_formats[i].format;
+         f->colorSpace = vn_thylacine_formats[i].color_space;
+      }
+   }
+
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+vn_thylacine_surface_get_formats2(VkIcdSurfaceBase *surface,
+                                  struct wsi_device *wsi_device,
+                                  const void *info_next,
+                                  uint32_t *pSurfaceFormatCount,
+                                  VkSurfaceFormat2KHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormat2KHR, out, pSurfaceFormats,
+                          pSurfaceFormatCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(vn_thylacine_formats); i++) {
+      vk_outarray_append_typed(VkSurfaceFormat2KHR, &out, f) {
+         assert(f->sType == VK_STRUCTURE_TYPE_SURFACE_FORMAT_2_KHR);
+         f->surfaceFormat.format = vn_thylacine_formats[i].format;
+         f->surfaceFormat.colorSpace = vn_thylacine_formats[i].color_space;
+      }
+   }
+
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+vn_thylacine_surface_get_present_modes(VkIcdSurfaceBase *surface,
+                                       struct wsi_device *wsi_device,
+                                       uint32_t *pPresentModeCount,
+                                       VkPresentModeKHR *pPresentModes)
+{
+   if (pPresentModes == NULL) {
+      *pPresentModeCount = ARRAY_SIZE(vn_thylacine_present_modes);
+      return VK_SUCCESS;
+   }
+
+   *pPresentModeCount =
+      MIN2(*pPresentModeCount, ARRAY_SIZE(vn_thylacine_present_modes));
+   typed_memcpy(pPresentModes, vn_thylacine_present_modes, *pPresentModeCount);
+
+   return *pPresentModeCount < ARRAY_SIZE(vn_thylacine_present_modes)
+             ? VK_INCOMPLETE
+             : VK_SUCCESS;
+}
+
+static VkResult
+vn_thylacine_surface_get_present_rectangles(VkIcdSurfaceBase *surface,
+                                            struct wsi_device *wsi_device,
+                                            uint32_t *pRectCount,
+                                            VkRect2D *pRects)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkRect2D, out, pRects, pRectCount);
+
+   vk_outarray_append_typed(VkRect2D, &out, rect) {
+      *rect = (VkRect2D){
+         .offset = { 0, 0 },
+         .extent = { UINT32_MAX, UINT32_MAX },
+      };
+   }
+
+   return vk_outarray_status(&out);
+}
+
+static uint32_t
+vn_thylacine_virtio_format(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_B8G8R8A8_UNORM:
+   case VK_FORMAT_B8G8R8A8_SRGB:
+      return 1; /* VIRTIO_GPU_FORMAT_B8G8R8A8_UNORM */
+   default:
+      return 0;
+   }
+}
+
+static VkResult
+vn_thylacine_wsi_create_image_mem(const struct wsi_swapchain *chain,
+                                  const struct wsi_image_info *info,
+                                  struct wsi_image *image)
+{
+   const struct wsi_device *wsi = chain->wsi;
+
+   VkMemoryRequirements reqs;
+   wsi->GetImageMemoryRequirements(chain->device, image->image, &reqs);
+
+   VkSubresourceLayout layout;
+   wsi->GetImageSubresourceLayout(chain->device, image->image,
+                                  &(VkImageSubresource){
+                                     .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                                  },
+                                  &layout);
+   assert(layout.offset == 0);
+
+   /* Any admitted memory type works: the memory is never mapped guest-side
+    * (never-map presentable), so HOST_VISIBLE buys nothing and constrains
+    * nothing -- take the first admitted type. */
+   assert(reqs.memoryTypeBits);
+   const uint32_t mt = ffs(reqs.memoryTypeBits) - 1;
+
+   const VkMemoryDedicatedAllocateInfo dedicated = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .image = image->image,
+   };
+   /* Chain-HEAD marker: vn_device_memory_alloc strips it and routes to
+    * alloc_simple (no renderer bo -- the one export is the registration's).
+    * The dedicated info stays on the stripped chain: the host allocator gets
+    * it, and vn_wsi_memory_info_init reads it to set mem->dedicated_img,
+    * which vn_AcquireNextImage2KHR's sync_fd arm dereferences. */
+   const struct vn_thylacine_wsi_memory_info marker = {
+      .sType = VN_STRUCTURE_TYPE_THYLACINE_WSI_MEMORY_INFO,
+      .pNext = &dedicated,
+   };
+   const VkMemoryAllocateInfo memory_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &marker,
+      .allocationSize = reqs.size,
+      .memoryTypeIndex = mt,
+   };
+   VkResult result = wsi->AllocateMemory(chain->device, &memory_info,
+                                         &chain->alloc, &image->memory);
+   if (result != VK_SUCCESS)
+      return result;
+
+   image->num_planes = 1;
+   image->sizes[0] = reqs.size;
+   image->row_pitches[0] = layout.rowPitch;
+   image->offsets[0] = 0;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+vn_thylacine_wsi_finish_create(const struct wsi_swapchain *chain,
+                               const struct wsi_image_info *info,
+                               struct wsi_image *image)
+{
+   struct vn_device *dev = vn_device_from_handle(chain->device);
+   struct vn_thylacine_wsi_image *timage =
+      container_of(image, struct vn_thylacine_wsi_image, base);
+   struct vn_device_memory *mem = vn_device_memory_from_handle(image->memory);
+
+   /* The host-side vkAllocateMemory rides the ring asynchronously and the
+    * compositor's img/new names mem->base.id host-side -- order the
+    * registration after the allocation the same way the mem-blob path
+    * orders its mint (wait_alloc's WaitRingSeqno, V-3b-3c-2b F7). */
+   VkResult result = vn_device_memory_wait_alloc(dev, mem);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const uint32_t fmt = vn_thylacine_virtio_format(info->create.format);
+   if (fmt == 0)
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   result = vn_renderer_thylacine_img_new(
+      dev->renderer, mem->base.id, info->create.extent.width,
+      info->create.extent.height, fmt, image->row_pitches[0],
+      &timage->img_handle);
+   if (result != VK_SUCCESS)
+      return result;
+
+   timage->registered = true;
+   return VK_SUCCESS;
+}
+
+static struct wsi_image *
+vn_thylacine_swapchain_get_wsi_image(struct wsi_swapchain *wsi_chain,
+                                     uint32_t image_index)
+{
+   struct vn_thylacine_swapchain *chain =
+      (struct vn_thylacine_swapchain *)wsi_chain;
+   return &chain->images[image_index].base;
+}
+
+static VkResult
+vn_thylacine_swapchain_acquire_next_image(struct wsi_swapchain *wsi_chain,
+                                          const VkAcquireNextImageInfoKHR *info,
+                                          uint32_t *image_index)
+{
+   struct vn_thylacine_swapchain *chain =
+      (struct vn_thylacine_swapchain *)wsi_chain;
+   struct timespec start_time, end_time, rel_timeout;
+
+   timespec_from_nsec(&rel_timeout, info->timeout);
+   clock_gettime(CLOCK_MONOTONIC, &start_time);
+   timespec_add(&end_time, &rel_timeout, &start_time);
+
+   while (1) {
+      for (uint32_t i = 0; i < chain->base.image_count; i++) {
+         if (!chain->images[i].busy_on_host) {
+            if (chain->images[i].busy_on_device) {
+               /* steer away from the just-presented image */
+               chain->images[i].busy_on_device = false;
+               continue;
+            }
+            *image_index = i;
+            chain->images[i].busy_on_host = true;
+            chain->images[i].busy_on_device = true;
+            return VK_SUCCESS;
+         }
+      }
+
+      struct timespec current_time;
+      clock_gettime(CLOCK_MONOTONIC, &current_time);
+      if (timespec_after(&current_time, &end_time))
+         return VK_NOT_READY;
+   }
+}
+
+static VkResult
+vn_thylacine_swapchain_release_images(struct wsi_swapchain *wsi_chain,
+                                      uint32_t count, const uint32_t *indices)
+{
+   struct vn_thylacine_swapchain *chain =
+      (struct vn_thylacine_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < count; i++) {
+      uint32_t index = indices[i];
+      assert(index < chain->base.image_count);
+      chain->images[index].busy_on_device = false;
+      chain->images[index].busy_on_host = false;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+vn_thylacine_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
+                                     uint32_t image_index,
+                                     uint64_t present_id,
+                                     const VkPresentRegionKHR *damage)
+{
+   struct vn_thylacine_swapchain *chain =
+      (struct vn_thylacine_swapchain *)wsi_chain;
+   struct vn_thylacine_wsi_image *image = &chain->images[image_index];
+   const struct wsi_device *wsi = chain->base.wsi;
+
+   assert(image_index < chain->base.image_count);
+
+   /* The I-40 stage-0 bracket, independent of the async-present drain: the
+    * per-image throttle fence was submitted by the generic present submit
+    * (which waited the app's present semaphores), so waiting it here means
+    * every GPU write to this image has retired before the display is poked.
+    * On the designed async path vn_wsi_fence_wait has already drained the
+    * queue and this returns immediately. */
+   if (chain->base.fences[image_index] != VK_NULL_HANDLE) {
+      VkResult result =
+         wsi->WaitForFences(chain->base.device, 1,
+                            &chain->base.fences[image_index], true, UINT64_MAX);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   if (image->registered) {
+      struct vn_device *dev = vn_device_from_handle(chain->base.device);
+      vn_renderer_thylacine_present_poke(dev->renderer, image->img_handle);
+   }
+
+   image->busy_on_host = false;
+   return VK_SUCCESS;
+}
+
+static VkResult
+vn_thylacine_swapchain_wait_for_present(struct wsi_swapchain *wsi_chain,
+                                        uint64_t waitValue,
+                                        uint64_t timeout)
+{
+   return wsi_swapchain_wait_for_present_semaphore(wsi_chain, waitValue,
+                                                   timeout);
+}
+
+static void
+vn_thylacine_swapchain_destroy_image(struct vn_thylacine_swapchain *chain,
+                                     struct vn_thylacine_wsi_image *image)
+{
+   /* Unregister BEFORE freeing the memory: the compositor's wimg_destroy is
+    * the display-safe teardown (unbind-before-unref server-side), and the
+    * venus memory must outlive the presentable that names it.  A refused
+    * unregister keeps the img handle marked renderer-side (bounded,
+    * ctx-death reaped) -- the memory free is still safe: the server's blob
+    * holds its own reference. */
+   if (image->registered) {
+      struct vn_device *dev = vn_device_from_handle(chain->base.device);
+      vn_renderer_thylacine_img_destroy(dev->renderer, image->img_handle);
+      image->registered = false;
+   }
+   if (image->base.image != VK_NULL_HANDLE)
+      wsi_destroy_image(&chain->base, &image->base);
+}
+
+static VkResult
+vn_thylacine_swapchain_destroy(struct wsi_swapchain *wsi_chain,
+                               const VkAllocationCallbacks *pAllocator)
+{
+   struct vn_thylacine_swapchain *chain =
+      (struct vn_thylacine_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < chain->base.image_count; i++)
+      vn_thylacine_swapchain_destroy_image(chain, &chain->images[i]);
+
+   wsi_swapchain_finish(&chain->base);
+   vk_free(pAllocator, chain);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+vn_thylacine_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
+                                      VkDevice device,
+                                      struct wsi_device *wsi_device,
+                                      const VkSwapchainCreateInfoKHR *pCreateInfo,
+                                      const VkAllocationCallbacks *pAllocator,
+                                      struct wsi_swapchain **swapchain_out)
+{
+   struct vn_thylacine_swapchain *chain;
+   VkResult result;
+
+   assert(pCreateInfo->sType == VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR);
+
+   uint32_t num_images = pCreateInfo->minImageCount;
+   if (num_images > VN_THYLACINE_WSI_MAX_IMAGES)
+      num_images = VN_THYLACINE_WSI_MAX_IMAGES;
+
+   size_t size = sizeof(*chain) + num_images * sizeof(chain->images[0]);
+   chain = vk_zalloc(pAllocator, size, 8, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (chain == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   /* CPU image params: with wants_linear pinned at vn_wsi_init this
+    * configures the NO_BLIT arm -- LINEAR tiling, no blit buffers, no
+    * command pools -- whose create_mem we then replace. */
+   const struct wsi_cpu_image_params cpu_params = {
+      .base.image_type = WSI_IMAGE_TYPE_CPU,
+   };
+
+   result = wsi_swapchain_init(wsi_device, &chain->base, device, pCreateInfo,
+                               &cpu_params.base, pAllocator);
+   if (result != VK_SUCCESS) {
+      vk_free(pAllocator, chain);
+      return result;
+   }
+
+   /* wants_linear is set unconditionally for this renderer; a BUFFER_BLIT
+    * chain here would mean OPTIMAL tiling under our LINEAR-stride
+    * registration -- refuse loudly rather than register garbage. */
+   if (chain->base.blit.type != WSI_SWAPCHAIN_NO_BLIT) {
+      wsi_swapchain_finish(&chain->base);
+      vk_free(pAllocator, chain);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   /* The image path is ours: venus device memories registered as compositor
+    * presentables (see the file header). */
+   chain->base.image_info.create_mem = vn_thylacine_wsi_create_image_mem;
+   chain->base.image_info.finish_create = vn_thylacine_wsi_finish_create;
+
+   chain->base.destroy = vn_thylacine_swapchain_destroy;
+   chain->base.get_wsi_image = vn_thylacine_swapchain_get_wsi_image;
+   chain->base.acquire_next_image = vn_thylacine_swapchain_acquire_next_image;
+   chain->base.release_images = vn_thylacine_swapchain_release_images;
+   chain->base.queue_present = vn_thylacine_swapchain_queue_present;
+   chain->base.wait_for_present = vn_thylacine_swapchain_wait_for_present;
+   chain->base.wait_for_present2 = vn_thylacine_swapchain_wait_for_present;
+   chain->base.present_mode =
+      wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+   chain->base.image_count = num_images;
+
+   uint32_t image = 0;
+   for (; image < chain->base.image_count; image++) {
+      result = wsi_create_image(&chain->base, &chain->base.image_info,
+                                &chain->images[image].base);
+      if (result != VK_SUCCESS)
+         goto fail_destroy_images;
+
+      /* wsi_create_image ran finish_create (registration) on success; the
+       * busy flags start clear. */
+   }
+
+   *swapchain_out = &chain->base;
+
+   return VK_SUCCESS;
+
+fail_destroy_images:
+   /* Only the images BEFORE the failed index: wsi_create_image's own fail
+    * path already wsi_destroy_image'd the partial one, and it cannot have
+    * registered (finish_create is the last fallible step, and a failed
+    * finish_create never sets `registered`) -- destroying it again here
+    * would double-free the stale handles the destroy does not null. */
+   for (uint32_t i = 0; i < image; i++)
+      vn_thylacine_swapchain_destroy_image(chain, &chain->images[i]);
+   wsi_swapchain_finish(&chain->base);
+   vk_free(pAllocator, chain);
+
+   return result;
+}
+
+VkResult
+vn_wsi_thylacine_init(struct vn_physical_device *physical_dev)
+{
+   const VkAllocationCallbacks *alloc =
+      &physical_dev->instance->base.vk.alloc;
+   struct wsi_device *wsi_device = &physical_dev->wsi_device;
+
+   struct vn_thylacine_wsi *wsi =
+      vk_alloc(alloc, sizeof(*wsi), 8, VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!wsi)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   wsi->base.get_support = vn_thylacine_surface_get_support;
+   wsi->base.get_capabilities2 = vn_thylacine_surface_get_capabilities2;
+   wsi->base.get_formats = vn_thylacine_surface_get_formats;
+   wsi->base.get_formats2 = vn_thylacine_surface_get_formats2;
+   wsi->base.get_present_modes = vn_thylacine_surface_get_present_modes;
+   wsi->base.get_present_rectangles =
+      vn_thylacine_surface_get_present_rectangles;
+   wsi->base.create_swapchain = vn_thylacine_surface_create_swapchain;
+
+   /* Replace the stock headless interface.  Ours is a vk_alloc'd struct
+    * whose first member is the wsi_interface, allocated with the same
+    * instance allocator -- so wsi_headless_finish_wsi's blind vk_free of
+    * whatever sits in the slot (wsi_device_finish) frees ours identically
+    * and vn_wsi_fini needs no special arm. */
+   vk_free(alloc, wsi_device->wsi[VK_ICD_WSI_PLATFORM_HEADLESS]);
+   wsi_device->wsi[VK_ICD_WSI_PLATFORM_HEADLESS] = &wsi->base;
+
+   return VK_SUCCESS;
+}
