    uint64_t mem_bitmap[THY_MEM_WORDS];
 
    uint32_t next_sync_id;
@@ -321,10 +327,15 @@ thylacine_shmem_destroy(struct vn_renderer *renderer,
 /*
  * Mint a device-memory blob for a VkDeviceMemory (V-3b-3c-2b). The driver calls
