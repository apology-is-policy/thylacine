    struct warp_conn warp;
    bool connected;
 
@@ -128,7 +133,8 @@ struct thylacine {
 
    /* allocated device-memory slots (handle 0..255); one bit per mem/<handle>.
     * Same SINGLE-THREAD assumption as ring_bitmap (see the warp field): the
-    * per-renderer mutex owed at multi-queue V-3b-3c covers this too. */
+    * owed per-renderer mutex (any concurrent vkAllocateMemory, not multi-queue)
