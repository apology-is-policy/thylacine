@@ -366,17 +377,18 @@ thylacine_bo_create_from_device_memory(
    int rc = warp_mem_new(&tly->warp, (uint32_t)handle, (uint32_t)rounded, mem_id,
                          &res_id);
    if (rc != 0) {
-      /* F2: free the handle IFF the server slot is provably not installed
-       * (rc > 0: a wedged/ctx-less conn or a refused mem/new Twrite -- the
-       * server installs the slot only on the Ok path, so a refused Twrite leaves
-       * none). The routine E_NOMEM at the holistic ctx cap is this arm, so a
-       * memory-pressure loop that refuses + retries does NOT burn the 256-slot
