       return VK_ERROR_OUT_OF_DEVICE_MEMORY;
@@ -434,12 +446,17 @@ thylacine_bo_map(struct vn_renderer *renderer, struct vn_renderer_bo *_bo,
    struct thylacine *tly = (struct thylacine *)renderer;
