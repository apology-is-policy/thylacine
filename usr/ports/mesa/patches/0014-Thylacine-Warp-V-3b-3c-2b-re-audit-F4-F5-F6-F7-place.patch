diff --git a/src/gallium/winsys/virgl/thylacine/warp_client.c b/src/gallium/winsys/virgl/thylacine/warp_client.c
index 095919b..224d28f 100644
--- a/src/gallium/winsys/virgl/thylacine/warp_client.c
+++ b/src/gallium/winsys/virgl/thylacine/warp_client.c
@@ -530,12 +530,22 @@ int warp_mem_new(struct warp_conn *w, uint32_t handle, uint32_t bytes,
 
    /* Three-valued failure so the caller frees the handle iff the server slot is
     * provably NOT installed (F2): the server installs the mem slot ONLY on the
-    * Ok path of the mem/new Twrite, so a wedged/ctx-less conn OR a refused Twrite
-    * (the routine E_NOMEM at the holistic ctx cap is exactly this) leaves NO slot
-    * -> return 1 = not-installed, free the handle. A Twrite that SUCCEEDED but
-    * whose info read failed MAY have a live slot -> return -1 = maybe-installed,
-    * keep the handle marked (the bounded-leak posture; converging it with a
-    * destroy is the ring/mem F2 follow-on). 0 = success. */
+    * Ok path of the mem/new Twrite. The decision turns on WHICH failure it was
+    * (V-3b-3c-2b F5/F6 -- the round-1 "refused Twrite -> free" was too coarse):
+    *   rc=1  (free)  = provably not installed: a wedged/ctx-less conn, an open
+    *                   failure (the Twrite never reached the server), or the
+    *                   routine -ENOMEM holistic-cap refusal (Rlerror = nothing
+    *                   installed; keeping F2's "cap loop must not burn slots").
+    *   rc=-1 (keep)  = MAYBE installed: a duplicate handle -EINVAL (the slot IS
+    *                   installed -- e.g. a concurrent-alloc race loser, F6), an
+    *                   -EINTR whose Twrite may have committed before the ack
+    *                   (F5), an info-read failure, any unrecognized errno. NEVER
+    *                   free a handle whose server slot may be live (re-handing it
+    *                   collides with the still-installed slot, the ring-F1 wedge).
+    *   rc=0          = success.
+    * Converging the rc<0 arm with a destroy is the ring/mem F2 follow-on. This
+    * relies on dev9p propagating the real Rlerror ecode (t_write returns the
+    * negative errno, never a collapsed -1). */
    if (w->wedged || w->ctx == 0)
       return 1;
 
@@ -547,8 +557,18 @@ int warp_mem_new(struct warp_conn *w, uint32_t handle, uint32_t bytes,
    snprintf(path, sizeof(path), "ctx/%u/mem/new", w->ctx);
    snprintf(verb, sizeof(verb), "%u %u %llu", bytes, handle,
             (unsigned long long)mem_id);
-   if (write_verb(w->root, path, verb) != 0)
-      return 1; /* refused Twrite -> no slot installed -> free the handle */
+   /* Open+write inline (not write_verb) to inspect the failure errno for the
+    * F5/F6 install-state decision above. */
+   {
+      long fd = open_at(w->root, path, T_OWRITE);
+      if (fd < 0)
+         return 1; /* never reached the server -> nothing installed -> free */
+      size_t vlen = strlen(verb);
+      long n = t_write(fd, verb, vlen);
+      t_close(fd);
+      if (n != (long)vlen)
+         return (n == -ENOMEM) ? 1 : -1;
+   }
 
    /* res_id (the value the vkAllocateMemory command names in resourceId) reads
     * back from mem/<handle>/info: "res <id> size <sz>". */
diff --git a/src/gallium/winsys/virgl/thylacine/warp_client.h b/src/gallium/winsys/virgl/thylacine/warp_client.h
index cd71a2c..062cdca 100644
--- a/src/gallium/winsys/virgl/thylacine/warp_client.h
+++ b/src/gallium/winsys/virgl/thylacine/warp_client.h
@@ -168,14 +168,20 @@ int warp_ring_destroy(struct warp_conn *w, uint32_t ridx);
  * the backing server-side (the disclosure floor), so the caller MUST mint at
  * vkAllocateMemory time, before any device write to mem_id -- a lazy mint after
  * a GPU copy INTO the memory would zero the results (server audit F4).
- * Three-valued return (V-3b-3c-2b F2): 0 = success (+ *res_id_out); 1 = failed,
- * server slot provably NOT installed (a wedged/ctx-less conn or a refused
- * mem/new Twrite -- the routine E_NOMEM at the holistic cap) -> the caller
- * SHOULD free its handle; -1 = failed, slot MAYBE installed (Twrite ok, info
- * read failed) -> the caller MUST keep the handle marked, else a re-handed
- * handle collides with the still-installed slot (the ring-F1 wedge). Freeing on
- * 1 keeps a memory-pressure loop from burning the 256-slot space on routine cap
- * refusals. */
+ * Three-valued return (V-3b-3c-2b F2, refined F5/F6): 0 = success
+ * (+ *res_id_out). 1 = failed, server slot provably NOT installed -> the caller
+ * SHOULD free its handle: a wedged/ctx-less conn, an open failure (the Twrite
+ * never reached the server), or the routine -ENOMEM holistic-cap refusal (the
+ * Rlerror means nothing was installed). -1 = failed, slot MAYBE installed -> the
+ * caller MUST keep the handle marked (else a re-handed handle collides with the
+ * still-installed slot, the ring-F1 wedge): a duplicate handle -EINVAL (the slot
+ * IS installed -- e.g. a concurrent-alloc race loser, F6), an -EINTR whose
+ * Twrite may have committed before the ack (F5 -- LATENT until native readers
+ * become caught-interruptible, the planned 11c), an info-read failure, or any
+ * unrecognized errno. Freeing on 1 keeps a memory-pressure loop from burning the
+ * 256-slot space on routine cap refusals; keeping on everything else preserves
+ * the two-sided guest-handle <-> server-slot invariant. Requires dev9p to
+ * propagate the real Rlerror ecode (t_write returns the negative errno). */
 int warp_mem_new(struct warp_conn *w, uint32_t handle, uint32_t bytes,
                  uint64_t mem_id, uint32_t *res_id_out);
 
