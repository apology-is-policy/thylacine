diff --git a/src/virtio/vulkan/vn_instance.c b/src/virtio/vulkan/vn_instance.c
index 8a3f9af..2567cfa 100644
--- a/src/virtio/vulkan/vn_instance.c
+++ b/src/virtio/vulkan/vn_instance.c
@@ -325,8 +325,19 @@ vn_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
 
    vn_cs_renderer_protocol_info_init(instance);
 
+   /* Thylacine (Warp V-3b-3b audit F2): the /srv/warp host3d ring backing is
+    * capped at 1 MiB (WARP_RING_MAX), so an 8 MiB pool min-alloc can never be
+    * backed -- every indirect-CS grow would fail as an OOM far from the cause.
+    * Clamp the pool to grow in <= 1 MiB units; a single CS > 1 MiB still needs
+    * the Loom bulk path (owed at V-3b-3c). Bring-up never grows the pool (all
+    * commands emit direct, under the ring's direct_size), so this is latent. */
+#ifdef __thylacine__
+   vn_renderer_shmem_pool_init(instance->renderer, &instance->cs_shmem_pool,
+                               1u << 20);
+#else
    vn_renderer_shmem_pool_init(instance->renderer, &instance->cs_shmem_pool,
                                8u << 20);
+#endif
 
    vn_renderer_shmem_pool_init(instance->renderer,
                                &instance->reply_shmem_pool, 1u << 20);
