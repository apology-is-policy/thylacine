+/* ---- Warp-6 V-3b-3 host3d ring path (Model B / Venus) ---- */
+
+/* Mint a HOST3D ring at `ridx` on the connection's ctx and read back the
+ * virtio-gpu res_id the Venus command stream names (in vkCreateRingMESA).
+ * Minting the FIRST host3d ring lazily arms the ctx's venus device-context,
+ * after which warp_venus_submit routes to it (no separate arm verb).
+ * `bytes` must be a nonzero multiple of the page and <= WARP_RING_MAX
+ * (1 MiB, server-enforced). The caller owns ridx allocation (a duplicate
+ * index is refused server-side). Returns 0 + *res_id_out, or -1. */
+int warp_ring_create_host3d(struct warp_conn *w, uint32_t ridx, uint32_t bytes,
+                            uint32_t *res_id_out);
+
+/* Map a minted host3d ring's coherent backing: opens ring/<ridx>/map and
+ * t_weft_map's it (the same claim+map-atomic path as warp_bo_map). The
+ * mapping is RW and cache-coherent with the host; it lives until *map_fd_out
+ * is closed (the clunk drops the mapping AND the transferred pin, letting
+ * tapestryd reclaim the ring). NULL on failure. */
+void *warp_ring_map(struct warp_conn *w, uint32_t ridx, long *map_fd_out);
+
+/* Drop a host3d ring mapping: closes the map fid returned by warp_ring_map.
+ * The clunk drops the client's mapping AND the transferred pin, which lets
+ * tapestryd reclaim the ring slot server-side. Safe on a wedged connection. */
+void warp_ring_unmap(long map_fd);
+
+/* Submit one opaque Venus command stream (raw SUBMIT_CMD/execbuffer bytes) to
+ * the ctx's submit file. With a host3d ring armed the server routes this to
+ * warp_venus_submit on the venus device-ctx; tapestryd never parses the
+ * bytes. One write = one atomic fenced submission (completion observed on
+ * ctx/<id>/fence via warp_fence_wait); `len` must be <= the seam chunk bound
+ * (the opaque stream cannot be split at a CCMD boundary the way warp_submit
+ * splits, so it must ride one Twrite). Latches the wedge on a dropped submit
+ * (a lost command stream poisons the ring). Returns the issue seq (> 0)
+ * or 0. */
+uint64_t warp_venus_submit(struct warp_conn *w, const void *bytes,
+                           uint32_t len);
+
 /* Warp-4, the adoption's ctx half: consent to displaying `bo_pub` on
  * tapestry surface `surface_id` ("present-to <surface> <bo>" on the ctx
  * ctl). Pure naming -- the display activates only when the surface's own
