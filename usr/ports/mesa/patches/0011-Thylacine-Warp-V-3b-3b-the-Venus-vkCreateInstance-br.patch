-long warp_read_caps(struct warp_conn *w, void *buf, unsigned long len)
+/* ---- Warp-6 V-3b-3 host3d ring path (Model B / Venus) ---- */
+
+int warp_ring_create_host3d(struct warp_conn *w, uint32_t ridx, uint32_t bytes,
+                            uint32_t *res_id_out)
+{
+   char path[64];
+   char verb[48];
+   char info[160];
+   long long rid;
+
+   if (w->wedged || w->ctx == 0)
+      return -1;
+
+   /* "<bytes> <ridx> host3d" -> ctx/<id>/ring/new. The third token arms the
+    * Model B path (host3d=true); minting the first host3d ring lazily arms
+    * the ctx's venus device-context server-side. bytes must be a nonzero
+    * multiple of the page and <= WARP_RING_MAX; the caller rounds up. */
+   snprintf(path, sizeof(path), "ctx/%u/ring/new", w->ctx);
+   snprintf(verb, sizeof(verb), "%u %u host3d", bytes, ridx);
+   if (write_verb(w->root, path, verb) != 0)
+      return -1;
+
+   /* The res_id the venus stream names (vkCreateRingMESA.resourceId) is read
+    * back from ring/<ridx>/info: "res <id> ridx <n> bytes <sz> hdr 64". */
+   snprintf(path, sizeof(path), "ctx/%u/ring/%u/info", w->ctx, ridx);
+   if (open_read_snapshot(w->root, path, info, sizeof(info)) <= 0)
+      return -1;
+   rid = parse_field(info, "res");
+   if (rid <= 0)
+      return -1;
+
+   *res_id_out = (uint32_t)rid;
+   return 0;
+}
+
+void *warp_ring_map(struct warp_conn *w, uint32_t ridx, long *map_fd_out)
+{
+   char path[64];
+   long fd, va;
+
+   if (w->ctx == 0)
+      return NULL;
+
+   snprintf(path, sizeof(path), "ctx/%u/ring/%u/map", w->ctx, ridx);
+   fd = open_at(w->root, path, T_OREAD);
+   if (fd < 0)
+      return NULL;
+   va = t_weft_map(fd, 0); /* RW + coherent regardless of the open mode */
+   if (va < 0) {
+      t_close(fd);
+      return NULL;
+   }
+   *map_fd_out = fd;
+   return (void *)(uintptr_t)va;
+}
+
+void warp_ring_unmap(long map_fd)
+{
+   if (map_fd >= 0)
+      t_close(map_fd); /* the clunk drops the mapping + pin -> ring reaps */
+}
+
+uint64_t warp_venus_submit(struct warp_conn *w, const void *bytes, uint32_t len)
+{
+   uint64_t seq;
+
+   if (w->wedged)
+      return 0;
+
+   /* One Twrite = one atomic submission. Past the chunk bound the kernel 9P
+    * client fragments the write into several Twrites, each of which the
+    * server decodes as its own submission -- splitting mid-command. The
+    * venus stream is opaque (the server never parses it), so unlike
+    * warp_submit there is no CCMD boundary to split at; the whole stream
+    * must ride one write. Bring-up's bootstrap commands are ~124 bytes, far
+    * under the bound. */
+   if (len == 0 || len > WARP_CHUNK_BYTES) {
+      fprintf(stderr, "warp: venus submit of %u bytes exceeds the %u-byte "
+                      "one-write bound -- the byte seam cannot carry it "
+                      "atomically (GPU-DESIGN 4.1 Loom is the successor); "
+                      "latching\n",
+              len, WARP_CHUNK_BYTES);
+      w->wedged = true;
+      return 0;
+   }
+
+   seq = fenced_write(w, w->submit_fd, bytes, len);
+   if (seq == 0 && !w->wedged) {
+      fprintf(stderr, "warp: venus submit failed -- a dropped command "
+                      "stream poisons the ring; latching\n");
+      w->wedged = true;
+   }
+   return seq;
+}
+
+static long read_caps_path(struct warp_conn *w, const char *path, void *buf,
+                           unsigned long len)
 {
-   long fd = open_at(w->root, "caps", T_OREAD);
+   long fd = open_at(w->root, path, T_OREAD);
    long total = 0;
    if (fd < 0)
       return -1;
@@ -454,6 +550,19 @@ long warp_read_caps(struct warp_conn *w, void *buf, unsigned long len)
    return total;
 }
 
+long warp_read_caps(struct warp_conn *w, void *buf, unsigned long len)
+{
+   return read_caps_path(w, "caps", buf, len);
+}
+
+long warp_read_venus_caps(struct warp_conn *w, void *buf, unsigned long len)
+{
+   /* The VENUS capset (id=4), served separately from `caps` (which serves the
+    * ranked virgl capset the OpenGL winsys reads). The Model B backend's
+    * instance gate needs the venus wire-format / vk-xml versions from here. */
+   return read_caps_path(w, "caps-venus", buf, len);
+}
