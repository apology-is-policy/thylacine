diff --git a/src/virtio/vulkan/vn_renderer_thylacine.c b/src/virtio/vulkan/vn_renderer_thylacine.c
new file mode 100644
index 0000000..5546f55
--- /dev/null
+++ b/src/virtio/vulkan/vn_renderer_thylacine.c
@@ -0,0 +1,353 @@
+/*
+ * Copyright 2026 The Thylacine Authors
+ * SPDX-License-Identifier: MIT
+ *
+ * based in part on vn_renderer_vtest.c which is:
+ * Copyright 2019 Google LLC
+ *
+ * The Thylacine vn_renderer backend (Warp V-3b-3). It is the VTEST shape --
+ * a userspace transport, no kernel DRM driver -- with Thylacine 9P file ops
+ * on the /srv/warp seam (tapestryd, the virtio-gpu owner) replacing vtest's
+ * socket, and t_weft_map replacing its SCM_RIGHTS-fd + mmap. It composes the
+ * shipped Model B substrate: shmem_create -> a HOST3D ring blob on the
+ * client's venus ctx (ring/new host3d) + weft-map; submit -> ctx/<id>/submit
+ * (warp_venus_submit, opaque bytes on venus_ctx); wait -> t_poll on the fence
+ * fd; bo -> the hostmem BAR (SYS_BURROW_FROM_HOSTMEM); info -> the caps file.
+ *
+ * V-3b-3a scope: the build path (a static, loader-less ICD; virtgpu/libdrm
+ * gated out) + this skeleton wired into vn_renderer_create + the vtable. The
+ * data-plane ops are stubs here; V-3b-3b fills shmem/submit/wait/sync and
+ * V-3b-3c the bo path. WARP-V3-DESIGN section 0.14 is the design pin.
+ */
+
+#include "virtio/virtio-gpu/venus_hw.h"
+
+#include "util/sparse_array.h"
+
+#include "vn_renderer_internal.h"
+
+/* virtio-gpu PCI identity (the same virtio vendor the guest device presents);
+ * the info is cosmetic until V-3c wires the real capset authority. */
+#define THYLACINE_PCI_VENDOR_ID 0x1af4
+#define THYLACINE_PCI_DEVICE_ID 0x1050
+
+struct thylacine_shmem {
+   struct vn_renderer_shmem base;
+};
+
+struct thylacine_bo {
+   struct vn_renderer_bo base;
+};
+
+struct thylacine_sync {
+   struct vn_renderer_sync base;
+};
+
+struct thylacine {
+   struct vn_renderer base;
+
+   struct vn_instance *instance;
+
+   /* the /srv/warp connection (open == connect). -1 until V-3b-3b wires the
+    * transport; the connect + ctx mint land there. */
+   long warp_root;
+
+   uint32_t max_timeline_count;
+
+   struct {
+      uint32_t id;
+      uint32_t version;
+      struct virgl_renderer_capset_venus data;
+   } capset;
+
+   struct util_sparse_array shmem_array;
+   struct util_sparse_array bo_array;
+
+   struct vn_renderer_shmem_cache shmem_cache;
+};
+
+/* ---- ops (V-3b-3a stubs; the real impl lands in 3b/3c) ---- */
+
+static void
+thylacine_shmem_destroy_now(struct vn_renderer *renderer,
+                            struct vn_renderer_shmem *shmem)
+{
+   struct thylacine *tly = (struct thylacine *)renderer;
+   struct thylacine_shmem *ts = (struct thylacine_shmem *)shmem;
+   (void)tly;
+   (void)ts;
+   /* V-3b-3b: t_close the map fd (drops mapping + pin) + retire the ring. */
+}
+
+static struct vn_renderer_shmem *
+thylacine_shmem_create(struct vn_renderer *renderer, size_t size)
+{
+   (void)renderer;
+   (void)size;
+   /* V-3b-3b: ring/new host3d <size> <ridx> on the venus ctx, read res_id
+    * from ring/<ridx>/info, t_weft_map the backing -> mmap_ptr. */
+   return NULL;
+}
+
+static void
+thylacine_shmem_destroy(struct vn_renderer *renderer,
+                        struct vn_renderer_shmem *shmem)
+{
+   struct thylacine *tly = (struct thylacine *)renderer;
+
+   if (vn_renderer_shmem_cache_add(&tly->shmem_cache, shmem))
+      return;
+
+   thylacine_shmem_destroy_now(&tly->base, shmem);
+}
+
+static VkResult
+thylacine_bo_create_from_device_memory(
+   struct vn_renderer *renderer,
+   VkDeviceSize size,
+   vn_object_id mem_id,
+   VkMemoryPropertyFlags flags,
+   VkExternalMemoryHandleTypeFlags external_handles,
+   struct vn_renderer_bo **out_bo)
+{
+   (void)renderer;
+   (void)size;
+   (void)mem_id;
+   (void)flags;
+   (void)external_handles;
+   (void)out_bo;
+   /* V-3b-3c: HOST_VISIBLE VkDeviceMemory over the hostmem BAR (MAP_BLOB +
+    * SYS_BURROW_FROM_HOSTMEM). */
+   return VK_ERROR_OUT_OF_HOST_MEMORY;
+}
+
+static bool
+thylacine_bo_destroy(struct vn_renderer *renderer, struct vn_renderer_bo *bo)
+{
+   (void)renderer;
+   (void)bo;
+   return false;
+}
+
+static int
+thylacine_bo_export_dma_buf(struct vn_renderer *renderer,
+                            struct vn_renderer_bo *bo)
+{
+   (void)renderer;
+   (void)bo;
+   return -1;
+}
+
+static void *
+thylacine_bo_map(struct vn_renderer *renderer, struct vn_renderer_bo *bo,
+                 void *placed_addr)
+{
+   (void)renderer;
+   (void)bo;
+   (void)placed_addr;
+   return NULL;
+}
+
+static void
+thylacine_bo_flush(struct vn_renderer *renderer, struct vn_renderer_bo *bo,
+                   VkDeviceSize offset, VkDeviceSize size)
+{
+   (void)renderer;
+   (void)bo;
+   (void)offset;
+   (void)size;
+   /* coherent hostmem BAR: no explicit flush (V-3b-3c confirms the cache
+    * attribute the host dictates). */
+}
+
+static void
+thylacine_bo_invalidate(struct vn_renderer *renderer,
+                        struct vn_renderer_bo *bo,
+                        VkDeviceSize offset, VkDeviceSize size)
+{
+   (void)renderer;
+   (void)bo;
+   (void)offset;
+   (void)size;
+}
+
+static VkResult
+thylacine_sync_create(struct vn_renderer *renderer, uint64_t initial_val,
+                      uint32_t flags, struct vn_renderer_sync **out_sync)
+{
+   (void)renderer;
+   (void)initial_val;
+   (void)flags;
+   (void)out_sync;
+   /* V-3b-3b: a u64 timeline over the coherent feedback slots
+    * (SIMULATE_SYNCOBJ). */
+   return VK_ERROR_OUT_OF_HOST_MEMORY;
+}
+
+static void
+thylacine_sync_destroy(struct vn_renderer *renderer,
+                       struct vn_renderer_sync *sync)
+{
+   (void)renderer;
+   (void)sync;
+}
+
+static VkResult
+thylacine_sync_reset(struct vn_renderer *renderer,
+                     struct vn_renderer_sync *sync, uint64_t initial_val)
+{
+   (void)renderer;
+   (void)sync;
+   (void)initial_val;
+   return VK_ERROR_OUT_OF_HOST_MEMORY;
+}
+
+static VkResult
+thylacine_sync_read(struct vn_renderer *renderer,
+                    struct vn_renderer_sync *sync, uint64_t *val)
+{
+   (void)renderer;
+   (void)sync;
+   (void)val;
+   return VK_ERROR_OUT_OF_HOST_MEMORY;
+}
+
+static VkResult
+thylacine_sync_write(struct vn_renderer *renderer,
+                     struct vn_renderer_sync *sync, uint64_t val)
+{
+   (void)renderer;
+   (void)sync;
+   (void)val;
+   return VK_ERROR_OUT_OF_HOST_MEMORY;
+}
+
+static VkResult
+thylacine_submit(struct vn_renderer *renderer,
+                 const struct vn_renderer_submit *submit)
+{
+   (void)renderer;
+   (void)submit;
+   /* V-3b-3b: ctx/<id>/submit -> warp_venus_submit (opaque venus bytes on
+    * venus_ctx); the bootstrap vkCreateRingMESA + the doorbell kick. */
+   return VK_ERROR_OUT_OF_HOST_MEMORY;
+}
+
+static VkResult
+thylacine_wait(struct vn_renderer *renderer,
+               const struct vn_renderer_wait *wait)
+{
+   (void)renderer;
+   (void)wait;
+   /* V-3b-3b: t_poll on ctx/<id>/fence with the Vulkan ns timeout; the fast
+    * path polls the coherent feedback slots. */
+   return VK_ERROR_DEVICE_LOST;
+}
+
+static void
+thylacine_destroy(struct vn_renderer *renderer,
+                  const VkAllocationCallbacks *alloc)
+{
+   struct thylacine *tly = (struct thylacine *)renderer;
+
+   vn_renderer_shmem_cache_fini(&tly->shmem_cache);
+
+   util_sparse_array_finish(&tly->shmem_array);
+   util_sparse_array_finish(&tly->bo_array);
+
+   /* V-3b-3b: warp_close(warp_root). */
+
+   vk_free(alloc, tly);
+}
+
+static void
+thylacine_init_renderer_info(struct thylacine *tly)
+{
+   struct vn_renderer_info *info = &tly->base.info;
+
+   info->pci.vendor_id = THYLACINE_PCI_VENDOR_ID;
+   info->pci.device_id = THYLACINE_PCI_DEVICE_ID;
+
+   info->has_dma_buf_import = false;
+   info->has_external_sync = false;
+   info->has_implicit_fencing = false;
+   info->has_guest_vram = false;
+
+   info->max_timeline_count = tly->max_timeline_count;
+
+   /* The capset (wire/xml/spec versions + the extension masks) is left zero
+    * here; V-3c wires the real capset authority from the caps file. The 3a
+    * link/load proof does not enumerate a physical device, so a zero capset
+    * is correct -- not a stub that must be remembered. */
+}
+
+static VkResult
+thylacine_init(struct thylacine *tly)
+{
+   util_sparse_array_init(&tly->shmem_array, sizeof(struct thylacine_shmem),
+                          1024);
+   util_sparse_array_init(&tly->bo_array, sizeof(struct thylacine_bo), 1024);
+
+   /* V-3b-3b: warp_open(&conn) -> connect + mint the venus ctx; init the
+    * capset from the caps file. At 3a the transport is unwired (the link/
+    * load proof needs neither). */
+   tly->warp_root = -1;
+   tly->max_timeline_count = 64;
+
+   vn_renderer_shmem_cache_init(&tly->shmem_cache, &tly->base,
+                                thylacine_shmem_destroy_now);
+
+   thylacine_init_renderer_info(tly);
+
+   tly->base.ops.destroy = thylacine_destroy;
+   tly->base.ops.submit = thylacine_submit;
+   tly->base.ops.wait = thylacine_wait;
+
+   tly->base.shmem_ops.create = thylacine_shmem_create;
+   tly->base.shmem_ops.destroy = thylacine_shmem_destroy;
+
+   tly->base.bo_ops.create_from_device_memory =
+      thylacine_bo_create_from_device_memory;
+   tly->base.bo_ops.create_from_dma_buf = NULL;
+   tly->base.bo_ops.destroy = thylacine_bo_destroy;
+   tly->base.bo_ops.export_dma_buf = thylacine_bo_export_dma_buf;
+   tly->base.bo_ops.export_sync_file =
+      vn_renderer_bo_export_sync_file_internal;
+   tly->base.bo_ops.map = thylacine_bo_map;
+   tly->base.bo_ops.flush = thylacine_bo_flush;
+   tly->base.bo_ops.invalidate = thylacine_bo_invalidate;
+
+   tly->base.sync_ops.create = thylacine_sync_create;
+   tly->base.sync_ops.create_from_syncobj = NULL;
+   tly->base.sync_ops.destroy = thylacine_sync_destroy;
+   tly->base.sync_ops.export_syncobj = NULL;
+   tly->base.sync_ops.reset = thylacine_sync_reset;
