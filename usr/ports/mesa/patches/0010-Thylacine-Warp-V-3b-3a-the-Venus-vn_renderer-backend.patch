diff --git a/src/virtio/vulkan/thylacine_prove.c b/src/virtio/vulkan/thylacine_prove.c
new file mode 100644
index 0000000..f284f0c
--- /dev/null
+++ b/src/virtio/vulkan/thylacine_prove.c
@@ -0,0 +1,51 @@
+/*
+ * Copyright 2026 The Thylacine Authors
+ * SPDX-License-Identifier: MIT
+ *
+ * V-3b-3a loader-less ICD proof (the virgl_prove.c analog for Venus).
+ *
+ * Thylacine has no dynamic loader (kernel/elf.c requires ET_EXEC with no
+ * PT_DYNAMIC), so there is no Vulkan loader to dlopen an ICD .so. This static
+ * ET_EXEC links libvulkan_virtio.a directly and resolves the ICD entry point
+ * -- vk_icdGetInstanceProcAddr -- by symbol, then dispatches one loader-less
+ * global command (vkEnumerateInstanceVersion, which needs no instance and no
+ * renderer transport). Proof that: (a) the static venus driver + the Thylacine
+ * backend link into a working ET_EXEC, and (b) the loader-less ICD entry
+ * resolves and dispatches. The renderer transport (V-3b-3b) is NOT exercised.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+
+#include <vulkan/vulkan.h>
+
+/* Defined in vn_icd.c; the driver's sole loader-facing entry. Declared here
+ * because the loader header (vk_icd.h) is not on this target's include path. */
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vk_icdGetInstanceProcAddr(VkInstance instance, const char *pName);
+
+int
+main(void)
+{
+   PFN_vkVoidFunction p =
+      vk_icdGetInstanceProcAddr(VK_NULL_HANDLE, "vkEnumerateInstanceVersion");
+   if (!p) {
+      printf("THYLACINE-VENUS-PROVE FAIL: "
+             "vk_icdGetInstanceProcAddr(vkEnumerateInstanceVersion) = NULL\n");
+      return 1;
+   }
+
+   uint32_t ver = 0;
+   VkResult r = ((PFN_vkEnumerateInstanceVersion)p)(&ver);
+   if (r != VK_SUCCESS) {
+      printf("THYLACINE-VENUS-PROVE FAIL: vkEnumerateInstanceVersion rc=%d\n", r);
+      return 1;
+   }
+
+   printf("THYLACINE-VENUS-PROVE PASS (loader-less ICD: "
+          "vk_icdGetInstanceProcAddr resolved + dispatched; "
+          "vkEnumerateInstanceVersion -> %u.%u.%u)\n",
+          VK_API_VERSION_MAJOR(ver), VK_API_VERSION_MINOR(ver),
+          VK_API_VERSION_PATCH(ver));
+   return 0;
+}
