 meson.build                               |  10 +
 src/virtio/vulkan/meson.build             | 115 ++++---
 src/virtio/vulkan/thylacine_prove.c       |  51 ++++
 src/virtio/vulkan/vn_renderer.h           |  13 +-
 src/virtio/vulkan/vn_renderer_thylacine.c | 353 ++++++++++++++++++++++
 6 files changed, 506 insertions(+), 38 deletions(-)
 create mode 100644 src/virtio/vulkan/thylacine_prove.c
 create mode 100644 src/virtio/vulkan/vn_renderer_thylacine.c

