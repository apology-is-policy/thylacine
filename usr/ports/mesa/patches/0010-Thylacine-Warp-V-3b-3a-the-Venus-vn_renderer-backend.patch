--- a/meson.build
+++ b/meson.build
@@ -168,6 +168,16 @@ system_has_kms_drm = ['openbsd', 'netbsd', 'freebsd', 'gnu/kfreebsd', 'dragonfly
 # keys on -- one signal, both layers.
 with_thylacine = cc.get_define('__thylacine__') != ''
 
+# Thylacine has no DRM device -- the /srv/warp seam (tapestryd) owns the GPU.
+# The cross file claims system = 'linux' (see above), which makes
+# system_has_kms_drm true and would force a hard libdrm dep plus a transitive
