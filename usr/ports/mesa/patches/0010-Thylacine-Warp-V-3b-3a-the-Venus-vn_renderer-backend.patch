+
+VkResult
+vn_renderer_create_thylacine(struct vn_instance *instance,
+                             const VkAllocationCallbacks *alloc,
+                             struct vn_renderer **renderer)
+{
+   struct thylacine *tly = vk_zalloc(alloc, sizeof(*tly), VN_DEFAULT_ALIGN,
+                                     VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!tly)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   tly->instance = instance;
+   tly->warp_root = -1;
+
+   VkResult result = thylacine_init(tly);
+   if (result != VK_SUCCESS) {
+      thylacine_destroy(&tly->base, alloc);
+      return result;
+   }
+
+   *renderer = &tly->base;
+
+   return VK_SUCCESS;
+}
