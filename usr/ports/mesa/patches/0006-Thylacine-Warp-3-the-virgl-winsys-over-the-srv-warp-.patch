diff --git a/meson.build b/meson.build
index fa82575..7c84bdd 100644
--- a/meson.build
+++ b/meson.build
@@ -159,6 +159,16 @@ with_any_opengl = with_opengl or with_gles1 or with_gles2
 
 system_has_kms_drm = ['openbsd', 'netbsd', 'freebsd', 'gnu/kfreebsd', 'dragonfly', 'linux', 'sunos', 'android', 'managarm'].contains(host_machine.system())
 
+# Thylacine (Warp-3): the cross file deliberately claims system = 'linux'
+# (its own comment explains why -- Mesa branches on host_machine.system()
+# in ~40 places and the linux arm assumes exactly the musl-shaped POSIX
+# pouch presents), so the system name cannot gate Thylacine-only build
+# arms. The compiler can: the aarch64-thylacine clang defines
+# __thylacine__, which is also what the source-level port (detect_os.h)
+# keys on -- one signal, both layers.
+with_thylacine = cc.get_define('__thylacine__') != ''
+
+
 gallium_drivers = get_option('gallium-drivers')
 if gallium_drivers.contains('auto')
   if system_has_kms_drm
diff --git a/src/gallium/auxiliary/target-helpers/inline_sw_helper.h b/src/gallium/auxiliary/target-helpers/inline_sw_helper.h
index ddb67b3..e48c589 100644
--- a/src/gallium/auxiliary/target-helpers/inline_sw_helper.h
+++ b/src/gallium/auxiliary/target-helpers/inline_sw_helper.h
@@ -39,7 +39,12 @@ sw_screen_create_named(struct sw_winsys *winsys, const char *driver)
       screen = llvmpipe_create_screen(winsys);
 #endif
 
-#if defined(GALLIUM_VIRGL)
+/* Thylacine: the vtest winsys does not exist there (no Unix-socket test
+ * server); GALLIUM_DRIVER=virpipe is handled one level up, in the osmesa
+ * target's screen fork, over the /srv/warp winsys -- so this arm is dead
+ * code that would only drag an undefined virgl_vtest_winsys_wrap into
+ * the link. */
+#if defined(GALLIUM_VIRGL) && !defined(__thylacine__)
    if (screen == NULL && strcmp(driver, "virpipe") == 0) {
       struct virgl_winsys *vws;
       vws = virgl_vtest_winsys_wrap(winsys);
diff --git a/src/gallium/drivers/virgl/meson.build b/src/gallium/drivers/virgl/meson.build
index 7ddcc90..a984ae0 100644
--- a/src/gallium/drivers/virgl/meson.build
+++ b/src/gallium/drivers/virgl/meson.build
@@ -16,16 +16,38 @@ files_libvirgl = files(
   'virgl_video.c',
 )
 
+# Thylacine (Warp-3): no libdrm exists there, and the driver core does
+# not use it (zero xf86drm includes; its drm-uapi headers are the
+# in-tree copies) -- the dependency belongs to the drm WINSYS, which
+# Thylacine does not build.
+virgl_core_deps = [idep_mesautil, idep_xmlconfig, idep_nir]
+if not with_thylacine
+  virgl_core_deps += dep_libdrm
+endif
+
+# <libsync.h> resolves from LIBDRM's installed copy upstream; without
+# dep_libdrm the include has no home. Mesa vendors an API-identical,
+# self-contained copy at src/util/libsync.h (inline ioctl wrappers over
+# headers pouch carries; virgl_context.c makes no sync_* calls -- the
+# include just has to parse). Thylacine-only, so the upstream resolution
+# is untouched.
+virgl_core_incs = [inc_include, inc_src, inc_gallium, inc_gallium_aux, inc_virtio]
+if with_thylacine
+  virgl_core_incs += include_directories('../../../util')
+endif
+
 libvirgl = static_library(
   'virgl',
   [ files_libvirgl ],
   gnu_symbol_visibility : 'hidden',
-  include_directories : [inc_include, inc_src, inc_gallium, inc_gallium_aux, inc_virtio],
-  dependencies : [dep_libdrm, idep_mesautil, idep_xmlconfig, idep_nir],
+  include_directories : virgl_core_incs,
+  dependencies : virgl_core_deps,
 )
 
 virgl_deps = [libvirgl]
-if not with_platform_windows
+if with_thylacine
+  virgl_deps += libvirglthylacine
+elif not with_platform_windows
   virgl_deps += libvirgldrm
   virgl_deps += libvirglvtest
 endif
diff --git a/src/gallium/drivers/virgl/virgl_screen.c b/src/gallium/drivers/virgl/virgl_screen.c
index 1e0b7cb..aabac4d 100644
--- a/src/gallium/drivers/virgl/virgl_screen.c
+++ b/src/gallium/drivers/virgl/virgl_screen.c
@@ -905,9 +905,13 @@ static void virgl_disk_cache_create(struct virgl_screen *screen)
    _mesa_blake3_init(&blake3_ctx);
 
 #if HAVE_BUILD_ID
+   /* A static link that never passed --build-id carries no note; without a
+    * build key the cache cannot be versioned, so run cacheless rather than
+    * abort. */
    const struct build_id_note *note =
       build_id_find_nhdr_for_addr(virgl_disk_cache_create);
-   assert(note);
+   if (!note)
+      return;
 
    unsigned build_id_len = build_id_length(note);
    assert(build_id_len == BUILD_ID_EXPECTED_HASH_LENGTH); /* sha1 */
diff --git a/src/gallium/meson.build b/src/gallium/meson.build
index d95ecb5..114154e 100644
--- a/src/gallium/meson.build
+++ b/src/gallium/meson.build
@@ -170,7 +170,13 @@ else
 endif
 if with_gallium_virgl
   subdir('winsys/virgl/common')
-  if not with_platform_windows
+  if with_thylacine
+    # Warp-3: the /srv/warp seam winsys. The drm winsys needs libdrm and
+    # the vtest winsys needs a Unix-socket test server; neither exists on
+    # Thylacine, and drivers/virgl selects its winsys set on the same
+    # condition.
+    subdir('winsys/virgl/thylacine')
+  elif not with_platform_windows
     subdir('winsys/virgl/drm')
     subdir('winsys/virgl/vtest')
   endif
diff --git a/src/gallium/targets/osmesa/meson.build b/src/gallium/targets/osmesa/meson.build
index e7b11cb..4ebd944 100644
--- a/src/gallium/targets/osmesa/meson.build
+++ b/src/gallium/targets/osmesa/meson.build
@@ -25,12 +25,34 @@
 # trying to RUN it on the builder; linking it is the proof, running it on-device
 # is the next one.
 
+# Warp-3: when virgl is enabled the target ALSO carries the virgl driver
+# + the Thylacine warp winsys, selected at runtime by GALLIUM_DRIVER in
+# osmesa_target.c (compiled in via driver_virgl's -DGALLIUM_VIRGL). The
+# archives ride link_whole for the same reason everything else here
+# does: build.sh links Thylacine binaries by hand, so libOSMesa.a must
+# be the whole closure. On the meson-side executables below the same
+# objects arriving again through driver_virgl's link_with is harmless --
+# archives are pull-based and every symbol is already defined.
+osmesa_link_whole = [
+  libosmesa_st, libgallium, libmesa, libws_null, libglapi, libglapi_bridge,
+]
+if with_gallium_virgl
+  # virgl_screen references the gallium VIDEO layer (vl_video_buffer_*);
+  # non-video targets satisfy it with the stub, exactly as the dri targets
+  # do when video is off. llvmpipe never referenced vl, which is why this
+  # target lived without it until virgl arrived.
+  osmesa_link_whole += [libvirgl, libvirglcommon, libgalliumvl_stub]
+  if with_thylacine
+    osmesa_link_whole += libvirglthylacine
+  endif
+endif
+
 libosmesa = static_library(
   'OSMesa',
   'osmesa_target.c',
   include_directories : [
     inc_include, inc_src, inc_gallium, inc_gallium_aux, inc_gallium_winsys,
-    inc_gallium_drivers,
+    inc_gallium_drivers, inc_virtio,
   ],
   # glapi is a PAIR at 26.1.6, and neither half is inside libmesa -- which is
   # what the first cut of this file assumed. libglapi (shared-glapi/core.c) has
@@ -42,11 +64,10 @@ libosmesa = static_library(
   #
   # The archive built perfectly well with neither, and again with only one. Only
   # linking the executable below ever said so.
-  link_whole : [
-    libosmesa_st, libgallium, libmesa, libws_null, libglapi, libglapi_bridge,
-  ],
+  link_whole : osmesa_link_whole,
   dependencies : [
-    dep_thread, dep_clock, dep_unwind, driver_swrast, idep_mesautil,
+    dep_thread, dep_clock, dep_unwind, driver_swrast, driver_virgl,
+    idep_mesautil,
   ],
   install : true,
 )
@@ -65,3 +86,21 @@ osmesa_prove = executable(
   ],
   install : true,
 )
+
+# The Warp-3 gate binary: the same link proof for the virgl+warp closure,
+# and the on-device prover for a triangle rendered on the HOST GPU. Built
+# only when the virgl driver is in the target -- on a llvmpipe-only
+# configure there is nothing for it to prove.
+if with_gallium_virgl
+  virgl_prove = executable(
+    'virgl-prove',
+    'virgl_prove.c',
+    include_directories : [inc_include, inc_src],
+    link_with : [libosmesa],
+    dependencies : [
+      dep_thread, dep_clock, dep_unwind, driver_swrast, driver_virgl,
+      idep_mesautil,
+    ],
+    install : true,
+  )
+endif
diff --git a/src/gallium/targets/osmesa/osmesa_target.c b/src/gallium/targets/osmesa/osmesa_target.c
index 25985dd..8967953 100644
--- a/src/gallium/targets/osmesa/osmesa_target.c
+++ b/src/gallium/targets/osmesa/osmesa_target.c
@@ -21,11 +21,21 @@
  */
 
 
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
 #include "target-helpers/inline_sw_helper.h"
 #include "target-helpers/inline_debug_helper.h"
 
 #include "sw/null/null_sw_winsys.h"
 
+#ifdef GALLIUM_VIRGL
+#include "virgl/virgl_public.h"
+#include "virgl/virgl_winsys.h"
+#include "virgl/thylacine/virgl_thylacine_public.h"
+#endif
+
 
 struct pipe_screen *
 osmesa_create_screen(void);
@@ -34,8 +44,36 @@ osmesa_create_screen(void);
 struct pipe_screen *
 osmesa_create_screen(void)
 {
-   struct sw_winsys *winsys;
    struct pipe_screen *screen;
+   struct sw_winsys *winsys;
+
+#ifdef GALLIUM_VIRGL
+   /* Warp-3: GALLIUM_DRIVER=virpipe (Mesa's own name for virgl-without-
+    * DRM, the vtest lane's spelling) or =virgl selects the /srv/warp
+    * seam: the unmodified virgl gallium driver over the Thylacine
+    * winsys, rendering on the HOST GPU through virglrenderer. The
+    * frontend above is unchanged either way -- it reads pixels back
+    * through ordinary pipe transfers, which on virgl become fenced
+    * TRANSFER_FROM_HOST_3D readbacks.
+    *
+    * Fallback is DELIBERATE and loud: a prover that must not pass on
+    * llvmpipe discriminates itself (GL_RENDERER + the absence of the
+    * CAP_JIT walk); an ordinary app asking for virgl on a 2D box still
+    * deserves a picture. */
+   const char *gd = getenv("GALLIUM_DRIVER");
+   if (gd && (strcmp(gd, "virpipe") == 0 || strcmp(gd, "virgl") == 0)) {
+      struct virgl_winsys *vws = virgl_thylacine_winsys_create();
+      if (vws) {
+         screen = virgl_create_screen(vws, NULL);
+         if (screen)
+            return debug_screen_wrap(screen);
+         vws->destroy(vws);
+      }
+      fprintf(stderr, "osmesa: GALLIUM_DRIVER=%s requested but the warp "
+                      "seam is unavailable; falling back to the software "
+                      "rasteriser\n", gd);
+   }
+#endif
 
    /* We use a null software winsys since we always just render to ordinary
     * driver resources.
diff --git a/src/gallium/targets/osmesa/virgl_prove.c b/src/gallium/targets/osmesa/virgl_prove.c
new file mode 100644
index 0000000..dfaa944
--- /dev/null
+++ b/src/gallium/targets/osmesa/virgl_prove.c
@@ -0,0 +1,203 @@
+/*
+ * virgl_prove.c -- the Warp-3 triangle-on-the-GPU prover.
+ * SPDX-License-Identifier: MIT
+ *
+ * The same two jobs as osmesa_prove.c: meson LINKS it to prove the
+ * virgl+thylacine-winsys closure closes, and on a GL host it RUNS to
+ * prove the whole Warp-3 path: the unmodified Mesa virgl driver encodes
+ * CCMD streams, the Thylacine winsys carries them over /srv/warp,
+ * tapestryd routes them to virtio-gpu, and virglrenderer rasterises on
+ * the HOST GPU -- then the pixels come back through a fenced
+ * TRANSFER_FROM_HOST_3D readback and are checked in-guest.
+ *
+ * Discrimination is structural, twice over (the #91/#109 discipline --
+ * a gate must prove WHICH mechanism produced its green):
+ *
+ *  1. This prover NEVER walks the CAP_JIT clearance. llvmpipe cannot
+ *     run without it (gallivm's first code Burrow fails, context
+ *     creation returns NULL), so a silent fallback to the software
+ *     rasteriser CANNOT paint the triangle -- it fails loudly instead
+ *     of passing on the wrong driver.
+ *  2. GL_RENDERER must name virgl and must not name llvmpipe.
+ *
+ * Exit: 0 PASS / 2 SKIP (no /srv/warp or a 2D device) / 1 FAIL.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "GL/osmesa.h"
+#include "GL/gl.h"
+
+#define W 64
+#define H 64
+
+#ifdef __thylacine__
+#include <stdint.h>
+#include <unistd.h>
+
+#define THYLA_SYS_OPEN  65
+#define THYLA_FROM_ROOT (-1L)
+#define THYLA_OREAD     0
+
+static long thyla_open(long dirfd, const char *name, unsigned long len,
+                       unsigned long omode)
+{
+    register long x0 __asm__("x0") = dirfd;
+    register long x1 __asm__("x1") = (long)(uintptr_t)name;
+    register long x2 __asm__("x2") = (long)len;
+    register long x3 __asm__("x3") = (long)omode;
+    register long x8 __asm__("x8") = THYLA_SYS_OPEN;
+    __asm__ volatile("svc #0"
+                     : "+r"(x0)
+                     : "r"(x1), "r"(x2), "r"(x3), "r"(x8)
+                     : "memory", "cc");
+    return x0;
+}
+
+/* SKIP is a first-class verdict, decided BEFORE any GL: on a 2D device
+ * the winsys would fall back to llvmpipe and the renderer assert would
+ * report a confusing FAIL where "not applicable" is the truth. Raw
+ * syscall open + musl read: pouch fds are kernel handles 1:1 (the same
+ * mix osmesa_prove.c uses on its corvus fd). */
+static int warp_seam_present(void)
+{
+    char buf[128];
+    long root, ctl;
+    ssize_t n;
+
+    root = thyla_open(THYLA_FROM_ROOT, "/srv/warp", 9, THYLA_OREAD);
+    if (root < 0)
+        return 0;
+    ctl = thyla_open(root, "ctl", 3, THYLA_OREAD);
+    close((int)root);
+    if (ctl < 0)
+        return 0;
+    n = read((int)ctl, buf, sizeof(buf) - 1);
+    close((int)ctl);
+    if (n <= 0)
+        return 0;
+    buf[n] = '\0';
+    return strncmp(buf, "virgl 1", 7) == 0;
+}
+#else
+static int warp_seam_present(void) { return 1; }
+#endif
+
+static const unsigned char *px(const unsigned char *buf, int x, int y)
+{
+    return buf + ((size_t)y * W + (size_t)x) * 4;
+}
+
+static int near(int got, int want, int tol)
+{
+    int d = got - want;
+    if (d < 0)
+        d = -d;
+    return d <= tol;
+}
+
+int main(void)
+{
+    OSMesaContext ctx;
+    unsigned char *buf;
+    const unsigned char *p;
+    const char *renderer;
+    int fails = 0;
+
+    if (!warp_seam_present()) {
+        printf("virgl-prove: SKIP -- no warp seam / 2D device\n");
+        return 2;
+    }
+
+    /* The screen fork in osmesa_target.c keys on this. Set here rather
+     * than required of the spawner: ut has no export (#151), and the
+     * prover's identity IS "the virgl path", so it selects itself. */
+    setenv("GALLIUM_DRIVER", "virpipe", 1);
+
+    ctx = OSMesaCreateContextExt(OSMESA_RGBA, 16, 0, 0, NULL);
+    if (!ctx) {
+        printf("virgl-prove: FAIL -- OSMesaCreateContextExt returned NULL "
+               "(the warp winsys or virgl screen did not come up)\n");
+        return 1;
+    }
+
+    buf = malloc((size_t)W * H * 4);
+    if (!buf) {
+        printf("virgl-prove: FAIL -- out of memory\n");
+        return 1;
+    }
+    memset(buf, 0xAB, (size_t)W * H * 4);
+
+    if (!OSMesaMakeCurrent(ctx, buf, GL_UNSIGNED_BYTE, W, H)) {
+        printf("virgl-prove: FAIL -- OSMesaMakeCurrent\n");
+        return 1;
+    }
+
+    renderer = (const char *)glGetString(GL_RENDERER);
+    printf("virgl-prove: GL_VERSION  = %s\n", (const char *)glGetString(GL_VERSION));
+    printf("virgl-prove: GL_RENDERER = %s\n", renderer ? renderer : "(null)");
+    if (!renderer || !strstr(renderer, "virgl")) {
+        printf("virgl-prove: FAIL -- renderer does not name virgl "
+               "(the draw would prove the wrong driver)\n");
+        return 1;
+    }
+    if (strstr(renderer, "llvmpipe")) {
+        /* The host's GL may itself be llvmpipe-backed on a GPU-less CI
+         * box -- but then the string is virgl's "virgl (llvmpipe...)"
+         * composite and the virgl check above already passed. A BARE
+         * llvmpipe string means the guest fell back. */
+        if (strncmp(renderer, "llvmpipe", 8) == 0) {
+            printf("virgl-prove: FAIL -- guest fell back to llvmpipe\n");
+            return 1;
+        }
+    }
+
+    /* Clear to blue -- necessary, not sufficient (host-side fast paths
+     * exist for clears too). */
+    glClearColor(0.0f, 0.0f, 1.0f, 1.0f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glFinish();
+
+    p = px(buf, 1, 1);
+    if (!near(p[0], 0, 4) || !near(p[1], 0, 4) || !near(p[2], 255, 4)) {
+        printf("virgl-prove: FAIL -- clear: corner is %u,%u,%u want 0,0,255\n",
+               p[0], p[1], p[2]);
+        fails++;
+    }
+
+    /* The triangle: vertex transform + fragment shading + rasterisation
+     * on the HOST renderer, readback through the fenced transfer path. */
+    glColor3f(1.0f, 0.0f, 0.0f);
+    glBegin(GL_TRIANGLES);
+    glVertex3f(-0.8f, -0.8f, 0.0f);
+    glVertex3f( 0.8f, -0.8f, 0.0f);
+    glVertex3f( 0.0f,  0.8f, 0.0f);
+    glEnd();
+    glFinish();
+
+    p = px(buf, W / 2, H / 3);
+    if (!near(p[0], 255, 8) || !near(p[1], 0, 8) || !near(p[2], 0, 8)) {
+        printf("virgl-prove: FAIL -- raster: interior is %u,%u,%u want 255,0,0\n",
+               p[0], p[1], p[2]);
+        fails++;
+    }
+    p = px(buf, 1, H - 2);
+    if (!near(p[2], 255, 8) || !near(p[0], 0, 8)) {
+        printf("virgl-prove: FAIL -- raster: exterior is %u,%u,%u want 0,0,255\n",
+               p[0], p[1], p[2]);
+        fails++;
+    }
+
+    OSMesaDestroyContext(ctx);
+    free(buf);
+
+    if (fails) {
+        printf("virgl-prove: FAIL (%d checks)\n", fails);
+        return 1;
+    }
+    printf("VIRGL-PROVE PASS (triangle rendered on the GPU via the warp seam, %dx%d)\n",
+           W, H);
+    return 0;
+}
