+ * The Thylacine winsys entry point (Warp-3).
+ *
+ * Returns NULL when the warp seam is unavailable (no /srv/warp in the
+ * namespace, a 2D device, or a pre-Warp-3 server) — the caller falls
+ * back to the software screen.
+ */
+#ifndef VIRGL_THYLACINE_PUBLIC_H
+#define VIRGL_THYLACINE_PUBLIC_H
+
+struct virgl_winsys;
+
+struct virgl_winsys *virgl_thylacine_winsys_create(void);
+
+#endif
diff --git a/src/gallium/winsys/virgl/thylacine/virgl_thylacine_winsys.c b/src/gallium/winsys/virgl/thylacine/virgl_thylacine_winsys.c
new file mode 100644
index 0000000..0f41da8
--- /dev/null
+++ b/src/gallium/winsys/virgl/thylacine/virgl_thylacine_winsys.c
@@ -0,0 +1,631 @@
+/*
+ * virgl_thylacine_winsys — the Mesa virgl winsys over Thylacine's
+ * /srv/warp GPU seam (Warp-3; GPU-DESIGN.md section 12 row 3).
+ *
+ * Shape: the vtest backend's 18 load-bearing slots, minus every
+ * displaytarget/sw_winsys arm — on Thylacine the OSMesa frontend reads
+ * the front buffer back through ordinary pipe transfers, so the winsys
+ * never touches a display target and `flush_frontbuffer` stays NULL
+ * (guarded at virgl_screen.c). The transport is warp_client.{c,h}: a
+ * 9P connection whose ops are blocking file reads/writes, with fences
+ * counted client-side against the seam's monotonic per-ctx
+ * `fence-signaled` counter (see warp_client.h for why the fence FILE
+ * alone cannot carry the model).
+ *
+ * Semantics pinned here rather than left to intuition:
+ *
+ *  - transfer_get is SYNCHRONOUS: the seam's transfer verbs are fenced
+ *    and complete asynchronously, but the driver maps and reads the
+ *    backing immediately after transfer_get returns (virgl_resource.c
+ *    readback path), so this slot queues the device->guest transfer AND
+ *    waits its fence. vtest's protocol-v2 arm makes the same choice
+ *    (busy_wait WAIT inside the get). transfer_put stays asynchronous;
+ *    ordering against later submits is the ring's FIFO.
+ *
+ *  - resource_wait/resource_is_busy ride a per-resource
+ *    `last_use_seq`, stamped by every transfer naming the resource and
+ *    by every submit whose command stream references it (the emit_res
+ *    bo list — the same list vtest keeps). `signaled >= last_use_seq`
+ *    is "the device is done with it", by ring FIFO.
+ *
+ *  - One mutex serializes every RPC-bearing entry point. The
+ *    connection is a single 9P stream and GL contexts are effectively
+ *    single-threaded here (OSMesa current-context); the lock exists so
+ *    screen-level create/destroy from a second thread is safe, not as
+ *    a concurrency design. Internal helpers are unlocked; only vtable
+ *    entry points take the lock (cache callbacks run under it).
+ *
+ *  - A hard failure LATCHES (warp_client wedge): submits that cannot
+ *    be delivered would otherwise silently corrupt all later GL state,
+ *    because the driver ignores submit_cmd's return (virgl_context.c).
+ *    Wedged, every wait unblocks and every new op fails fast.
+ */
+#include <stdio.h>
+
+#include "util/u_memory.h"
+#include "util/u_inlines.h"
+#include "util/u_thread.h"
+#include "util/macros.h"
+#include "pipe/p_state.h"
+
+#include "virgl/virgl_winsys.h"
+#include "virgl_resource_cache.h"
+#include "virgl_thylacine_public.h"
+#include "warp_client.h"
+
+#define THY_CACHE_TIMEOUT_USEC 1000000
+
+struct virgl_hw_res {
+   struct pipe_reference reference;
+   uint32_t res_handle;    /* device-global id: what command streams name */
+   uint32_t bo_pub;        /* the seam's BO id: what the ctl tree names */
+   int num_cs_references;
+   void *ptr;              /* the weft mapping; NULL until first map */
+   long map_fd;            /* owns the mapping; -1 until first map */
+   uint32_t size;          /* page-rounded backing size */
+   uint32_t format;        /* pipe format (cache identity only) */
+   uint32_t bind;          /* virgl bind (cache identity + policy) */
+   uint32_t width, height;
+   uint64_t last_use_seq;  /* newest fenced op touching this res */
+   struct virgl_resource_cache_entry cache_entry;
+};
+
+struct virgl_thylacine_winsys {
+   struct virgl_winsys base;
+   struct warp_conn conn;
+   struct virgl_resource_cache cache;
+   mtx_t mutex;
+};
+
+struct virgl_thylacine_cmd_buf {
+   struct virgl_cmd_buf base;
+   uint32_t *buf;
+   unsigned nres;
+   unsigned cres;
+   struct virgl_hw_res **res_bo;
+   struct virgl_winsys *ws;
+};
+
+#define cache_entry_container_res(ptr) \
+   (struct virgl_hw_res *)((char *)ptr - offsetof(struct virgl_hw_res, cache_entry))
+
+static inline struct virgl_thylacine_winsys *
+virgl_thylacine_winsys(struct virgl_winsys *vws)
+{
+   return (struct virgl_thylacine_winsys *)vws;
+}
+
+static inline struct virgl_thylacine_cmd_buf *
+virgl_thylacine_cmd_buf(struct virgl_cmd_buf *cbuf)
+{
+   return (struct virgl_thylacine_cmd_buf *)cbuf;
+}
+
+/* Fences are seq numbers with a refcount — nothing server-side. */
+struct thy_fence {
+   struct pipe_reference reference;
+   uint64_t seq;
+};
+
+static inline struct thy_fence *thy_fence(struct pipe_fence_handle *f)
+{
+   return (struct thy_fence *)f;
+}
+
+static inline bool can_cache_resource_with_bind(uint32_t bind)
+{
+   return bind == VIRGL_BIND_CONSTANT_BUFFER ||
+          bind == VIRGL_BIND_INDEX_BUFFER ||
+          bind == VIRGL_BIND_VERTEX_BUFFER ||
+          bind == VIRGL_BIND_CUSTOM ||
+          bind == VIRGL_BIND_STAGING;
+}
+
+/* ---- unlocked internals ------------------------------------------------ */
+
+static void thy_hw_res_destroy(struct virgl_thylacine_winsys *tws,
+                               struct virgl_hw_res *res)
+{
+   warp_bo_destroy(&tws->conn, res->bo_pub, res->map_fd);
+   FREE(res);
+}
+
+static bool thy_res_is_busy_unlocked(struct virgl_thylacine_winsys *tws,
+                                     struct virgl_hw_res *res)
+{
+   if (warp_wedged(&tws->conn))
+      return false; /* nothing will ever complete */
+   if (tws->conn.signaled >= res->last_use_seq)
+      return false;
+   (void)warp_fence_refresh(&tws->conn);
+   return tws->conn.signaled < res->last_use_seq;
+}
+
+static void thy_res_wait_unlocked(struct virgl_thylacine_winsys *tws,
+                                  struct virgl_hw_res *res)
+{
+   (void)warp_fence_wait(&tws->conn, res->last_use_seq);
+}
+
+static void thy_resource_reference_unlocked(struct virgl_thylacine_winsys *tws,
+                                            struct virgl_hw_res **dres,
+                                            struct virgl_hw_res *sres)
+{
+   struct virgl_hw_res *old = *dres;
+   if (pipe_reference(&(*dres)->reference, &sres->reference)) {
+      if (!can_cache_resource_with_bind(old->bind)) {
+         thy_hw_res_destroy(tws, old);
+      } else {
+         virgl_resource_cache_add(&tws->cache, &old->cache_entry);
+      }
+   }
+   *dres = sres;
+}
+
+/* ---- resources --------------------------------------------------------- */
+
+static struct virgl_hw_res *
+thy_resource_create_unlocked(struct virgl_thylacine_winsys *tws,
+                             enum pipe_texture_target target,
+                             uint32_t format, uint32_t bind,
+                             uint32_t width, uint32_t height,
+                             uint32_t depth, uint32_t array_size,
+                             uint32_t last_level, uint32_t nr_samples,
+                             uint32_t flags, uint32_t size)
+{
+   struct virgl_hw_res *res = CALLOC_STRUCT(virgl_hw_res);
+   uint32_t sz = size;
+   uint32_t res_id = 0;
+   uint32_t bo;
+
+   if (!res)
+      return NULL;
+
+   bo = warp_bo_create(&tws->conn, (uint32_t)target,
+                       (uint32_t)pipe_to_virgl_format(format), bind,
+                       width, height, depth, array_size, last_level,
+                       nr_samples, flags, &sz, &res_id);
+   if (bo == 0) {
+      FREE(res);
+      return NULL;
+   }
+
+   res->res_handle = res_id;
+   res->bo_pub = bo;
+   res->map_fd = -1;
+   res->size = sz;
+   res->format = format;
+   res->bind = bind;
+   res->width = width;
+   res->height = height;
+
+   struct virgl_resource_params params = { .size = sz,
+                                           .bind = bind,
+                                           .format = format,
+                                           .flags = 0,
+                                           .nr_samples = nr_samples,
+                                           .width = width,
+                                           .height = height,
+                                           .depth = depth,
+                                           .array_size = array_size,
+                                           .last_level = last_level,
+                                           .target = target };
+   virgl_resource_cache_entry_init(&res->cache_entry, params);
+   pipe_reference_init(&res->reference, 1);
+   p_atomic_set(&res->num_cs_references, 0);
+   return res;
+}
+
+static struct virgl_hw_res *
+virgl_thylacine_resource_cache_create(struct virgl_winsys *vws,
+                                      enum pipe_texture_target target,
+                                      const void *map_front_private,
+                                      uint32_t format, uint32_t bind,
+                                      uint32_t width, uint32_t height,
+                                      uint32_t depth, uint32_t array_size,
+                                      uint32_t last_level, uint32_t nr_samples,
+                                      uint32_t flags, uint32_t size)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   struct virgl_hw_res *res;
+   struct virgl_resource_cache_entry *entry;
+   struct virgl_resource_params params = { .size = size,
+                                           .bind = bind,
+                                           .format = format,
+                                           .flags = 0,
+                                           .nr_samples = nr_samples,
+                                           .width = width,
+                                           .height = height,
+                                           .depth = depth,
+                                           .array_size = array_size,
+                                           .last_level = last_level,
+                                           .target = target };
+   (void)map_front_private; /* the sw-dt front-map path: never taken here */
+
+   mtx_lock(&tws->mutex);
+   if (can_cache_resource_with_bind(bind)) {
+      /* The cache keys on the DRIVER-requested size; a cached entry's
+       * page-rounded backing satisfies it by construction. */
+      entry = virgl_resource_cache_remove_compatible(&tws->cache, params);
+      if (entry) {
+         res = cache_entry_container_res(entry);
+         mtx_unlock(&tws->mutex);
+         pipe_reference_init(&res->reference, 1);
+         return res;
+      }
+   }
+   res = thy_resource_create_unlocked(tws, target, format, bind, width,
+                                      height, depth, array_size, last_level,
+                                      nr_samples, flags, size);
+   mtx_unlock(&tws->mutex);
+   return res;
+}
+
+static void virgl_thylacine_resource_reference(struct virgl_winsys *vws,
+                                               struct virgl_hw_res **dres,
+                                               struct virgl_hw_res *sres)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   mtx_lock(&tws->mutex);
+   thy_resource_reference_unlocked(tws, dres, sres);
+   mtx_unlock(&tws->mutex);
+}
+
+static void *virgl_thylacine_resource_map(struct virgl_winsys *vws,
+                                          struct virgl_hw_res *res)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   if (res->ptr)
+      return res->ptr;
+   mtx_lock(&tws->mutex);
+   if (!res->ptr)
+      res->ptr = warp_bo_map(&tws->conn, res->bo_pub, &res->map_fd);
+   mtx_unlock(&tws->mutex);
+   return res->ptr;
+}
+
+static void virgl_thylacine_resource_wait(struct virgl_winsys *vws,
+                                          struct virgl_hw_res *res)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   mtx_lock(&tws->mutex);
+   thy_res_wait_unlocked(tws, res);
+   mtx_unlock(&tws->mutex);
+}
+
+static bool virgl_thylacine_resource_is_busy(struct virgl_winsys *vws,
+                                             struct virgl_hw_res *res)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   bool busy;
+   mtx_lock(&tws->mutex);
+   busy = thy_res_is_busy_unlocked(tws, res);
+   mtx_unlock(&tws->mutex);
+   return busy;
+}
+
+/* ---- transfers --------------------------------------------------------- */
+
+static int virgl_thylacine_transfer_put(struct virgl_winsys *vws,
+                                        struct virgl_hw_res *res,
+                                        const struct pipe_box *box,
+                                        uint32_t stride, uint32_t layer_stride,
+                                        uint32_t buf_offset, uint32_t level)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   uint64_t seq;
+   mtx_lock(&tws->mutex);
+   seq = warp_transfer(&tws->conn, res->bo_pub, true, level,
+                       box->x, box->y, box->z,
+                       box->width, box->height, box->depth,
+                       buf_offset, stride, layer_stride);
+   if (seq)
+      res->last_use_seq = seq;
+   mtx_unlock(&tws->mutex);
+   return seq ? 0 : -1;
+}
+
+static int virgl_thylacine_transfer_get(struct virgl_winsys *vws,
+                                        struct virgl_hw_res *res,
+                                        const struct pipe_box *box,
+                                        uint32_t stride, uint32_t layer_stride,
+                                        uint32_t buf_offset, uint32_t level)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   uint64_t seq;
+   int ret = -1;
+   mtx_lock(&tws->mutex);
+   seq = warp_transfer(&tws->conn, res->bo_pub, false, level,
+                       box->x, box->y, box->z,
+                       box->width, box->height, box->depth,
+                       buf_offset, stride, layer_stride);
+   if (seq) {
+      res->last_use_seq = seq;
+      /* Synchronous by contract: the caller maps and reads on return. */
+      ret = warp_fence_wait(&tws->conn, seq) == 0 ? 0 : -1;
+   }
+   mtx_unlock(&tws->mutex);
+   return ret;
+}
+
+/* ---- command buffers + submit ------------------------------------------ */
+
+static struct virgl_cmd_buf *
+virgl_thylacine_cmd_buf_create(struct virgl_winsys *vws, uint32_t size)
+{
+   struct virgl_thylacine_cmd_buf *cbuf = CALLOC_STRUCT(virgl_thylacine_cmd_buf);
+   if (!cbuf)
+      return NULL;
+   cbuf->nres = 512;
+   cbuf->res_bo = CALLOC(cbuf->nres, sizeof(struct virgl_hw_res *));
+   if (!cbuf->res_bo) {
+      FREE(cbuf);
+      return NULL;
+   }
+   cbuf->buf = CALLOC(size, sizeof(uint32_t));
+   if (!cbuf->buf) {
+      FREE(cbuf->res_bo);
+      FREE(cbuf);
+      return NULL;
+   }
+   cbuf->ws = vws;
+   cbuf->base.buf = cbuf->buf;
+   return &cbuf->base;
+}
+
+static void thy_release_all_res(struct virgl_thylacine_winsys *tws,
+                                struct virgl_thylacine_cmd_buf *cbuf)
+{
+   unsigned i;
+   for (i = 0; i < cbuf->cres; i++) {
+      p_atomic_dec(&cbuf->res_bo[i]->num_cs_references);
+      thy_resource_reference_unlocked(tws, &cbuf->res_bo[i], NULL);
+   }
+   cbuf->cres = 0;
+}
+
+static void virgl_thylacine_cmd_buf_destroy(struct virgl_cmd_buf *_cbuf)
+{
+   struct virgl_thylacine_cmd_buf *cbuf = virgl_thylacine_cmd_buf(_cbuf);
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(cbuf->ws);
+   mtx_lock(&tws->mutex);
+   thy_release_all_res(tws, cbuf);
+   mtx_unlock(&tws->mutex);
+   FREE(cbuf->res_bo);
+   FREE(cbuf->buf);
+   FREE(cbuf);
+}
+
+static bool thy_res_is_added(struct virgl_thylacine_cmd_buf *cbuf,
+                             struct virgl_hw_res *res)
+{
+   unsigned i;
+   for (i = 0; i < cbuf->cres; i++)
+      if (cbuf->res_bo[i] == res)
+         return true;
+   return false;
+}
+
+static void virgl_thylacine_emit_res(struct virgl_winsys *vws,
+                                     struct virgl_cmd_buf *_cbuf,
+                                     struct virgl_hw_res *res, bool write_buf)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   struct virgl_thylacine_cmd_buf *cbuf = virgl_thylacine_cmd_buf(_cbuf);
+
+   if (write_buf)
+      cbuf->base.buf[cbuf->base.cdw++] = res->res_handle;
+
+   if (thy_res_is_added(cbuf, res))
+      return;
+
+   if (cbuf->cres >= cbuf->nres) {
+      unsigned new_nres = cbuf->nres + 256;
+      struct virgl_hw_res **grown =
+         REALLOC(cbuf->res_bo, cbuf->nres * sizeof(struct virgl_hw_res *),
+                 new_nres * sizeof(struct virgl_hw_res *));
+      if (!grown) {
+         fprintf(stderr, "warp winsys: failed to grow the relocation list "
+                         "(%u)\n", cbuf->cres);
+         return;
+      }
+      cbuf->res_bo = grown;
+      cbuf->nres = new_nres;
+   }
+
+   cbuf->res_bo[cbuf->cres] = NULL;
+   mtx_lock(&tws->mutex);
+   thy_resource_reference_unlocked(tws, &cbuf->res_bo[cbuf->cres], res);
+   mtx_unlock(&tws->mutex);
+   p_atomic_inc(&res->num_cs_references);
+   cbuf->cres++;
+}
+
+static bool virgl_thylacine_res_is_ref(struct virgl_winsys *vws,
+                                       struct virgl_cmd_buf *_cbuf,
+                                       struct virgl_hw_res *res)
+{
+   return p_atomic_read(&res->num_cs_references) != 0;
+}
+
+static struct pipe_fence_handle *thy_fence_create(uint64_t seq)
+{
+   struct thy_fence *f = CALLOC_STRUCT(thy_fence);
+   if (!f)
+      return NULL;
+   pipe_reference_init(&f->reference, 1);
+   f->seq = seq;
+   return (struct pipe_fence_handle *)f;
+}
+
+static int virgl_thylacine_submit_cmd(struct virgl_winsys *vws,
+                                      struct virgl_cmd_buf *_cbuf,
+                                      struct pipe_fence_handle **fence)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   struct virgl_thylacine_cmd_buf *cbuf = virgl_thylacine_cmd_buf(_cbuf);
+   uint64_t seq = 0;
+   unsigned i;
+   int ret = 0;
+
+   if (cbuf->base.cdw == 0)
+      return 0;
+
+   mtx_lock(&tws->mutex);
+   seq = warp_submit(&tws->conn, cbuf->base.buf, cbuf->base.cdw);
+   if (seq) {
+      /* Every resource this stream references is in-use until the
+       * LAST chunk's fence retires (ring FIFO). */
+      for (i = 0; i < cbuf->cres; i++)
+         cbuf->res_bo[i]->last_use_seq = seq;
+      if (fence)
+         *fence = thy_fence_create(seq);
+   } else {
+      ret = -1; /* warp_submit latched + reported */
+   }
+   thy_release_all_res(tws, cbuf);
+   mtx_unlock(&tws->mutex);
+   cbuf->base.cdw = 0;
+   return ret;
+}
+
+/* ---- caps + fences ------------------------------------------------------ */
+
+static int virgl_thylacine_get_caps(struct virgl_winsys *vws,
+                                    struct virgl_drm_caps *caps)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   long n;
+
+   virgl_ws_fill_new_caps_defaults(caps);
+   mtx_lock(&tws->mutex);
+   n = warp_read_caps(&tws->conn, &caps->caps, sizeof(caps->caps));
+   mtx_unlock(&tws->mutex);
+   if (n <= 0)
+      return -1;
+
+   /* Mirror vtest: without blob support the host->guest copy-transfer
+    * path has nowhere to land, and stripping it also keeps textures on
+    * real (mappable) backings rather than 1-byte staging stand-ins. */
+   caps->caps.v2.capability_bits_v2 &= ~VIRGL_CAP_V2_COPY_TRANSFER_BOTH_DIRECTIONS;
+   return 0;
+}
+
+static struct pipe_fence_handle *
+virgl_thylacine_cs_create_fence(struct virgl_winsys *vws, int fd)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   (void)fd; /* fd fences are the DRM path; supports_fences = 0 */
+   return thy_fence_create(tws->conn.issued);
+}
+
+static bool virgl_thylacine_fence_wait(struct virgl_winsys *vws,
+                                       struct pipe_fence_handle *fence,
+                                       uint64_t timeout)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   struct thy_fence *f = thy_fence(fence);
+   bool done;
+
+   mtx_lock(&tws->mutex);
+   if (warp_wedged(&tws->conn)) {
+      mtx_unlock(&tws->mutex);
+      return true; /* dead pipeline: end every wait, fail elsewhere */
+   }
+   if (tws->conn.signaled < f->seq)
+      (void)warp_fence_refresh(&tws->conn);
+   done = tws->conn.signaled >= f->seq;
+   if (!done && timeout != 0) {
+      /* Finite timeouts are coarsened to the wait's own progress
+       * events: the fence is in flight, so a retirement (or the poison
+       * EOF, which latches and unblocks) is coming. Nothing on the
+       * OSMesa path passes a finite timeout. Either way the wait is
+       * over on return: 0 = signaled; -1 = wedged (latched + loud). */
+      (void)warp_fence_wait(&tws->conn, f->seq);
+      done = true;
+   }
+   mtx_unlock(&tws->mutex);
+   return done;
+}
+
+static void virgl_thylacine_fence_reference(struct virgl_winsys *vws,
+                                            struct pipe_fence_handle **dst,
+                                            struct pipe_fence_handle *src)
+{
+   struct thy_fence *dfence = thy_fence(*dst);
+   struct thy_fence *sfence = thy_fence(src);
+   if (pipe_reference(dfence ? &dfence->reference : NULL,
+                      sfence ? &sfence->reference : NULL))
+      FREE(dfence);
+   *dst = src;
+}
+
+/* ---- cache callbacks (run under the winsys mutex) ---------------------- */
+
+static bool
+thy_cache_entry_is_busy(struct virgl_resource_cache_entry *entry, void *user)
+{
+   struct virgl_thylacine_winsys *tws = user;
+   return thy_res_is_busy_unlocked(tws, cache_entry_container_res(entry));
+}
+
+static void
+thy_cache_entry_release(struct virgl_resource_cache_entry *entry, void *user)
+{
+   struct virgl_thylacine_winsys *tws = user;
+   thy_hw_res_destroy(tws, cache_entry_container_res(entry));
+}
+
+/* ---- lifecycle ---------------------------------------------------------- */
+
+static void virgl_thylacine_winsys_destroy(struct virgl_winsys *vws)
+{
+   struct virgl_thylacine_winsys *tws = virgl_thylacine_winsys(vws);
+   mtx_lock(&tws->mutex);
+   virgl_resource_cache_flush(&tws->cache);
+   warp_close(&tws->conn);
+   mtx_unlock(&tws->mutex);
+   mtx_destroy(&tws->mutex);
+   FREE(tws);
+}
+
+struct virgl_winsys *virgl_thylacine_winsys_create(void)
+{
+   struct virgl_thylacine_winsys *tws = CALLOC_STRUCT(virgl_thylacine_winsys);
+   if (!tws)
+      return NULL;
+
+   if (warp_open(&tws->conn) != 0) {
+      FREE(tws);
+      return NULL;
+   }
+
+   virgl_resource_cache_init(&tws->cache, THY_CACHE_TIMEOUT_USEC,
+                             thy_cache_entry_is_busy,
+                             thy_cache_entry_release, tws);
+   (void)mtx_init(&tws->mutex, mtx_plain);
+
+   tws->base.destroy = virgl_thylacine_winsys_destroy;
+   tws->base.transfer_put = virgl_thylacine_transfer_put;
+   tws->base.transfer_get = virgl_thylacine_transfer_get;
+   tws->base.resource_create = virgl_thylacine_resource_cache_create;
+   tws->base.resource_reference = virgl_thylacine_resource_reference;
+   tws->base.resource_map = virgl_thylacine_resource_map;
+   tws->base.resource_wait = virgl_thylacine_resource_wait;
+   tws->base.resource_is_busy = virgl_thylacine_resource_is_busy;
+   tws->base.cmd_buf_create = virgl_thylacine_cmd_buf_create;
+   tws->base.cmd_buf_destroy = virgl_thylacine_cmd_buf_destroy;
+   tws->base.submit_cmd = virgl_thylacine_submit_cmd;
+   tws->base.emit_res = virgl_thylacine_emit_res;
+   tws->base.res_is_referenced = virgl_thylacine_res_is_ref;
+   tws->base.get_caps = virgl_thylacine_get_caps;
+   tws->base.cs_create_fence = virgl_thylacine_cs_create_fence;
+   tws->base.fence_wait = virgl_thylacine_fence_wait;
+   tws->base.fence_reference = virgl_thylacine_fence_reference;
+
+   tws->base.supports_fences = 0;        /* fd fences are DRM-only */
+   tws->base.supports_encoded_transfers = 1; /* uploads ride the cmdbuf */
+   tws->base.supports_coherent = 0;      /* F2: no blobs at this tier */
+
+   return &tws->base;
+}
diff --git a/src/gallium/winsys/virgl/thylacine/warp_client.c b/src/gallium/winsys/virgl/thylacine/warp_client.c
new file mode 100644
index 0000000..22e81b8
--- /dev/null
+++ b/src/gallium/winsys/virgl/thylacine/warp_client.c
@@ -0,0 +1,417 @@
+/*
+ * warp_client — Thylacine /srv/warp seam client (see warp_client.h).
+ *
+ * Everything here is blocking file ops over the raw syscall layer
+ * (<thyla/syscall.h>, the same substrate as the SDL port's thyla_tap):
+ * musl never sees these fds, so nothing below libc buffers or retries.
+ * Thylacine errnos are POSIX-value-pinned (the kernel's errno registry
+ * static-asserts the alignment), so musl's <errno.h> names are the
+ * correct comparators for the negative returns.
+ */
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <thyla/syscall.h>
+
+#include "warp_client.h"
+
+#define WARP_PAGE 4096u
+
+/* One write = one atomic submission, so every write must arrive at the
+ * server as ONE Twrite. /srv/warp is a default-msize service (32 KiB
+ * rings); past the iounit the kernel 9P client would fragment a large
+ * write into several Twrites, each of which the server would decode as
+ * its own submission — splitting mid-command. 24 KiB leaves margin
+ * under both the iounit (msize - 23) and the server's 64 KiB slot. */
+#define WARP_CHUNK_BYTES (24u * 1024u)
+#define WARP_CHUNK_DWORDS (WARP_CHUNK_BYTES / 4u)
+
+/* Client-side mirror of the server's per-ctx fenced-lane share
+ * (WARP_CTX_FENCE_MAX = FENCED_SLOTS / 2). Purely an optimization to
+ * make E_AGAIN rare — the retry loop below is the correctness path, so
+ * server-side drift costs a retry, never a wrong answer. */
+#define WARP_MAX_INFLIGHT 2u
+
+static long open_at(long root, const char *path, unsigned long omode)
+{
+   return t_open(root, path, strlen(path), omode);
+}
+
+/* Read a fresh snapshot of a small text file into buf (NUL-terminated).
+ * The server regenerates ctl content per read, so offset 0 always sees
+ * a whole current snapshot. Returns the length or -1. */
+static long read_snapshot(long fd, char *buf, unsigned long cap)
+{
+   long n = t_pread(fd, buf, cap - 1, 0);
+   if (n < 0)
+      return -1;
+   buf[n] = '\0';
+   return n;
+}
+
+static long open_read_snapshot(long root, const char *path, char *buf,
+                               unsigned long cap)
+{
+   long fd = open_at(root, path, T_OREAD);
+   long n;
+   if (fd < 0)
+      return -1;
+   n = read_snapshot(fd, buf, cap);
+   t_close(fd);
+   return n;
+}
+
+/* Parse "<key> <u64>" out of a "k v\n"-per-line snapshot. -1 if absent. */
+static long long parse_field(const char *s, const char *key)
+{
+   size_t klen = strlen(key);
+   const char *p = s;
+   while (p && *p) {
+      if (!strncmp(p, key, klen) && p[klen] == ' ') {
+         unsigned long long v = 0;
+         const char *q = p + klen + 1;
+         if (*q < '0' || *q > '9')
+            return -1;
+         while (*q >= '0' && *q <= '9')
+            v = v * 10 + (unsigned long long)(*q++ - '0');
+         return (long long)v;
+      }
+      p = strchr(p, '\n');
+      if (p)
+         p++;
+   }
+   return -1;
+}
+
+static int write_verb(long root, const char *path, const char *verb)
+{
+   long fd = open_at(root, path, T_OWRITE);
+   long n;
+   size_t len = strlen(verb);
+   if (fd < 0)
+      return -1;
+   n = t_write(fd, verb, len);
+   t_close(fd);
+   return (n == (long)len) ? 0 : -1;
+}
+
+/* Mint via the open+read idiom: reading <dir>/new yields "<id>\n". */
+static uint32_t mint_id(long root, const char *path)
+{
+   char buf[32];
+   uint32_t id = 0;
+   const char *q = buf;
+   if (open_read_snapshot(root, path, buf, sizeof(buf)) <= 0)
+      return 0;
+   if (*q < '0' || *q > '9')
+      return 0;
+   while (*q >= '0' && *q <= '9')
+      id = id * 10 + (uint32_t)(*q++ - '0');
+   return id;
+}
+
+int warp_fence_refresh(struct warp_conn *w)
+{
+   char buf[256];
+   long long v;
+   if (read_snapshot(w->ctx_ctl_fd, buf, sizeof(buf)) < 0)
+      return -1;
+   v = parse_field(buf, "fence-signaled");
+   if (v < 0)
+      return -1;
+   w->signaled = (uint64_t)v;
+   return 0;
+}
+
+/* Block until at least one fence retires, then refresh the counter.
+ * ONLY sound with in-flight > 0 (else the read parks unfillably); every
+ * caller checks. EOF means the ctx was poisoned or torn down: latch. */
+static int wait_progress(struct warp_conn *w)
+{
+   char rec[64];
+   long n = t_read(w->fence_fd, rec, sizeof(rec));
+   if (n <= 0) {
+      if (!w->wedged) {
+         fprintf(stderr, "warp: fence stream %s -- context is dead "
+                         "(poisoned or torn down); latching\n",
+                 n == 0 ? "EOF" : "error");
+         w->wedged = true;
+      }
+      return -1;
+   }
+   return warp_fence_refresh(w);
+}
+
+int warp_fence_wait(struct warp_conn *w, uint64_t seq)
+{
+   if (w->signaled >= seq)
+      return 0;
+   if (warp_fence_refresh(w) < 0)
+      return -1;
+   while (w->signaled < seq) {
+      /* seq <= issued and signaled < seq, so in-flight > 0: the park
+       * is fillable (a retirement or the poison EOF is coming). */
+      if (wait_progress(w) < 0)
+         return -1;
+   }
+   return 0;
+}
+
+/* The common fenced write: throttle under the per-ctx lane share, retry
+ * E_AGAIN by parking on the fence file (the lane's own back-pressure),
+ * and count the issue on success. Returns the seq or 0. */
+static uint64_t fenced_write(struct warp_conn *w, long fd, const void *buf,
+                             unsigned long len)
+{
+   int attempts;
+   if (w->wedged)
+      return 0;
+   for (attempts = 0; attempts < 64; attempts++) {
+      long n;
+      while (w->issued - w->signaled >= WARP_MAX_INFLIGHT) {
+         if (wait_progress(w) < 0)
+            return 0;
+      }
+      n = t_write(fd, buf, len);
+      if (n == (long)len)
+         return ++w->issued;
+      if (n == -EAGAIN) {
+         /* Lane momentarily full (another client's chains). If we have
+          * something in flight, park on it; otherwise the contention is
+          * foreign and a yield is all we can offer. */
+         if (w->issued > w->signaled) {
+            if (wait_progress(w) < 0)
+               return 0;
+         } else {
+            t_yield();
+         }
+         continue;
+      }
+      return 0; /* E_IO (poisoned / engine dead) or transport failure */
+   }
+   return 0;
+}
+
+uint64_t warp_submit(struct warp_conn *w, const uint32_t *dw, uint32_t ndw)
+{
+   uint32_t i = 0;
+   uint64_t seq = 0;
+   if (w->wedged)
+      return 0;
+   while (i < ndw) {
+      /* Greedy chunk at CCMD boundaries: dword 0 of each command is
+       * (len << 16 | ...), the payload follows. */
+      uint32_t start = i;
+      uint32_t chunk = 0;
+      while (i < ndw) {
+         uint32_t cmd_dw = 1 + (dw[i] >> 16);
+         if (cmd_dw > WARP_CHUNK_DWORDS) {
+            fprintf(stderr, "warp: single command of %u dwords exceeds "
+                            "the %u-dword submit bound -- the byte seam "
+                            "cannot carry it (GPU-DESIGN 4.1 is the "
+                            "successor); latching\n",
+                    cmd_dw, WARP_CHUNK_DWORDS);
+            w->wedged = true;
+            return 0;
+         }
+         if (chunk + cmd_dw > WARP_CHUNK_DWORDS)
+            break;
+         chunk += cmd_dw;
+         i += cmd_dw;
+      }
+      seq = fenced_write(w, w->submit_fd, dw + start, (unsigned long)chunk * 4);
+      if (seq == 0) {
+         if (!w->wedged) {
+            fprintf(stderr, "warp: submit failed -- a dropped command "
+                            "buffer poisons all downstream GL state; "
+                            "latching\n");
+            w->wedged = true;
+         }
+         return 0;
+      }
+   }
+   return seq;
+}
+
+uint64_t warp_transfer(struct warp_conn *w, uint32_t bo, bool to_host,
+                       uint32_t level, int x, int y, int z,
+                       int width, int height, int depth,
+                       uint32_t offset, uint32_t stride,
+                       uint32_t layer_stride)
+{
+   char path[64];
+   char verb[160];
+   long fd;
+   uint64_t seq = 0;
+   if (w->wedged)
+      return 0;
+   snprintf(path, sizeof(path), "ctx/%u/bo/%u/ctl", w->ctx, bo);
+   snprintf(verb, sizeof(verb), "%s %u %d %d %d %d %d %d %u %u %u",
+            to_host ? "transfer_to" : "transfer_from",
+            level, x, y, z, width, height, depth,
+            offset, stride, layer_stride);
+   fd = open_at(w->root, path, T_OWRITE);
+   if (fd < 0)
+      return 0;
+   seq = fenced_write(w, fd, verb, strlen(verb));
+   t_close(fd);
+   return seq;
+}
+
+uint32_t warp_bo_create(struct warp_conn *w,
+                        uint32_t target, uint32_t vformat, uint32_t vbind,
+                        uint32_t width, uint32_t height, uint32_t depth,
+                        uint32_t array_size, uint32_t last_level,
+                        uint32_t nr_samples, uint32_t flags,
+                        uint32_t *size_inout, uint32_t *res_id)
+{
+   char path[64];
+   char verb[192];
+   char info[160];
+   uint32_t bo, size;
+   long long rid;
+
+   if (w->wedged)
+      return 0;
+
+   /* The seam refuses unaligned or zero backings; the driver's
+    * staging-path textures legitimately ask for size 1. */
+   size = *size_inout ? *size_inout : 1;
+   size = (size + (WARP_PAGE - 1)) & ~(WARP_PAGE - 1);
+
+   snprintf(path, sizeof(path), "ctx/%u/bo/new", w->ctx);
+   bo = mint_id(w->root, path);
+   if (bo == 0)
+      return 0;
+
+   snprintf(path, sizeof(path), "ctx/%u/bo/%u/ctl", w->ctx, bo);
+   snprintf(verb, sizeof(verb),
+            "create3d %u %u %u %u %u %u %u %u %u %u %u",
+            target, vformat, vbind, width, height, depth, array_size,
+            last_level, nr_samples, flags, size);
+   if (write_verb(w->root, path, verb) != 0)
+      return 0; /* the minted-but-unbuilt record dies with the ctx */
+
+   snprintf(path, sizeof(path), "ctx/%u/bo/%u/info", w->ctx, bo);
+   if (open_read_snapshot(w->root, path, info, sizeof(info)) <= 0)
+      return 0;
+   rid = parse_field(info, "res");
+   if (rid <= 0)
+      return 0;
+
+   *size_inout = size;
+   *res_id = (uint32_t)rid;
+   return bo;
+}
+
+void *warp_bo_map(struct warp_conn *w, uint32_t bo, long *map_fd_out)
+{
+   char path[64];
+   long fd, va;
+   snprintf(path, sizeof(path), "ctx/%u/bo/%u/map", w->ctx, bo);
+   fd = open_at(w->root, path, T_OREAD);
+   if (fd < 0)
+      return NULL;
+   va = t_weft_map(fd, 0);
+   if (va < 0) {
+      t_close(fd);
+      return NULL;
+   }
+   *map_fd_out = fd;
+   return (void *)(uintptr_t)va;
+}
+
+void warp_bo_destroy(struct warp_conn *w, uint32_t bo, long map_fd)
+{
+   char path[64];
+   if (map_fd >= 0)
+      t_close(map_fd); /* the clunk drops the mapping */
+   snprintf(path, sizeof(path), "ctx/%u/bo/%u/ctl", w->ctx, bo);
+   (void)write_verb(w->root, path, "destroy");
+}
+
+long warp_read_caps(struct warp_conn *w, void *buf, unsigned long len)
+{
+   long fd = open_at(w->root, "caps", T_OREAD);
+   long total = 0;
+   if (fd < 0)
+      return -1;
+   while ((unsigned long)total < len) {
+      long n = t_pread(fd, (char *)buf + total, len - total, total);
+      if (n < 0) {
+         t_close(fd);
+         return -1;
+      }
+      if (n == 0)
+         break;
+      total += n;
+   }
+   t_close(fd);
+   return total;
+}
+
+int warp_open(struct warp_conn *w)
+{
+   char buf[512];
+   char path[64];
+   long long cap;
+
+   memset(w, 0, sizeof(*w));
+   w->root = w->ctx_ctl_fd = w->submit_fd = w->fence_fd = -1;
+
+   w->root = t_open(T_WALK_OPEN_FROM_ROOT, "/srv/warp", 9, T_OREAD);
+   if (w->root < 0)
+      return -1;
+
+   if (open_read_snapshot(w->root, "ctl", buf, sizeof(buf)) <= 0)
+      goto fail;
+   if (strncmp(buf, "virgl 1", 7) != 0)
+      goto fail; /* 2D device: the caller falls back / SKIPs */
+   cap = parse_field(buf, "bo-cap");
+   if (cap <= 0)
+      goto fail; /* pre-Warp-3 server: the fence counter is absent too */
+   w->bo_cap = (uint32_t)cap;
+
+   w->ctx = mint_id(w->root, "ctx/new");
+   if (w->ctx == 0)
+      goto fail;
+
+   snprintf(path, sizeof(path), "ctx/%u/ctl", w->ctx);
+   w->ctx_ctl_fd = open_at(w->root, path, T_OREAD);
+   snprintf(path, sizeof(path), "ctx/%u/submit", w->ctx);
+   w->submit_fd = open_at(w->root, path, T_OWRITE);
+   snprintf(path, sizeof(path), "ctx/%u/fence", w->ctx);
+   w->fence_fd = open_at(w->root, path, T_OREAD);
+   if (w->ctx_ctl_fd < 0 || w->submit_fd < 0 || w->fence_fd < 0)
+      goto fail;
+
+   /* The promoted counter is load-bearing (the whole fence model rides
+    * it): prove it parses before reporting the seam usable. */
+   if (warp_fence_refresh(w) != 0)
+      goto fail;
+   return 0;
+
+fail:
+   warp_close(w);
+   return -1;
+}
+
+void warp_close(struct warp_conn *w)
+{
+   char path[64];
+   if (w->ctx != 0 && w->root >= 0) {
+      snprintf(path, sizeof(path), "ctx/%u/ctl", w->ctx);
+      (void)write_verb(w->root, path, "destroy");
+   }
+   if (w->fence_fd >= 0)
+      t_close(w->fence_fd);
+   if (w->submit_fd >= 0)
+      t_close(w->submit_fd);
+   if (w->ctx_ctl_fd >= 0)
+      t_close(w->ctx_ctl_fd);
+   if (w->root >= 0)
+      t_close(w->root);
+   w->root = w->ctx_ctl_fd = w->submit_fd = w->fence_fd = -1;
+   w->ctx = 0;
+}
diff --git a/src/gallium/winsys/virgl/thylacine/warp_client.h b/src/gallium/winsys/virgl/thylacine/warp_client.h
new file mode 100644
index 0000000..e72c482
--- /dev/null
+++ b/src/gallium/winsys/virgl/thylacine/warp_client.h
@@ -0,0 +1,116 @@
+/*
+ * warp_client — the C client library for Thylacine's /srv/warp GPU seam.
+ *
+ * The seam (docs/reference/149-warp.md in the Thylacine tree) is a 9P
+ * service tree served by tapestryd, the virtio-gpu owner. Opening
+ * /srv/warp is a CONNECT (each open mints a fresh server-side
+ * connection; ownership of everything minted below is keyed on it), and
+ * every operation is a blocking file op relative to that root:
+ *
+ *   ctl                    global: "virgl <0|1>\n... bo-cap <n>\n"
+ *   caps                   the retained capset blob, raw
+ *   ctx/new                open+read mints a context (ONE per connection)
+ *   ctx/<id>/ctl           per-ctx state incl. "fence-signaled <n>"
+ *   ctx/<id>/submit        one write = one atomic fenced CCMD submission
+ *   ctx/<id>/fence         read parks until an unreported fence retires
+ *   ctx/<id>/bo/new        mints a BO record
+ *   ctx/<id>/bo/<id>/ctl   "create3d ..." / "transfer_to/from ..." / "destroy"
+ *   ctx/<id>/bo/<id>/map   the map fid: t_weft_map() -> client VA
+ *
+ * Fence model. Every submit and every transfer verb is fence-bearing and
+ * completes FIFO within the context's single ring. The client counts the
+ * fenced ops it ISSUED; the per-ctx ctl `fence-signaled` counter is the
+ * monotonic count of ops that RETIRED. issued - signaled is the in-flight
+ * depth, and "op #seq is done" is exactly `signaled >= seq`. The fence
+ * FILE is only the blocking primitive: a read parks until a fence retires
+ * and its content (the coalesced newest fence id) is ignored — parking is
+ * safe iff in-flight > 0, which every wait loop here guarantees.
+ *
+ * Threading: the connection is one 9P stream; callers serialize through
+ * the winsys mutex. This library does no locking of its own.
+ *
+ * Errors: functions return 0/-1 (or a pointer/NULL); a hard transport
+ * failure or a poisoned context LATCHES the connection (warp_wedged())
+ * so a submit-drop can never silently corrupt downstream rendering.
+ */
+#ifndef WARP_CLIENT_H
+#define WARP_CLIENT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct warp_conn {
+   long root;         /* the /srv/warp connection (open = connect) */
+   long ctx_ctl_fd;   /* kept open; fence-signaled polls are one t_pread */
+   long submit_fd;
+   long fence_fd;
+   uint32_t ctx;      /* the minted context's public id */
+   uint32_t bo_cap;   /* ctl `bo-cap`: per-ctx BO capacity (discovery) */
+   uint64_t issued;   /* fenced ops issued (submits + transfers) */
+   uint64_t signaled; /* last read of ctl `fence-signaled` */
+   bool wedged;       /* latched on transport failure / poison EOF */
+};
+
+/* Connect + mint the context + open the hot fds. Returns 0, or -1 when
+ * /srv/warp is absent, the device is 2D (`virgl 0`), or any mint fails —
+ * the caller falls back (or SKIPs); nothing is left open on failure. */
+int warp_open(struct warp_conn *w);
+void warp_close(struct warp_conn *w);
+
+/* Read the retained capset blob into buf (up to len). Returns the byte
+ * count (>= 0) or -1. */
+long warp_read_caps(struct warp_conn *w, void *buf, unsigned long len);
+
+/* Mint + build a BO. Geometry/format/bind are raw virgl wire values (the
+ * server passes them through to RESOURCE_CREATE_3D); size is rounded up
+ * to the page here (the seam refuses unaligned backings). On success
+ * returns the BO public id (>= 1) and stores the device-global resource
+ * id — the value command streams name — in *res_id. Returns 0 on
+ * failure (E_NOMEM at the bo-cap, E_IO on implausible geometry). */
+uint32_t warp_bo_create(struct warp_conn *w,
+                        uint32_t target, uint32_t vformat, uint32_t vbind,
+                        uint32_t width, uint32_t height, uint32_t depth,
+                        uint32_t array_size, uint32_t last_level,
+                        uint32_t nr_samples, uint32_t flags,
+                        uint32_t *size_inout, uint32_t *res_id);
+
+/* Map the BO's backing (opens the map fid + t_weft_map). The mapping
+ * lives until warp_bo_destroy closes the fid. NULL on failure. */
+void *warp_bo_map(struct warp_conn *w, uint32_t bo, long *map_fd_out);
+
+/* Destroy: closes the map fid (dropping the mapping) then writes the
+ * ctl `destroy` verb. Safe on a wedged connection (best-effort). */
+void warp_bo_destroy(struct warp_conn *w, uint32_t bo, long map_fd);
+
+/* Queue one fenced op. Each returns the op's issue seq (> 0) or 0 on
+ * failure (which latches the wedge for submits — a dropped command
+ * buffer corrupts all later state — but NOT for transfers, whose
+ * failure the driver surfaces per-call).
+ *
+ * warp_submit takes a dword stream and splits it into <= chunk-bound
+ * writes at CCMD boundaries (one write = one atomic submission; state
+ * persists across submissions in the same ctx, so a boundary split is
+ * transparent). A single command wider than the chunk bound cannot be
+ * carried by the byte seam and fails loudly (the Loom bulk path is the
+ * designed successor, GPU-DESIGN 4.1). */
+uint64_t warp_submit(struct warp_conn *w, const uint32_t *dw, uint32_t ndw);
+uint64_t warp_transfer(struct warp_conn *w, uint32_t bo, bool to_host,
+                       uint32_t level, int x, int y, int z,
+                       int width, int height, int depth,
+                       uint32_t offset, uint32_t stride,
+                       uint32_t layer_stride);
+
+/* Refresh `signaled` from the ctl fd (one pread). Returns 0 / -1. */
+int warp_fence_refresh(struct warp_conn *w);
+
+/* Block until signaled >= seq (refreshing as fences land). Latches the
+ * wedge and returns -1 on fence-stream EOF (poison/teardown); 0 on
+ * success. Never parks with nothing in flight. */
+int warp_fence_wait(struct warp_conn *w, uint64_t seq);
+
+static inline bool warp_wedged(const struct warp_conn *w)
+{
+   return w->wedged;
+}
+
+#endif /* WARP_CLIENT_H */
