 src/gallium/meson.build                       |   8 +-
 src/gallium/targets/osmesa/meson.build        |  49 +-
 src/gallium/targets/osmesa/osmesa_target.c    |  40 +-
 src/gallium/targets/osmesa/virgl_prove.c      | 203 ++++++
 .../winsys/virgl/thylacine/meson.build        |  16 +
 .../virgl/thylacine/virgl_thylacine_public.h  |  15 +
 .../virgl/thylacine/virgl_thylacine_winsys.c  | 631 ++++++++++++++++++
 .../winsys/virgl/thylacine/warp_client.c      | 417 ++++++++++++
 .../winsys/virgl/thylacine/warp_client.h      | 116 ++++
 13 files changed, 1534 insertions(+), 12 deletions(-)
