+/// Thylacine (Clade CL-7b): maps JIT memory onto an I-42 dual-mapped code
+/// Burrow -- one physical region with an RW writer alias and an RX exec alias.
+///
+/// Thylacine has no mprotect and its mmap ignores PROT, so InProcessMemoryMapper
+/// cannot raise a mapping to executable and this is the only mapper that works
+/// there. Reservations are keyed and handed out in EXEC-alias coordinates
+/// (relocations must resolve to where code is fetched); prepare() returns the
+/// matching writer-alias pointer, exactly as SharedMemoryMapper returns a local
+/// mapping of remote pages. See ThylacineMemoryMapper.cpp.
+///
+/// Requires the process to hold CAP_JIT; reserve() reports a distinguishable
+/// permission error if it does not.
+class LLVM_ABI DualMapMemoryMapper final : public MemoryMapper {
+public:
+  DualMapMemoryMapper(size_t PageSize);
+
+  static Expected<std::unique_ptr<DualMapMemoryMapper>> Create();
+
+  unsigned int getPageSize() override { return PageSize; }
+
+  void reserve(size_t NumBytes, OnReservedFunction OnReserved) override;
+
+  char *prepare(jitlink::LinkGraph &G, ExecutorAddr Addr,
+                size_t ContentSize) override;
+
+  void initialize(AllocInfo &AI, OnInitializedFunction OnInitialized) override;
+
+  void deinitialize(ArrayRef<ExecutorAddr> Allocations,
+                    OnDeinitializedFunction OnDeInitialized) override;
+
+  void release(ArrayRef<ExecutorAddr> Reservations,
+               OnReleasedFunction OnRelease) override;
+
+  ~DualMapMemoryMapper() override;
+
+private:
+  struct Allocation {
+    size_t Size;
+    std::vector<shared::WrapperFunctionCall> DeinitializationActions;
+  };
+
+  struct Reservation {
+    uint64_t WriterBase;
+    size_t Size;
+    std::vector<ExecutorAddr> Allocations;
+  };
+
+  /// Exec address -> writer address. Caller must hold Mutex.
+  char *writerFor(ExecutorAddr Addr);
+
+  std::mutex Mutex;
+  /// Ordered, unlike InProcessMemoryMapper's DenseMap: prepare() has to find
+  /// the reservation *containing* an address, not one keyed by it.
+  std::map<ExecutorAddr, Reservation> Reservations;
+  DenseMap<ExecutorAddr, Allocation> Allocations;
+
+  size_t PageSize;
+};
+
+#endif // __thylacine__
