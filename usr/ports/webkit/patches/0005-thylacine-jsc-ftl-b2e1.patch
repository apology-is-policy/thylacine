From 5a2724d70f483b28276f93d6b56f40b1c35e7b44 Mon Sep 17 00:00:00 2001
From: Michal Frdlik <noreply@example.invalid>
Date: Tue, 13 Oct 2026 08:29:22 +0200
Subject: [PATCH] thylacine: B-2e1 the FTL on at run time, an ISB where a
 thread takes a finished Wasm plan

The FTL joins Baseline, the DFG and the RegExp JIT at run time; Wasm's BBQ
and OMG stay off until their own step. Every rewrite of installed FTL code
falls under the rules B-2d set (the JS thread's own patches return through
eret; a compiler thread's code is installed after crossModifyingCodeFence;
the collector patches with the world stopped and a resuming thread runs an
ISB), and its new kind, a property cache that rewrites code, rewrites more
than one instruction only on the JS thread, outside the region it rewrites.

A Wasm module's wasm-to-JS exit stubs are JIT-compiled by a worklist thread
while it validates the module, and a CalleeGroup's wasm-to-wasm stubs by the
thread that completes its plan; a wait that finds a plan done returns
without sleeping, so a JS thread could run stubs written on another CPU
with no context-synchronization event in between.
JSWebAssemblyInstance::finalizeCreation, which every instance passes before
it reads a stub or runs the start function, and Wasm::Module::compileSync,
which returns a group another thread may have created, now run
WTF::crossModifyingCodeFence() (an ISB) first: the DFG finalizer's rule.

WTF gives every thread it creates 1 MiB of stack, as it does on musl Linux:
musl's default is 128 KiB and jsc's PT_GNU_STACK is empty, so the compiler,
collector and Wasm worklist threads ran on 128 KiB, the size of JSC's own soft
reserved zone.
---
 Source/JavaScriptCore/runtime/Options.cpp               | 7 +++----
 Source/JavaScriptCore/wasm/WasmModule.cpp               | 4 ++++
 Source/JavaScriptCore/wasm/js/JSWebAssemblyInstance.cpp | 6 ++++++
 Source/WTF/wtf/Threading.cpp                            | 2 +-
 4 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/Source/JavaScriptCore/runtime/Options.cpp b/Source/JavaScriptCore/runtime/Options.cpp
index 2bcf75b6a1..8bcc90b7b2 100644
--- a/Source/JavaScriptCore/runtime/Options.cpp
+++ b/Source/JavaScriptCore/runtime/Options.cpp
@@ -838,10 +838,9 @@ void Options::notifyOptionsChanged()
 
 #if OS(THYLACINE)
     // As on RISCV64, every JIT tier is built (the configuration upstream builds) and
-    // the tiers not yet opened on Thylacine are off at run time: Baseline, the DFG and
-    // the RegExp JIT run; FTL and Wasm's BBQ and OMG stay off whatever a flag or the
-    // environment asked, until each is opened in its own audited step.
-    Options::useFTLJIT() = false;
+    // the tiers not yet opened on Thylacine are off at run time: Baseline, the DFG, the
+    // FTL and the RegExp JIT run; Wasm's BBQ and OMG stay off whatever a flag or the
+    // environment asked, until they are opened in their own audited step.
     Options::useBBQJIT() = false;
     Options::useOMGJIT() = false;
 #endif
diff --git a/Source/JavaScriptCore/wasm/WasmModule.cpp b/Source/JavaScriptCore/wasm/WasmModule.cpp
index 59984286fb..b9b09cb6f4 100644
--- a/Source/JavaScriptCore/wasm/WasmModule.cpp
+++ b/Source/JavaScriptCore/wasm/WasmModule.cpp
@@ -119,6 +119,10 @@ Ref<CalleeGroup> Module::compileSync(VM& vm, MemoryMode mode)
 {
     Ref<CalleeGroup> calleeGroup = getOrCreateCalleeGroup(vm, mode);
     calleeGroup->waitUntilFinished();
+    // The group's wasm-to-wasm exit stubs were written by the thread that completed its
+    // plan, which need not be this one, and the wait returns without sleeping when the plan
+    // is done. finalizeCreation fences every instance; this covers the group returned here.
+    WTF::crossModifyingCodeFence();
     return calleeGroup;
 }
 
diff --git a/Source/JavaScriptCore/wasm/js/JSWebAssemblyInstance.cpp b/Source/JavaScriptCore/wasm/js/JSWebAssemblyInstance.cpp
index 807d8b5158..9d7f3b3632 100644
--- a/Source/JavaScriptCore/wasm/js/JSWebAssemblyInstance.cpp
+++ b/Source/JavaScriptCore/wasm/js/JSWebAssemblyInstance.cpp
@@ -247,6 +247,12 @@ void JSWebAssemblyInstance::finalizeCreation(VM& vm, JSGlobalObject* globalObjec
         return;
     }
 
+    // The module's wasm-to-JS exit stubs were written by a worklist thread while it validated
+    // the module, and the group's wasm-to-wasm stubs by whichever thread completed its plan;
+    // a wait that found either done took no context synchronization on this CPU. Every
+    // instance passes here before it reads a stub or runs the start function below.
+    WTF::crossModifyingCodeFence();
+
     // When memory is imported, we will initialize all memory modes with the initial IPInt compilation
     // results, so that later when memory imports become available, the appropriate CalleeGroup can be used.
     // If IPInt is disabled, we instead defer compilation to module evaluation.
diff --git a/Source/WTF/wtf/Threading.cpp b/Source/WTF/wtf/Threading.cpp
index 7249ada7d7..2e65de9bbb 100644
--- a/Source/WTF/wtf/Threading.cpp
+++ b/Source/WTF/wtf/Threading.cpp
@@ -123,7 +123,7 @@ static std::optional<size_t> NODELETE stackSize(ThreadType threadType)
 
 #if defined(DEFAULT_THREAD_STACK_SIZE_IN_KB) && DEFAULT_THREAD_STACK_SIZE_IN_KB > 0
     return DEFAULT_THREAD_STACK_SIZE_IN_KB * 1024;
-#elif OS(LINUX) && !defined(__BIONIC__) && !defined(__GLIBC__)
+#elif (OS(LINUX) && !defined(__BIONIC__) && !defined(__GLIBC__)) || OS(THYLACINE)
     // on libcs other than glibc and bionic (e.g. musl) we are either unsure how big
     // the default thread stack is, or we know it's too small - pick a robust default
     return 1 * MB;
-- 
