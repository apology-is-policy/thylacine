From 435ef4e5bade9da134f0ac7131c37b37e857c8fa Mon Sep 17 00:00:00 2001
From: Michal Frdlik <noreply@example.invalid>
Date: Mon, 12 Oct 2026 19:45:00 +0200
Subject: [PATCH] thylacine: gcpark the conservative scan reads parked stack
 images, never suspends (WIP, local only)

OS(THYLACINE): Thread::suspend is unavailable (Pouch has no per-thread
signal), and the collector's conservative scan suspended every thread in the
heap's group except itself -- including the mutator, whenever a stop-the-world
phase found it without heap access (Heap::stopTheMutator stops the world
instantly then). jsc died in RELEASE_ASSERT_NOT_REACHED.

A thread now parks when it releases heap access: Heap::releaseAccess (and
releaseAccessSlow, just before the clearing CAS) copies its callee-saves and
its stack from the release point to the origin into a per-heap, per-thread
image in MachineThreads; acquiring access, or entering the JSLock on access it
did not acquire, unparks it. The scan reads the images of every group thread
but the current and conducting ones and never suspends; a group thread that is
not parked is fatal, with a message. The image is a copy, not a recorded
range: the frames below the releasing caller are reused once the release
returns, and they may hold the only copy of a caller's callee-save. It is
complete because a thread without heap access cannot obtain a cell it did not
hold at the release. Records are written only by their own thread while it
holds access and read only while no thread but the conductor can hold it
(gatherStackRoots asserts the world is stopped); the thread group's lock
guards them as well.
---
 Source/JavaScriptCore/heap/Heap.cpp           | 23 ++++++
 Source/JavaScriptCore/heap/Heap.h             |  7 ++
 Source/JavaScriptCore/heap/HeapInlines.h      |  6 +-
 .../heap/MachineStackMarker.cpp               | 79 +++++++++++++++++++
 .../JavaScriptCore/heap/MachineStackMarker.h  | 25 ++++++
 Source/JavaScriptCore/runtime/JSLock.cpp      |  8 +-
 Source/WTF/wtf/posix/ThreadingPOSIX.cpp       |  4 +-
 7 files changed, 148 insertions(+), 4 deletions(-)

diff --git a/Source/JavaScriptCore/heap/Heap.cpp b/Source/JavaScriptCore/heap/Heap.cpp
index 67e317d5bb..490eaf090c 100644
--- a/Source/JavaScriptCore/heap/Heap.cpp
+++ b/Source/JavaScriptCore/heap/Heap.cpp
@@ -907,6 +907,10 @@ void Heap::assertMarkStacksEmpty()
 
 void Heap::gatherStackRoots(ConservativeRoots& roots)
 {
+#if OS(THYLACINE)
+    // The parked images are stable only while no thread but the conductor can hold access.
+    RELEASE_ASSERT(worldIsStopped());
+#endif
     m_machineThreads->gatherConservativeRoots(roots, *m_jitStubRoutines, *m_codeBlocks, m_currentThreadState, m_currentThread);
 #if ENABLE(C_LOOP)
     vm().cloopStack().gatherConservativeRoots(roots, *m_jitStubRoutines, *m_codeBlocks);
@@ -2189,6 +2193,9 @@ void Heap::acquireAccessSlow()
         RELEASE_ASSERT(!(oldState & stoppedBit));
         unsigned newState = oldState | hasAccessBit;
         if (m_worldState.compareExchangeWeak(oldState, newState)) {
+#if OS(THYLACINE)
+            unparkCurrentThread();
+#endif
             handleNeedFinalize();
             m_mutatorDidRun = true;
             stopIfNecessary();
@@ -2224,6 +2231,10 @@ void Heap::releaseAccessSlow()
             newState |= stoppedBit;
         }
 
+#if OS(THYLACINE)
+        // handleNeedFinalize() may have run finalizers since releaseAccess() parked us.
+        parkCurrentThread();
+#endif
         if (m_worldState.compareExchangeWeak(oldState, newState)) {
             if (oldState & mutatorHasConnBit)
                 finishRelinquishingConn();
@@ -2232,6 +2243,18 @@ void Heap::releaseAccessSlow()
     }
 }
 
+#if OS(THYLACINE)
+void Heap::parkCurrentThread()
+{
+    m_machineThreads->parkCurrentThread();
+}
+
+void Heap::unparkCurrentThread()
+{
+    m_machineThreads->unparkCurrentThread();
+}
+#endif
+
 bool Heap::relinquishConn(unsigned oldState)
 {
     RELEASE_ASSERT(oldState & hasAccessBit);
diff --git a/Source/JavaScriptCore/heap/Heap.h b/Source/JavaScriptCore/heap/Heap.h
index eaa7a00f76..7d98331540 100644
--- a/Source/JavaScriptCore/heap/Heap.h
+++ b/Source/JavaScriptCore/heap/Heap.h
@@ -555,6 +555,9 @@ public:
     // on the ParkingLot.
     void releaseAccess()
     {
+#if OS(THYLACINE)
+        parkCurrentThread();
+#endif
         if (m_worldState.compareExchangeWeak(hasAccessBit, 0))
             return;
         releaseAccessSlow();
@@ -739,6 +742,10 @@ private:
     
     JS_EXPORT_PRIVATE void acquireAccessSlow();
     JS_EXPORT_PRIVATE void releaseAccessSlow();
+#if OS(THYLACINE)
+    JS_EXPORT_PRIVATE void parkCurrentThread();
+    JS_EXPORT_PRIVATE void unparkCurrentThread();
+#endif
     
     bool handleNeedFinalize(unsigned);
     void handleNeedFinalize();
diff --git a/Source/JavaScriptCore/heap/HeapInlines.h b/Source/JavaScriptCore/heap/HeapInlines.h
index 5333d28aa3..1bad65d789 100644
--- a/Source/JavaScriptCore/heap/HeapInlines.h
+++ b/Source/JavaScriptCore/heap/HeapInlines.h
@@ -210,8 +210,12 @@ inline void Heap::acquireAccess()
     if constexpr (validateDFGDoesGC)
         vm().verifyCanGC();
 
-    if (m_worldState.compareExchangeWeak(0, hasAccessBit))
+    if (m_worldState.compareExchangeWeak(0, hasAccessBit)) {
+#if OS(THYLACINE)
+        unparkCurrentThread();
+#endif
         return;
+    }
     acquireAccessSlow();
 }
 
diff --git a/Source/JavaScriptCore/heap/MachineStackMarker.cpp b/Source/JavaScriptCore/heap/MachineStackMarker.cpp
index 9c95d17c77..21c0409f23 100644
--- a/Source/JavaScriptCore/heap/MachineStackMarker.cpp
+++ b/Source/JavaScriptCore/heap/MachineStackMarker.cpp
@@ -25,6 +25,7 @@
 #include "ConservativeRoots.h"
 #include "MachineContext.h"
 #include <wtf/BitVector.h>
+#include <wtf/DataLog.h>
 #include <wtf/PageBlock.h>
 #include <wtf/StdLibExtras.h>
 #include <wtf/TZoneMallocInlines.h>
@@ -52,6 +53,7 @@ void MachineThreads::gatherFromCurrentThread(ConservativeRoots& conservativeRoot
     conservativeRoots.add(currentThreadState.stackTop, currentThreadState.stackOrigin, jitStubRoutines, codeBlocks);
 }
 
+#if !OS(THYLACINE)
 static inline int NODELETE osRedZoneAdjustment()
 {
     int redZoneAdjustment = 0;
@@ -88,6 +90,7 @@ static std::pair<void*, size_t> NODELETE captureStack(Thread& thread, void* stac
     std::swap(begin, endWithRedZone);
     return std::make_pair(begin, endWithRedZone - begin);
 }
+#endif
 
 SUPPRESS_ASAN
 static void NODELETE copyMemory(void* dst, const void* src, size_t size)
@@ -107,6 +110,76 @@ static void NODELETE copyMemory(void* dst, const void* src, size_t size)
     
 
 
+#if OS(THYLACINE)
+MachineThreads::ParkedThread* MachineThreads::findParkedThread(const AbstractLocker&, Thread& thread)
+{
+    for (auto& parked : m_parkedThreads) {
+        if (parked.thread.ptr() == &thread)
+            return &parked;
+    }
+    return nullptr;
+}
+
+MachineThreads::ParkedThread& MachineThreads::ensureParkedThread(const AbstractLocker& locker, Thread& thread)
+{
+    if (auto* parked = findParkedThread(locker, thread))
+        return *parked;
+    m_parkedThreads.append(ParkedThread { thread, { }, false });
+    return m_parkedThreads.last();
+}
+
+// The image is what suspending the thread at this point would have read: its callee-saves
+// and its stack from here to the origin. Until it reacquires heap access the thread cannot
+// obtain a cell it does not hold now, so the image covers every cell its frames will use,
+// however the compiler moves values between registers and slots meanwhile. It is a copy,
+// not a recorded range, because the frames below the caller are reused once this returns.
+NEVER_INLINE void MachineThreads::parkCurrentThread()
+{
+    DECLARE_AND_COMPUTE_CURRENT_THREAD_STATE(state);
+    static_assert(!(sizeof(RegisterState) % sizeof(CPURegister)));
+    char* stackTop = static_cast<char*>(state.stackTop);
+    char* stackOrigin = static_cast<char*>(state.stackOrigin);
+    RELEASE_ASSERT(stackTop < stackOrigin);
+    size_t registerWords = sizeof(RegisterState) / sizeof(CPURegister);
+    size_t stackBytes = stackOrigin - stackTop;
+
+    Locker locker { m_threadGroup->getLock() };
+    auto& parked = ensureParkedThread(locker, Thread::currentSingleton());
+    parked.image.resize(registerWords + stackBytes / sizeof(CPURegister));
+    auto image = parked.image.mutableSpan();
+    copyMemory(image.data(), state.registerState, sizeof(RegisterState));
+    copyMemory(image.subspan(registerWords).data(), stackTop, stackBytes);
+    parked.parked = true;
+}
+
+void MachineThreads::unparkCurrentThread()
+{
+    Locker locker { m_threadGroup->getLock() };
+    if (auto* parked = findParkedThread(locker, Thread::currentSingleton()))
+        parked->parked = false;
+}
+
+void MachineThreads::gatherFromParkedThreads(const AbstractLocker& locker, ConservativeRoots& conservativeRoots, JITStubRoutineSet& jitStubRoutines, CodeBlockSet& codeBlocks, Thread& currentThreadForGC)
+{
+    auto& currentThread = Thread::currentSingleton();
+    const ListHashSet<Ref<Thread>>& threads = m_threadGroup->threads(locker);
+    m_parkedThreads.removeAllMatching([&](auto& parked) {
+        return !threads.contains(parked.thread.get());
+    });
+
+    for (const Ref<Thread>& thread : threads) {
+        if (thread.ptr() == &currentThread || thread.ptr() == &currentThreadForGC)
+            continue;
+        auto* parked = findParkedThread(locker, thread.get());
+        if (!parked || !parked->parked) {
+            dataLogLn("FATAL: the conservative scan found thread ", thread->uid(), " running without a published stack image; Thylacine cannot suspend it.");
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+        auto image = parked->image.mutableSpan();
+        conservativeRoots.add(image.data(), image.data() + image.size(), jitStubRoutines, codeBlocks);
+    }
+}
+#else
 // This function must not call malloc(), free(), or any other function that might
 // acquire a lock. Since 'thread' is suspended, trying to acquire a lock
 // will deadlock if 'thread' holds that lock.
@@ -209,12 +282,17 @@ static void growBuffer(size_t size, void** buffer, size_t* capacity)
     *capacity = WTF::roundUpToMultipleOf(WTF::pageSize(), size * 2);
     *buffer = fastMalloc(*capacity);
 }
+#endif
 
 void MachineThreads::gatherConservativeRoots(ConservativeRoots& conservativeRoots, JITStubRoutineSet& jitStubRoutines, CodeBlockSet& codeBlocks, CurrentThreadState* currentThreadState, Thread* currentThread)
 {
     if (currentThreadState)
         gatherFromCurrentThread(conservativeRoots, jitStubRoutines, codeBlocks, *currentThreadState);
 
+#if OS(THYLACINE)
+    Locker locker { m_threadGroup->getLock() };
+    gatherFromParkedThreads(locker, conservativeRoots, jitStubRoutines, codeBlocks, *currentThread);
+#else
     size_t size;
     size_t capacity = 0;
     void* buffer = nullptr;
@@ -227,6 +305,7 @@ void MachineThreads::gatherConservativeRoots(ConservativeRoots& conservativeRoot
 
     conservativeRoots.add(buffer, static_cast<char*>(buffer) + size, jitStubRoutines, codeBlocks);
     fastFree(buffer);
+#endif
 }
 
 NEVER_INLINE int callWithCurrentThreadState(const ScopedLambda<void(CurrentThreadState&)>& lambda)
diff --git a/Source/JavaScriptCore/heap/MachineStackMarker.h b/Source/JavaScriptCore/heap/MachineStackMarker.h
index 16d683d645..0a0f3e6b60 100644
--- a/Source/JavaScriptCore/heap/MachineStackMarker.h
+++ b/Source/JavaScriptCore/heap/MachineStackMarker.h
@@ -24,8 +24,10 @@
 #include <JavaScriptCore/RegisterState.h>
 #include <wtf/Lock.h>
 #include <wtf/ScopedLambda.h>
+#include <wtf/StdIntExtras.h>
 #include <wtf/TZoneMalloc.h>
 #include <wtf/ThreadGroup.h>
+#include <wtf/Vector.h>
 
 namespace JSC {
 
@@ -54,11 +56,34 @@ public:
     WordLock& getLock() { return m_threadGroup->getLock(); }
     const ListHashSet<Ref<Thread>>& threads(const AbstractLocker& locker) const { return m_threadGroup->threads(locker); }
 
+#if OS(THYLACINE)
+    // Thylacine cannot suspend a thread. A thread publishes an image of its callee-saves
+    // and its stack each time it releases heap access, and the scan reads the image.
+    void parkCurrentThread();
+    void unparkCurrentThread();
+#endif
+
 private:
     void gatherFromCurrentThread(ConservativeRoots&, JITStubRoutineSet&, CodeBlockSet&, CurrentThreadState&);
 
+#if OS(THYLACINE)
+    struct ParkedThread {
+        Ref<Thread> thread;
+        Vector<CPURegister> image;
+        bool parked { false };
+    };
+
+    ParkedThread* findParkedThread(const AbstractLocker&, Thread&);
+    ParkedThread& ensureParkedThread(const AbstractLocker&, Thread&);
+    void gatherFromParkedThreads(const AbstractLocker&, ConservativeRoots&, JITStubRoutineSet&, CodeBlockSet&, Thread&);
+
+    // Guarded by the thread group's lock. Written only by the thread it describes, while
+    // that thread holds heap access; read by the scan, while no other thread holds it.
+    Vector<ParkedThread> m_parkedThreads;
+#else
     void tryCopyOtherThreadStack(const ThreadSuspendLocker&, Thread&, void*, size_t capacity, size_t*);
     bool tryCopyOtherThreadStacks(const AbstractLocker&, void*, size_t capacity, size_t*, Thread&);
+#endif
 
     Ref<ThreadGroup> m_threadGroup;
 };
diff --git a/Source/JavaScriptCore/runtime/JSLock.cpp b/Source/JavaScriptCore/runtime/JSLock.cpp
index 0fa9323dc1..efa7a6fc22 100644
--- a/Source/JavaScriptCore/runtime/JSLock.cpp
+++ b/Source/JavaScriptCore/runtime/JSLock.cpp
@@ -128,9 +128,13 @@ void JSLock::didAcquireLock()
 
     m_vm->setLastStackTop(thread);
 
-    if (m_vm->heap.hasAccess())
+    if (m_vm->heap.hasAccess()) {
         m_shouldReleaseHeapAccess = false;
-    else {
+#if OS(THYLACINE)
+        // This thread runs on access it did not acquire, so an image it parked earlier is stale.
+        m_vm->heap.machineThreads().unparkCurrentThread();
+#endif
+    } else {
         m_vm->heap.acquireAccess();
         m_shouldReleaseHeapAccess = true;
     }
diff --git a/Source/WTF/wtf/posix/ThreadingPOSIX.cpp b/Source/WTF/wtf/posix/ThreadingPOSIX.cpp
index e9f6b33897..5512e3766d 100644
--- a/Source/WTF/wtf/posix/ThreadingPOSIX.cpp
+++ b/Source/WTF/wtf/posix/ThreadingPOSIX.cpp
@@ -195,7 +195,9 @@ WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
 #if OS(THYLACINE)
     // Pouch delivers no per-thread asynchronous signal, so there is no handler to install
     // and Thread::suspend() is unavailable. JavaScriptCore's users of it are switched off
-    // in Options (polling VM traps; no sampling profiler; no Wasm fault handler).
+    // in Options (polling VM traps; no sampling profiler; no Wasm fault handler), and the
+    // collector's conservative scan reads the stack image a thread parks when it releases
+    // heap access (MachineThreads::parkCurrentThread) instead of suspending it.
     return;
 #endif
 
