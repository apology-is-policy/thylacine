Thylacine DX-1: route __thylacine__ through whereami's Linux arm.
whereami.c dispatches on __linux__/__APPLE__/_WIN32 and #errors on any
other platform. Thylacine's musl provides readlink + /proc/self/exe-style
resolution (and DOSBox-X degrades gracefully if the exe path is
unavailable), so use the Linux implementation.

--- a/src/gui/whereami.c
+++ b/src/gui/whereami.c
@@ -12,7 +12,7 @@
 extern "C" {
 #endif
 
-#if defined(__linux__) || defined(__CYGWIN__)
+#if defined(__linux__) || defined(__CYGWIN__) || defined(__thylacine__)
 #undef _DEFAULT_SOURCE
 #define _DEFAULT_SOURCE
 #elif defined(__APPLE__)
@@ -175,7 +175,7 @@
   return length;
 }
 
-#elif defined(__linux__) || defined(__CYGWIN__) || defined(__sun) || defined(WAI_USE_PROC_SELF_EXE)
+#elif defined(__linux__) || defined(__CYGWIN__) || defined(__sun) || defined(WAI_USE_PROC_SELF_EXE) || defined(__thylacine__)
 
 #include <stdio.h>
 #include <stdlib.h>
