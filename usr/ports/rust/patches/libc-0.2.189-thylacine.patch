diff --color -ruN --exclude=.cargo-checksum.json a-libc/src/unix/thylacine/mod.rs libc-b/src/unix/thylacine/mod.rs
--- a-libc/src/unix/thylacine/mod.rs	1970-01-01 01:00:00
+++ libc-b/src/unix/thylacine/mod.rs	2026-09-21 13:58:49
@@ -0,0 +1,791 @@
+//! Definitions for Thylacine (pouch: musl-1.2.5-derived, retargeted to the
+//! Thylacine syscall ABI).
+//!
+//! The ABI is musl aarch64's, so the type aliases, struct layouts, and
+//! constants here are transcribed from `linux_like/linux/musl` (aarch64) --
+//! the honest source of truth, since pouch IS patched musl -- with the deltas
+//! the pouch boundary-line patches (`usr/lib/pouch/patches/*`) introduce.
+//! Only the surface `library/std` references is reproduced (compiler-bounded).
+
+use crate::prelude::*;
+
+// ===========================================================================
+// Type aliases
+//
+// musl shared (`linux/musl/mod.rs`), linux shared (`linux/mod.rs`),
+// linux_like shared (`linux_like/mod.rs`), and the aarch64 arch layer.
+// On aarch64 `c_long == i64`, so `time_t`/`suseconds_t` are the musl 1.2
+// 64-bit types.
+// ===========================================================================
+
+pub type pthread_t = *mut c_void;
+pub type clock_t = c_long;
+pub type time_t = c_long;
+pub type suseconds_t = c_long;
+pub type ino_t = u64;
+pub type off_t = i64;
+pub type blkcnt_t = i64;
+pub type fsblkcnt_t = c_ulonglong;
