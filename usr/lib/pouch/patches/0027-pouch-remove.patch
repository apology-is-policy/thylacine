diff --color -ruN musl-base/src/stdio/remove.c b/src/stdio/remove.c
--- a/src/stdio/remove.c
+++ b/src/stdio/remove.c
@@ -1,19 +1,29 @@
+/* pouch boundary-line (Clade CL-2): remove(3). musl's stdio remove() issues a
+ * RAW __syscall(SYS_unlinkat) -- the 0xFFFF/ENOSYS sentinel on pouch -- so the
+ * upstream body cannot work here regardless; it must route through the
+ * pouch-wired unlink()/rmdir() (the CL-1a unlinkat wire). lstat-dispatch: a
+ * directory -> rmdir(), anything else -> unlink(). Thylacine has no symlinks at
+ * v1.0 so lstat == stat. std::filesystem::remove uses ::remove -- surfaced by
+ * CL-2.
+ *
+ * HISTORY (#80): this patch was originally written because SYS_UNLINK ALSO
+ * collapsed every failure to a generic -1, so the classic
+ * unlink-then-rmdir-on-EISDIR form had nothing to branch on. That kernel gap is
+ * CLOSED -- SYS_UNLINK now returns the server's real errno, measured -EISDIR
+ * (21) for a directory and -ENOTEMPTY (39) for a populated rmdir. The classic
+ * form is therefore available again, at the cost of the raw-syscall rewrite it
+ * still needs. lstat-dispatch is RETAINED as a deliberate choice, not a
+ * necessity: it is correct, already proven, and costs one extra lstat per
+ * remove(). Do not re-derive the old claim from this comment -- the kernel
+ * distinguishes these cases now. */
 #include <stdio.h>
-#include <errno.h>
-#include <fcntl.h>
-#include "syscall.h"
+#include <unistd.h>
+#include <sys/stat.h>
 
 int remove(const char *path)
 {
-#ifdef SYS_unlink
-	int r = __syscall(SYS_unlink, path);
-#else
-	int r = __syscall(SYS_unlinkat, AT_FDCWD, path, 0);
-#endif
-#ifdef SYS_rmdir
-	if (r==-EISDIR) r = __syscall(SYS_rmdir, path);
-#else
-	if (r==-EISDIR) r = __syscall(SYS_unlinkat, AT_FDCWD, path, AT_REMOVEDIR);
-#endif
-	return __syscall_ret(r);
+	struct stat st;
+	if (lstat(path, &st) == 0 && S_ISDIR(st.st_mode))
+		return rmdir(path);
+	return unlink(path);
 }
