+/* pouch boundary-line: readlink() delegates to readlinkat().
+ *
+ * Stock musl issues the raw SYS_readlinkat syscall here rather than calling
+ * readlinkat(), so leaving this file alone would route readlink() straight past
+ * the boundary-line implementation next door and back into the 0xFFFF ENOSYS
+ * sentinel. musl's realpath() -- the reason any of this matters -- calls
+ * readlink(), not readlinkat(), so this one-line redirect is load-bearing.
+ *
+ * The bufsize==0 dummy dance lives in readlinkat() alone; duplicating it here
+ * would just make the same substitution twice.
+ */
 #include <unistd.h>
 #include <fcntl.h>
 #include "syscall.h"
 
 ssize_t readlink(const char *restrict path, char *restrict buf, size_t bufsize)
 {
-	char dummy[1];
-	if (!bufsize) {
-		buf = dummy;
-		bufsize = 1;
-	}
-#ifdef SYS_readlink
-	int r = __syscall(SYS_readlink, path, buf, bufsize);
-#else
-	int r = __syscall(SYS_readlinkat, AT_FDCWD, path, buf, bufsize);
-#endif
-	if (buf == dummy && r > 0) r = 0;
-	return __syscall_ret(r);
+	return readlinkat(AT_FDCWD, path, buf, bufsize);
 }
