 #include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <string.h>
 #include "syscall.h"
+#include "_pouch_fs.h"
 
+/* "/proc/" + a 10-digit u32 pid + "/" + a 3-char leaf + NUL. */
+#define PROC_LINK_MAX 21
+
+static size_t udec(char *out, unsigned long v)
+{
+	char tmp[20];
+	size_t n = 0, i;
+	do { tmp[n++] = (char)('0' + (v % 10)); v /= 10; } while (v);
+	for (i = 0; i < n; i++) out[i] = tmp[n - 1 - i];
+	return n;
+}
+
+/* Recognize /proc/{self,<pid>}/{exe,cwd} and write the NUMERIC equivalent into
+ * `out` (>= PROC_LINK_MAX bytes). Returns the written length, 0 for no match.
+ * Deliberately strict -- no normalization of "//" or "/./" -- because a miss
+ * degrades to the honest general answer while a loose match would not. */
+static size_t proc_link_path(const char *path, char *out)
+{
+	static const char pfx[] = "/proc/";
+	const size_t plen = sizeof pfx - 1;
+	const char *p;
+	char pidtext[20];
+	size_t pidlen, n, i;
+	int leaf_ok;
+
+	for (i = 0; i < plen; i++)
+		if (path[i] != pfx[i]) return 0;
+	p = path + plen;
+
+	if (p[0]=='s' && p[1]=='e' && p[2]=='l' && p[3]=='f' && p[4]=='/') {
+		long pid = __syscall(SYS_thyla_getpid);
+		if (pid <= 0) return 0;
+		pidlen = udec(pidtext, (unsigned long)pid);
+		p += 5;
+	} else {
+		size_t d = 0;
+		/* Bound the run INSIDE the scan, before anything is copied. pidtext is
+		 * 20 bytes and this scans caller-supplied text, so an unbounded run of
+		 * digits would overflow it -- readlink("/proc/00000000000000000000/exe")
+		 * reaches here from any program. A kernel pid is a u32, so a run longer
+		 * than 10 digits is malformed by construction and no valid path is
+		 * turned away. */
+		while (p[d] >= '0' && p[d] <= '9')
+			if (++d > 10) return 0;
+		if (!d || p[d] != '/') return 0;
+		pidlen = d;
+		for (i = 0; i < d; i++) pidtext[i] = p[i];
+		p += d + 1;
+	}
+	/* The self branch's udec: a u32 pid cannot exceed 10 digits, so this is a
+	 * belt-and-braces bound on the build below staying inside PROC_LINK_MAX. */
+	if (pidlen > 10) return 0;
+
+	/* The leaf must be EXACTLY "exe" or "cwd". Nothing else under /proc is
+	 * link-shaped here: fd/ and root/ are not served (task #65). */
+	leaf_ok = ((p[0]=='e' && p[1]=='x' && p[2]=='e') ||
+	           (p[0]=='c' && p[1]=='w' && p[2]=='d')) && p[3] == '\0';
+	if (!leaf_ok) return 0;
+
+	n = 0;
+	for (i = 0; i < plen; i++)   out[n++] = pfx[i];
+	for (i = 0; i < pidlen; i++) out[n++] = pidtext[i];
+	out[n++] = '/';
+	out[n++] = p[0]; out[n++] = p[1]; out[n++] = p[2];
+	out[n] = '\0';
+	return n;
+}
+
 ssize_t readlinkat(int fd, const char *restrict path, char *restrict buf, size_t bufsize)
 {
 	char dummy[1];
+	char lp[PROC_LINK_MAX];
+	size_t len, lplen;
+
 	if (!bufsize) {
 		buf = dummy;
 		bufsize = 1;
 	}
-	int r = __syscall(SYS_readlinkat, fd, path, buf, bufsize);
-	if (buf == dummy && r > 0) r = 0;
-	return __syscall_ret(r);
+
+	if (fd != AT_FDCWD) return __syscall_ret(-ENOTSUP);
+	if (!path || !buf)  return __syscall_ret(-EFAULT);
+
+	len = strnlen(path, POUCH_PATH_MAX + 1);
+	if (!len) return __syscall_ret(-ENOENT);
+	if (len > POUCH_PATH_MAX) return __syscall_ret(-ENAMETOOLONG);
+
+	lplen = proc_link_path(path, lp);
+	if (lplen) {
+		/* The link target IS this file's contents. */
+		char scratch[POUCH_PATH_MAX];
+		size_t k;
+		long n;
+		long f = __syscall(SYS_thyla_open, POUCH_FROM_ROOT, lp, lplen,
+		                   (unsigned long)POUCH_OREAD);
+		if (f < 0) return __syscall_ret(f);
+		n = __syscall(SYS_read, f, scratch, sizeof scratch);
+		__syscall(SYS_close, f);
+		if (n < 0) return __syscall_ret(n);
+		/* An EMPTY render means the kernel has no recorded name -- kproc, a
+		 * blob-loaded init, or an I-33 fail-soft Path alloc failure. Report the
+		 * absence rather than a zero-length target: realpath() reads a 0 return
+		 * as ENOENT anyway, and a direct caller would otherwise take "" for a
+		 * real link target. */
+		if (n == 0) return __syscall_ret(-ENOENT);
+		k = (size_t)n;
+		if (k > bufsize) k = bufsize;  /* readlink TRUNCATES; never NUL-terminates */
+		memcpy(buf, scratch, k);
+		if (buf == dummy) return 0;
+		return (ssize_t)k;
+	}
+
+	/* Everything else. Existence decides between the two truthful answers, and
+	 * the resolution errno (ENOENT / ENOTDIR / EACCES) passes through verbatim
+	 * -- which is what lets realpath() fail for the RIGHT reason.
+	 *
+	 * Reusing faccessat rather than repeating its SYS_STAT probe is deliberate:
+	 * that probe carries an 88-byte struct t_stat ABI mirror, and a duplicated
+	 * mirror is only ever verified against ITSELF. A kernel-side growth of
+	 * t_stat would then smash the stack of whichever copy was forgotten -- the
+	 * #100 lesson, which cost a boot segv. One mirror, one place. */
+	if (faccessat(AT_FDCWD, path, F_OK, 0) != 0)
+		return -1;                     /* errno already set, verbatim */
+	return __syscall_ret(-EINVAL);     /* it exists, and it is not a symlink */
 }
