+/* The SPAWN_EXT_ENV tail (struct sys_spawn_ext_env): ext_flags bit 2 names
+ * the child's whole environment. Tails sit after the record in bit order, so
+ * with no cwd or thread tail it is the record's next 16 bytes. */
+#define POUCH_SPAWN_EXT_ENV (1u << 2)
+struct pouch_spawn_ext_env {
+	unsigned long long env_va;         /* 0 -- may be 0 when env_len is 0 */
+	unsigned int env_len;              /* 8 -- the records, NULs included */
+	unsigned int env_flags;            /* 12 -- must be 0 */
+};
+_Static_assert(sizeof(struct pouch_spawn_ext_env) == 16,
+	"struct pouch_spawn_ext_env must match the kernel sys_spawn_ext_env ABI");
+_Static_assert(__builtin_offsetof(struct pouch_spawn_ext_env, env_va)    ==  0, "env_va@0");
+_Static_assert(__builtin_offsetof(struct pouch_spawn_ext_env, env_len)   ==  8, "env_len@8");
+_Static_assert(__builtin_offsetof(struct pouch_spawn_ext_env, env_flags) == 12, "env_flags@12");
+
+struct pouch_spawn_env_rec {
+	struct pouch_spawn_args args;
+	struct pouch_spawn_ext_env env;
+};
+_Static_assert(__builtin_offsetof(struct pouch_spawn_env_rec, env) == 104,
+	"the env tail must sit directly after the 104-byte record");
