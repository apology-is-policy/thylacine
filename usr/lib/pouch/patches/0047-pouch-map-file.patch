+/* B-1d (ARCHITECTURE.md sec 6.5 "Dynamic loading"): a MAP_PRIVATE file map
+   is SYS_BURROW_MAP_FILE, the three shapes musl's loader asks for. Without
+   MAP_FIXED it maps the span read-only or executable where the kernel
+   chooses; the hint is dropped, so an ET_EXEC asking for its own address
+   fails in the loader (EBUSY) and only a position-independent object loads.
+   With MAP_FIXED it replaces the window at `start`: a read-only or
+   executable window shares the file's pages, a writable one is a private
+   copy made now, and no write ever reaches the file. Executable bytes need
+   a mount that may back them, EACCES otherwise, as W with X is. Not
+   served, ENOSYS: MAP_SHARED, whose coherence with the file no private page
+   gives; a writable map without MAP_FIXED; a map without read. A negative
+   descriptor is EBADF here, where the kernel would read it as the
+   anonymous window. */
+static void *map_file(void *start, size_t len, int prot, int flags, int fd,
+                      off_t off)
+{
+	if (fd < 0) {
+		errno = EBADF;
+		return MAP_FAILED;
+	}
+	unsigned pr = (unsigned)prot & (PROT_READ|PROT_WRITE|PROT_EXEC);
+	if (pr & PROT_WRITE) pr |= PROT_READ;
+	if ((flags & MAP_TYPE) != MAP_PRIVATE || (flags & MAP_FIXED_NOREPLACE)
+	    || !(pr & PROT_READ) || ((pr & PROT_WRITE) && !(flags & MAP_FIXED))) {
 		errno = ENOSYS;
 		return MAP_FAILED;
 	}
+	long rc = (flags & MAP_FIXED)
+		? __syscall(SYS_thyla_burrow_map_file, fd, off, len, pr,
+		            POUCH_BURROW_MAP_FIXED, start)
+		: __syscall(SYS_thyla_burrow_map_file, fd, off, len, pr, 0, 0);
+	return (void *)__syscall_ret(rc);
+}
