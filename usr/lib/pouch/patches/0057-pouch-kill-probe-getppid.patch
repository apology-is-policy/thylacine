+++ b/src/signal/kill.c
@@ -20,6 +20,18 @@
 
 int kill(pid_t pid, int sig)
 {
+	/* Signal 0 asks whether pid could be signalled: an empty note name is the
+	 * kernel's probe, which runs the gate below and posts nothing (operator
+	 * vote 2026-10-14 #6). */
+	if (sig == 0) {
+		long r = __syscall(SYS_postnote, (long)pid, 0L, 0UL);
+		if (r == -EACCES) {
+			errno = EPERM;
+			return -1;
+		}
+		return __syscall_ret(r);
+	}
+
