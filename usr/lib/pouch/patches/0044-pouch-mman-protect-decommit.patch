--- a/src/mman/mmap.c
+++ b/src/mman/mmap.c
@@ -2,52 +2,96 @@
 #include <sys/mman.h>
 #include <errno.h>
 #include <stdint.h>
+#include "libc.h"
 #include "syscall.h"
+#include "_pouch_mman.h"
 
 /* pouch: musl's __mmap targets Linux mmap(2) with six arguments; Thylacine
    has no file-backed mmap by design (a mapped file cannot be 9P-network-
    transparent, a Plan 9 conviction kept as a Thylacine conviction -
    ARCHITECTURE.md sec 6.5).
 
-   pouch's __mmap retains the POSIX prototype for source-compatibility but
-   maps only the anonymous subset onto Thylacine's SYS_BURROW_ATTACH_LAZY
-   and refuses everything else with ENOSYS. The kernel chooses the VA; the
-   region is demand-zero RW and overcommitted (no pages until first touch;
-   W^X invariant I-12 forbids X, so mmap PROT bits are upgraded to RW); an
-   anon region has no offset. `start`, `prot`, `fd`, `off` are ignored.
-   MAP_FIXED is rejected (the v1.0 burrow-attach window is kernel-chosen).
+   B-1b (ARCHITECTURE.md sec 6.5 "The permission ceiling" / "Capacity"): the
+   anonymous subset is EXACT. A fresh mapping is SYS_BURROW_RESERVE at the
+   prot asked for, under a mint-time ceiling of RW: PROT_NONE mints a
+   reservation that faults until mprotect raises it (a guard page, or
+   reserve-then-commit), PROT_READ mints read-only, PROT_WRITE implies read
+   (AArch64 Linux has no write-only mapping), and PROT_EXEC is refused with
+   EACCES -- W^X (I-12) is never degraded; bytes a process wrote become code
+   only through the JIT syscalls. Bits beyond R|W|X are ignored, as Linux's
+   mmap ignores them. The kernel chooses the VA; the region is demand-zero
+   and overcommitted (no pages until first touch); `fd` and `off` are
+   ignored for an anonymous map.
 
-   SYS_mmap is __NR_mmap after the 0001-syscall-seam-retarget aliases it
-   to Thylacine number 83 (= SYS_BURROW_ATTACH_LAZY; see thylacine/syscall.h).
-   The call passes ONE argument, the length - all other Linux mmap fields
-   are stripped at the seam. */
+   MAP_FIXED over a range this process already maps as anonymous memory is
+   Linux's own effect -- fresh zero pages at the new prot -- done as two
+   native calls: SYS_BURROW_DECOMMIT discards the range's pages (the mapping
+   stays) and SYS_BURROW_PROTECT sets the prot. It never CREATES a mapping at
+   an address and never replaces a file, text or shared mapping: a range not
+   wholly plain anonymous memory of this process answers ENOMEM, before
+   anything is discarded. (WebKit's OSAllocator places its guard pages this
+   way; musl itself never asks.) The two calls are not one: a refusal of the
+   SECOND -- a range sealed below the prot asked (EACCES), no VMA slot left
+   for a middle cut (ENOMEM) -- comes after the discard and leaves zero pages
+   at the old prot. MAP_FIXED_NOREPLACE cannot be served (no fixed-address
+   creation): ENOSYS.
+
+   Errors: RESERVE and PROTECT return an explicit -errno, passed through;
+   DECOMMIT's flat -1 (the range is not wholly plain anonymous memory of
+   this process) is mapped to ENOMEM here, before __syscall_ret would make
+   it the generic EIO. */
 void *__mmap(void *start, size_t len, int prot, int flags, int fd, off_t off)
 {
-	(void)start; (void)prot; (void)fd; (void)off;
+	(void)fd; (void)off;
 
 	/* File-backed mmap is refused. */
 	if (!(flags & MAP_ANON)) {
 		errno = ENOSYS;
 		return MAP_FAILED;
 	}
-
-	/* MAP_FIXED would force a VA - the kernel chooses, so reject. */
-	if (flags & MAP_FIXED) {
-		errno = ENOSYS;
-		return MAP_FAILED;
-	}
-
 	if (len == 0) {
 		errno = EINVAL;
 		return MAP_FAILED;
 	}
-
 	if (len >= PTRDIFF_MAX) {
 		errno = ENOMEM;
 		return MAP_FAILED;
 	}
 
-	long ret = __syscall(SYS_mmap, len);
+	/* The prot word the kernel takes: Linux's values, W implying R. X is
+	   the kernel's EACCES; answering it here keeps a MAP_FIXED request from
+	   discarding a range it cannot then reprotect. */
+	unsigned pr = (unsigned)prot & (PROT_READ|PROT_WRITE|PROT_EXEC);
+	if (pr & PROT_WRITE) pr |= PROT_READ;
+	if (pr & PROT_EXEC) {
+		errno = EACCES;
+		return MAP_FAILED;
+	}
+
+	if (flags & MAP_FIXED_NOREPLACE) {
+		errno = ENOSYS;
+		return MAP_FAILED;
+	}
+	if (flags & MAP_FIXED) {
+		if ((uintptr_t)start & (PAGE_SIZE-1)) {
+			errno = EINVAL;
+			return MAP_FAILED;
+		}
+		long rc = __syscall(SYS_thyla_burrow_decommit, start, len);
+		if (rc == -1) rc = -ENOMEM;
+		if (rc < 0) {
+			__syscall_ret(rc);
+			return MAP_FAILED;
+		}
+		rc = __syscall(SYS_thyla_burrow_protect, start, len, pr, 0);
+		if (rc < 0) {
+			__syscall_ret(rc);
+			return MAP_FAILED;
+		}
+		return start;
+	}
+
+	long ret = __syscall(SYS_thyla_burrow_reserve, len, pr, 0);
 	return (void *)__syscall_ret(ret);
 }
 
