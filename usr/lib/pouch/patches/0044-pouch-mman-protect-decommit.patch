+#include "libc.h"
 #include "syscall.h"
 
-/* pouch: musl's __munmap targets Linux munmap(2); Thylacine's equivalent is
-   SYS_BURROW_DETACH, which takes the same (vaddr, len) shape. The kernel
-   matches against the installed VMA exactly - the page-rounded
-   [start, start + len) range must match what SYS_BURROW_ATTACH_LAZY (= __mmap)
-   produced. mallocng tracks `needed` exactly as the length it passed to
-   __mmap, so the round-trip is lossless.
+/* pouch: musl's __munmap targets Linux munmap(2); Thylacine's SYS_BURROW_DETACH
+   (38) takes the same (vaddr, len) shape and, since B-1a', the same meaning:
+   every mapping and piece under the page-rounded range goes, a partial range
+   trims or splits (the two slack ends of an over-sized reservation -- WebKit's
+   aligned reserve -- or one page out of a mapping), holes are permitted and an
+   empty range answers 0. The two shape errors Linux reports are answered here
+   (EINVAL); the kernel's own refusals -- a JIT code alias in the range, a
+   shared-in mapping the range would cut, no VMA slot for a middle cut -- have
+   no Linux analogue and decode to the generic EIO.
 
    SYS_munmap is __NR_munmap after the 0001-syscall-seam-retarget aliases it
    to Thylacine number 38 (= SYS_BURROW_DETACH; see thylacine/syscall.h). */
 int __munmap(void *start, size_t len)
 {
+	if (len == 0 || ((uintptr_t)start & (PAGE_SIZE-1))) {
+		errno = EINVAL;
+		return -1;
+	}
 	return syscall(SYS_munmap, start, len);
 }
 
--- a/src/mman/madvise.c
+++ b/src/mman/madvise.c
@@ -1,9 +1,58 @@
+#define _GNU_SOURCE
 #include <sys/mman.h>
+#include <errno.h>
+#include <stdint.h>
+#include "libc.h"
 #include "syscall.h"
+#include "_pouch_mman.h"
 
+/* pouch (B-1b; ARCHITECTURE.md sec 6.5 "Capacity"): madvise over
+   SYS_BURROW_DECOMMIT. MADV_DONTNEED and MADV_FREE release the range's
+   pages -- the mapping stays, a later touch faults a fresh zero page in,
+   and the process's footprint FALLS: this is how mallocng's freed slots
+   inside a retained group (free.c, USE_MADV_FREE) and an engine's decommit
+   give memory back. MADV_FREE is a lazy free on Linux, whose pages the
+   kernel may take at any moment; taking them at once is inside that
+   contract. The pure hints (NORMAL, RANDOM, SEQUENTIAL, WILLNEED, the THP
+   and dump-filter pairs, COLD, PAGEOUT) answer 0 without a syscall --
+   Thylacine has no readahead, THP or core-dump policy for them to steer;
+   the one divergence, documented: a hint on an unmapped range is 0 here
+   where Linux says ENOMEM. Any other advice is EINVAL, Linux's answer for
+   one it does not know.
+
+   The kernel's one refusal of a release is a flat -1 (the range is not
+   wholly plain anonymous memory of this process, or has a hole): ENOMEM,
+   mapped here before __syscall_ret would make it the generic EIO. Linux's
+   argument order is kept: alignment before a zero length. */
 int __madvise(void *addr, size_t len, int advice)
 {
-	return syscall(SYS_madvise, addr, len, advice);
+	if ((uintptr_t)addr & (PAGE_SIZE-1)) {
+		errno = EINVAL;
+		return -1;
+	}
+	switch (advice) {
+	case MADV_DONTNEED:
+	case MADV_FREE: {
+		if (len == 0) return 0;
+		long rc = __syscall(SYS_thyla_burrow_decommit, addr, len);
+		if (rc == -1) rc = -ENOMEM;
+		return __syscall_ret(rc);
+	}
+	case MADV_NORMAL:
+	case MADV_RANDOM:
+	case MADV_SEQUENTIAL:
+	case MADV_WILLNEED:
+	case MADV_HUGEPAGE:
+	case MADV_NOHUGEPAGE:
+	case MADV_DONTDUMP:
+	case MADV_DODUMP:
+	case MADV_COLD:
+	case MADV_PAGEOUT:
+		return 0;
+	default:
+		errno = EINVAL;
+		return -1;
+	}
 }
 
 weak_alias(__madvise, madvise);
--- a/src/mman/mprotect.c
+++ b/src/mman/mprotect.c
@@ -1,13 +1,35 @@
 #include <sys/mman.h>
+#include <errno.h>
 #include "libc.h"
 #include "syscall.h"
+#include "_pouch_mman.h"
 
+/* pouch (B-1b; ARCHITECTURE.md sec 6.5 "The permission ceiling"): mprotect
+   over SYS_BURROW_PROTECT (125), the one permission mutation, FOUR arguments
+   -- the fourth is the flags word (PROTECT_SEAL), passed as 0 here; the
+   seam's three-argument form would hand the kernel whatever x3 held, and a
+   stray 1 would SEAL the range. That is also why __NR_mprotect stays a
+   sentinel: a raw syscall(SYS_mprotect, ...) from a port cannot reach 125.
+
+   Linux's prot normalisation, then the kernel's own answers: a bit beyond
+   R|W|X is EINVAL; PROT_WRITE implies read; PROT_EXEC is refused with EACCES
+   before any lookup ("X is never a target": an RX text mapping may only
+   descend); a raise past the mapping's mint-time ceiling, a guard, a shared
+   or a JIT mapping is EACCES; a hole is ENOMEM. musl's own page rounding of
+   the ends is kept, and a range that rounds to nothing succeeds (Linux). */
 int __mprotect(void *addr, size_t len, int prot)
 {
 	size_t start, end;
+	if (prot & ~(PROT_READ|PROT_WRITE|PROT_EXEC)) {
+		errno = EINVAL;
+		return -1;
+	}
+	unsigned pr = (unsigned)prot;
+	if (pr & PROT_WRITE) pr |= PROT_READ;
 	start = (size_t)addr & -PAGE_SIZE;
 	end = (size_t)((char *)addr + len + PAGE_SIZE-1) & -PAGE_SIZE;
-	return syscall(SYS_mprotect, start, end-start, prot);
+	if (end == start) return 0;
+	return __syscall_ret(__syscall(SYS_thyla_burrow_protect, start, end-start, pr, 0));
 }
 
 weak_alias(__mprotect, mprotect);
