+/* pouch (B-1b): through __madvise, so a hint answers 0 instead of the raw
+   sentinel's ENOSYS. POSIX_MADV_DONTNEED keeps upstream's short-circuit:
+   POSIX's DONTNEED is advisory and must not discard, unlike Linux's. */
 int posix_madvise(void *addr, size_t len, int advice)
 {
 	if (advice == MADV_DONTNEED) return 0;
-	return -__syscall(SYS_madvise, addr, len, advice);
+	return __madvise(addr, len, advice) ? errno : 0;
 }
