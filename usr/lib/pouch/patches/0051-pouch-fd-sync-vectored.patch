diff --color -ruN a/src/unistd/_pouch_iov.c b/src/unistd/_pouch_iov.c
--- a/src/unistd/_pouch_iov.c	1970-01-01 01:00:00
+++ b/src/unistd/_pouch_iov.c	2026-10-14 23:37:12
@@ -0,0 +1,142 @@
+/* pouch -- readv / writev / preadv / pwritev as ONE read or write of a
+ * gathered buffer.
+ *
+ * The kernel has no vectored I/O. One call per iovec would split what the
+ * caller hands over as one record: a UDP datagram, a pipe write within
+ * PIPE_BUF that POSIX makes atomic. So the vector is gathered into one buffer
+ * and moved by one read or write (tag-aware: a pouch socket fd reaches its
+ * data handle), then scattered back after a read.
+ *
+ * Up to POUCH_IOV_STACK bytes are gathered on the stack, more in a heap buffer
+ * of at most POUCH_IOV_CHUNK bytes. A read moves at most one buffer (a short
+ * read, which every reader accepts). A write moves the vector buffer by buffer
+ * and stops at the first short write or error, answering the bytes written so
+ * far, as a short writev does. A vector with one non-empty element is moved in
+ * place, without a copy. A heap buffer that cannot be had answers ENOMEM.
+ *
+ * Cancellation: the heap buffer is released by a cleanup handler, so a thread
+ * cancelled inside the transfer does not leak it. */
+#include <sys/uio.h>
+#include <unistd.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+#include "syscall.h"
+#include "_pouch_fd.h"
+
+#define POUCH_IOV_STACK 4096u        /* PIPE_BUF */
+#define POUCH_IOV_CHUNK (1u << 20)
+
+/* Linux's rw_copy_check_uvector rules: cnt in [0, IOV_MAX], and the lengths
+ * summed within SSIZE_MAX. Answers the total, or -1 with EINVAL. */
+static ssize_t iov_total(const struct iovec *iov, int cnt)
+{
+	size_t total = 0;
+	if (cnt < 0 || cnt > IOV_MAX) { errno = EINVAL; return -1; }
+	for (int i = 0; i < cnt; i++) {
+		if (iov[i].iov_len > (size_t)SSIZE_MAX - total) {
+			errno = EINVAL;
+			return -1;
+		}
+		total += iov[i].iov_len;
+	}
+	return (ssize_t)total;
+}
+
+static ssize_t xfer(int fd, void *buf, size_t len, off_t off, int flags)
+{
+	if (flags & POUCH_IOV_AT)
+		return (flags & POUCH_IOV_WRITE) ? pwrite(fd, buf, len, off)
+		                                 : pread(fd, buf, len, off);
+	return (flags & POUCH_IOV_WRITE) ? write(fd, buf, len)
+	                                 : read(fd, buf, len);
+}
+
+/* Copies up to `cap` bytes of the vector, starting `skip` bytes in, to dst. */
+static size_t gather(char *dst, size_t cap, const struct iovec *iov, int cnt,
+                     size_t skip)
+{
+	size_t n = 0;
+	for (int i = 0; i < cnt && n < cap; i++) {
+		size_t len = iov[i].iov_len;
+		if (skip >= len) { skip -= len; continue; }
+		size_t take = len - skip;
+		if (take > cap - n) take = cap - n;
+		memcpy(dst + n, (const char *)iov[i].iov_base + skip, take);
+		n += take;
+		skip = 0;
+	}
+	return n;
+}
+
+static void scatter(const struct iovec *iov, int cnt, const char *src, size_t n)
+{
+	for (int i = 0; i < cnt && n; i++) {
+		size_t take = iov[i].iov_len < n ? iov[i].iov_len : n;
+		memcpy(iov[i].iov_base, src, take);
+		src += take;
+		n -= take;
+	}
+}
+
+static void free_heap(void *p)
+{
+	free(p);
+}
+
+ssize_t __pouch_iov_rw(int fd, const struct iovec *iov, int cnt, off_t off,
+                       int flags)
+{
+	ssize_t total = iov_total(iov, cnt);
+	if (total < 0) return -1;
+	if ((flags & POUCH_IOV_AT) && (off < 0 || total > LLONG_MAX - off)) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	int only = -1, nonempty = 0;
+	for (int i = 0; i < cnt; i++)
+		if (iov[i].iov_len) { only = i; nonempty++; }
+	if (nonempty <= 1) {
+		char none;
+		return only < 0 ? xfer(fd, &none, 0, off, flags)
+		                : xfer(fd, iov[only].iov_base, iov[only].iov_len,
+		                       off, flags);
+	}
+
+	char stack[POUCH_IOV_STACK];
+	char *heap = 0, *buf = stack;
+	size_t cap = (size_t)total;
+	if (cap > POUCH_IOV_STACK) {
+		if (cap > POUCH_IOV_CHUNK) cap = POUCH_IOV_CHUNK;
+		heap = malloc(cap);
+		if (!heap) { errno = ENOMEM; return -1; }
+		buf = heap;
+	}
+
+	ssize_t ret;
+	int saved;
+	pthread_cleanup_push(free_heap, heap);
+	if (!(flags & POUCH_IOV_WRITE)) {
+		ret = xfer(fd, buf, cap, off, flags);
+		if (ret > 0) scatter(iov, cnt, buf, (size_t)ret);
+	} else {
+		size_t done = 0, n;
+		ret = 0;
+		while ((n = gather(buf, cap, iov, cnt, done)) != 0) {
+			ssize_t w = xfer(fd, buf, n, off + (off_t)done, flags);
+			if (w < 0) {
+				if (!done) ret = -1;
+				break;
+			}
+			done += (size_t)w;
+			if ((size_t)w < n) break;
+		}
+		if (ret == 0) ret = (ssize_t)done;
+	}
+	saved = errno;
+	pthread_cleanup_pop(1);
+	errno = saved;
+	return ret;
+}
