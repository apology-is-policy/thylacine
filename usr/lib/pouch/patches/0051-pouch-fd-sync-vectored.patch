diff --color -ruN a/src/unistd/_pouch_iov.c b/src/unistd/_pouch_iov.c
--- a/src/unistd/_pouch_iov.c	1970-01-01 01:00:00
+++ b/src/unistd/_pouch_iov.c	2026-10-15 01:24:18
@@ -0,0 +1,155 @@
+/* pouch -- readv / writev / preadv / pwritev as ONE read or write.
+ *
+ * The kernel has no vectored I/O. One call per iovec would split what the
+ * caller hands over as one record: a UDP datagram, a pipe write within
+ * PIPE_BUF that POSIX makes atomic. So each call makes ONE transfer: a vector
+ * with one non-empty element moves in place; otherwise up to POUCH_IOV_CHUNK
+ * bytes of it are gathered into one buffer and moved by one read or write
+ * (tag-aware: a pouch socket fd reaches its data handle), and a read is
+ * scattered back. The answer is that transfer's count: a short count is a
+ * short readv or writev, which POSIX allows and a caller of a stream resumes.
+ *
+ * POUCH_IOV_CHUNK is the kernel's SYS_RW_MAX, the most one read or write
+ * moves; a larger buffer would be filled and never sent. It bounds work, not
+ * correctness: the kernel and the 9P client cut a transfer at their own
+ * bounds, and the short count says so either way. Up to POUCH_IOV_STACK bytes
+ * are gathered on the stack, in a helper so the in-place and refusal paths do
+ * not carry its frame; more on the heap, released by a cleanup handler if the
+ * thread is cancelled inside the transfer. A heap buffer that cannot be had
+ * answers ENOMEM.
+ *
+ * Unlike musl's single syscall, a gathered vector past POUCH_IOV_STACK bytes
+ * calls malloc (not async-signal-safe), and a bad iov_base there faults in
+ * the copy rather than answering EFAULT. */
+#include <sys/uio.h>
+#include <unistd.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+#include "syscall.h"
+#include "_pouch_fd.h"
+
+#define POUCH_IOV_STACK 4096u        /* PIPE_BUF */
+#define POUCH_IOV_CHUNK (128u << 10) /* the kernel's SYS_RW_MAX */
+
+/* POSIX's rules: cnt in [0, IOV_MAX], and the lengths summed within
+ * SSIZE_MAX, else EINVAL (Linux instead caps the sum). Answers the total, or
+ * -1 with EINVAL. */
+static ssize_t iov_total(const struct iovec *iov, int cnt)
+{
+	size_t total = 0;
+	if (cnt < 0 || cnt > IOV_MAX) { errno = EINVAL; return -1; }
+	for (int i = 0; i < cnt; i++) {
+		if (iov[i].iov_len > (size_t)SSIZE_MAX - total) {
+			errno = EINVAL;
+			return -1;
+		}
+		total += iov[i].iov_len;
+	}
+	return (ssize_t)total;
+}
+
+static ssize_t xfer(int fd, void *buf, size_t len, off_t off, int flags)
+{
+	if (flags & POUCH_IOV_AT)
+		return (flags & POUCH_IOV_WRITE) ? pwrite(fd, buf, len, off)
+		                                 : pread(fd, buf, len, off);
+	return (flags & POUCH_IOV_WRITE) ? write(fd, buf, len)
+	                                 : read(fd, buf, len);
+}
+
+/* Copies the first `cap` bytes of the vector to dst. An empty element's base
+ * is never touched (it may be null). */
+static void gather(char *dst, size_t cap, const struct iovec *iov, int cnt)
+{
+	for (int i = 0; i < cnt && cap; i++) {
+		size_t take = iov[i].iov_len < cap ? iov[i].iov_len : cap;
+		if (!take) continue;
+		memcpy(dst, iov[i].iov_base, take);
+		dst += take;
+		cap -= take;
+	}
+}
+
+static void scatter(const struct iovec *iov, int cnt, const char *src, size_t n)
+{
+	for (int i = 0; i < cnt && n; i++) {
+		size_t take = iov[i].iov_len < n ? iov[i].iov_len : n;
+		if (!take) continue;
+		memcpy(iov[i].iov_base, src, take);
+		src += take;
+		n -= take;
+	}
+}
+
+static void free_heap(void *p)
+{
+	free(p);
+}
+
+/* One transfer through buf: gather and write, or read and scatter. */
+static ssize_t iov_move(int fd, const struct iovec *iov, int cnt, char *buf,
+                        size_t cap, off_t off, int flags)
+{
+	if (flags & POUCH_IOV_WRITE) {
+		gather(buf, cap, iov, cnt);
+		return xfer(fd, buf, cap, off, flags);
+	}
+	ssize_t ret = xfer(fd, buf, cap, off, flags);
+	if (ret > 0) scatter(iov, cnt, buf, (size_t)ret);
+	return ret;
+}
+
+/* Out of line, so the in-place and refusal paths do not carry its frame. No
+ * cleanup handler: a signal handler may siglongjmp out of this transfer (a
+ * small readv or writev stays async-signal-safe), and a pushed handler would
+ * be left pointing into the abandoned frame. */
+static __attribute__((__noinline__))
+ssize_t iov_stacked(int fd, const struct iovec *iov, int cnt, size_t cap,
+                    off_t off, int flags)
+{
+	char stack[POUCH_IOV_STACK];
+	return iov_move(fd, iov, cnt, stack, cap, off, flags);
+}
+
+static ssize_t iov_heaped(int fd, const struct iovec *iov, int cnt, size_t cap,
+                          off_t off, int flags)
+{
+	char *heap = malloc(cap);
+	if (!heap) { errno = ENOMEM; return -1; }
+
+	ssize_t ret;
+	int saved;
+	pthread_cleanup_push(free_heap, heap);
+	ret = iov_move(fd, iov, cnt, heap, cap, off, flags);
+	saved = errno;
+	pthread_cleanup_pop(1);
+	errno = saved;
+	return ret;
+}
+
+ssize_t __pouch_iov_rw(int fd, const struct iovec *iov, int cnt, off_t off,
+                       int flags)
+{
+	ssize_t total = iov_total(iov, cnt);
+	if (total < 0) return -1;
+	if ((flags & POUCH_IOV_AT) && (off < 0 || total > LLONG_MAX - off)) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	int only = -1, nonempty = 0;
+	for (int i = 0; i < cnt; i++)
+		if (iov[i].iov_len) { only = i; nonempty++; }
+	if (nonempty > 1) {
+		size_t cap = (size_t)total < POUCH_IOV_CHUNK ? (size_t)total
+		                                             : POUCH_IOV_CHUNK;
+		return cap <= POUCH_IOV_STACK ? iov_stacked(fd, iov, cnt, cap, off, flags)
+		                              : iov_heaped(fd, iov, cnt, cap, off, flags);
+	}
+
+	char none;
+	return only < 0 ? xfer(fd, &none, 0, off, flags)
+	                : xfer(fd, iov[only].iov_base, iov[only].iov_len, off, flags);
+}
