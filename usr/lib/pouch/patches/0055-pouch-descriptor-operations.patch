+/* Native descriptor operations only. Tagged sockets have another owner. */
+#ifndef _POUCH_DESCRIPTOR_H
+#define _POUCH_DESCRIPTOR_H
+#include <errno.h>
+#include "syscall.h"
+#include "_pouch_socket.h"
+
+static inline int pouch_descriptor_check(int fd)
+{
+    if (fd < 0) return EBADF;
+    if (fd & POUCH_SOCK_TAG)
+        return pouch_sock_resolve(fd) ? ENOSYS : EBADF;
+    return 0;
+}
+
+/* These metadata/dup contracts exclude EPERM, so legacy unknown-call -1
+ * can be translated here without changing unrelated native error handling. */
+static inline long pouch_descriptor_result(long result)
+{
+    return result == -1 ? -ENOSYS : result;
+}
+#endif
