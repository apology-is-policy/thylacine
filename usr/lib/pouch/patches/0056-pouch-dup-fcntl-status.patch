+#define POUCH_HANDLE_CLOSE_ON_EXEC   1
+#define POUCH_HANDLE_DUP_LOWEST      2
+#define POUCH_HANDLE_OMODE_SHIFT     8
+#define POUCH_HANDLE_OMODE_MASK      (3L << POUCH_HANDLE_OMODE_SHIFT)
+#define POUCH_HANDLE_NONBLOCK        0x400L
+#define POUCH_HANDLE_APPEND          0x800L
+
 static inline int pouch_descriptor_check(int fd)
 {
     if (fd < 0) return EBADF;
@@ -19,4 +28,16 @@
 {
     return result == -1 ? -ENOSYS : result;
 }
+
+/* O_CLOEXEC is the native descriptor flag, set after the descriptor exists:
+ * a peer thread's spawn in between sees it unflagged, which Linux's single
+ * call rules out. A tagged socket has no native slot to flag: ENOSYS while it
+ * is live, EBADF once it is not. */
+static inline long pouch_set_cloexec(int fd)
+{
+    int e = pouch_descriptor_check(fd);
+    if (e) return -e;
+    return pouch_descriptor_result(
+        __syscall2(SYS_thyla_handle_flags_set, fd, POUCH_HANDLE_CLOSE_ON_EXEC));
+}
