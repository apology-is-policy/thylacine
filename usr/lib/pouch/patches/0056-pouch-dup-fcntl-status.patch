 #include <errno.h>
 #include "_pouch_descriptor.h"
 
+/* The open-file status the kernel can change after open is O_NONBLOCK only:
+ * O_APPEND lives in the server's open of the file, so F_SETFL may restate it
+ * but not flip it, and O_ASYNC, O_DIRECT and O_NOATIME have no mechanism.
+ * Those answer EINVAL, as Linux does for a status flag a file cannot take;
+ * every other bit is ignored, as Linux ignores it. */
+static int status_flags(long word)
+{
+	int mode = (int)((word & POUCH_HANDLE_OMODE_MASK) >> POUCH_HANDLE_OMODE_SHIFT);
+	/* OEXEC (3) has no Linux access mode; it reads as O_RDONLY. */
+	int fl = mode == 1 ? O_WRONLY : mode == 2 ? O_RDWR : O_RDONLY;
+	if (word & POUCH_HANDLE_NONBLOCK) fl |= O_NONBLOCK;
+	if (word & POUCH_HANDLE_APPEND)   fl |= O_APPEND;
+	return fl;
+}
