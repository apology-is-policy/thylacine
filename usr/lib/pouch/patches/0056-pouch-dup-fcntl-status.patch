--- a/src/unistd/pipe2.c
+++ b/src/unistd/pipe2.c
@@ -3,14 +3,36 @@
 #include <fcntl.h>
 #include "syscall.h"
 #include "_pouch_process.h"
+#include "_pouch_descriptor.h"
 
-/* pouch: pipe2. O_CLOEXEC is accepted as a no-op -- a pipe fd is inherited by
- * a child ONLY if explicitly listed in the spawn fd_list, so "close on exec"
- * holds by construction. O_NONBLOCK is not settable at v1.0 (no fcntl
- * F_SETFL); the pipe stays blocking (a documented best-effort, rare in the
- * compile path). Any other flag is EINVAL (musl's contract). */
+/* pouch: pipe2. The flags are set on both ends after SYS_PIPE creates them:
+ * O_CLOEXEC through the native descriptor flag (spawn leaves a flagged stream
+ * out of the child, native exec closes it) and O_NONBLOCK through the native
+ * per-open-file flag. A peer thread's spawn between the two steps could see
+ * an unflagged end, which Linux's single call rules out. A failed flag set
+ * closes both ends and fails the call. Any other flag is EINVAL (musl's
+ * contract). */
 int pipe2(int fd[2], int flag)
 {
 	if (flag & ~(O_CLOEXEC | O_NONBLOCK)) { errno = EINVAL; return -1; }
-	return __pouch_pipe(fd);
+	int p[2];
+	if (__pouch_pipe(p) < 0) return -1;
+	for (int i = 0; i < 2; i++) {
+		long r = 0;
+		if (flag & O_CLOEXEC)
+			r = __syscall2(SYS_thyla_handle_flags_set, p[i],
+			               POUCH_HANDLE_CLOSE_ON_EXEC);
+		if (!r && (flag & O_NONBLOCK))
+			r = __syscall2(SYS_thyla_set_nonblock, p[i], 1);
+		r = pouch_descriptor_result(r);
+		if (r < 0) {
+			close(p[0]);
+			close(p[1]);
+			errno = (int)-r;
+			return -1;
+		}
+	}
+	fd[0] = p[0];
+	fd[1] = p[1];
+	return 0;
 }
