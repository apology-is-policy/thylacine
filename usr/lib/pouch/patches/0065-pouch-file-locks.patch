+static int lock_type(short t)
+{
+	switch (t) {
+	case F_RDLCK: return POUCH_FILE_LOCK_RD;
+	case F_WRLCK: return POUCH_FILE_LOCK_WR;
+	case F_UNLCK: return POUCH_FILE_LOCK_UN;
+	}
+	return -1;
+}
+
+/* The lock commands over SYS_thyla_file_lock. F_SETLK, F_SETLKW and F_GETLK
+ * name the Proc as the owner (POSIX gives the lock to the descriptor table);
+ * F_OFD_* name the open file. The range and the order of the refusals are
+ * Linux's (fs/locks.c): whence, then the range, then the type, then the
+ * access mode, then an OFD request's l_pid. The server never reports a
+ * process: F_GETLK answers l_pid -1, Linux's answer for an OFD lock. */
+static int fcntl_lock(int fd, int cmd, struct flock *fl)
+{
+	int ec = pouch_descriptor_check(fd);
+	if (ec) { errno = ec; return -1; }
+	int getlk = cmd == F_GETLK || cmd == F_OFD_GETLK;
+	int ofd = cmd == F_OFD_GETLK || cmd == F_OFD_SETLK || cmd == F_OFD_SETLKW;
+	int wait = cmd == F_SETLKW || cmd == F_OFD_SETLKW;
+	int type = lock_type(fl->l_type);
+	if (getlk && type != POUCH_FILE_LOCK_RD && type != POUCH_FILE_LOCK_WR)
+		return pouch_lock_refuse(fd, EINVAL);
+	off_t base;
+	switch (fl->l_whence) {
+	case SEEK_SET:
+		base = 0;
+		break;
+	case SEEK_CUR:
+		/* A descriptor with no cursor reads as 0, Linux's f_pos of a pipe. The
+		 * kernel says so with its flat -1 (ESPIPE is not in the errno registry),
+		 * which __lseek would report as EIO. */
+		base = __syscall3(SYS_lseek, fd, 0, SEEK_CUR);
+		if (base == -1) base = 0;
+		else if (base < 0) { errno = -base; return -1; }
+		break;
+	case SEEK_END: {
+		/* fstat, not lseek: the lock must not move the cursor. */
+		struct stat st;
+		if (__fstat(fd, &st)) return -1;
+		base = st.st_size;
+		break;
+	}
+	default:
+		return pouch_lock_refuse(fd, EINVAL);
+	}
+	if (fl->l_start > LLONG_MAX - base) return pouch_lock_refuse(fd, EOVERFLOW);
+	off_t start = base + fl->l_start;
+	if (start < 0) return pouch_lock_refuse(fd, EINVAL);
+	unsigned long long len = 0;
+	if (fl->l_len > 0) {
+		if (fl->l_len - 1 > LLONG_MAX - start) return pouch_lock_refuse(fd, EOVERFLOW);
+		len = fl->l_len;
+	} else if (fl->l_len < 0) {
+		/* POSIX 2001: the range ends just before start. */
+		if (start + fl->l_len < 0) return pouch_lock_refuse(fd, EINVAL);
+		start += fl->l_len;
+		len = -(unsigned long long)fl->l_len;
+	}
+	if (type < 0) return pouch_lock_refuse(fd, EINVAL);
+	if (ofd && fl->l_pid != 0) {
+		long st = pouch_descriptor_result(__syscall1(SYS_thyla_handle_flags_get, fd));
+		if (st < 0) { errno = (int)-st; return -1; }
+		int acc = status_flags(st) & O_ACCMODE;
+		if (!getlk && ((type == POUCH_FILE_LOCK_RD && acc == O_WRONLY)
+		               || (type == POUCH_FILE_LOCK_WR && acc == O_RDONLY))) {
+			errno = EBADF;
+			return -1;
+		}
+		errno = EINVAL;
+		return -1;
+	}
+	long op = type | (ofd ? 0 : POUCH_FILE_LOCK_PROC);
+	long ret;
+	if (getlk) {
+		struct pouch_file_lock ans = {0};
+		ret = pouch_descriptor_result(__syscall5(SYS_thyla_file_lock, fd,
+		        op | POUCH_FILE_LOCK_TEST, start, (long)len, &ans));
+		if (ret < 0) { errno = (int)-ret; return -1; }
+		short t;
+		switch (ans.type) {
+		case POUCH_FILE_LOCK_UN:
+			/* Linux changes only l_type when nothing conflicts. */
+			fl->l_type = F_UNLCK;
+			return 0;
+		case POUCH_FILE_LOCK_RD: t = F_RDLCK; break;
+		case POUCH_FILE_LOCK_WR: t = F_WRLCK; break;
+		default: errno = EIO; return -1;
+		}
+		/* The conflict overlaps the request, so it starts at or below
+		 * LLONG_MAX from an honest server. One that ends past LLONG_MAX
+		 * covers every offset a struct flock can name from its start:
+		 * l_len 0, as Linux reports a lock ending at OFFSET_MAX. */
+		if (ans.start > LLONG_MAX) { errno = EOVERFLOW; return -1; }
+		fl->l_type = t;
+		fl->l_whence = SEEK_SET;
+		fl->l_start = (off_t)ans.start;
+		fl->l_len = ans.len == 0 || ans.len - 1 >= LLONG_MAX - ans.start
+		            ? 0 : (off_t)ans.len;
+		fl->l_pid = -1;
+		return 0;
+	}
+	if (wait) {
+		/* F_SETLKW is a cancellation point; the unlock never waits. */
+		if (type != POUCH_FILE_LOCK_UN) op |= POUCH_FILE_LOCK_WAIT;
+		ret = __syscall_cp(SYS_thyla_file_lock, fd, op, start, (long)len, 0);
+	} else {
+		ret = __syscall5(SYS_thyla_file_lock, fd, op, start, (long)len, 0);
+	}
+	ret = pouch_descriptor_result(ret);
+	if (ret < 0) { errno = (int)-ret; return -1; }
+	return 0;
+}
+
 int fcntl(int fd, int cmd, ...)
 {
     int arg = 0;
