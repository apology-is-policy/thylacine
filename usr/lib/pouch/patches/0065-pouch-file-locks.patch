 #include <sys/file.h>
-#include "syscall.h"
+#include <errno.h>
+#include "_pouch_descriptor.h"
+#include "_pouch_lock.h"
 
+/* flock over SYS_thyla_file_lock: a whole-file lock owned by the open file,
+ * the byte-range lock Linux's NFS client turns flock into. So flock and fcntl
+ * locks on one file conflict, and LOCK_EX needs a descriptor open for
+ * writing (EBADF), as on Linux NFS. Linux reads the op before the descriptor. */
 int flock(int fd, int op)
 {
-	return syscall(SYS_flock, fd, op);
+	long type;
+	switch (op & ~LOCK_NB) {
+	case LOCK_SH: type = POUCH_FILE_LOCK_RD; break;
+	case LOCK_EX: type = POUCH_FILE_LOCK_WR; break;
+	case LOCK_UN: type = POUCH_FILE_LOCK_UN; break;
+	default: errno = EINVAL; return -1;
+	}
+	int ec = pouch_descriptor_check(fd);
+	if (ec) { errno = ec; return -1; }
+	if (!(op & LOCK_NB) && type != POUCH_FILE_LOCK_UN) type |= POUCH_FILE_LOCK_WAIT;
+	long ret = pouch_descriptor_result(__syscall5(SYS_thyla_file_lock, fd, type, 0, 0, 0));
+	if (ret < 0) { errno = (int)-ret; return -1; }
+	return 0;
 }
