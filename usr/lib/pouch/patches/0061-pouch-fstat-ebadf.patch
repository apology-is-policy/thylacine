+/* The refusal for an fd a request does not fit: EBADF when the fd is
+ * dead, else ENOTTY. A tagged socket fd is a libc slot the kernel
+ * cannot see, so its own table answers for it. */
+static int refuse_fd(int fd)
+{
+	struct pouch_tstat ts;
+	int dead;
+	if (fd < 0) dead = 1;
+	else if (fd & POUCH_SOCK_TAG) dead = !pouch_sock_resolve(fd);
+	else dead = __syscall(SYS_fstat, fd, &ts) == -EBADF;
+	errno = dead ? EBADF : ENOTTY;
+	return -1;
 }
 
