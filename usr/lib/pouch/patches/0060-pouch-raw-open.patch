+/* pouch: SYS_open is the native open (start_fd, path, length, omode), not
+ * Linux's open(path, flags, mode), and SYS_openat is the ENOSYS sentinel, so
+ * musl's own opens (stdio's, __map_file's, the secure start's) cannot be raw
+ * syscalls. They take openat's translation, which answers a descriptor or
+ * -errno, as the syscall would, and leaves errno alone. None is a
+ * cancellation point; Pouch's open() is not one either. */
+hidden long __pouch_sys_open(const char *, int, unsigned);
+#define __sys_open2(x,pn,fl) __pouch_sys_open(pn, fl, 0)
+#define __sys_open3(x,pn,fl,mo) __pouch_sys_open(pn, fl, mo)
+#define __sys_open_cp2(x,pn,fl) __pouch_sys_open(pn, fl, 0)
+#define __sys_open_cp3(x,pn,fl,mo) __pouch_sys_open(pn, fl, mo)
 
 #define __sys_open(...) __SYSCALL_DISP(__sys_open,,__VA_ARGS__)
 #define sys_open(...) __syscall_ret(__sys_open(__VA_ARGS__))
