diff --color -ru a/src/signal/kill.c b/src/signal/kill.c
--- a/src/signal/kill.c
+++ b/src/signal/kill.c
@@ -27,6 +27,17 @@
 	if (sig == SIGABRT && (pid == 0 || pid == getpid()))
 		abort();
 
+	/* SIGSEGV, SIGBUS, SIGILL and SIGFPE have no note either and no
+	 * disposition but the default, so one sent to the caller itself ends
+	 * it: the kernel takes the snare it names to the same death a real
+	 * fault reaches. To another process they stay EINVAL below. */
+	if (pid == 0 || pid == getpid()) {
+		const char *snare = __pouch_self_snare(sig);
+		if (snare)
+			return syscall(SYS_postnote, 0L, snare,
+			               (unsigned long)strlen(snare));
+	}
+
 	const char *name;
 	if (__pouch_sig_to_note(sig, &name) != 0) {
 		errno = EINVAL;
@@ -45,6 +56,16 @@
 		return -1;
 	}
 
+	/* The kernel refuses a process that is not the caller's child with
+	 * -EACCES: its handlers never answer -EPERM, which is the flat -1 the
+	 * seam reads as EIO. POSIX kill spells that refusal EPERM, so it is
+	 * set here rather than through the seam. ESRCH, EAGAIN and EINVAL
+	 * pass through as the kernel names them. */
 	unsigned long len = (unsigned long)strlen(name);
-	return syscall(SYS_postnote, (long)pid, name, len);
+	long r = __syscall(SYS_postnote, (long)pid, name, len);
+	if (r == -EACCES) {
+		errno = EPERM;
+		return -1;
+	}
+	return __syscall_ret(r);
 }
