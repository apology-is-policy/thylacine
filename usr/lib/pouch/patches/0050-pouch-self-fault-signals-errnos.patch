 hidden int __pouch_sig_to_note(int sig, const char **out);
 
+/* The snare a fault signal names, for a process ending itself with it:
+ * SIGSEGV -> "snare:segv", SIGBUS -> "snare:bus", SIGILL -> "snare:ill",
+ * SIGFPE -> "snare:fpe"; NULL for every other signal. Posted to the caller
+ * itself, the kernel ends it with that snare and records the signal; posted
+ * to anyone else it is refused. */
+hidden const char *__pouch_self_snare(int sig);
+
 /* The bootstrap async-handler. Registered with SYS_NOTIFY at startup;
  * the kernel calls this at EL0-return tail when a note is dispatched.
  * Plan-9-style ABI: x0 = pointer to 16-byte note name on user stack;
diff --color -ru a/src/signal/_pouch_signal.c b/src/signal/_pouch_signal.c
--- a/src/signal/_pouch_signal.c
+++ b/src/signal/_pouch_signal.c
@@ -83,6 +83,17 @@
     }
 }
 
+hidden const char *__pouch_self_snare(int sig)
+{
+    switch (sig) {
+    case SIGSEGV: return "snare:segv";
+    case SIGBUS:  return "snare:bus";
+    case SIGILL:  return "snare:ill";
+    case SIGFPE:  return "snare:fpe";
+    default:      return 0;
+    }
+}
