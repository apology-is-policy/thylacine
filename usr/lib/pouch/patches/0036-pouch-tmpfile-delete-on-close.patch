 	close_file(__stdout_used);
 	close_file(__stderr_used);
+	__pouch_tmpfile_exit();
 }
 
 weak_alias(__stdio_exit, __stdio_exit_needed);
--- a/src/stdio/tmpfile.c
+++ b/src/stdio/tmpfile.c
@@ -1,30 +1,179 @@
 #include <stdio.h>
 #include <fcntl.h>
 #include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <errno.h>
 #include "stdio_impl.h"
+#include "lock.h"
 
 #define MAXTRIES 100
 
+/* pouch: tmpfile() is DELETE-ON-CLOSE, not create-then-unlink.
+ *
+ * Upstream creates the file, unlinks it at once and keeps using the fd. That
+ * needs a filesystem on which an open file outlives its last name, and the
+ * root filesystem here is not one: Stratum REJECTS I/O on a fid whose file has
+ * been unlinked (its fid model's IOReject gate -- ENOENT/ESTALE), by design.
+ * So an honest unlink-at-creation leaves a stream whose first uncached read
+ * or flushed write fails. (For years this was invisible: upstream's unlink is
+ * a raw SYS_unlinkat, a 0xFFFF sentinel whose result is ignored, so NO unlink
+ * happened -- every tmpfile() simply leaked /tmp/tmpfile_XXXXXX for ever.)
+ *
+ * The name therefore lives exactly as long as the stream: removed by fclose()
+ * (through f->close) and, for streams still open at a normal exit, by
+ * __stdio_exit after the final flush. That is best effort by nature: a
+ * process that dies without running exit() leaves its names behind (POSIX
+ * calls that case implementation-defined), and so does an exit() that lands
+ * between open() returning and the node being listed below. Both need a
+ * boot-time /tmp sweep, not libc.
+ *
+ * LOCKING. tmp_lock guards the list and tmp_exiting and is NEVER held across
+ * a syscall: every hold is a few pointer stores, the same window upstream's
+ * open-file-list lock has. (The first version held it across close + unlink,
+ * four 9P round trips, each a note-delivery point: a handler calling exit()
+ * there met its own lock in a threaded program and, in a single-threaded one,
+ * found the node unlisted but the name still on disk.) So:
+ *   - fclose() closes and unlinks while the node is STILL LISTED, and only
+ *     then unlists it: an exit() landing anywhere in between still sweeps the
+ *     name, and the sweep repeating a close or an unlink is harmless.
+ *   - the exit sweep sets tmp_exiting and releases the lock before it walks.
+ *     From then on the list is frozen: fclose() leaves its node in place and
+ *     tmpfile() removes its own new file instead of listing it, so the walk
+ *     needs no lock and no thread is parked holding a file the sweep missed.
+ *   - the DESCRIPTOR has one closer. Whoever takes it out of the node, under
+ *     the lock, closes it (tmp_take_fd): fclose(), the __fdopen-failure arm or
+ *     the sweep, never two of them -- a second close can land on a descriptor
+ *     another thread was handed in between. */
+
+struct tmpnode {
+	struct tmpnode *next, *prev;
+	int fd;
+	char name[sizeof "/tmp/tmpfile_XXXXXX"];
+};
+
+static struct tmpnode *tmp_head;
+static int tmp_exiting;
+static volatile int tmp_lock[1];
+
+/* exit() reaches __stdio_exit only through this reference: the weak
+ * __stdio_exit_needed is otherwise pulled in by __toread.o / __towrite.o
+ * alone, and a program that uses tmpfile() through fileno() links neither --
+ * its exit() would bind the dummy and never sweep. */
+hidden void __tmpfile_needs_stdio_exit()
+{
+	__stdio_exit_needed();
+}
+
+static void tmp_unlist(struct tmpnode *n)
+{
+	if (n->prev) n->prev->next = n->next;
+	else tmp_head = n->next;
+	if (n->next) n->next->prev = n->prev;
+}
+
+/* Returns 0 with the node unlisted (the caller frees it), or -1 if the exit
+ * sweep owns the list and the node must stay where it is. */
+static int tmp_retire(struct tmpnode *n)
+{
+	int r = -1;
+	LOCK(tmp_lock);
+	if (!tmp_exiting) {
+		tmp_unlist(n);
+		r = 0;
+	}
+	UNLOCK(tmp_lock);
+	return r;
+}
+
+/* Takes the descriptor out of the node: the caller that gets >= 0 closes it. */
+static int tmp_take_fd(struct tmpnode *n)
+{
+	int fd;
+	LOCK(tmp_lock);
+	fd = n->fd;
+	n->fd = -1;
+	UNLOCK(tmp_lock);
+	return fd;
+}
+
+static int tmpfile_close(FILE *f)
+{
+	struct tmpnode *n = f->cookie;
+	int r, e;
+
+	/* __stdio_close closes it (f->fd is the same descriptor), and closes it
+	 * first: nothing may touch the fid after the unlink. */
+	(void)tmp_take_fd(n);
+	r = __stdio_close(f);
+	e = errno;
+	unlink(n->name);
+	errno = e;
+	if (!tmp_retire(n)) free(n);
+	return r;
+}
+
+/* Called by __stdio_exit once every stream has been flushed. */
+void __pouch_tmpfile_exit(void)
+{
+	struct tmpnode *n;
+	LOCK(tmp_lock);
+	tmp_exiting = 1;
+	n = tmp_head;
+	UNLOCK(tmp_lock);
+	for (; n; n = n->next) {
+		int fd = tmp_take_fd(n);
+		if (fd >= 0) __syscall(SYS_close, fd);
+		unlink(n->name);
+	}
+}
+
 FILE *tmpfile(void)
 {
 	char s[] = "/tmp/tmpfile_XXXXXX";
-	int fd;
+	int fd, e, listed;
 	FILE *f;
 	int try;
+	struct tmpnode *n;
+
+	/* Before the file exists, so a failure here leaves nothing to undo. */
+	n = malloc(sizeof *n);
+	if (!n) return 0;
+
 	for (try=0; try<MAXTRIES; try++) {
 		__randname(s+13);
 		/* pouch: route through the patched open() -- see fopen.c. */
 		fd = open(s, O_RDWR|O_CREAT|O_EXCL, 0600);
-		if (fd >= 0) {
-#ifdef SYS_unlink
-			__syscall(SYS_unlink, s);
-#else
-			__syscall(SYS_unlinkat, AT_FDCWD, s, 0);
-#endif
-			f = __fdopen(fd, "w+");
-			if (!f) __syscall(SYS_close, fd);
-			return f;
+		if (fd < 0) continue;
+
+		n->fd = fd;
+		memcpy(n->name, s, sizeof s);
+		LOCK(tmp_lock);
+		listed = !tmp_exiting;
+		if (listed) {
+			n->prev = 0;
+			n->next = tmp_head;
+			if (tmp_head) tmp_head->prev = n;
+			tmp_head = n;
 		}
+		UNLOCK(tmp_lock);
+
+		f = listed ? __fdopen(fd, "w+") : 0;
+		if (!f) {
+			e = listed ? errno : EAGAIN;
+			/* Unlisted, the node is private; listed, the sweep may be
+			 * walking it. */
+			fd = listed ? tmp_take_fd(n) : fd;
+			if (fd >= 0) __syscall(SYS_close, fd);
+			unlink(s);
+			if (!listed || !tmp_retire(n)) free(n);
+			errno = e;
+			return 0;
+		}
+		f->cookie = n;
+		f->close = tmpfile_close;
+		return f;
 	}
+	free(n);
 	return 0;
 }
