--- a/src/stdio/__stdio_seek.c
+++ b/src/stdio/__stdio_seek.c
@@ -1,7 +1,16 @@
 #include "stdio_impl.h"
 #include <unistd.h>
+#include <errno.h>
+#include "_pouch_socket.h"
 
 off_t __stdio_seek(FILE *f, off_t off, int whence)
 {
+	/* pouch: a socket is not seekable, and its fd is a slot tag the kernel
+	 * has never seen -- answer what POSIX says rather than the kernel's
+	 * EBADF for a number it did not issue. */
+	if (f->fd & POUCH_SOCK_TAG) {
+		errno = ESPIPE;
+		return -1;
+	}
 	return __lseek(f->fd, off, whence);
 }
