+	 * against; INT_MAX would turn every close-all-fds loop into a hang. */
+	if (getrlimit(RLIMIT_NOFILE, &rl)) return 1024;
 	return rl.rlim_cur < INT_MAX ? rl.rlim_cur : INT_MAX;
