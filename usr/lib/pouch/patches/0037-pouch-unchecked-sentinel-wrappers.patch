--- a/src/legacy/getdtablesize.c
+++ b/src/legacy/getdtablesize.c
@@ -6,6 +6,10 @@
 int getdtablesize(void)
 {
 	struct rlimit rl;
-	getrlimit(RLIMIT_NOFILE, &rl);
+	/* pouch: getrlimit is a sentinel and this API has no error channel.
+	 * The kernel's per-Proc handle table is PROC_HANDLE_MAX = 1024
