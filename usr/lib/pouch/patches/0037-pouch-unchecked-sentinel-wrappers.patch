--- a/src/unistd/ualarm.c
+++ b/src/unistd/ualarm.c
@@ -2,12 +2,17 @@
 #include <unistd.h>
 #include <sys/time.h>
 
+/* pouch: setitimer is a sentinel here, so the call fails WITHOUT writing
+ * it_old, and upstream then returned that uninitialised struct as "the time
+ * left on the previous alarm". Report the failure instead (errno is the
+ * wrapper's ENOSYS); -1 is what glibc answers when the timer cannot be set.
+ * alarm() beside this file is saved only by its `old = { 0 }`. */
 unsigned ualarm(unsigned value, unsigned interval)
 {
 	struct itimerval it = {
 		.it_interval.tv_usec = interval,
 		.it_value.tv_usec = value
-	}, it_old;
-	setitimer(ITIMER_REAL, &it, &it_old);
+	}, it_old = { 0 };
+	if (setitimer(ITIMER_REAL, &it, &it_old)) return -1;
 	return it_old.it_value.tv_sec*1000000 + it_old.it_value.tv_usec;
 }
