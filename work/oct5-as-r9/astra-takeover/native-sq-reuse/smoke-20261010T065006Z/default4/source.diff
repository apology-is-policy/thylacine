 }
 
+// At head publication, simulate the permitted producer immediately reusing
+// a one-entry SQ. This deterministic boundary detects copying AFTER release;
+// it does not pretend to exercise userspace scheduling or private ENTER.
+static struct Loom *sq_reuse_target;
+static u32 sq_reuse_visits;
+static void sq_reuse_producer(struct Loom *l) {
+    if (l != sq_reuse_target || sq_reuse_visits++) return;
+    struct loom_ring_hdr *h = (struct loom_ring_hdr *)(l->ring_kva + l->hdr_off);
+    loom_stage_sqe(l, 0, LOOM_OP_NOP, 0, 0, 0, 0x222ULL);
+    __atomic_store_n(&h->sq_tail, 2u, __ATOMIC_RELEASE);
+}
+void test_loom_sq_reuse_after_copy(void);
+void test_loom_sq_reuse_after_copy(void) {
+    for (u32 bad_index = 0; bad_index < 2; ++bad_index) {
+        struct Loom *l = loom_create(1, 2, false);
+        TEST_ASSERT(l != NULL, "one-entry SQ");
+        struct loom_ring_hdr *h = (struct loom_ring_hdr *)(l->ring_kva + l->hdr_off);
+        struct loom_cqe *cq = (struct loom_cqe *)(l->ring_kva + l->cqe_off);
+        u32 *indices = (u32 *)(l->ring_kva + l->sq_array_off);
+        loom_stage_sqe(l, 0, LOOM_OP_NOP, 0, 0, 0, 0x111ULL);
+        if (bad_index) indices[0] = 7;
+        __atomic_store_n(&h->sq_tail, 1u, __ATOMIC_RELEASE);
+        sq_reuse_target = l; sq_reuse_visits = 0;
+        loom_sq_reuse_hook_for_test(sq_reuse_producer);
+        int n = loom_enter(l, 1, 0, LOOM_ENTER_NONBLOCK);
+        loom_sq_reuse_hook_for_test(NULL); sq_reuse_target = NULL;
+        TEST_EXPECT_EQ(sq_reuse_visits, 1u, "producer runs exactly at head release");
+        TEST_EXPECT_EQ(n, bad_index ? 0 : 1, "invalid index cannot be repaired retroactively");
+        TEST_EXPECT_EQ(h->dropped, bad_index, "rejected original index counted");
+        TEST_EXPECT_EQ(l->cq_tail, bad_index ? 0u : 1u, "only valid original completes");
+        if (!bad_index) {
+            TEST_EXPECT_EQ(cq[0].user_data, 0x111ULL, "original SQE copied before reuse");
+            TEST_EXPECT_EQ(cq[0].result, 0, "original NOP result");
+        }
+        TEST_EXPECT_EQ(loom_enter(l, 1, 0, LOOM_ENTER_NONBLOCK), 1, "replacement consumed separately");
+        TEST_EXPECT_EQ(cq[bad_index ? 0 : 1].user_data, 0x222ULL, "replacement cookie preserved");
+        TEST_EXPECT_EQ(h->sq_head, 2u, "both slots acknowledged exactly once");
+        loom_unref(l);
+    }
+}
+
 // The submit-time reject paths each post an error CQE (the SQE is still consumed
 // -- io_uring semantics), never a dropped/lost SQE: a bad handle_idx (-EINVAL),
 // an empty registered slot (-EBADF), a still-unimplemented-but-in-range opcode
