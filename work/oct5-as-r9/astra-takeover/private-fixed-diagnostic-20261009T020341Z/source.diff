+    const struct loom_reg_buffer *b = &l->reg_buf[m->buffer_index];
+    if (!b->burrow || b->burrow == l->ring ||
+        b->burrow->type != BURROW_TYPE_ANON || !b->burrow->pages ||
+        m->offset > b->len || m->length > b->len - m->offset) {
+        return -T_E_INVAL;
