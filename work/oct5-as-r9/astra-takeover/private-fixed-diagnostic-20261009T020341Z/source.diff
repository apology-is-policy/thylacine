+static int loom_private_extent_locked(struct Loom *l,
+                                      const struct loom_service_pool_member *m,
+                                      struct loom_pool_extent *out) {
+    if (m->reserved || m->buffer_index >= l->n_reg_buf || !m->length) {
+        return -T_E_INVAL;
